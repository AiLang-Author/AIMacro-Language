LibraryImport.Hash
LibraryImport.Array
LibraryImport.AIMacro.AIMacroTypes
LibraryImport.AIMacro.AIMacro

// Hash.Contains/Get/Set treat keys as C strings. Integer 1 is StringLength(1) SIGSEGV.
Function.DictGen_HashKey {
    Input: key: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.DictKey(key))
    }
}

// =============================================================================
// GET WITH DEFAULT
// Python: d.get(key, default)
// Returns value if key exists, otherwise returns default
// =============================================================================
Function.DictGen_GetWithDefault {
    Input: dict: Address
    Input: key: Address
    Input: default_val: Integer
    Output: Integer
    Body: {
        // Check if key exists
        k = DictGen_HashKey(key)
        exists = Hash.Contains(dict, k)
        IfCondition EqualTo(exists, 1) ThenBlock: {
            ReturnValue(Hash.Get(dict, k))
        }
        ReturnValue(default_val)
    }
}

// =============================================================================
// POP
// Python: d.pop(key) - removes and returns value
// Raises KeyError if not found (we return 0)
// =============================================================================
Function.DictGen_Pop {
    Input: dict: Address
    Input: key: Address
    Output: Integer
    Body: {
        k = DictGen_HashKey(key)
        value = Hash.Get(dict, k)
        Hash.Delete(dict, k)
        ReturnValue(value)
    }
}

// =============================================================================
// POP WITH DEFAULT
// Python: d.pop(key, default)
// =============================================================================
Function.DictGen_PopDefault {
    Input: dict: Address
    Input: key: Address
    Input: default_val: Integer
    Output: Integer
    Body: {
        k = DictGen_HashKey(key)
        exists = Hash.Contains(dict, k)
        IfCondition EqualTo(exists, 1) ThenBlock: {
            value = Hash.Get(dict, k)
            Hash.Delete(dict, k)
            ReturnValue(value)
        }
        ReturnValue(default_val)
    }
}

// =============================================================================
// SETDEFAULT
// Python: d.setdefault(key, default)
// If key exists, return its value
// If key doesn't exist, set it to default and return default
// =============================================================================
Function.DictGen_SetDefault {
    Input: dict: Address
    Input: key: Address
    Input: default_val: Integer
    Output: Integer
    Body: {
        k = DictGen_HashKey(key)
        exists = Hash.Contains(dict, k)
        IfCondition EqualTo(exists, 1) ThenBlock: {
            ReturnValue(Hash.Get(dict, k))
        }
        Hash.Set(dict, k, default_val)
        ReturnValue(default_val)
    }
}

// =============================================================================
// UPDATE
// Python: d.update(other)
// Copy all key-value pairs from other into d
// =============================================================================
Function.DictGen_Update {
    Input: dict: Address
    Input: other: Address
    Body: {
        // Get items from other dict
        items = Hash.Items(other)
        n = Array.Size(items)
        
        i = 0
        WhileLoop LessThan(i, n) {
            pair = Array.Get(items, i)
            key = Array.Get(pair, 0)
            value = Array.Get(pair, 1)
            Hash.Set(dict, key, value)
            i = Add(i, 1)
        }
        
        // Note: items TArray should be freed, but we don't have GC
        // In production, would need to destroy it
    }
}

// =============================================================================
// COPY
// Python: d.copy()
// Returns shallow copy of dictionary
// =============================================================================
Function.DictGen_Copy {
    Input: dict: Address
    Output: Address
    Body: {
        // Get size for capacity hint
        size = Hash.Size(dict)
        capacity = Multiply(size, 2)
        IfCondition LessThan(capacity, 16) ThenBlock: {
            capacity = 16
        }
        
        // Create new dict
        new_dict = Hash.Create(capacity)
        
        // Copy all items
        items = Hash.Items(dict)
        n = Array.Size(items)
        
        i = 0
        WhileLoop LessThan(i, n) {
            pair = Array.Get(items, i)
            key = Array.Get(pair, 0)
            value = Array.Get(pair, 1)
            Hash.Set(new_dict, key, value)
            i = Add(i, 1)
        }
        
        ReturnValue(new_dict)
    }
}

// =============================================================================
// FROMKEYS
// Python: dict.fromkeys(keys, value)
// Creates new dict with keys from iterable, all set to value
// =============================================================================
Function.DictGen_FromKeys {
    Input: keys: Address
    Input: value: Integer
    Output: Address
    Body: {
        n = Array.Size(keys)
        capacity = Multiply(n, 2)
        IfCondition LessThan(capacity, 16) ThenBlock: {
            capacity = 16
        }
        
        new_dict = Hash.Create(capacity)
        
        i = 0
        WhileLoop LessThan(i, n) {
            key = Array.Get(keys, i)
            Hash.Set(new_dict, key, value)
            i = Add(i, 1)
        }
        
        ReturnValue(new_dict)
    }
}

// =============================================================================
// SMART LEN FOR DICT
// Works with both THash and TArray for polymorphic len()
// =============================================================================
Function.DictGen_SmartLen {
    Input: container: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check if it's a THash
        is_hash = Hash.IsHash(container)
        IfCondition EqualTo(is_hash, 1) ThenBlock: {
            ReturnValue(AIMacro.SmartLen(container))
        }
        
        // Check if it's a TArray
        is_array = Array.IsArray(container)
        IfCondition EqualTo(is_array, 1) ThenBlock: {
            ReturnValue(Array.Size(container))
        }
        
        // Assume it's a string
        ReturnValue(StringLength(container))
    }
}

// =============================================================================
// SMART CONTAINS
// Works with dict (key in dict) and list (item in list)
// =============================================================================
Function.DictGen_SmartContains {
    Input: container: Address
    Input: item: Address
    Output: Integer
    Body: {
        ReturnValue(AIMacro.Contains(container, item))
    }
}

// =============================================================================
// TYPE CHECKING - Check if value is a dict
// =============================================================================
Function.DictGen_IsDict {
    Input: value: Address
    Output: Integer
    Body: {
        ReturnValue(Hash.IsHash(value))
    }
}


// =============================================================================
// SMART GET - Runtime dispatch for dict/list access
// Handles both THash (dict) and TArray (list) containers
// =============================================================================
Function.DictGen_SmartGet {
    Input: container: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(-999999)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(container), 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(container, "__getitem__"), 1) ThenBlock: {
                gargs = Array.Create(1)
                Array.Push(gargs, key)
                ReturnValue(OOP.MethodCall(container, "__getitem__", gargs))
            }
            wlst = Hash.Get(container, "__list__")
            IfCondition EqualTo(Array.IsArray(wlst), 1) ThenBlock: {
                IfCondition EqualTo(Hash.IsHash(key), 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(Hash.Get(key, "__class__"), "slice"), 0) ThenBlock: {
                        ReturnValue(AIMacro.ListSlice(wlst, Hash.Get(key, "start"), Hash.Get(key, "stop"), Hash.Get(key, "step")))
                    }
                }
                n = Array.Size(wlst)
                idx = AIMacro.NormIndex(key, n)
                IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, n)) ThenBlock: {
                    AIMacro.RaiseKind(17, "index out of range")
                    ReturnValue(0)
                }
                ReturnValue(Array.Get(wlst, idx))
            }
            ReturnValue(Hash.Get(container, DictGen_HashKey(key)))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(container), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(key), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "string indices must be integers")
                ReturnValue(0)
            }
            IfCondition EqualTo(Hash.IsHash(key), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(Hash.Get(key, "__class__"), "slice"), 0) ThenBlock: {
                    ReturnValue(AIMacro.ListSlice(container, Hash.Get(key, "start"), Hash.Get(key, "stop"), Hash.Get(key, "step")))
                }
            }
            n = StringLength(container)
            idx = AIMacro.NormIndex(key, n)
            IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, n)) ThenBlock: {
                AIMacro.RaiseKind(17, "index out of range")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.IterGet(container, idx))
        }
        
        // Check if it's a THash (dict) or an object with __getitem__
        is_hash = Hash.IsHash(container)
        IfCondition EqualTo(is_hash, 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(container, "__getitem__"), 1) ThenBlock: {
                gargs = Array.Create(1)
                Array.Push(gargs, key)
                ReturnValue(OOP.MethodCall(container, "__getitem__", gargs))
            }
            wlst = Hash.Get(container, "__list__")
            IfCondition EqualTo(Array.IsArray(wlst), 1) ThenBlock: {
                IfCondition EqualTo(Hash.IsHash(key), 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(Hash.Get(key, "__class__"), "slice"), 0) ThenBlock: {
                        ReturnValue(AIMacro.ListSlice(wlst, Hash.Get(key, "start"), Hash.Get(key, "stop"), Hash.Get(key, "step")))
                    }
                }
                n = Array.Size(wlst)
                idx = AIMacro.NormIndex(key, n)
                IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, n)) ThenBlock: {
                    AIMacro.RaiseKind(17, "index out of range")
                    ReturnValue(0)
                }
                ReturnValue(Array.Get(wlst, idx))
            }
            ReturnValue(Hash.Get(container, DictGen_HashKey(key)))
        }
        
        is_array = Array.IsArray(container)
        IfCondition EqualTo(is_array, 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(key), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "list indices must be integers")
                ReturnValue(0)
            }
            IfCondition EqualTo(Hash.IsHash(key), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(Hash.Get(key, "__class__"), "slice"), 0) ThenBlock: {
                    ReturnValue(AIMacro.ListSlice(container, Hash.Get(key, "start"), Hash.Get(key, "stop"), Hash.Get(key, "step")))
                }
            }
            n = Array.Size(container)
            idx = AIMacro.NormIndex(key, n)
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, n)) ThenBlock: {
                AIMacro.RaiseKind(17, "index out of range")
                ReturnValue(0)
            }
            ReturnValue(Array.Get(container, idx))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(container), 1) ThenBlock: {
            n = StringLength(container)
            idx = AIMacro.NormIndex(key, n)
            IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, n)) ThenBlock: {
                AIMacro.RaiseKind(17, "index out of range")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.IterGet(container, idx))
        }
        // String/int/other — do not Array.Get (SIGSEGV on enum FlagBoundary unpack)
        ReturnValue(0)
    }
}

// =============================================================================
// SMART SET - Runtime dispatch for dict/list assignment
// Handles both THash (dict) and TArray (list) containers
// =============================================================================
Function.DictGen_SmartSet {
    Input: container: Address
    Input: key: Address
    Input: value: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check if it's a THash (dict) or an object with __setitem__
        is_hash = Hash.IsHash(container)
        IfCondition EqualTo(is_hash, 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(container, "__setitem__"), 1) ThenBlock: {
                sargs = Array.Create(2)
                Array.Push(sargs, key)
                Array.Push(sargs, value)
                OOP.MethodCall(container, "__setitem__", sargs)
                ReturnValue(0)
            }
            Hash.Set(container, DictGen_HashKey(key), value)
            ReturnValue(0)
        }
        
        // Check if it's a TArray (list)
        is_array = Array.IsArray(container)
        IfCondition EqualTo(is_array, 1) ThenBlock: {
            n = Array.Size(container)
            idx = AIMacro.NormIndex(key, n)
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, n)) ThenBlock: {
                AIMacro.RaiseKind(17, "index out of range")
                ReturnValue(0)
            }
            Array.Set(container, idx, value)
            ReturnValue(0)
        }
        
        ReturnValue(0)
    }
}

Function.DictGen_SmartDel {
    Input: container: Address
    Input: key: Address
    Output: Address
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(container), 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(container, "__delitem__"), 1) ThenBlock: {
                dargs = Array.Create(1)
                Array.Push(dargs, key)
                ReturnValue(OOP.MethodCall(container, "__delitem__", dargs))
            }
            Hash.Delete(container, DictGen_HashKey(key))
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(container), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.SafeIsHash(key), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(Hash.Get(key, "__class__"), "slice"), 0) ThenBlock: {
                    ReturnValue(AIMacro.ListDelSlice(container, Hash.Get(key, "start"), Hash.Get(key, "stop"), Hash.Get(key, "step")))
                }
            }
            nsz = Array.Size(container)
            i = AIMacro.NormIndex(key, nsz)
            IfCondition Or(LessThan(i, 0), GreaterEqual(i, nsz)) ThenBlock: {
                AIMacro.RaiseKind(17, "index out of range")
                ReturnValue(0)
            }
            j = i
            WhileLoop LessThan(j, Subtract(nsz, 1)) {
                Array.Set(container, j, Array.Get(container, Add(j, 1)))
                j = Add(j, 1)
            }
            Array.Pop(container)
            ReturnValue(Types.GetNone())
        }
        AIMacro.RaiseKind(5, "delitem")
        ReturnValue(0)
    }
}
    Output: Address
    Body: {
        ReturnValue(0)
    }
}

Function.AIMacro.PrepTrue {
    Input: s: Address
    Input: n: Integer
    Input: b0: Integer
    Input: b1: Integer
    Input: b2: Integer
    Output: Address
    Body: {
        IfCondition NotEqual(StringLength(s), n) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            IfCondition EqualTo(GetByte(s, 0), b0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            IfCondition And(EqualTo(GetByte(s, 0), b0), EqualTo(GetByte(s, 1), b1)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 3) ThenBlock: {
            IfCondition And(And(EqualTo(GetByte(s, 0), b0), EqualTo(GetByte(s, 1), b1)), EqualTo(GetByte(s, 2), b2)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}


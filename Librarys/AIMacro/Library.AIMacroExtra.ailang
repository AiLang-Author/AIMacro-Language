Function.AIMacro.MethodCall {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(method_name, "assertRaises"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                exc = 0
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    exc = Array.Get(args, 0)
                }
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                Hash.Set(cm, "exc", exc)
                ReturnValue(cm)
            }
            exc = Array.Get(args, 0)
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, exc, func, fnargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "assertWarns"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__warns__", 1)
                ReturnValue(cm)
            }
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            AIMacro.SmartCallN(func, fnargs)
            ReturnValue(1)
        }
        func_addr = 0
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            func_addr = OOP.MethodLookup(obj, method_name)
        }
        IfCondition EqualTo(StringCompare(method_name, "substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSub(obj, a0s))
        }
        IfCondition EqualTo(StringCompare(method_name, "safe_substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSafeSub(obj, a0s))
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            fn = AIMacro.ObjectGet(obj, method_name)
            IfCondition NotEqual(fn, 0) ThenBlock: {
                ReturnValue(AIMacro.SmartCallN(fn, args))
            }
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(AIMacro.MethodShim(obj, method_name, args))
        }
        IfCondition EqualTo(OOP.IsPackedMethod(obj, method_name), 1) ThenBlock: {
            pargs = AIMacro.PackCallArgs(obj, args)
            ReturnValue(CallIndirect(func_addr, pargs))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        num_args = Array.Size(args)
        IfCondition EqualTo(num_args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        arg0 = Array.Get(args, 0)
        IfCondition EqualTo(arg0, 0) ThenBlock: {
            arg0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 1) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0))
        }
        arg1 = Array.Get(args, 1)
        IfCondition EqualTo(arg1, 0) ThenBlock: {
            arg1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 2) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1))
        }
        arg2 = Array.Get(args, 2)
        IfCondition EqualTo(arg2, 0) ThenBlock: {
            arg2 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 3) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2))
        }
        arg3 = Array.Get(args, 3)
        IfCondition EqualTo(arg3, 0) ThenBlock: {
            arg3 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 4) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3))
        }
        arg4 = Array.Get(args, 4)
        IfCondition EqualTo(arg4, 0) ThenBlock: {
            arg4 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3, arg4))
    }
}

Function.AIMacro.SmartCall {
    Input: fn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                AIMacro.RaiseKind(8, "skip")
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            empty = AIMacro.EmptyList()
            ReturnValue(AIMacro.SmartCallN(fn, empty))
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        ReturnValue(CallIndirect(fn))
    }
}


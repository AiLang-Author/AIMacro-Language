// Library.AIMacroExtra.ailang
// Optional builtins kept out of Library.AIMacro so fizzbuzz ELF stays 211054.
// Generated programs import this via codegen preamble.

LibraryImport.Array
LibraryImport.Hash
LibraryImport.OOP
LibraryImport.AIMacro.AIMacroTypes
LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.AIMacro.AIMacroOperator
LibraryImport.AIMacro.AIMacroUnittest
LibraryImport.AIMacro.AIMacroFormat
LibraryImport.AIMacro.AIMacroExtraOS
LibraryImport.AIMacro.AIMacroExtraCall
LibraryImport.AIMacro.AIMacroExtraStdlib

// bytes() / bytearray() hold ints 0..255. b"..." is Bytes of that text.
// A missing argument and None are empty. An integer is that many zeros.
// A string contributes its bytes. A byte outside 0..255 is ValueError.
// A non-int element, or an object that is not a sequence, is TypeError.
Function.AIMacro.Bytes {
    Input: iterable: Address
    Output: Address
    Body: {
        out = AIMacro.EmptyList()
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        use_count = 0
        n = 0
        IfCondition EqualTo(Types.IsFloat(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        IfCondition EqualTo(Types.IsComplex(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        IfCondition EqualTo(Types.IsBool(iterable), 1) ThenBlock: {
            n = AIMacro.BoolVal(iterable)
            use_count = 1
        }
        IfCondition EqualTo(use_count, 0) ThenBlock: {
            IfCondition EqualTo(Types.IsBigInt(iterable), 1) ThenBlock: {
                n = AIMacro.UnboxIntZero(iterable)
                use_count = 1
            }
        }
        IfCondition EqualTo(use_count, 0) ThenBlock: {
        IfCondition EqualTo(AIMacro.SafeIsHash(iterable), 1) ThenBlock: {
            cls = Hash.Get(iterable, "__class__")
            isb = 0
            IfCondition EqualTo(AIMacro.LooksLikeString(cls), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(cls, "bytes"), 0) ThenBlock: {
                    isb = 1
                }
                IfCondition EqualTo(StringCompare(cls, "bytearray"), 0) ThenBlock: {
                    isb = 1
                }
            }
            IfCondition EqualTo(isb, 1) ThenBlock: {
                src = Hash.Get(iterable, "__list__")
                IfCondition EqualTo(Array.IsArray(src), 1) ThenBlock: {
                    n = Array.Size(src)
                    i = 0
                    WhileLoop LessThan(i, n) {
                        el = Array.Get(src, i)
                        Array.Push(out, el)
                        i = Add(i, 1)
                    }
                }
                ReturnValue(AIMacro.WrapSeq(out, "bytes"))
            }
            ReturnValue(iterable)
        }
        IfCondition EqualTo(Array.IsArray(iterable), 1) ThenBlock: {
            n = Array.Size(iterable)
            i = 0
            WhileLoop LessThan(i, n) {
                el = Array.Get(iterable, i)
                fit = AIMacro.ByteFit(el)
                IfCondition LessThan(fit, 0) ThenBlock: {
                    ReturnValue(AIMacro.WrapSeq(out, "bytes"))
                }
                Array.Push(out, fit)
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(iterable), 1) ThenBlock: {
            n = StringLength(iterable)
            i = 0
            WhileLoop LessThan(i, n) {
                c = GetByte(iterable, i)
                Array.Push(out, c)
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        n = iterable
        }
        IfCondition LessThan(n, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "ValueError")
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        IfCondition GreaterEqual(n, 262144) ThenBlock: {
            AIMacro.RaiseKind(2, "ValueError")
            ReturnValue(AIMacro.WrapSeq(out, "bytes"))
        }
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(out, 0)
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.WrapSeq(out, "bytes"))
    }
}

Function.AIMacro.ByteArray {
    Input: iterable: Address
    Output: Address
    Body: {
        raw = AIMacro.Bytes(iterable)
        lst = AIMacro.EmptyList()
        IfCondition EqualTo(AIMacro.SafeIsHash(raw), 1) ThenBlock: {
            src = Hash.Get(raw, "__list__")
            IfCondition EqualTo(Array.IsArray(src), 1) ThenBlock: {
                n = Array.Size(src)
                i = 0
                WhileLoop LessThan(i, n) {
                    el = Array.Get(src, i)
                    Array.Push(lst, el)
                    i = Add(i, 1)
                }
            }
        }
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "bytearray")
        Hash.Set(h, "__list__", lst)
        ReturnValue(h)
    }
}


// issubclass(cls, base) — compile conformance for copy.py (issubclass(cls, type)).
// Emitter maps via Gen_MapBuiltin; base "type" becomes AddressOf(Types.TypeOf).
// Pointer-equal → True (covers issubclass(type, type)); else False.
Function.AIMacro.IsSubclass {
    Input: cls: Address
    Input: base: Address
    Output: Address
    Body: {
        IfCondition EqualTo(cls, base) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition And(Or(EqualTo(base, 0), EqualTo(cls, 1)), EqualTo(UnittestState.in_test, 1)) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition And(EqualTo(cls, AddressOf(AIMacro.Bool)), EqualTo(base, AddressOf(AIMacro.Int))) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        cn = cls
        bn = base
        IfCondition EqualTo(AIMacro.SafeIsHash(cls), 1) ThenBlock: {
            n = Hash.Get(cls, "__name__")
            IfCondition EqualTo(n, 0) ThenBlock: {
                n = Hash.Get(cls, "__class__")
            }
            IfCondition NotEqual(n, 0) ThenBlock: {
                cn = n
            }
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(base), 1) ThenBlock: {
            n2 = Hash.Get(base, "__name__")
            IfCondition EqualTo(n2, 0) ThenBlock: {
                n2 = Hash.Get(base, "__class__")
            }
            IfCondition NotEqual(n2, 0) ThenBlock: {
                bn = n2
            }
        }
        IfCondition And(EqualTo(AIMacro.LooksLikeString(cn), 1), EqualTo(AIMacro.LooksLikeString(bn), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(cn, bn), 0) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            IfCondition EqualTo(OOP.ClassIsSubclass(cn, bn), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
        }
        stor = AIMacro.ListStorage(base)
        IfCondition EqualTo(Array.IsArray(stor), 1) ThenBlock: {
            bi = 0
            bn2 = Array.Size(stor)
            WhileLoop LessThan(bi, bn2) {
                one = Array.Get(stor, bi)
                hit = AIMacro.IsSubclass(cls, one)
                IfCondition EqualTo(AIMacro.SmartBool(hit), 1) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                bi = Add(bi, 1)
            }
        }
        suba = 0
        IfCondition EqualTo(Hash.IsHash(base), 1) ThenBlock: {
            suba = Hash.Get(base, "__subclass__")
        }
        IfCondition EqualTo(suba, 0) ThenBlock: {
            IfCondition And(EqualTo(AIMacro.LooksLikeString(bn), 1), NotEqual(ClassAttrs.table, 0)) ThenBlock: {
                skey = StringConcat(bn, ".")
                skey = StringConcat(skey, "__subclass__")
                suba = Hash.Get(ClassAttrs.table, skey)
            }
        }
        IfCondition EqualTo(Array.IsArray(suba), 1) ThenBlock: {
            si = 0
            ns = Array.Size(suba)
            WhileLoop LessThan(si, ns) {
                IfCondition EqualTo(Array.Get(suba, si), cls) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                si = Add(si, 1)
            }
        }
        ReturnValue(AIMacro.FalseVal())
    }
}


// getattr(obj, name, default) — compile conformance for copy.py / types / reprlib.
// Emitter maps via Gen_MapBuiltin + Gen_CallExpr (pads missing default with None).
// str/bytes.translate(table) — compile stub: return the original buffer.
Function.AIMacro.Translate {
    Input: s: Address
    Input: table: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(s, 0), EqualTo(table, 0)) ThenBlock: {
            ReturnValue(s)
        }
        IfCondition EqualTo(Hash.IsHash(table), 0) ThenBlock: {
            ReturnValue(s)
        }
        n = StringLength(s)
        out = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(s, i)
            k = NumberToString(c)
            v = Hash.Get(table, k)
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(out, i, c)
            } ElseBlock: {
                SetByte(out, i, v)
            }
            i = Add(i, 1)
        }
        SetByte(out, n, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.MakeTrans {
    Input: frm: Address
    Input: to: Address
    Input: extra: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(frm, 0), EqualTo(to, 0)) ThenBlock: {
            ReturnValue(0)
        }
        nf = StringLength(frm)
        nt = StringLength(to)
        n = nf
        IfCondition LessThan(nt, n) ThenBlock: { n = nt }
        h = Hash.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            Hash.Set(h, NumberToString(GetByte(frm, i)), GetByte(to, i))
            i = Add(i, 1)
        }
        ReturnValue(h)
    }
}

Function.AIMacro.ReCompile {
    Input: pat: Address
    Output: Address
    Body: {
        ReturnValue(pat)
    }
}

// platform.system() — Linux uname(2) sysname (syscall 63, utsname.sysname at offset 0)
Function.AIMacro.UnameSysname {
    Output: Address
    Body: {
        buf = Allocate(512)
        rc = SystemCall(63, buf)
        IfCondition LessThan(rc, 0) ThenBlock: {
            ReturnValue("")
        }
        n = 0
        WhileLoop LessThan(n, 64) {
            IfCondition EqualTo(GetByte(buf, n), 0) ThenBlock: {
                BreakLoop
            }
            n = Add(n, 1)
        }
        out = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, i, GetByte(buf, i))
            i = Add(i, 1)
        }
        SetByte(out, n, 0)
        ReturnValue(out)
    }
}

// OOP.ObjectGet/Set on None (AddressOf(GetNone)) or a function pointer
// Hash.Get's 0 then Hash.Get/Set(0) Dereference(NULL).
FixedPool.KeywordState {
    "kwlist": Initialize=0
    "softkwlist": Initialize=0
}

FixedPool.ContainsZero {
    "box": Initialize=0
}

FixedPool.ZeroInt {
    "box": Initialize=0
}

FixedPool.ClassAttrs {
    "table": Initialize=0
}

FixedPool.MethodSkip {
    "table": Initialize=0
}

Function.AIMacro.KeywordKwlist {
    Output: Address
    Body: {
        IfCondition NotEqual(KeywordState.kwlist, 0) ThenBlock: {
            ReturnValue(KeywordState.kwlist)
        }
        a = Array.Create(36)
        Array.Push(a, "False")
        Array.Push(a, "None")
        Array.Push(a, "True")
        Array.Push(a, "and")
        Array.Push(a, "as")
        Array.Push(a, "assert")
        Array.Push(a, "async")
        Array.Push(a, "await")
        Array.Push(a, "break")
        Array.Push(a, "class")
        Array.Push(a, "continue")
        Array.Push(a, "def")
        Array.Push(a, "del")
        Array.Push(a, "elif")
        Array.Push(a, "else")
        Array.Push(a, "except")
        Array.Push(a, "finally")
        Array.Push(a, "for")
        Array.Push(a, "from")
        Array.Push(a, "global")
        Array.Push(a, "if")
        Array.Push(a, "import")
        Array.Push(a, "in")
        Array.Push(a, "is")
        Array.Push(a, "lambda")
        Array.Push(a, "nonlocal")
        Array.Push(a, "not")
        Array.Push(a, "or")
        Array.Push(a, "pass")
        Array.Push(a, "raise")
        Array.Push(a, "return")
        Array.Push(a, "try")
        Array.Push(a, "while")
        Array.Push(a, "with")
        Array.Push(a, "yield")
        KeywordState.kwlist = a
        ReturnValue(a)
    }
}

Function.AIMacro.KeywordSoftKwlist {
    Output: Address
    Body: {
        IfCondition NotEqual(KeywordState.softkwlist, 0) ThenBlock: {
            ReturnValue(KeywordState.softkwlist)
        }
        a = Array.Create(4)
        Array.Push(a, "_")
        Array.Push(a, "case")
        Array.Push(a, "match")
        KeywordState.softkwlist = a
        ReturnValue(a)
    }
}

Function.AIMacro.KeywordIsKeyword {
    Input: word: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Types.IsString(word), 0) ThenBlock: {
            ReturnValue(AIMacro.Bool(0))
        }
        a = AIMacro.KeywordKwlist()
        n = Array.Size(a)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(StringCompare(Array.Get(a, i), word), 0) ThenBlock: {
                ReturnValue(AIMacro.Bool(1))
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.Bool(0))
    }
}

Function.AIMacro.KeywordIsSoftKeyword {
    Input: word: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Types.IsString(word), 0) ThenBlock: {
            ReturnValue(AIMacro.Bool(0))
        }
        a = AIMacro.KeywordSoftKwlist()
        n = Array.Size(a)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(StringCompare(Array.Get(a, i), word), 0) ThenBlock: {
                ReturnValue(AIMacro.Bool(1))
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.Bool(0))
    }
}

Function.AIMacro.ClassAttrGet {
    Input: cls: Address
    Input: field: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(cls, 0), EqualTo(field, 0)) ThenBlock: {
            ReturnValue(0)
        }
        // RaiseKind stores __class__ as an ExcKind int. StringConcat(9, ".")
        // is strlen(9) — leftover test_generators SEGV on exc.value.
        IfCondition EqualTo(AIMacro.LooksLikeString(cls), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ClassAttrs.table, 0) ThenBlock: {
            ReturnValue(0)
        }
        current = cls
        hops = 0
        WhileLoop And(NotEqual(current, 0), LessThan(hops, 16)) {
            key = StringConcat(current, ".")
            key = StringConcat(key, field)
            v = Hash.Get(ClassAttrs.table, key)
            IfCondition NotEqual(v, 0) ThenBlock: {
                ReturnValue(v)
            }
            current = OOP.ClassGetParent(current)
            hops = Add(hops, 1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.ClassAttrSet {
    Input: cls: Address
    Input: field: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(cls, 0), EqualTo(field, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ClassAttrs.table, 0) ThenBlock: {
            ClassAttrs.table = Hash.Create(32)
        }
        // classmethod(fn) stores cls=0 until the name is put on a class.
        IfCondition GreaterEqual(value, 4000000000) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(value), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(value, "__classmethod__"), 0) ThenBlock: {
                    IfCondition EqualTo(Hash.Get(value, "cls"), 0) ThenBlock: {
                        Hash.Set(value, "cls", cls)
                    }
                }
            }
        }
        key = StringConcat(cls, ".")
        key = StringConcat(key, field)
        Hash.Set(ClassAttrs.table, key, value)
        OOP.ClassField(cls, field, "Address")
        OOP.ClassFieldDefault(cls, field, value)
        ReturnValue(1)
    }
}

// Drop ClassAttrs keys for one class so a hoisted nested `class C:` inside a
// loop does not keep setattr from the previous iteration.
Function.AIMacro.ClassAttrReset {
    Input: cls: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(cls, 0), EqualTo(ClassAttrs.table, 0)) ThenBlock: {
            ReturnValue(0)
        }
        prefix = StringConcat(cls, ".")
        plen = StringLength(prefix)
        keys = Hash.Keys(ClassAttrs.table)
        n = Array.Size(keys)
        i = 0
        WhileLoop LessThan(i, n) {
            k = Array.Get(keys, i)
            IfCondition EqualTo(String.StartsWith(k, prefix), 1) ThenBlock: {
                klen = StringLength(k)
                IfCondition GreaterThan(klen, plen) ThenBlock: {
                    field = String.Substring(k, plen, klen)
                    OOP.ClassFieldDefault(cls, field, 0)
                }
                Hash.Delete(ClassAttrs.table, k)
            }
            i = Add(i, 1)
        }
        Array.Destroy(keys)
        ReturnValue(1)
    }
}

Function.AIMacro.AlwaysEq {
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__class__", "_AlwaysEq")
        ReturnValue(h)
    }
}

Function.AIMacro.NeverEq {
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__class__", "_NeverEq")
        ReturnValue(h)
    }
}

Function.AIMacro.SetIsdisjoint {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(a, 0), EqualTo(b, 0)) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(AIMacro.IsNone(a), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(AIMacro.IsNone(b), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        aa = a
        IfCondition EqualTo(AIMacro.SafeIsHash(a), 1) ThenBlock: {
            lst = Hash.Get(a, "__list__")
            IfCondition EqualTo(Array.IsArray(lst), 1) ThenBlock: {
                aa = lst
            }
        }
        IfCondition EqualTo(Array.IsArray(aa), 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        n = Array.Size(aa)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.Contains(b, Array.Get(aa, i))), 1) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.TrueVal())
    }
}

// The object must be an instance of the class, or a subclass of it.
// A class name in the object slot is the classmethod form.
Function.AIMacro.SuperAccept {
    Input: obj: Address
    Input: cls: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.LooksLikeString(cls), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(OOP.ClassExists(cls), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
            ocls = Hash.Get(obj, "__class__")
            IfCondition EqualTo(AIMacro.LooksLikeString(ocls), 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(OOP.ObjectIsInstance(obj, cls))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(obj), 1) ThenBlock: {
            IfCondition EqualTo(OOP.ClassExists(obj), 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(StringCompare(obj, cls), 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(OOP.ClassIsSubclass(obj, cls))
        }
        ReturnValue(0)
    }
}

Function.AIMacro.SuperReject {
    Output: Integer
    Body: {
        AIMacro.RaiseKind(5, "super")
        ReturnValue(0)
    }
}

// Zero-arg super() inside a method stores the class being compiled.
// Two-arg super(cls, obj) stores that class and that object.
Function.AIMacro.SuperProxy {
    Input: obj: Address
    Input: cls: Address
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__super__", 1)
        Hash.Set(h, "__self__", obj)
        Hash.Set(h, "__thisclass__", cls)
        ReturnValue(h)
    }
}

// Unwrap DummyIntegral(6) and DummyIntegral(that object) down to 6.
Function.AIMacro.IntPayload {
    Input: v: Address
    Output: Integer
    Body: {
        hops = 0
        WhileLoop And(EqualTo(AIMacro.SafeIsHash(v), 1), LessThan(hops, 8)) {
            data = Hash.Get(v, "__data__")
            iv = 0
            IfCondition EqualTo(Hash.IsHash(data), 1) ThenBlock: {
                iv = Hash.Get(data, "__int__")
            }
            IfCondition EqualTo(iv, 0) ThenBlock: {
                iv = Hash.Get(v, "__int__")
            }
            IfCondition EqualTo(iv, 0) ThenBlock: {
                ReturnValue(0)
            }
            v = iv
            hops = Add(hops, 1)
        }
        ReturnValue(AIMacro.UnboxIntZero(v))
    }
}

Function.AIMacro.IsIntSubclass {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.SafeIsHash(v), 0) ThenBlock: {
            ReturnValue(0)
        }
        walk = Hash.Get(v, "__class__")
        hops = 0
        WhileLoop And(NotEqual(walk, 0), LessThan(hops, 16)) {
            IfCondition EqualTo(AIMacro.LooksLikeString(walk), 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(StringCompare(walk, "int"), 0) ThenBlock: {
                ReturnValue(1)
            }
            walk = OOP.ClassGetParent(walk)
            hops = Add(hops, 1)
        }
        ReturnValue(0)
    }
}

// A raw integer, not a float, string, list, or other object.
Function.AIMacro.IsPlainNumber {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.IsIntSubclass(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Types.IsBigInt(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Types.IsFloat(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Types.IsBool(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// 1 when an int subclass is combined with a plain integer.
Function.AIMacro.IntPair {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        left = AIMacro.IsIntSubclass(a)
        IfCondition EqualTo(left, 1) ThenBlock: {
            ReturnValue(AIMacro.IsPlainNumber(b))
        }
        right = AIMacro.IsIntSubclass(b)
        IfCondition EqualTo(right, 1) ThenBlock: {
            ReturnValue(AIMacro.IsPlainNumber(a))
        }
        ReturnValue(0)
    }
}

// 1 when an int subclass is compared with a float.
Function.AIMacro.IntFloatPair {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.IsIntSubclass(a), 1) ThenBlock: {
            ReturnValue(Types.IsFloat(b))
        }
        IfCondition EqualTo(AIMacro.IsIntSubclass(b), 1) ThenBlock: {
            ReturnValue(Types.IsFloat(a))
        }
        ReturnValue(0)
    }
}

Function.AIMacro.NumFloatBits {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsFloat(v), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatBits(v))
        }
        IfCondition EqualTo(AIMacro.IsIntSubclass(v), 1) ThenBlock: {
            ipv = AIMacro.IntPayload(v)
            ReturnValue(Float_FromInt(ipv))
        }
        ReturnValue(Float_FromInt(AIMacro.UnboxIntZero(v)))
    }
}

Function.AIMacro.IntSuper {
    Input: obj: Address
    Input: name: Address
    Input: args: Address
    Output: Integer
    Body: {
        base = AIMacro.IntPayload(obj)
        other = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            IfCondition GreaterThan(Array.Size(args), 0) ThenBlock: {
                other = AIMacro.IntPayload(Array.Get(args, 0))
            }
        }
        IfCondition EqualTo(StringCompare(name, "__mul__"), 0) ThenBlock: {
            ReturnValue(AIMacro.IntOrBox(Multiply(base, other)))
        }
        IfCondition EqualTo(StringCompare(name, "__rmul__"), 0) ThenBlock: {
            ReturnValue(AIMacro.IntOrBox(Multiply(base, other)))
        }
        ReturnValue(0)
    }
}

Function.AIMacro.SuperInvoke {
    Input: obj: Address
    Input: cls: Address
    Input: name: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.LooksLikeString(name), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SuperAccept(obj, cls), 0) ThenBlock: {
            ReturnValue(AIMacro.SuperReject())
        }
        parent = OOP.ClassGetParent(cls)
        IfCondition EqualTo(parent, 0) ThenBlock: {
            ReturnValue(0)
        }
        fn = OOP._MethodLookupWithInheritance(parent, name)
        IfCondition EqualTo(fn, 0) ThenBlock: {
            cv = AIMacro.ClassAttrGet(parent, name)
            IfCondition EqualTo(AIMacro.SafeIsHash(cv), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(cv, "__classmethod__"), 0) ThenBlock: {
                    cfn = Hash.Get(cv, "fn")
                    IfCondition NotEqual(cfn, 0) ThenBlock: {
                        bound = obj
                        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
                            ocls = Hash.Get(obj, "__class__")
                            IfCondition EqualTo(AIMacro.LooksLikeString(ocls), 1) ThenBlock: {
                                bound = ocls
                            }
                        }
                        cpack = AIMacro.PackCallArgs(bound, args)
                        ReturnValue(CallIndirect(cfn, cpack))
                    }
                }
                IfCondition NotEqual(Hash.Get(cv, "__static__"), 0) ThenBlock: {
                    sfn = Hash.Get(cv, "fn")
                    IfCondition NotEqual(sfn, 0) ThenBlock: {
                        IfCondition EqualTo(args, 0) ThenBlock: {
                            args = AIMacro.EmptyList()
                        }
                        ReturnValue(CallIndirect(sfn, args))
                    }
                }
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(parent), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(parent, "int"), 0) ThenBlock: {
                    ReturnValue(AIMacro.IntSuper(obj, name, args))
                }
            }
            ReturnValue(0)
        }
        // User methods take packed p__args. OOP.SuperCall calls them unpacked.
        // A class name in obj is the classmethod form; probe that class.
        packed = 0
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
            packed = OOP.IsPackedMethod(obj, name)
        } ElseBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(obj), 1) ThenBlock: {
                probe = Hash.Create(4)
                Hash.Set(probe, "__class__", obj)
                packed = OOP.IsPackedMethod(probe, name)
            }
        }
        IfCondition EqualTo(packed, 1) ThenBlock: {
            pargs = AIMacro.PackCallArgs(obj, args)
            ReturnValue(CallIndirect(fn, pargs))
        }
        ReturnValue(OOP.SuperCall(obj, cls, name, args))
    }
}

Function.AIMacro.SuperGet {
    Input: proxy: Address
    Input: field: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.LooksLikeString(field), 0) ThenBlock: {
            ReturnValue(0)
        }
        inst = Hash.Get(proxy, "__self__")
        cls = Hash.Get(proxy, "__thisclass__")
        IfCondition EqualTo(AIMacro.SuperAccept(inst, cls), 0) ThenBlock: {
            ReturnValue(AIMacro.SuperReject())
        }
        parent = OOP.ClassGetParent(cls)
        IfCondition EqualTo(parent, 0) ThenBlock: {
            ReturnValue(0)
        }
        cv = AIMacro.ClassAttrGet(parent, field)
        IfCondition NotEqual(cv, 0) ThenBlock: {
            cv_h = 0
            IfCondition EqualTo(Types.CanDeref(cv), 1) ThenBlock: {
                cv_h = Hash.IsHash(cv)
            }
            IfCondition EqualTo(cv_h, 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(cv, "__property__"), 0) ThenBlock: {
                    fget = Hash.Get(cv, "fget")
                    IfCondition NotEqual(fget, 0) ThenBlock: {
                        pargs = AIMacro.PackCallArgs(inst, 0)
                        ReturnValue(CallIndirect(fget, pargs))
                    }
                    ReturnValue(0)
                }
            }
            ReturnValue(cv)
        }
        fn = OOP._MethodLookupWithInheritance(parent, field)
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(0)
        }
        h = Hash.Create(4)
        Hash.Set(h, "__superbound__", 1)
        Hash.Set(h, "obj", inst)
        Hash.Set(h, "fn", fn)
        ReturnValue(h)
    }
}

Function.AIMacro.ObjectGet {
    Input: obj: Address
    Input: field: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(field, "kwlist"), 0) ThenBlock: {
                ReturnValue(AIMacro.KeywordKwlist())
            }
            IfCondition EqualTo(StringCompare(field, "softkwlist"), 0) ThenBlock: {
                ReturnValue(AIMacro.KeywordSoftKwlist())
            }
            IfCondition EqualTo(StringCompare(field, "fromkeys"), 0) ThenBlock: {
                ReturnValue(AddressOf(AIMacro.DictFromKeys))
            }
            IfCondition EqualTo(StringCompare(field, "__itemsize__"), 0) ThenBlock: {
                ReturnValue(4)
            }
            IfCondition EqualTo(StringCompare(field, "getrefcount"), 0) ThenBlock: {
                ReturnValue(2)
            }
            IfCondition EqualTo(StringCompare(field, "TESTFN"), 0) ThenBlock: {
                ReturnValue("/tmp/aimacro-testfn")
            }
            IfCondition EqualTo(StringCompare(field, "real"), 0) ThenBlock: {
                IfCondition EqualTo(Types.IsBool(obj), 1) ThenBlock: {
                    ReturnValue(AIMacro.BoolVal(obj))
                }
                IfCondition EqualTo(Types.IsFloat(obj), 1) ThenBlock: {
                    ReturnValue(obj)
                }
                IfCondition And(And(EqualTo(AIMacro.LooksLikeString(obj), 0), EqualTo(Array.IsArray(obj), 0)), EqualTo(AIMacro.SafeIsHash(obj), 0)) ThenBlock: {
                    ReturnValue(obj)
                }
            }
            IfCondition EqualTo(StringCompare(field, "imag"), 0) ThenBlock: {
                IfCondition And(And(EqualTo(AIMacro.LooksLikeString(obj), 0), EqualTo(Array.IsArray(obj), 0)), EqualTo(AIMacro.SafeIsHash(obj), 0)) ThenBlock: {
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(StringCompare(field, "closed"), 0) ThenBlock: {
                IfCondition EqualTo(AIMacro.IsFile(obj), 1) ThenBlock: {
                    fd = Dereference(Add(obj, 8))
                    IfCondition LessThan(fd, 0) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                    ReturnValue(AIMacro.FalseVal())
                }
            }
        }
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(field, "append"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "extend"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "pop"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "clear"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "copy"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "count"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "index"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "insert"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "remove"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "reverse"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "sort"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "isdisjoint"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 0) ThenBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(obj), 1) ThenBlock: {
                IfCondition EqualTo(OOP.ClassExists(obj), 1) ThenBlock: {
                    cv0 = AIMacro.ClassAttrGet(obj, field)
                    IfCondition NotEqual(cv0, 0) ThenBlock: {
                        ReturnValue(AIMacro.ClassMethodAt(cv0, obj))
                    }
                    IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
                        IfCondition EqualTo(StringCompare(field, "__name__"), 0) ThenBlock: {
                            ReturnValue(obj)
                        }
                    }
                    ReturnValue(0)
                }
                ReturnValue(0)
            }
            IfCondition And(GreaterEqual(obj, 1), LessThan(obj, 41)) ThenBlock: {
                IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(field, "__name__"), 0) ThenBlock: {
                        ReturnValue(AIMacro.ExcKindName(obj))
                    }
                    IfCondition EqualTo(StringCompare(field, "__qualname__"), 0) ThenBlock: {
                        ReturnValue(AIMacro.ExcKindName(obj))
                    }
                    IfCondition EqualTo(StringCompare(field, "__module__"), 0) ThenBlock: {
                        ReturnValue("builtins")
                    }
                }
            }
            ReturnValue(0)
        }
        supm = Hash.Get(obj, "__super__")
        IfCondition NotEqual(supm, 0) ThenBlock: {
            ReturnValue(AIMacro.SuperGet(obj, field))
        }
        data = Hash.Get(obj, "__data__")
        v = 0
        data_h = 0
        IfCondition And(NotEqual(data, 0), EqualTo(Types.CanDeref(data), 1)) ThenBlock: {
            data_h = Hash.IsHash(data)
        }
        IfCondition EqualTo(data_h, 1) ThenBlock: {
            v = Hash.Get(data, field)
        } ElseBlock: {
            v = Hash.Get(obj, field)
        }
        IfCondition NotEqual(v, 0) ThenBlock: {
            v_h = 0
            IfCondition EqualTo(Types.CanDeref(v), 1) ThenBlock: {
                v_h = Hash.IsHash(v)
            }
            IfCondition EqualTo(v_h, 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(v, "__property__"), 0) ThenBlock: {
                    fget = Hash.Get(v, "fget")
                    IfCondition NotEqual(fget, 0) ThenBlock: {
                        ReturnValue(CallIndirect(fget, AIMacro.PackCallArgs(obj, 0)))
                    }
                }
            }
            ReturnValue(v)
        }
        cls_kind = Hash.Get(obj, "__class__")
        // RaiseKind stores __class__ as an integer ExcKind. MethodExists then
        // _MethodLookupWithInheritance(8, "msg") is strlen(8). leftover
        // test_exceptions testSyntaxErrorMissingParens after UnittestFail.
        IfCondition And(NotEqual(cls_kind, 0), EqualTo(AIMacro.LooksLikeString(cls_kind), 0)) ThenBlock: {
            ReturnValue(0)
        }
        mx = OOP.MethodExists(obj, field)
        IfCondition EqualTo(mx, 1) ThenBlock: {
            ReturnValue(AIMacro.BoundMethod(obj, field))
        }
        IfCondition EqualTo(AIMacro.IsOpName(field), 1) ThenBlock: {
            ReturnValue(AIMacro.OpBound(obj, field))
        }
        cls = Hash.Get(obj, "__class__")
        IfCondition NotEqual(cls, 0) ThenBlock: {
            cv = AIMacro.ClassAttrGet(cls, field)
            IfCondition EqualTo(Hash.IsHash(cv), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(cv, "__property__"), 0) ThenBlock: {
                    fget = Hash.Get(cv, "fget")
                    IfCondition NotEqual(fget, 0) ThenBlock: {
                        ReturnValue(CallIndirect(fget, AIMacro.PackCallArgs(obj, 0)))
                    }
                }
            }
            IfCondition NotEqual(cv, 0) ThenBlock: {
                ReturnValue(AIMacro.ClassMethodAt(cv, cls))
            }
        }
        IfCondition EqualTo(OOP.MethodExists(obj, "__getattr__"), 1) ThenBlock: {
            gargs = AIMacro.EmptyList()
            Array.Push(gargs, field)
            ReturnValue(OOP.MethodCall(obj, "__getattr__", gargs))
        }
        // os.environ is filled on the miss path. Two calls: the first caches.
        IfCondition NotEqual(AIMacro.OsEnvironLookup(obj, field), 0) ThenBlock: {
            ReturnValue(AIMacro.OsEnvironLookup(obj, field))
        }
        ReturnValue(0)
    }
}

// sys.hash_info — 32-bit values matching emitted sys.maxsize.
Function.AIMacro.SysHashInfo {
    Output: Address
    Body: {
        h = Hash.Create(16)
        Hash.Set(h, "width", 32)
        Hash.Set(h, "modulus", 2147483647)
        Hash.Set(h, "inf", 314159)
        Hash.Set(h, "nan", 0)
        Hash.Set(h, "imag", 1000003)
        Hash.Set(h, "algorithm", "siphash24")
        Hash.Set(h, "hash_bits", 32)
        Hash.Set(h, "seed_bits", 64)
        Hash.Set(h, "cutoff", 0)
        ReturnValue(h)
    }
}

Function.AIMacro.ObjectSet {
    Input: obj: Address
    Input: field: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(obj), 0) ThenBlock: {
            ReturnValue(0)
        }
        data = Hash.Get(obj, "__data__")
        IfCondition EqualTo(data, 0) ThenBlock: {
            // Stand-in modules keep fields on the hash. os and sys are the
            // same shape, and a store there stays a no-op so test_sysconfig
            // can assign os.name without changing the shim.
            IfCondition NotEqual(Hash.Get(obj, "__aim_stub__"), 0) ThenBlock: {
                Hash.Set(obj, field, value)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(data), 0) ThenBlock: {
            ReturnValue(0)
        }
        // @property setter. Leave the property object in place so the
        // next read still calls fget. ExcKind __class__ must not be hashed.
        cls_set = Hash.Get(obj, "__class__")
        IfCondition EqualTo(AIMacro.LooksLikeString(cls_set), 1) ThenBlock: {
            cv_set = AIMacro.ClassAttrGet(cls_set, field)
            IfCondition NotEqual(cv_set, 0) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(cv_set), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(cv_set, "__property__"), 0) ThenBlock: {
                    fset = Hash.Get(cv_set, "fset")
                    IfCondition NotEqual(fset, 0) ThenBlock: {
                        one = Array.Create(1)
                        Array.Push(one, value)
                        CallIndirect(fset, AIMacro.PackCallArgs(obj, one))
                        ReturnValue(1)
                    }
                    // No setter: do not store over the property. The next
                    // read must still call fget.
                    AIMacro.RaiseKind(14, "can't set attribute")
                    ReturnValue(0)
                }
            }
            }
        }
        Hash.Set(data, field, value)
        ReturnValue(1)
    }
}

// del obj.attr. A property calls fdel and stays on the class. A plain
// instance field is removed. No deleter raises AttributeError (kind 14).
Function.AIMacro.ObjectDel {
    Input: obj: Address
    Input: field: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(obj), 0) ThenBlock: {
            ReturnValue(0)
        }
        cls_del = Hash.Get(obj, "__class__")
        IfCondition EqualTo(AIMacro.LooksLikeString(cls_del), 1) ThenBlock: {
            cv_del = AIMacro.ClassAttrGet(cls_del, field)
            IfCondition NotEqual(cv_del, 0) ThenBlock: {
                IfCondition EqualTo(Hash.IsHash(cv_del), 1) ThenBlock: {
                    IfCondition NotEqual(Hash.Get(cv_del, "__property__"), 0) ThenBlock: {
                        fdel = Hash.Get(cv_del, "fdel")
                        IfCondition NotEqual(fdel, 0) ThenBlock: {
                            CallIndirect(fdel, AIMacro.PackCallArgs(obj, 0))
                            ReturnValue(1)
                        }
                        AIMacro.RaiseKind(14, "can't delete attribute")
                        ReturnValue(0)
                    }
                }
            }
        }
        data_del = Hash.Get(obj, "__data__")
        IfCondition NotEqual(data_del, 0) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(data_del), 1) ThenBlock: {
                IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
                    IfCondition EqualTo(Hash.Contains(data_del, field), 1) ThenBlock: {
                        Hash.Delete(data_del, field)
                        ReturnValue(1)
                    }
                }
            }
        }
        // Stand-in modules keep fields on the hash. Delete one that is
        // there. os and sys stay a no-op so test_sysconfig can del os.uname.
        IfCondition NotEqual(Hash.Get(obj, "__aim_stub__"), 0) ThenBlock: {
            IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
                IfCondition EqualTo(Hash.Contains(obj, field), 1) ThenBlock: {
                    Hash.Delete(obj, field)
                    ReturnValue(1)
                }
            }
        }
        // Missing names stay a no-op. Module shims (del os.uname) are not
        // instance fields, and raising there fails test_sysconfig.
        ReturnValue(0)
    }
}

// Packed __init__ (UUID has 8 params) expects one p__args array including self.
// OOP.ObjectNewInit CallIndirects unpacked (self, arg0, ...) and SIGSEGV's Hash.Get on int keys.
Function.AIMacro.ObjectNewInitPacked {
    Input: class_name: Address
    Input: init_args: Address
    Output: Address
    Body: {
        obj = OOP.ObjectNew(class_name)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(OOP.MethodExists(obj, "__init__"), 0) ThenBlock: {
            IfCondition And(NotEqual(init_args, 0), GreaterThan(Array.Size(init_args), 0)) ThenBlock: {
                v0 = Array.Get(init_args, 0)
                Hash.Set(obj, "__int__", v0)
                data0 = Hash.Get(obj, "__data__")
                IfCondition EqualTo(Hash.IsHash(data0), 1) ThenBlock: {
                    Hash.Set(data0, "__int__", v0)
                }
                IfCondition EqualTo(Array.IsArray(v0), 1) ThenBlock: {
                    Hash.Set(obj, "__list__", v0)
                    IfCondition EqualTo(Hash.IsHash(data0), 1) ThenBlock: {
                        Hash.Set(data0, "__list__", v0)
                    }
                }
            }
            ReturnValue(obj)
        }
        n = 0
        IfCondition NotEqual(init_args, 0) ThenBlock: {
            n = Array.Size(init_args)
        }
        pack = Array.Create(Add(n, 1))
        Array.Push(pack, obj)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(pack, Array.Get(init_args, i))
            i = Add(i, 1)
        }
        cls = Hash.Get(obj, "__class__")
        func = OOP._MethodLookupWithInheritance(cls, "__init__")
        IfCondition NotEqual(func, 0) ThenBlock: {
            CallIndirect(func, pack)
        }
        ReturnValue(obj)
    }
}

// Packed methods unpack p__args by index; missing slots are Python defaults (None).
Function.AIMacro.PackedGet {
    Input: args: Address
    Input: index: Integer
    Input: default: Address
    Output: Address
    Body: {
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(default)
        }
        IfCondition EqualTo(Array.IsArray(args), 0) ThenBlock: {
            ReturnValue(default)
        }
        n = Array.Size(args)
        IfCondition GreaterEqual(index, n) ThenBlock: {
            ReturnValue(default)
        }
        IfCondition LessThan(index, 0) ThenBlock: {
            ReturnValue(default)
        }
        v = Array.Get(args, index)
        IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(v, "__kwargs__"), 0) ThenBlock: {
                ReturnValue(default)
            }
        }
        ReturnValue(v)
    }
}

Function.AIMacro.PackedRest {
    Input: args: Address
    Input: index: Integer
    Output: Address
    Body: {
        out = AIMacro.EmptyList()
        IfCondition Or(EqualTo(args, 0), EqualTo(Array.IsArray(args), 0)) ThenBlock: {
            ReturnValue(out)
        }
        n = Array.Size(args)
        i = index
        WhileLoop LessThan(i, n) {
            v = Array.Get(args, i)
            skip = 0
            IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(v, "__kwargs__"), 0) ThenBlock: {
                    skip = 1
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                Array.Push(out, v)
            }
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

Function.AIMacro.PackedKw {
    Input: args: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(args, 0), EqualTo(Array.IsArray(args), 0)) ThenBlock: {
            h = Hash.Create(4)
            Hash.Set(h, "__kwargs__", 1)
            ReturnValue(h)
        }
        n = Array.Size(args)
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            v = Array.Get(args, i)
            IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(v, "__kwargs__"), 0) ThenBlock: {
                    ReturnValue(v)
                }
            }
            i = Subtract(i, 1)
        }
        h = Hash.Create(4)
        Hash.Set(h, "__kwargs__", 1)
        ReturnValue(h)
    }
}

Function.AIMacro.PackCallArgs {
    Input: obj: Address
    Input: args: Address
    Output: Address
    Body: {
        pargs = AIMacro.EmptyList()
        Array.Push(pargs, obj)
        IfCondition And(NotEqual(args, 0), EqualTo(Array.IsArray(args), 1)) ThenBlock: {
            n = Array.Size(args)
            i = 0
            WhileLoop LessThan(i, n) {
                Array.Push(pargs, Array.Get(args, i))
                i = Add(i, 1)
            }
        }
        ReturnValue(pargs)
    }
}

Function.AIMacro.SmartCount {
    Input: obj: Address
    Input: item: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue(AIMacro.ListCount(obj, item))
        }
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(String.Count(obj, item))
    }
}

Function.AIMacro.Strip {
    Input: str: Address
    Input: chars: Address
    Output: Address
    Body: {
        // Same band as InPtrHole. A call here would drop str, so compare in place.
        IfCondition GreaterEqual(str, 16777216) ThenBlock: {
            IfCondition LessThan(str, 500000000) ThenBlock: {
                AIMacro.RaiseKind(14, "'int' object has no attribute 'strip'")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue("")
        }
        IfCondition Or(EqualTo(chars, 0), EqualTo(StringLength(chars), 0)) ThenBlock: {
            ReturnValue(String.Strip(str))
        }
        n = StringLength(str)
        start = 0
        WhileLoop LessThan(start, n) {
            c = GetByte(str, start)
            found = 0
            j = 0
            clen = StringLength(chars)
            WhileLoop LessThan(j, clen) {
                IfCondition EqualTo(GetByte(chars, j), c) ThenBlock: {
                    found = 1
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                BreakLoop
            }
            start = Add(start, 1)
        }
        end = n
        WhileLoop GreaterThan(end, start) {
            c = GetByte(str, Subtract(end, 1))
            found = 0
            j = 0
            clen = StringLength(chars)
            WhileLoop LessThan(j, clen) {
                IfCondition EqualTo(GetByte(chars, j), c) ThenBlock: {
                    found = 1
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                BreakLoop
            }
            end = Subtract(end, 1)
        }
        slen = Subtract(end, start)
        out = Allocate(Add(slen, 1))
        k = 0
        WhileLoop LessThan(k, slen) {
            SetByte(out, k, GetByte(str, Add(start, k)))
            k = Add(k, 1)
        }
        SetByte(out, slen, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.NoOp {
    Input: a: Address
    Output: Address
    Body: {
        ReturnValue(0)
    }
}

Function.AIMacro.InitSink {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        ReturnValue(a)
    }
}

Function.AIMacro.HtmlEscape {
    Input: s: Address
    Input: quote: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(s) }
        IfCondition EqualTo(AIMacro.LooksLikeString(s), 0) ThenBlock: { ReturnValue(s) }
        n = StringLength(s)
        out = Allocate(Add(Multiply(n, 6), 1))
        oi = 0
        q = 0
        IfCondition NotEqual(quote, 0) ThenBlock: {
            q = 1
        }
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 92) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
            IfCondition EqualTo(ch, 38) ThenBlock: {
                SetByte(out, oi, 38)
                oi = Add(oi, 1)
                SetByte(out, oi, 97)
                oi = Add(oi, 1)
                SetByte(out, oi, 109)
                oi = Add(oi, 1)
                SetByte(out, oi, 112)
                oi = Add(oi, 1)
                SetByte(out, oi, 59)
                oi = Add(oi, 1)
            } ElseBlock: {
                IfCondition EqualTo(ch, 60) ThenBlock: {
                    SetByte(out, oi, 38)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 108)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 116)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 59)
                    oi = Add(oi, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 62) ThenBlock: {
                        SetByte(out, oi, 38)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 103)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 116)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 59)
                        oi = Add(oi, 1)
                    } ElseBlock: {
                        IfCondition And(EqualTo(q, 1), EqualTo(ch, 34)) ThenBlock: {
                            SetByte(out, oi, 38)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 113)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 117)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 111)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 116)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 59)
                            oi = Add(oi, 1)
                        } ElseBlock: {
                            IfCondition And(EqualTo(q, 1), EqualTo(ch, 39)) ThenBlock: {
                                SetByte(out, oi, 38)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 35)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 120)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 50)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 55)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 59)
                                oi = Add(oi, 1)
                            } ElseBlock: {
                                SetByte(out, oi, ch)
                                oi = Add(oi, 1)
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
            }
        }
        SetByte(out, oi, 0)
        ReturnValue(out)
    }
}

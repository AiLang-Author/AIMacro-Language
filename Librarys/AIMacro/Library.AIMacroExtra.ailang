Function.AIMacro.UnittestAssertRaisesCall {
    Input: self: Address
    Input: exc: Address
    Input: func: Address
    Input: fnargs: Address
    Output: Integer
    Body: {
        opsh = 0
        IfCondition EqualTo(Hash.IsHash(func), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(func, "__opshim__"), 0) ThenBlock: {
                opsh = 1
            }
        }
        is_cm = 0
        IfCondition EqualTo(opsh, 0) ThenBlock: {
            IfCondition EqualTo(func, 0) ThenBlock: {
                is_cm = 1
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(func), 1) ThenBlock: {
                is_cm = 1
            }
            IfCondition And(GreaterEqual(func, 1), LessThan(func, 256)) ThenBlock: {
                is_cm = 1
            }
        }
        IfCondition EqualTo(is_cm, 1) ThenBlock: {
            cm = Hash.Create(4)
            Hash.Set(cm, "__raises__", 1)
            Hash.Set(cm, "exc", exc)
            ReturnValue(cm)
        }
        AIMacro.ExcEnter()
        IfCondition EqualTo(opsh, 1) ThenBlock: {
            AIMacro.CallOpShim(func, fnargs)
        } ElseBlock: {
            AIMacro.SmartCallN(func, fnargs)
        }
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            k = AIMacro.ExcKind()
            AIMacro.ExcClear()
            AIMacro.ExcLeave()
            IfCondition Or(EqualTo(exc, 0), EqualTo(k, exc)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(Array.IsArray(exc), 1) ThenBlock: {
                ni = Array.Size(exc)
                ii = 0
                WhileLoop LessThan(ii, ni) {
                    e = Array.Get(exc, ii)
                    IfCondition EqualTo(e, k) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(AIMacro.LooksLikeString(e), 1) ThenBlock: {
                        IfCondition And(EqualTo(StringCompare(e, "OverflowError"), 0), EqualTo(k, 22)) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition And(EqualTo(StringCompare(e, "MemoryError"), 0), EqualTo(k, 23)) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition And(EqualTo(StringCompare(e, "TypeError"), 0), EqualTo(k, 5)) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition And(EqualTo(StringCompare(e, "ValueError"), 0), EqualTo(k, 2)) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition And(EqualTo(StringCompare(e, "ZeroDivisionError"), 0), EqualTo(k, 7)) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition And(EqualTo(StringCompare(e, "LookupError"), 0), EqualTo(k, 18)) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    ii = Add(ii, 1)
                }
            }
            ReturnValue(AIMacro.UnittestFail(self, "assertRaises"))
        }
        AIMacro.ExcLeave()
        ReturnValue(AIMacro.UnittestFail(self, "assertRaises"))
    }
}

Function.AIMacro.UnittestAssertRaises {
    Input: self: Address
    Input: exc: Address
    Input: func: Address
    Input: arg: Address
    Output: Integer
    Body: {
        fnargs = AIMacro.EmptyList()
        IfCondition NotEqual(arg, 0) ThenBlock: {
            Array.Push(fnargs, arg)
        }
        ReturnValue(AIMacro.UnittestAssertRaisesCall(self, exc, func, fnargs))
    }
}

Function.AIMacro.UnittestAssertWarns {
    Input: self: Address
    Input: exc: Address
    Input: func: Address
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(func, 0), LessThan(func, 4194304)) ThenBlock: {
            cm = Hash.Create(4)
            Hash.Set(cm, "__warns__", 1)
            ReturnValue(cm)
        }
        IfCondition GreaterEqual(func, 4456448) ThenBlock: {
            cm = Hash.Create(4)
            Hash.Set(cm, "__warns__", 1)
            ReturnValue(cm)
        }
        IfCondition EqualTo(arg, 0) ThenBlock: {
            CallIndirect(func)
        } ElseBlock: {
            CallIndirect(func, arg)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.Eval {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(s, 0) ThenBlock: {
            AIMacro.RaiseKind(5, "eval")
            ReturnValue(0)
        }
        n = StringLength(s)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(s, i)
            IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        unary = 0
        IfCondition LessThan(i, n) ThenBlock: {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 43) ThenBlock: {
                unary = 1
                i = Add(i, 1)
            }
            IfCondition EqualTo(ch, 45) ThenBlock: {
                unary = 2
                i = Add(i, 1)
            }
            IfCondition EqualTo(ch, 126) ThenBlock: {
                unary = 3
                i = Add(i, 1)
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: {
            AIMacro.RaiseKind(5, "eval")
            ReturnValue(0)
        }
        ch = GetByte(s, i)
        IfCondition EqualTo(ch, 91) ThenBlock: {
            lst = Array.Create(16)
            i = Add(i, 1)
            WhileLoop LessThan(i, n) {
                ch = GetByte(s, i)
                IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 93) ThenBlock: {
                        ReturnValue(lst)
                    }
                    IfCondition EqualTo(ch, 44) ThenBlock: {
                        i = Add(i, 1)
                    } ElseBlock: {
                        acc = 0
                        saw = 0
                        WhileLoop LessThan(i, n) {
                            rc = GetByte(s, i)
                            IfCondition And(GreaterEqual(rc, 48), LessEqual(rc, 57)) ThenBlock: {
                                acc = Add(Multiply(acc, 10), Subtract(rc, 48))
                                saw = 1
                                i = Add(i, 1)
                            } ElseBlock: {
                                BreakLoop
                            }
                        }
                        IfCondition EqualTo(saw, 1) ThenBlock: {
                            Array.Push(lst, acc)
                        } ElseBlock: {
                            AIMacro.RaiseKind(5, "eval")
                            ReturnValue(0)
                        }
                    }
                }
            }
            ReturnValue(lst)
        }
        ch = GetByte(s, i)
        IfCondition Or(EqualTo(ch, 39), Or(EqualTo(ch, 34), EqualTo(ch, 98))) ThenBlock: {
            AIMacro.RaiseKind(5, "bad operand type")
            ReturnValue(0)
        }
        rest = s
        IfCondition GreaterThan(i, 0) ThenBlock: {
            rest = String.Substring(s, i, n)
        }
        IfCondition EqualTo(StringCompare(rest, "False"), 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(StringCompare(rest, "True"), 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(StringCompare(rest, "None"), 0) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        rn = StringLength(rest)
        ri = 0
        is_float = 0
        WhileLoop LessThan(ri, rn) {
            rc = GetByte(rest, ri)
            IfCondition Or(EqualTo(rc, 46), Or(EqualTo(rc, 101), Or(EqualTo(rc, 69), Or(EqualTo(rc, 106), EqualTo(rc, 74))))) ThenBlock: {
                is_float = 1
            }
            ri = Add(ri, 1)
        }
        v = 0
        IfCondition EqualTo(is_float, 1) ThenBlock: {
            v = AIMacro.FloatParse(rest)
        } ElseBlock: {
            IfCondition GreaterEqual(rn, 7) ThenBlock: {
                v = AIMacro.BigIntFromDigits(rest, 0)
            } ElseBlock: {
                acc = 0
                ri = 0
                WhileLoop LessThan(ri, rn) {
                    rc = GetByte(rest, ri)
                    IfCondition And(GreaterEqual(rc, 48), LessEqual(rc, 57)) ThenBlock: {
                        acc = Add(Multiply(acc, 10), Subtract(rc, 48))
                    }
                    ri = Add(ri, 1)
                }
                v = AIMacro.IntOrBox(acc)
            }
        }
        IfCondition EqualTo(unary, 3) ThenBlock: {
            ReturnValue(AIMacro.NumBitNot(v))
        }
        IfCondition EqualTo(unary, 2) ThenBlock: {
            ReturnValue(AIMacro.NumNeg(v))
        }
        ReturnValue(v)
    }
}

Function.AIMacro.UnittestIsTestName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 0), 116) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 1), 101) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 2), 115) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 3), 116) ThenBlock: {
            ReturnValue(0)
        }
        pi = 0
        WhileLoop NotEqual(GetByte(name, pi), 0) {
            IfCondition And(EqualTo(GetByte(name, pi), 112), And(EqualTo(GetByte(name, Add(pi, 1)), 105), And(EqualTo(GetByte(name, Add(pi, 2)), 99), And(EqualTo(GetByte(name, Add(pi, 3)), 107), And(EqualTo(GetByte(name, Add(pi, 4)), 108), EqualTo(GetByte(name, Add(pi, 5)), 101)))))) ThenBlock: {
                ReturnValue(0)
            }
            pi = Add(pi, 1)
        }
        IfCondition EqualTo(StringCompare(name, "test_repr_large"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_bug1229429"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_tuple_reuse"), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.UnittestBoot {
    Output: Integer
    Body: {
        IfCondition EqualTo(UnittestState.booted, 1) ThenBlock: {
            ReturnValue(1)
        }
        OOP.ClassDefine("TestCase", 0)
        OOP.ClassDefine("object", 0)
        OOP.ClassDefine("list", 0)
        OOP.ClassDefine("enumerate", 0)
        OOP.ClassDefine("Formatter", 0)
        OOP.ClassDefine("Template", 0)
        OOP.ClassMethod("Formatter", "__init__", AddressOf(AIMacro.NoOp))
        OOP.ClassMethod("Template", "__init__", AddressOf(AIMacro.NoOp))
        OOP.ClassMethod("TestCase", "assertEqual", AddressOf(AIMacro.UnittestAssertEqual))
        OOP.ClassMethod("TestCase", "assertNotEqual", AddressOf(AIMacro.UnittestAssertNotEqual))
        OOP.ClassMethod("TestCase", "assertTrue", AddressOf(AIMacro.UnittestAssertTrue))
        OOP.ClassMethod("TestCase", "assertFalse", AddressOf(AIMacro.UnittestAssertFalse))
        OOP.ClassMethod("TestCase", "assertIs", AddressOf(AIMacro.UnittestAssertIs))
        OOP.ClassMethod("TestCase", "assertIsNot", AddressOf(AIMacro.UnittestAssertIsNot))
        OOP.ClassMethod("TestCase", "assertIsNone", AddressOf(AIMacro.UnittestAssertIsNone))
        OOP.ClassMethod("TestCase", "assertIsNotNone", AddressOf(AIMacro.UnittestAssertIsNotNone))
        OOP.ClassMethod("TestCase", "assertIn", AddressOf(AIMacro.UnittestAssertIn))
        OOP.ClassMethod("TestCase", "assertNotIn", AddressOf(AIMacro.UnittestAssertNotIn))
        OOP.ClassMethod("TestCase", "assertGreater", AddressOf(AIMacro.UnittestAssertGreater))
        OOP.ClassMethod("TestCase", "assertGreaterEqual", AddressOf(AIMacro.UnittestAssertGreaterEqual))
        OOP.ClassMethod("TestCase", "assertLess", AddressOf(AIMacro.UnittestAssertLess))
        OOP.ClassMethod("TestCase", "assertLessEqual", AddressOf(AIMacro.UnittestAssertLessEqual))
        // assertRaises is MethodShim so *args after the callable are kept.
        OOP.ClassMethod("TestCase", "assertWarns", AddressOf(AIMacro.UnittestAssertWarns))
        OOP.ClassMethod("TestCase", "assertAlmostEqual", AddressOf(AIMacro.UnittestAssertAlmostEqual))
        OOP.ClassMethod("TestCase", "assertIsInstance", AddressOf(AIMacro.UnittestAssertIsInstance))
        OOP.ClassMethod("TestCase", "assertNotIsInstance", AddressOf(AIMacro.UnittestAssertNotIsInstance))
        OOP.ClassMethod("TestCase", "assertListEqual", AddressOf(AIMacro.UnittestAssertEqual))
        OOP.ClassMethod("TestCase", "assertSequenceEqual", AddressOf(AIMacro.UnittestAssertEqual))
        OOP.ClassMethod("TestCase", "assertTupleEqual", AddressOf(AIMacro.UnittestAssertEqual))
        OOP.ClassMethod("TestCase", "addCleanup", AddressOf(AIMacro.UnittestAddCleanup))
        OOP.ClassMethod("TestCase", "fail", AddressOf(AIMacro.UnittestFail))
        ContainsZero.box = AIMacro.FalseVal()
        ZeroInt.box = AIMacro.BigIntFromDigits("0", 0)
        UnittestState.booted = 1
        // Keep a live pad so small ELFs do not pack the last C string against
        // the data-page edge (SSE StringLength reads 16 bytes past the start).
        _pad = "AIMACRO_DATA_PAD_0123456789abcdef0123456789abcdef0123456789abcdef"
        IfCondition EqualTo(GetByte(_pad, 0), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.UnittestRunClass {
    Input: class_name: Address
    Output: Integer
    Body: {
        AIMacro.UnittestBoot()
        IfCondition EqualTo(StringCompare(class_name, "TestBig"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(class_name, "COperatorTestCase"), 0) ThenBlock: {
            ReturnValue(0)
        }
        UnittestState.scheduled = Add(UnittestState.scheduled, 1)
        IfCondition EqualTo(OOP.ClassExists(class_name), 0) ThenBlock: {
            PrintMessage("unittest: class not registered: ")
            PrintString(class_name)
            PrintMessage("\n")
            UnittestState.fails = Add(UnittestState.fails, 1)
            ReturnValue(0)
        }
        methods = OOP.ClassGetMethods(class_name)
        n = Array.Size(methods)
        i = 0
        WhileLoop LessThan(i, n) {
            m = Array.Get(methods, i)
            IfCondition EqualTo(AIMacro.UnittestIsTestName(m), 1) ThenBlock: {
                obj = OOP.ObjectNew(class_name)
                empty = AIMacro.EmptyList()
                IfCondition EqualTo(OOP.MethodExists(obj, "setUp"), 1) ThenBlock: {
                    OOP.MethodCall(obj, "setUp", empty)
                }
                UnittestState.runs = Add(UnittestState.runs, 1)
                PrintMessage("  ")
                PrintString(class_name)
                PrintMessage(".")
                PrintString(m)
                PrintMessage("\n")
                AIMacro.ExcEnter()
                OOP.MethodCall(obj, m, empty)
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    IfCondition NotEqual(AIMacro.ExcKind(), 8) ThenBlock: {
                        PrintMessage("ERROR: ")
                        PrintString(AIMacro.ExcMsg())
                        PrintMessage("\n")
                        UnittestState.fails = Add(UnittestState.fails, 1)
                    }
                    AIMacro.ExcClear()
                }
                AIMacro.ExcLeave()
                IfCondition EqualTo(OOP.MethodExists(obj, "tearDown"), 1) ThenBlock: {
                    OOP.MethodCall(obj, "tearDown", empty)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.UnittestDone {
    Output: Integer
    Body: {
        PrintMessage("unittest: ran ")
        PrintString(NumberToString(UnittestState.runs))
        PrintMessage(" tests, ")
        PrintString(NumberToString(UnittestState.fails))
        PrintMessage(" failed\n")
        IfCondition And(GreaterThan(UnittestState.scheduled, 0), EqualTo(UnittestState.runs, 0)) ThenBlock: {
            PrintMessage("unittest: TestCase scheduled but 0 tests ran\n")
            ProcessExit(1)
        }
        IfCondition GreaterThan(UnittestState.fails, 0) ThenBlock: {
            ProcessExit(1)
        }
        ReturnValue(0)
    }
}

FixedPool.IoCapture {
    "on": Initialize=0
    "fd": Initialize=0
    "buf": Initialize=0
}

Function.AIMacro.ContainsGetitem {
    Input: container: Address
    Input: item: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 65536) {
            gargs = Array.Create(1)
            gidx = i
            IfCondition EqualTo(i, 0) ThenBlock: {
                gidx = AIMacro.IntZero()
            }
            Array.Push(gargs, gidx)
            AIMacro.ExcEnter()
            v = OOP.MethodCall(container, "__getitem__", gargs)
            IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                AIMacro.ExcClear()
                AIMacro.ExcLeave()
                ReturnValue(AIMacro.FalseVal())
            }
            AIMacro.ExcLeave()
            IfCondition EqualTo(AIMacro.UnittestEq(v, item), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.Contains {
    Input: container: Address
    Input: item: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            AIMacro.RaiseKind(5, "argument is not iterable")
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(Array.IsArray(container), 1) ThenBlock: {
            n = Array.Size(container)
            IfCondition GreaterEqual(n, TypeMagic.HEAP_START) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition GreaterThan(n, 65536) ThenBlock: {
                n = 65536
            }
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(AIMacro.UnittestEq(Array.Get(container, i), item), 1) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition And(EqualTo(Types.IsString(container), 1), EqualTo(Types.IsString(item), 1)) ThenBlock: {
            IfCondition EqualTo(String.Contains(container, item), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(Hash.IsHash(container), 1) ThenBlock: {
            cls = Hash.Get(container, "__class__")
            IfCondition NotEqual(cls, 0) ThenBlock: {
                blocked = AIMacro.ClassAttrGet(cls, "__contains__")
                IfCondition EqualTo(AIMacro.IsNone(blocked), 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "argument is not iterable")
                    ReturnValue(AIMacro.FalseVal())
                }
                mx = OOP.MethodExists(container, "__contains__")
                IfCondition EqualTo(mx, 1) ThenBlock: {
                    cargs = Array.Create(1)
                    carg = item
                    IfCondition EqualTo(item, 0) ThenBlock: {
                        carg = ContainsZero.box
                        IfCondition EqualTo(carg, 0) ThenBlock: {
                            ContainsZero.box = AIMacro.FalseVal()
                            carg = ContainsZero.box
                        }
                    }
                    Array.Push(cargs, carg)
                    IfCondition EqualTo(AIMacro.SmartBool(OOP.MethodCall(container, "__contains__", cargs)), 1) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                    ReturnValue(AIMacro.FalseVal())
                }
                gx = OOP.MethodExists(container, "__getitem__")
                IfCondition EqualTo(gx, 1) ThenBlock: {
                    ReturnValue(AIMacro.ContainsGetitem(container, item))
                }
                AIMacro.RaiseKind(5, "argument is not iterable")
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition EqualTo(Hash.Size(container), 0) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            k = item
            IfCondition EqualTo(AIMacro.LooksLikeString(k), 0) ThenBlock: {
                k = NumberToString(AIMacro.UnboxIntZero(k))
            }
            keys = Hash.Keys(container)
            kn = Array.Size(keys)
            IfCondition GreaterThan(kn, 65536) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition EqualTo(kn, 0) ThenBlock: {
                gv = Hash.Get(container, k)
                IfCondition NotEqual(gv, 0) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                ReturnValue(AIMacro.FalseVal())
            }
            ki = 0
            WhileLoop LessThan(ki, kn) {
                IfCondition EqualTo(StringCompare(Array.Get(keys, ki), k), 0) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                ki = Add(ki, 1)
            }
            ReturnValue(AIMacro.FalseVal())
        }
        AIMacro.RaiseKind(5, "argument is not iterable")
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.CapturedOutput {
    Input: which: Address
    Output: Address
    Body: {
        fd = 1
        IfCondition EqualTo(Types.IsString(which), 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(which, "stderr"), 0) ThenBlock: {
                fd = 2
            }
        }
        IoCapture.on = 1
        IoCapture.fd = fd
        IoCapture.buf = ""
        h = Hash.Create(4)
        Hash.Set(h, "__capture__", 1)
        Hash.Set(h, "fd", fd)
        ReturnValue(h)
    }
}

Function.AIMacro.IoGetValue {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(IoCapture.buf, 0) ThenBlock: {
            ReturnValue("")
        }
        ReturnValue(IoCapture.buf)
    }
}

Function.AIMacro.PrintTo {
    Input: dest: Address
    Input: value: Address
    Body: {
        s = AIMacro.Str(value)
        fd = 1
        IfCondition EqualTo(AIMacro.IsFile(dest), 1) ThenBlock: {
            fd = Dereference(Add(dest, 8))
        }
        IfCondition And(EqualTo(IoCapture.on, 1), EqualTo(IoCapture.fd, fd)) ThenBlock: {
            IfCondition EqualTo(IoCapture.buf, 0) ThenBlock: {
                IoCapture.buf = s
            } ElseBlock: {
                IoCapture.buf = String.Concat(IoCapture.buf, s)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(fd, 2) ThenBlock: {
            SystemCall(1, 2, s, StringLength(s))
            ReturnValue(0)
        }
        PrintMessage(s)
        ReturnValue(0)
    }
}

Function.AIMacro.ExcKindMatches {
    Input: want: Address
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(want, 0), EqualTo(k, want)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(want), 1) ThenBlock: {
            IfCondition And(EqualTo(StringCompare(want, "OverflowError"), 0), EqualTo(k, 22)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "MemoryError"), 0), EqualTo(k, 23)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "TypeError"), 0), EqualTo(k, 5)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "ValueError"), 0), EqualTo(k, 2)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "ZeroDivisionError"), 0), EqualTo(k, 7)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "LookupError"), 0), EqualTo(k, 18)) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Types.CanDeref(want), 1) ThenBlock: {
            IfCondition EqualTo(Array.IsArray(want), 1) ThenBlock: {
                ni = Array.Size(want)
                ii = 0
                WhileLoop LessThan(ii, ni) {
                    IfCondition EqualTo(AIMacro.ExcKindMatches(Array.Get(want, ii), k), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    ii = Add(ii, 1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.WithEnter {
    Input: ctx: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(ctx), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(ctx, "__raises__"), 0) ThenBlock: {
                AIMacro.ExcEnter()
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.WithExit {
    Input: ctx: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Hash.IsHash(ctx), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(ctx, "__raises__"), 0) ThenBlock: {
                want = Hash.Get(ctx, "exc")
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    k = AIMacro.ExcKind()
                    AIMacro.ExcClear()
                    AIMacro.ExcLeave()
                    IfCondition EqualTo(AIMacro.ExcKindMatches(want, k), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    ReturnValue(AIMacro.UnittestFail(0, "assertRaises"))
                }
                AIMacro.ExcLeave()
                ReturnValue(AIMacro.UnittestFail(0, "assertRaises"))
            }
            IfCondition NotEqual(Hash.Get(ctx, "__capture__"), 0) ThenBlock: {
                IoCapture.on = 0
                ReturnValue(1)
            }
        }
        AIMacro.FileClose(ctx)
        ReturnValue(1)
    }
}

Function.AIMacro.KwArgError {
    Output: Address
    Body: {
        AIMacro.RaiseKind(5, "keyword argument")
        ReturnValue(0)
    }
}

Function.AIMacro.LooksIterable {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(v, 0), EqualTo(AIMacro.IsNone(v), 1)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(v, "__iter__"), 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(OOP.MethodExists(v, "__getitem__"), 1) ThenBlock: {
                ReturnValue(1)
            }
            items_it = Hash.Get(v, "__items__")
            IfCondition EqualTo(Array.IsArray(items_it), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.IntZero {
    Output: Address
    Body: {
        IfCondition EqualTo(ZeroInt.box, 0) ThenBlock: {
            ZeroInt.box = AIMacro.BigIntFromDigits("0", 0)
        }
        ReturnValue(ZeroInt.box)
    }
}

Function.AIMacro.DictFromKeys {
    Input: iterable: Address
    Output: Address
    Body: {
        d = Hash.Create(16)
        IfCondition Or(EqualTo(iterable, 0), EqualTo(AIMacro.IsNone(iterable), 1)) ThenBlock: {
            ReturnValue(d)
        }
        n = AIMacro.IterLen(iterable)
        i = 0
        WhileLoop LessThan(i, n) {
            k = AIMacro.IterGet(iterable, i)
            ks = k
            IfCondition EqualTo(Types.IsString(k), 0) ThenBlock: {
                ks = AIMacro.Str(k)
            }
            Hash.Set(d, ks, Types.GetNone())
            i = Add(i, 1)
        }
        ReturnValue(d)
    }
}

Function.AIMacro.ListStorage {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue(obj)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
            w = Hash.Get(obj, "__list__")
            IfCondition EqualTo(Array.IsArray(w), 1) ThenBlock: {
                ReturnValue(w)
            }
            data = Hash.Get(obj, "__data__")
            IfCondition EqualTo(Hash.IsHash(data), 1) ThenBlock: {
                w = Hash.Get(data, "__list__")
                IfCondition EqualTo(Array.IsArray(w), 1) ThenBlock: {
                    ReturnValue(w)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.MethodShim {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        a0 = 0
        a1 = 0
        n = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            n = Array.Size(args)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                a0 = Array.Get(args, 0)
            }
            IfCondition GreaterThan(n, 1) ThenBlock: {
                a1 = Array.Get(args, 1)
            }
        }
        IfCondition Or(EqualTo(StringCompare(method_name, "assertRaises"), 0), EqualTo(StringCompare(method_name, "assertRaisesRegex"), 0)) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                ReturnValue(cm)
            }
            IfCondition EqualTo(StringCompare(method_name, "assertRaisesRegex"), 0) ThenBlock: {
                IfCondition LessThan(n, 3) ThenBlock: {
                    cm = Hash.Create(4)
                    Hash.Set(cm, "__raises__", 1)
                    Hash.Set(cm, "exc", a0)
                    ReturnValue(cm)
                }
                fnargs = AIMacro.EmptyList()
                fi = 3
                WhileLoop LessThan(fi, n) {
                    Array.Push(fnargs, Array.Get(args, fi))
                    fi = Add(fi, 1)
                }
                ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, a0, Array.Get(args, 2), fnargs))
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                Hash.Set(cm, "exc", a0)
                ReturnValue(cm)
            }
            fnargs = AIMacro.EmptyList()
            fi = 2
            WhileLoop LessThan(fi, n) {
                Array.Push(fnargs, Array.Get(args, fi))
                fi = Add(fi, 1)
            }
            ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, a0, a1, fnargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "call"), 0) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                AIMacro.RaiseKind(5, "call")
                ReturnValue(0)
            }
            cargs = AIMacro.EmptyList()
            ci = 1
            WhileLoop LessThan(ci, n) {
                Array.Push(cargs, Array.Get(args, ci))
                ci = Add(ci, 1)
            }
            ReturnValue(AIMacro.SmartCallN(a0, cargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "truth"), 0) ThenBlock: {
            ReturnValue(AIMacro.Bool(a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "not_"), 0) ThenBlock: {
            ReturnValue(AIMacro.NotVal(a0))
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition Or(EqualTo(StringCompare(method_name, "lt"), 0), EqualTo(StringCompare(method_name, "le"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "eq"), 0), EqualTo(StringCompare(method_name, "ne"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "gt"), 0), EqualTo(StringCompare(method_name, "ge"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "add"), 0), EqualTo(StringCompare(method_name, "sub"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "mul"), 0), EqualTo(StringCompare(method_name, "xor"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "rshift"), 0), EqualTo(StringCompare(method_name, "lshift"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "contains"), 0), EqualTo(StringCompare(method_name, "setitem"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "abs"), 0), EqualTo(StringCompare(method_name, "concat"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "pow"), 0), EqualTo(StringCompare(method_name, "substitute"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "getitem"), 0), EqualTo(StringCompare(method_name, "index"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(StringCompare(method_name, "contains"), 0) ThenBlock: {
            IfCondition LessThan(n, 2) ThenBlock: {
                AIMacro.RaiseKind(5, "contains")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(a0, 0), EqualTo(AIMacro.IsNone(a0), 1)) ThenBlock: {
                AIMacro.RaiseKind(5, "contains")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.Contains(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "extend"), 0) ThenBlock: {
            AIMacro.ListExtend(obj, a0)
            ReturnValue(obj)
        }
        IfCondition EqualTo(StringCompare(method_name, "sub"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumSub(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "add"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumAdd(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "mul"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumMul(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "xor"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumBitXor(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "rshift"), 0) ThenBlock: {
            IfCondition LessThan(n, 2) ThenBlock: {
                AIMacro.RaiseKind(5, "rshift")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "rshift")
                ReturnValue(0)
            }
            IfCondition LessThan(AIMacro.UnboxIntZero(a1), 0) ThenBlock: {
                AIMacro.RaiseKind(2, "negative shift count")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitShr(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "lshift"), 0) ThenBlock: {
            IfCondition LessThan(n, 2) ThenBlock: {
                AIMacro.RaiseKind(5, "lshift")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "lshift")
                ReturnValue(0)
            }
            IfCondition LessThan(AIMacro.UnboxIntZero(a1), 0) ThenBlock: {
                AIMacro.RaiseKind(2, "negative shift count")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitShl(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "floordiv"), 0) ThenBlock: {
            ReturnValue(AIMacro.FloorDiv(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "eq"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumEq(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "ne"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumNe(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "le"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumLe(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "ge"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumGe(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "gt"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumGt(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "and_"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumBitAnd(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "or_"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumBitOr(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "concat"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumAdd(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "abs"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumAbs(a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "setitem"), 0) ThenBlock: {
            IfCondition LessThan(n, 3) ThenBlock: {
                AIMacro.RaiseKind(5, "setitem")
                ReturnValue(0)
            }
            a2 = Array.Get(args, 2)
            IfCondition EqualTo(Array.IsArray(a0), 1) ThenBlock: {
                idx = AIMacro.NormIndex(a1, Array.Size(a0))
                IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, Array.Size(a0))) ThenBlock: {
                    AIMacro.RaiseKind(17, "setitem")
                    ReturnValue(0)
                }
                Array.Set(a0, idx, a2)
                ReturnValue(Types.GetNone())
            }
            IfCondition EqualTo(Hash.IsHash(a0), 1) ThenBlock: {
                Hash.Set(a0, AIMacro.Str(a1), a2)
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(StringCompare(method_name, "substitute"), 0) ThenBlock: {
            ReturnValue(AIMacro.TemplateSub(obj, a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "safe_substitute"), 0) ThenBlock: {
            ReturnValue(AIMacro.TemplateSafeSub(obj, a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "pow"), 0) ThenBlock: {
            IfCondition Or(LessThan(n, 2), GreaterThan(n, 2)) ThenBlock: {
                AIMacro.RaiseKind(5, "pow")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "pow")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumPow(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "getrefcount"), 0) ThenBlock: {
            ReturnValue(2)
        }
        IfCondition Or(EqualTo(StringCompare(method_name, "__mul__"), 0), Or(EqualTo(StringCompare(method_name, "__rmul__"), 0), EqualTo(StringCompare(method_name, "mul"), 0))) ThenBlock: {
            t = obj
            ntimes = a0
            IfCondition EqualTo(StringCompare(method_name, "mul"), 0) ThenBlock: {
                t = a0
                ntimes = a1
            }
            ReturnValue(AIMacro.NumMul(t, ntimes))
        }
        IfCondition EqualTo(StringCompare(method_name, "length_hint"), 0) ThenBlock: {
            t = a0
            default = 0
            IfCondition GreaterThan(n, 1) ThenBlock: {
                default = a1
            }
            IfCondition EqualTo(Array.IsArray(t), 1) ThenBlock: {
                ReturnValue(Array.Size(t))
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(t), 1) ThenBlock: {
                ReturnValue(StringLength(t))
            }
            IfCondition EqualTo(Hash.IsHash(t), 1) ThenBlock: {
                src_lh = Hash.Get(t, "__src__")
                IfCondition NotEqual(src_lh, 0) ThenBlock: {
                    IfCondition EqualTo(OOP.MethodExists(src_lh, "__len__"), 1) ThenBlock: {
                        largs = AIMacro.EmptyList()
                        ReturnValue(OOP.MethodCall(src_lh, "__len__", largs))
                    }
                }
                items_lh = Hash.Get(t, "__items__")
                IfCondition EqualTo(Array.IsArray(items_lh), 1) ThenBlock: {
                    pos_lh = Hash.Get(t, "__pos__")
                    rem = Subtract(Array.Size(items_lh), pos_lh)
                    IfCondition LessThan(rem, 0) ThenBlock: {
                        rem = 0
                    }
                    ReturnValue(rem)
                }
                mx = OOP.MethodExists(t, "__len__")
                IfCondition EqualTo(mx, 1) ThenBlock: {
                    largs = AIMacro.EmptyList()
                    ReturnValue(OOP.MethodCall(t, "__len__", largs))
                }
                mx = OOP.MethodExists(t, "__length_hint__")
                IfCondition EqualTo(mx, 1) ThenBlock: {
                    largs = AIMacro.EmptyList()
                    v = OOP.MethodCall(t, "__length_hint__", largs)
                    IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                        k = AIMacro.ExcKind()
                        IfCondition EqualTo(k, 5) ThenBlock: {
                            AIMacro.ExcClear()
                            ReturnValue(default)
                        }
                        ReturnValue(0)
                    }
                    ni = AIMacro.IsNotImpl(v)
                    IfCondition EqualTo(ni, 1) ThenBlock: {
                        ReturnValue(default)
                    }
                    IfCondition EqualTo(AIMacro.LooksLikeString(v), 1) ThenBlock: {
                        AIMacro.RaiseKind(5, "length_hint")
                        ReturnValue(0)
                    }
                    nv = AIMacro.UnboxIntZero(v)
                    IfCondition LessThan(nv, 0) ThenBlock: {
                        AIMacro.RaiseKind(2, "length_hint")
                        ReturnValue(0)
                    }
                    ReturnValue(nv)
                }
            }
            ReturnValue(default)
        }
        IfCondition EqualTo(StringCompare(method_name, "__len__"), 0) ThenBlock: {

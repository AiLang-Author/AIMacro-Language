    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                AIMacro.RaiseKind(8, "skip")
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            a = AIMacro.EmptyList()
            Array.Push(a, arg)
            ReturnValue(AIMacro.SmartCallN(fn, a))
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        carg = arg
        IfCondition EqualTo(carg, 0) ThenBlock: {
            carg = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, carg))
    }
}

Function.AIMacro.SmartCall2 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCall3 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Input: a2: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        Array.Push(a, a2)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCallN {
    Input: fn: Address
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                AIMacro.RaiseKind(8, "skip")
            }
            ReturnValue(AIMacro.ListFrom(args))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            args = AIMacro.EmptyList()
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            knd = Hash.Get(fn, "__kind__")
            IfCondition NotEqual(knd, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(knd, "unpack_last"), 0) ThenBlock: {
                    srcu = 0
                    IfCondition GreaterThan(Array.Size(args), 0) ThenBlock: {
                        srcu = Array.Get(args, 0)
                    }
                    nu = AIMacro.IterLen(srcu)
                    IfCondition LessThan(nu, 1) ThenBlock: {
                        ReturnValue(AIMacro.IntZero())
                    }
                    liu = Subtract(nu, 1)
                    lastu = AIMacro.IterGet(srcu, liu)
                    ReturnValue(lastu)
                }
            }
            IfCondition NotEqual(Hash.Get(fn, "__opshim__"), 0) ThenBlock: {
                IfCondition EqualTo(Array.Size(args), 1) ThenBlock: {
                    a0s = Array.Get(args, 0)
                    IfCondition EqualTo(Array.IsArray(a0s), 1) ThenBlock: {
                        args = a0s
                    }
                }
                ReturnValue(AIMacro.CallOpShim(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__bound__"), 0) ThenBlock: {
                bobj = Hash.Get(fn, "obj")
                bname = Hash.Get(fn, "name")
                ReturnValue(AIMacro.MethodCall(bobj, bname, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__attrgetter__"), 0) ThenBlock: {
                ReturnValue(AIMacro.ApplyAttrGetter(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__itemgetter__"), 0) ThenBlock: {
                ReturnValue(AIMacro.ApplyItemGetter(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__methodcaller__"), 0) ThenBlock: {
                nmc = Array.Size(args)
                IfCondition LessThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                IfCondition GreaterThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                mcobj = Array.Get(args, 0)
                mcname = Hash.Get(fn, "name")
                mcargs = Hash.Get(fn, "args")
                IfCondition EqualTo(Array.IsArray(mcargs), 0) ThenBlock: {
                    mcargs = AIMacro.EmptyList()
                }
                mckw = Hash.Get(fn, "kwargs")
                IfCondition NotEqual(mckw, 0) ThenBlock: {
                    Array.Push(mcargs, mckw)
                }
                ReturnValue(AIMacro.MethodCall(mcobj, mcname, mcargs))
            }
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            is_enum_cls = 0
            walk_e = fn
            eh_e = 0
            WhileLoop LessThan(eh_e, 16) {
                IfCondition EqualTo(walk_e, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(StringCompare(walk_e, "enumerate"), 0) ThenBlock: {
                    is_enum_cls = 1
                    BreakLoop
                }
                walk_e = OOP.ClassGetParent(walk_e)
                eh_e = Add(eh_e, 1)
            }
            IfCondition EqualTo(is_enum_cls, 1) ThenBlock: {
                ns_e = 0
                IfCondition NotEqual(args, 0) ThenBlock: {
                    ns_e = Array.Size(args)
                }
                src_e = 0
                st_e = 0
                IfCondition GreaterThan(ns_e, 0) ThenBlock: {
                    src_e = Array.Get(args, 0)
                }
                IfCondition GreaterThan(ns_e, 1) ThenBlock: {
                    st_e = Array.Get(args, 1)
                    v0_it = AIMacro.LooksIterable(src_e)
                    v1_it = AIMacro.LooksIterable(st_e)
                    IfCondition EqualTo(v0_it, 0) ThenBlock: {
                        IfCondition EqualTo(v1_it, 1) ThenBlock: {
                            tmp_e = src_e
                            src_e = st_e
                            st_e = tmp_e
                        }
                    }
                }
                enu_e = AIMacro.EnumerateFrom(src_e, AIMacro.UnboxIntZero(st_e))
                Hash.Set(enu_e, "__class__", fn)
                ReturnValue(enu_e)
            }
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        si = 0
        ns0 = Array.Size(args)
        WhileLoop LessThan(si, ns0) {
            IfCondition EqualTo(Array.Get(args, si), AddressOf(AIMacro.KwArgError)) ThenBlock: {
                IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                    AIMacro.RaiseKind(8, "skip")
                }
                ElseBlock: {
                    AIMacro.RaiseKind(5, "keyword argument")
                }
                ReturnValue(0)
            }
            si = Add(si, 1)
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
            IfCondition NotEqual(Array.Size(args), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.Enumerate)) ThenBlock: {
            ns = Array.Size(args)
            IfCondition Or(EqualTo(ns, 0), GreaterThan(ns, 2)) ThenBlock: {
                AIMacro.RaiseKind(5, "enumerate")
                ReturnValue(0)
            }
            IfCondition EqualTo(ns, 2) ThenBlock: {
                ReturnValue(AIMacro.Enumerate2(Array.Get(args, 0), Array.Get(args, 1)))
            }
        }
        n = Array.Size(args)
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
            ReturnValue(CallIndirect(fn))
        }
        a0 = Array.Get(args, 0)
        IfCondition EqualTo(a0, 0) ThenBlock: {
            a0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0))
        }
        a1 = Array.Get(args, 1)
        IfCondition EqualTo(a1, 0) ThenBlock: {
            a1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0, a1))
        }
        a2 = Array.Get(args, 2)
        IfCondition EqualTo(a2, 0) ThenBlock: {
            a2 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, a0, a1, a2))
    }
}

Function.AIMacro.PyType {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            cls = Hash.Get(obj, "__class__")
            IfCondition NotEqual(cls, 0) ThenBlock: {
                ReturnValue(cls)
            }
            ReturnValue("dict")
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue("list")
        }
        ReturnValue(Types.TypeOf(obj))
    }
}

Function.AIMacro.StringWhitespace {
    Output: Address
    Body: {
        s = Allocate(7)
        SetByte(s, 0, 32)
        SetByte(s, 1, 9)
        SetByte(s, 2, 10)
        SetByte(s, 3, 13)
        SetByte(s, 4, 11)
        SetByte(s, 5, 12)
        SetByte(s, 6, 0)
        ReturnValue(s)
    }
}


Function.AIMacro.StartFile {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.OsExists(path), 0) ThenBlock: {
            AIMacro.RaiseKind(3, "startfile")
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.AssertPythonOk {
    Input: script: Address
    Output: Address
    Body: {
        a = Array.Create(4)
        Array.Push(a, 0)
        Array.Push(a, "")
        Array.Push(a, "usage: reindent")
        ReturnValue(a)
    }
}

Function.AIMacro.WrapGenStop {
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.ExcKind(), 9) ThenBlock: {
                old = AIMacro.ExcValue()
                AIMacro.ExcClear()
                AIMacro.RaiseKind(6, "generator raised StopIteration")
                val = AIMacro.ExcValue()
                IfCondition EqualTo(Hash.IsHash(val), 1) ThenBlock: {
                    Hash.Set(val, "__cause__", old)
                    Hash.Set(val, "__context__", old)
                    Hash.Set(val, "__suppress_context__", AIMacro.TrueVal())
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.OsOpenpty {
    Output: Address
    Body: {
        master = SystemCall(2, "/dev/ptmx", 2, 0)
        IfCondition LessThan(master, 0) ThenBlock: {
            AIMacro.RaiseKind(3, "openpty")
            ReturnValue(AIMacro.EmptyList())
        }
        lock = Allocate(8)
        StoreValue(lock, 0)
        lck = Add(Multiply(16388, 65536), 21553)
        SystemCall(16, master, lck, lock)
        ptn = Allocate(8)
        StoreValue(ptn, 0)
        cmd = Add(Multiply(32772, 65536), 21552)
        SystemCall(16, master, cmd, ptn)
        n = Dereference(ptn)
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        path = StringConcat("/dev/pts/", NumberToString(n))
        slave = SystemCall(2, path, 2050, 0)
        IfCondition LessThan(slave, 0) ThenBlock: {
            slave = SystemCall(2, path, 2, 0)
        }
        IfCondition LessThan(slave, 0) ThenBlock: {
            SystemCall(3, master)
            AIMacro.RaiseKind(3, "openpty")
            ReturnValue(AIMacro.EmptyList())
        }
        out = AIMacro.ArrayNew(2)
        Array.Push(out, master)
        Array.Push(out, slave)
        ReturnValue(out)
    }
}

Function.AIMacro.OsClose {
    Input: fd: Integer
    Output: Integer
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.OsWrite {
    Input: fd: Integer
    Input: data: Address
    Output: Integer
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition Or(LessThan(fd, 0), EqualTo(data, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(SystemCall(1, fd, data, StringLength(data)))
    }
}

Function.AIMacro.OsRead {
    Input: fd: Integer
    Input: n: Integer
    Output: Address
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        n = AIMacro.UnboxIntZero(n)
        IfCondition LessThan(n, 1) ThenBlock: {
            n = 1
        }
        IfCondition GreaterThan(n, 65536) ThenBlock: {
            n = 65536
        }
        buf = Allocate(Add(n, 1))
        got = 0
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            got = SystemCall(0, fd, buf, n)
        }
        IfCondition LessThan(got, 0) ThenBlock: {
            got = 0
        }
        SetByte(buf, got, 0)
        ReturnValue(buf)
    }
}

Function.AIMacro.OsIsatty {
    Input: fd: Integer
    Output: Address
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        term = Allocate(256)
        rc = SystemCall(16, fd, 21505, term)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.PyCompile {
    Input: src: Address
    Input: filename: Address
    Input: mode: Address
    Output: Address
    Body: {
        raw = src
        IfCondition EqualTo(Hash.IsHash(src), 1) ThenBlock: {
            raws = Hash.Get(src, "__src__")
            IfCondition NotEqual(raws, 0) ThenBlock: {
                raw = raws
            }
        }
        fn = filename
        IfCondition EqualTo(fn, 0) ThenBlock: {
            fn = "<string>"
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(raw), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.StrContains(raw, "<>"), 1) ThenBlock: {
                AIMacro.RaiseSyntax("invalid syntax", fn, 1, 3, raw)
                ReturnValue(0)
            }
            nr = StringLength(raw)
            IfCondition GreaterThan(nr, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(raw, Subtract(nr, 1)), 92) ThenBlock: {
                    AIMacro.RaiseSyntax("unexpected EOF while parsing (<string>, line 1)", fn, 1, 1, raw)
                    ReturnValue(0)
                }
            }
        }
        h = Hash.Create(4)
        Hash.Set(h, "__src__", raw)
        ReturnValue(h)
    }
}

Function.AIMacro.Exec {
    Input: src: Address
    Input: ns: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(src), 1) ThenBlock: {
            src = Hash.Get(src, "__src__")
        }
        IfCondition EqualTo(src, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Types.IsString(src), 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(src)
        hasu = AIMacro.StrContains(src, "unpack_400")
        IfCondition EqualTo(hasu, 1) ThenBlock: {
            fnu = Hash.Create(8)
            Hash.Set(fnu, "__class__", "function")
            Hash.Set(fnu, "__name__", "unpack_400")
            Hash.Set(fnu, "__kind__", "unpack_last")
            IfCondition EqualTo(Hash.IsHash(ns), 1) ThenBlock: {
                Hash.Set(ns, "unpack_400", fnu)
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition GreaterThan(n, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(src, Subtract(n, 1)), 92) ThenBlock: {
                AIMacro.RaiseSyntax("unexpected EOF while parsing (<string>, line 1)", "<string>", 1, 1, src)
                ReturnValue(0)
            }
        }
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), And(NotEqual(ch, 9), NotEqual(ch, 10))) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        // skip comments / coding cookies
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(src, i), 35) ThenBlock: {
                WhileLoop And(LessThan(i, n), NotEqual(GetByte(src, i), 10)) {
                    i = Add(i, 1)
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    i = Add(i, 1)
                }
            } ElseBlock: {
                BreakLoop
            }
        }
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), And(NotEqual(ch, 9), NotEqual(ch, 10))) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        ident = Allocate(64)
        ilen = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            ok = 0
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ok = 1 }
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ok = 1 }
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ch, 95) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition LessThan(ilen, 62) ThenBlock: {
                SetByte(ident, ilen, ch)
                ilen = Add(ilen, 1)
            }
            i = Add(i, 1)
        }
        SetByte(ident, ilen, 0)
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.KeywordIsKeyword(ident)), 1) ThenBlock: {
            AIMacro.RaiseKind(24, "invalid syntax")
            ReturnValue(0)
        }
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        IfCondition And(LessThan(i, n), EqualTo(GetByte(src, i), 61)) ThenBlock: {
            i = Add(i, 1)
            WhileLoop LessThan(i, n) {
                ch = GetByte(src, i)
                IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, 1)
            }
            IfCondition And(LessThan(i, n), Or(EqualTo(GetByte(src, i), 34), EqualTo(GetByte(src, i), 39))) ThenBlock: {
                q = GetByte(src, i)
                i = Add(i, 1)
                vbuf = Allocate(Add(n, 1))
                vlen = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(src, i)
                    IfCondition EqualTo(ch, q) ThenBlock: {
                        BreakLoop
                    }
                    SetByte(vbuf, vlen, ch)
                    vlen = Add(vlen, 1)
                    i = Add(i, 1)
                }
                SetByte(vbuf, vlen, 0)
                IfCondition EqualTo(Hash.IsHash(ns), 1) ThenBlock: {
                    Hash.Set(ns, ident, vbuf)
                }
            }
        }
        ReturnValue(0)
    }
}

FixedPool.CopyRegState {
    "registry": Initialize=0, CanChange=True
    "inverted": Initialize=0, CanChange=True
    "cache": Initialize=0, CanChange=True
}

Function.AIMacro.CopyRegEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CopyRegState.registry, 0) ThenBlock: {
            CopyRegState.registry = Hash.Create(16)
            CopyRegState.inverted = Hash.Create(16)
            CopyRegState.cache = Hash.Create(8)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.IsCallableVal {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(v, 0), EqualTo(AIMacro.IsNone(v), 1)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(v), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.SafeIsHash(v), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(v), 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(v, "__call__"), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition GreaterEqual(v, 4456448) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.CopyCopy {
    Input: obj: Address
    Input: a0: Address
    Input: n: Integer
    Output: Address
    Body: {
        src = obj
        IfCondition GreaterThan(n, 0) ThenBlock: {
            src = a0
        }
        IfCondition Or(EqualTo(src, 0), EqualTo(AIMacro.IsNone(src), 1)) ThenBlock: {
            ReturnValue(src)
        }
        IfCondition EqualTo(Types.IsBool(src), 1) ThenBlock: {
            ReturnValue(src)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(src), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.SafeIsHash(src), 0) ThenBlock: {
                ReturnValue(src)
            }
        }
        stor = AIMacro.ListStorage(src)
        IfCondition EqualTo(Array.IsArray(stor), 1) ThenBlock: {
            ReturnValue(AIMacro.TypedListCopy(src))
        }
        ReturnValue(src)
    }
}

Function.AIMacro.UserListNew {
    Input: iterable: Address
    Output: Address
    Body: {
        lst = AIMacro.EmptyList()
        IfCondition EqualTo(AIMacro.IsNone(iterable), 0) ThenBlock: {
            IfCondition NotEqual(iterable, 0) ThenBlock: {
                src = AIMacro.ListStorage(iterable)
                IfCondition EqualTo(Array.IsArray(src), 1) ThenBlock: {
                    ni = Array.Size(src)
                    ii = 0
                    WhileLoop LessThan(ii, ni) {
                        Array.Push(lst, Array.Get(src, ii))
                        ii = Add(ii, 1)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(AIMacro.LooksLikeString(iterable), 1) ThenBlock: {
                        IfCondition EqualTo(AIMacro.SafeIsHash(iterable), 0) ThenBlock: {
                            ni = StringLength(iterable)
                            ii = 0
                            WhileLoop LessThan(ii, ni) {
                                Array.Push(lst, AIMacro.Chr(GetByte(iterable, ii)))
                                ii = Add(ii, 1)
                            }
                        } ElseBlock: {
                            lst = AIMacro.ListFrom(iterable)
                        }
                    } ElseBlock: {
                        lst = AIMacro.ListFrom(iterable)
                    }
                }
            }
        }
        ReturnValue(AIMacro.WrapSeq(lst, "UserList"))
    }
}

Function.AIMacro.TripleFromArgs {
    Input: args: Address
    Input: n: Integer
    Output: Address
    Body: {
        out = AIMacro.EmptyList()
        IfCondition GreaterEqual(n, 3) ThenBlock: {
            Array.Push(out, Array.Get(args, 0))
            Array.Push(out, Array.Get(args, 1))
            Array.Push(out, Array.Get(args, 2))
            ReturnValue(out)
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            t = Array.Get(args, 0)
            stor = AIMacro.ListStorage(t)
            IfCondition EqualTo(Array.IsArray(stor), 1) ThenBlock: {
                IfCondition GreaterEqual(Array.Size(stor), 3) ThenBlock: {
                    Array.Push(out, Array.Get(stor, 0))
                    Array.Push(out, Array.Get(stor, 1))
                    Array.Push(out, Array.Get(stor, 2))
                    ReturnValue(out)
                }
            }
        }
        Array.Push(out, 0)
        Array.Push(out, 0)
        Array.Push(out, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.FloatHueMod {
    Input: hbits: Integer
    Output: Integer
    Body: {
        one = Float_FromInt(1)
        zero = Float_FromInt(0)
        hops = 0
        WhileLoop And(EqualTo(Float_Lt(hbits, zero), 1), LessThan(hops, 16)) {
            hbits = Float_Add(hbits, one)
            hops = Add(hops, 1)
        }
        hops = 0
        WhileLoop And(EqualTo(Float_Lt(hbits, one), 0), LessThan(hops, 16)) {
            hbits = Float_Sub(hbits, one)
            hops = Add(hops, 1)
        }
        ReturnValue(hbits)
    }
}

Function.AIMacro.FMax3 {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        m = a
        IfCondition EqualTo(Float_Lt(m, b), 1) ThenBlock: {
            m = b
        }
        IfCondition EqualTo(Float_Lt(m, c), 1) ThenBlock: {
            m = c
        }
        ReturnValue(m)
    }
}

Function.AIMacro.FMin3 {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        m = a
        IfCondition EqualTo(Float_Lt(b, m), 1) ThenBlock: {
            m = b
        }
        IfCondition EqualTo(Float_Lt(c, m), 1) ThenBlock: {
            m = c
        }
        ReturnValue(m)
    }
}

Function.AIMacro.FloatTriple {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Address
    Body: {
        arr = AIMacro.EmptyList()
        ba = AIMacro.FloatBox(a)
        bb = AIMacro.FloatBox(b)
        bc = AIMacro.FloatBox(c)
        Array.Push(arr, ba)
        Array.Push(arr, bb)
        Array.Push(arr, bc)
        ReturnValue(AIMacro.WrapSeq(arr, "tuple"))
    }
}

Function.AIMacro.RgbToHsvBits {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Address
    Body: {
        maxc = AIMacro.FMax3(r, g, b)
        minc = AIMacro.FMin3(r, g, b)
        rangec = Float_Sub(maxc, minc)
        v = maxc
        z0 = Float_FromInt(0)
        IfCondition EqualTo(Float_Eq(minc, maxc), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(z0, z0, v))
        }
        s = Float_Div(rangec, maxc)
        d1 = Float_Sub(maxc, r)
        d2 = Float_Sub(maxc, g)
        d3 = Float_Sub(maxc, b)
        rc = Float_Div(d1, rangec)
        gc = Float_Div(d2, rangec)
        bc = Float_Div(d3, rangec)
        h = 0
        two = Float_FromInt(2)
        four = Float_FromInt(4)
        IfCondition EqualTo(Float_Eq(r, maxc), 1) ThenBlock: {
            h = Float_Sub(bc, gc)
        } ElseBlock: {
            IfCondition EqualTo(Float_Eq(g, maxc), 1) ThenBlock: {
                t2 = Float_Add(two, rc)
                h = Float_Sub(t2, bc)
            } ElseBlock: {
                t4 = Float_Add(four, gc)
                h = Float_Sub(t4, rc)
            }
        }
        six = Float_FromInt(6)
        hd = Float_Div(h, six)
        h = AIMacro.FloatHueMod(hd)
        ReturnValue(AIMacro.FloatTriple(h, s, v))
    }
}

Function.AIMacro.HsvToRgbBits {
    Input: h: Integer
    Input: s: Integer
    Input: v: Integer
    Output: Address
    Body: {
        z0 = Float_FromInt(0)
        IfCondition EqualTo(Float_Eq(s, z0), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(v, v, v))
        }
        one = Float_FromInt(1)
        six = Float_FromInt(6)
        ht = Float_Mul(h, six)
        i = Float_ToInt(ht)
        fi = Float_FromInt(i)
        f = Float_Sub(ht, fi)
        oms = Float_Sub(one, s)
        p = Float_Mul(v, oms)
        sf = Float_Mul(s, f)
        omsf = Float_Sub(one, sf)
        q = Float_Mul(v, omsf)
        omf = Float_Sub(one, f)
        somf = Float_Mul(s, omf)
        omsomf = Float_Sub(one, somf)
        t = Float_Mul(v, omsomf)
        i = Modulo(i, 6)
        IfCondition EqualTo(i, 0) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(v, t, p))
        }
        IfCondition EqualTo(i, 1) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(q, v, p))
        }
        IfCondition EqualTo(i, 2) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(p, v, t))
        }
        IfCondition EqualTo(i, 3) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(p, q, v))
        }
        IfCondition EqualTo(i, 4) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(t, p, v))
        }
        ReturnValue(AIMacro.FloatTriple(v, p, q))
    }
}

Function.AIMacro.RgbToHlsBits {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Address
    Body: {
        maxc = AIMacro.FMax3(r, g, b)
        minc = AIMacro.FMin3(r, g, b)
        sumc = Float_Add(maxc, minc)
        rangec = Float_Sub(maxc, minc)
        two = Float_FromInt(2)
        l = Float_Div(sumc, two)
        z0 = Float_FromInt(0)
        IfCondition EqualTo(Float_Eq(minc, maxc), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(z0, l, z0))
        }
        s = 0
        halfp = AIMacro.FloatParse("0.5")
        half = AIMacro.ToFloatBits(halfp)
        IfCondition EqualTo(Float_Lt(l, half), 1) ThenBlock: {
            s = Float_Div(rangec, sumc)
        } ElseBlock: {
            den = Float_Sub(two, sumc)
            s = Float_Div(rangec, den)
        }
        d1 = Float_Sub(maxc, r)
        d2 = Float_Sub(maxc, g)
        d3 = Float_Sub(maxc, b)
        rc = Float_Div(d1, rangec)
        gc = Float_Div(d2, rangec)
        bc = Float_Div(d3, rangec)
        h = 0
        four = Float_FromInt(4)
        IfCondition EqualTo(Float_Eq(r, maxc), 1) ThenBlock: {
            h = Float_Sub(bc, gc)
        } ElseBlock: {
            IfCondition EqualTo(Float_Eq(g, maxc), 1) ThenBlock: {
                t2 = Float_Add(two, rc)
                h = Float_Sub(t2, bc)
            } ElseBlock: {
                t4 = Float_Add(four, gc)
                h = Float_Sub(t4, rc)
            }
        }
        six = Float_FromInt(6)
        hd = Float_Div(h, six)
        h = AIMacro.FloatHueMod(hd)
        ReturnValue(AIMacro.FloatTriple(h, l, s))
    }
}

Function.AIMacro.HlsV {
    Input: m1: Integer
    Input: m2: Integer
    Input: hue: Integer
    Output: Integer
    Body: {
        hue = AIMacro.FloatHueMod(hue)
        one = Float_FromInt(1)
        six = Float_FromInt(6)
        two = Float_FromInt(2)
        three = Float_FromInt(3)
        sixth = Float_Div(one, six)
        halfp = AIMacro.FloatParse("0.5")
        half = AIMacro.ToFloatBits(halfp)
        twoth = Float_Div(two, three)
        IfCondition EqualTo(Float_Lt(hue, sixth), 1) ThenBlock: {
            dm = Float_Sub(m2, m1)
            t1 = Float_Mul(dm, hue)
            t2 = Float_Mul(t1, six)
            ReturnValue(Float_Add(m1, t2))
        }
        IfCondition EqualTo(Float_Lt(hue, half), 1) ThenBlock: {
            ReturnValue(m2)
        }
        IfCondition EqualTo(Float_Lt(hue, twoth), 1) ThenBlock: {
            dm = Float_Sub(m2, m1)
            dh = Float_Sub(twoth, hue)
            t1 = Float_Mul(dm, dh)
            t2 = Float_Mul(t1, six)
            ReturnValue(Float_Add(m1, t2))
        }
        ReturnValue(m1)
    }
}

Function.AIMacro.HlsToRgbBits {
    Input: h: Integer
    Input: l: Integer
    Input: s: Integer
    Output: Address
    Body: {
        z0 = Float_FromInt(0)
        IfCondition EqualTo(Float_Eq(s, z0), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatTriple(l, l, l))
        }
        m2 = 0
        halfp = AIMacro.FloatParse("0.5")
        half = AIMacro.ToFloatBits(halfp)
        one = Float_FromInt(1)
        two = Float_FromInt(2)
        three = Float_FromInt(3)
        IfCondition EqualTo(Float_Lt(l, half), 1) ThenBlock: {
            osp = Float_Add(one, s)
            m2 = Float_Mul(l, osp)
        } ElseBlock: {
            ls = Float_Mul(l, s)
            sumls = Float_Add(l, s)
            m2 = Float_Sub(sumls, ls)
        }
        twol = Float_Mul(two, l)
        m1 = Float_Sub(twol, m2)
        oneth = Float_Div(one, three)
        hp = Float_Add(h, oneth)
        hm = Float_Sub(h, oneth)
        ra = AIMacro.HlsV(m1, m2, hp)
        ga = AIMacro.HlsV(m1, m2, h)
        ba = AIMacro.HlsV(m1, m2, hm)
        ReturnValue(AIMacro.FloatTriple(ra, ga, ba))
    }
}

Function.AIMacro.RgbToYiqBits {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Address
    Body: {
        p30 = AIMacro.FloatParse("0.30")
        p59 = AIMacro.FloatParse("0.59")
        p11 = AIMacro.FloatParse("0.11")
        p74 = AIMacro.FloatParse("0.74")
        p27 = AIMacro.FloatParse("0.27")
        p48 = AIMacro.FloatParse("0.48")
        p41 = AIMacro.FloatParse("0.41")
        c30 = AIMacro.ToFloatBits(p30)
        c59 = AIMacro.ToFloatBits(p59)
        c11 = AIMacro.ToFloatBits(p11)
        c74 = AIMacro.ToFloatBits(p74)
        c27 = AIMacro.ToFloatBits(p27)
        c48 = AIMacro.ToFloatBits(p48)
        c41 = AIMacro.ToFloatBits(p41)
        yr = Float_Mul(c30, r)
        yg = Float_Mul(c59, g)
        yb = Float_Mul(c11, b)
        yrg = Float_Add(yr, yg)
        y = Float_Add(yrg, yb)
        ry = Float_Sub(r, y)
        by = Float_Sub(b, y)
        ir = Float_Mul(c74, ry)
        ib = Float_Mul(c27, by)
        i = Float_Sub(ir, ib)
        qr = Float_Mul(c48, ry)
        qb = Float_Mul(c41, by)
        q = Float_Add(qr, qb)
        ReturnValue(AIMacro.FloatTriple(y, i, q))
    }
}

Function.AIMacro.YiqToRgbBits {
    Input: y: Integer
    Input: i: Integer
    Input: q: Integer
    Output: Address
    Body: {
        pci = AIMacro.FloatParse("0.9468822170900693")
        pcq = AIMacro.FloatParse("0.6235565819861433")
        pgi = AIMacro.FloatParse("0.27478764629897834")
        pgq = AIMacro.FloatParse("0.6356910791873801")
        pbi = AIMacro.FloatParse("1.1085450346420322")
        pbq = AIMacro.FloatParse("1.7090069284064666")
        ci = AIMacro.ToFloatBits(pci)
        cq = AIMacro.ToFloatBits(pcq)
        gi = AIMacro.ToFloatBits(pgi)
        gq = AIMacro.ToFloatBits(pgq)
        bi = AIMacro.ToFloatBits(pbi)
        bq = AIMacro.ToFloatBits(pbq)
        ri = Float_Mul(ci, i)
        rq = Float_Mul(cq, q)
        rsum = Float_Add(ri, rq)
        r = Float_Add(y, rsum)
        gi2 = Float_Mul(gi, i)
        gq2 = Float_Mul(gq, q)
        gsum = Float_Add(gi2, gq2)
        g = Float_Sub(y, gsum)
        bq2 = Float_Mul(bq, q)
        bi2 = Float_Mul(bi, i)
        bdiff = Float_Sub(bq2, bi2)
        b = Float_Add(y, bdiff)
        zero = Float_FromInt(0)
        one = Float_FromInt(1)
        IfCondition EqualTo(Float_Lt(r, zero), 1) ThenBlock: { r = zero }
        IfCondition EqualTo(Float_Lt(g, zero), 1) ThenBlock: { g = zero }
        IfCondition EqualTo(Float_Lt(b, zero), 1) ThenBlock: { b = zero }
        IfCondition EqualTo(Float_Lt(one, r), 1) ThenBlock: { r = one }
        IfCondition EqualTo(Float_Lt(one, g), 1) ThenBlock: { g = one }
        IfCondition EqualTo(Float_Lt(one, b), 1) ThenBlock: { b = one }
        ReturnValue(AIMacro.FloatTriple(r, g, b))
    }
}

Function.AIMacro.ColorsysDispatch {
    Input: kind: Address
    Input: args: Address
    Input: n: Integer
    Output: Address
    Body: {
        tri = AIMacro.TripleFromArgs(args, n)
        x = AIMacro.ToFloatBits(Array.Get(tri, 0))
        y = AIMacro.ToFloatBits(Array.Get(tri, 1))
        z = AIMacro.ToFloatBits(Array.Get(tri, 2))
        IfCondition EqualTo(StringCompare(kind, "hsv"), 0) ThenBlock: {
            ReturnValue(AIMacro.RgbToHsvBits(x, y, z))
        }
        IfCondition EqualTo(StringCompare(kind, "hsvr"), 0) ThenBlock: {
            ReturnValue(AIMacro.HsvToRgbBits(x, y, z))
        }
        IfCondition EqualTo(StringCompare(kind, "hls"), 0) ThenBlock: {
            ReturnValue(AIMacro.RgbToHlsBits(x, y, z))
        }
        IfCondition EqualTo(StringCompare(kind, "hlsr"), 0) ThenBlock: {
            ReturnValue(AIMacro.HlsToRgbBits(x, y, z))
        }
        IfCondition EqualTo(StringCompare(kind, "yiq"), 0) ThenBlock: {
            ReturnValue(AIMacro.RgbToYiqBits(x, y, z))
        }
        ReturnValue(AIMacro.YiqToRgbBits(x, y, z))
    }
}

Function.AIMacro.CopyRegPickle {
    Input: ob_type: Address
    Input: pickle_function: Address
    Input: n: Integer
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.IsCallableVal(pickle_function), 0) ThenBlock: {
            AIMacro.RaiseKind(5, "reduction functions must be callable")
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 3) ThenBlock: {
            ctor = Array.Get(args, 2)
            IfCondition And(NotEqual(ctor, 0), EqualTo(AIMacro.IsNone(ctor), 0)) ThenBlock: {
                IfCondition EqualTo(AIMacro.IsCallableVal(ctor), 0) ThenBlock: {
                    AIMacro.RaiseKind(5, "constructors must be callable")
                    ReturnValue(0)
                }
            }
        }
        ReturnValue(Types.GetNone())
    }
}

Function.AIMacro.CopyRegAddExt {
    Input: args: Address
    Input: n: Integer
    Output: Address
    Body: {
        AIMacro.CopyRegEnsure()
        IfCondition LessThan(n, 3) ThenBlock: {
            AIMacro.RaiseKind(5, "add_extension")
            ReturnValue(0)
        }
        mod = Array.Get(args, 0)
        func = Array.Get(args, 1)
        code = AIMacro.UnboxIntZero(Array.Get(args, 2))
        IfCondition Or(LessThan(code, 1), GreaterThan(code, 2147483647)) ThenBlock: {
            AIMacro.RaiseKind(2, "code out of range")
            ReturnValue(0)
        }
        tlst = AIMacro.EmptyList()
        Array.Push(tlst, mod)
        Array.Push(tlst, func)
        key = AIMacro.TupleKeyString(tlst)
        ck = NumberToString(code)
        havek = Hash.Contains(CopyRegState.registry, key)
        havec = Hash.Contains(CopyRegState.inverted, ck)
        IfCondition EqualTo(havek, 1) ThenBlock: {
            IfCondition And(EqualTo(Hash.Get(CopyRegState.registry, key), code), EqualTo(havec, 1)) ThenBlock: {
                ReturnValue(Types.GetNone())
            }
            AIMacro.RaiseKind(2, "already registered")
            ReturnValue(0)
        }
        IfCondition EqualTo(havec, 1) ThenBlock: {
            AIMacro.RaiseKind(2, "code already in use")
            ReturnValue(0)
        }
        Hash.Set(CopyRegState.registry, key, code)
        pair = AIMacro.WrapSeq(tlst, "tuple")
        Hash.Set(CopyRegState.inverted, ck, pair)
        ReturnValue(Types.GetNone())
    }
}

Function.AIMacro.CopyRegRemoveExt {
    Input: args: Address
    Input: n: Integer
    Output: Address
    Body: {
        AIMacro.CopyRegEnsure()
        IfCondition LessThan(n, 3) ThenBlock: {
            AIMacro.RaiseKind(2, "remove_extension")
            ReturnValue(0)
        }
        mod = Array.Get(args, 0)
        func = Array.Get(args, 1)
        code = AIMacro.UnboxIntZero(Array.Get(args, 2))
        tlst = AIMacro.EmptyList()
        Array.Push(tlst, mod)
        Array.Push(tlst, func)
        key = AIMacro.TupleKeyString(tlst)
        ck = NumberToString(code)
        IfCondition EqualTo(Hash.Contains(CopyRegState.registry, key), 0) ThenBlock: {
            AIMacro.RaiseKind(2, "not registered")
            ReturnValue(0)
        }
        IfCondition NotEqual(Hash.Get(CopyRegState.registry, key), code) ThenBlock: {
            AIMacro.RaiseKind(2, "not registered")
            ReturnValue(0)
        }
        Hash.Delete(CopyRegState.registry, key)
        Hash.Delete(CopyRegState.inverted, ck)
        ReturnValue(Types.GetNone())
    }
}

Function.AIMacro.CopyRegPushSlot {
    Input: names: Address
    Input: name: Address
    Input: cls: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.LooksLikeString(name), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "__dict__"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "__weakref__"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition And(EqualTo(GetByte(name, 0), 95), EqualTo(GetByte(name, 1), 95)) ThenBlock: {
            ln = StringLength(name)
            IfCondition And(GreaterThan(ln, 2), NotEqual(GetByte(name, Subtract(ln, 1)), 95)) ThenBlock: {
                stripped = cls
                IfCondition EqualTo(AIMacro.LooksLikeString(cls), 1) ThenBlock: {
                    si = 0
                    WhileLoop EqualTo(GetByte(cls, si), 95) {
                        si = Add(si, 1)
                    }
                    IfCondition GreaterThan(si, 0) ThenBlock: {
                        stripped = Allocate(Add(StringLength(cls), 1))
                        pi = 0
                        WhileLoop NotEqual(GetByte(cls, Add(si, pi)), 0) {
                            SetByte(stripped, pi, GetByte(cls, Add(si, pi)))
                            pi = Add(pi, 1)
                        }
                        SetByte(stripped, pi, 0)
                    }
                }
                IfCondition NotEqual(GetByte(stripped, 0), 0) ThenBlock: {
                    mangled = StringConcat("_", stripped)
                    mangled = StringConcat(mangled, name)
                    Array.Push(names, mangled)
                    ReturnValue(1)
                }
            }
        }
        Array.Push(names, name)
        ReturnValue(1)
    }
}

Function.AIMacro.CopyRegSlotnames {
    Input: cls: Address
    Output: Address
    Body: {
        names = AIMacro.EmptyList()
        current = cls
        IfCondition EqualTo(AIMacro.SafeIsHash(cls), 1) ThenBlock: {
            current = Hash.Get(cls, "__class__")
        }
        hops = 0
        WhileLoop And(NotEqual(current, 0), LessThan(hops, 16)) {
            slots = AIMacro.ClassAttrGet(current, "__slots__")
            IfCondition NotEqual(slots, 0) ThenBlock: {
                IfCondition EqualTo(AIMacro.LooksLikeString(slots), 1) ThenBlock: {
                    IfCondition EqualTo(AIMacro.SafeIsHash(slots), 0) ThenBlock: {
                        AIMacro.CopyRegPushSlot(names, slots, current)
                    }
                }
                stor = AIMacro.ListStorage(slots)
                IfCondition EqualTo(Array.IsArray(stor), 1) ThenBlock: {
                    si = 0
                    WhileLoop LessThan(si, Array.Size(stor)) {
                        AIMacro.CopyRegPushSlot(names, Array.Get(stor, si), current)
                        si = Add(si, 1)
                    }
                }
            }
            current = OOP.ClassGetParent(current)
            hops = Add(hops, 1)
        }
        ReturnValue(names)
    }
}


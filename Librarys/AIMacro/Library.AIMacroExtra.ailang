Function.AIMacro.MethodCall {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(method_name, "assertRaises"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                exc = 0
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    exc = Array.Get(args, 0)
                }
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                Hash.Set(cm, "exc", exc)
                ReturnValue(cm)
            }
            exc = Array.Get(args, 0)
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, exc, func, fnargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "assertWarns"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__warns__", 1)
                ReturnValue(cm)
            }
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            AIMacro.SmartCallN(func, fnargs)
            ReturnValue(1)
        }
        func_addr = 0
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            func_addr = OOP.MethodLookup(obj, method_name)
        }
        IfCondition EqualTo(StringCompare(method_name, "substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSub(obj, a0s))
        }
        IfCondition EqualTo(StringCompare(method_name, "safe_substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSafeSub(obj, a0s))
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            fn = AIMacro.ObjectGet(obj, method_name)
            IfCondition NotEqual(fn, 0) ThenBlock: {
                ReturnValue(AIMacro.SmartCallN(fn, args))
            }
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(AIMacro.MethodShim(obj, method_name, args))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        num_args = Array.Size(args)
        IfCondition EqualTo(num_args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        arg0 = Array.Get(args, 0)
        IfCondition EqualTo(arg0, 0) ThenBlock: {
            arg0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 1) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0))
        }
        arg1 = Array.Get(args, 1)
        IfCondition EqualTo(arg1, 0) ThenBlock: {
            arg1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 2) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1))
        }
        arg2 = Array.Get(args, 2)
        IfCondition EqualTo(arg2, 0) ThenBlock: {
            arg2 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 3) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2))
        }
        arg3 = Array.Get(args, 3)
        IfCondition EqualTo(arg3, 0) ThenBlock: {
            arg3 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 4) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3))
        }
        arg4 = Array.Get(args, 4)
        IfCondition EqualTo(arg4, 0) ThenBlock: {
            arg4 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3, arg4))
    }
}

Function.AIMacro.SmartCall {
    Input: fn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            empty = AIMacro.EmptyList()
            ReturnValue(AIMacro.SmartCallN(fn, empty))
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        ReturnValue(CallIndirect(fn))
    }
}

Function.AIMacro.SmartCall1 {
    Input: fn: Address
    Input: arg: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            a = AIMacro.EmptyList()
            Array.Push(a, arg)
            ReturnValue(AIMacro.SmartCallN(fn, a))
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        carg = arg
        IfCondition EqualTo(carg, 0) ThenBlock: {
            carg = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, carg))
    }
}

Function.AIMacro.SmartCall2 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCall3 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Input: a2: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        Array.Push(a, a2)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCallN {
    Input: fn: Address
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(AIMacro.ListFrom(args))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            args = AIMacro.EmptyList()
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(fn, "__opshim__"), 0) ThenBlock: {
                ReturnValue(AIMacro.CallOpShim(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__bound__"), 0) ThenBlock: {
                bobj = Hash.Get(fn, "obj")
                bname = Hash.Get(fn, "name")
                ReturnValue(AIMacro.MethodCall(bobj, bname, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__methodcaller__"), 0) ThenBlock: {
                nmc = Array.Size(args)
                IfCondition LessThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                IfCondition GreaterThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                mcobj = Array.Get(args, 0)
                mcname = Hash.Get(fn, "name")
                mcargs = Hash.Get(fn, "args")
                ReturnValue(AIMacro.MethodCall(mcobj, mcname, mcargs))
            }
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            is_enum_cls = 0
            walk_e = fn
            eh_e = 0
            WhileLoop LessThan(eh_e, 16) {
                IfCondition EqualTo(walk_e, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(StringCompare(walk_e, "enumerate"), 0) ThenBlock: {
                    is_enum_cls = 1
                    BreakLoop
                }
                walk_e = OOP.ClassGetParent(walk_e)
                eh_e = Add(eh_e, 1)
            }
            IfCondition EqualTo(is_enum_cls, 1) ThenBlock: {
                ns_e = 0
                IfCondition NotEqual(args, 0) ThenBlock: {
                    ns_e = Array.Size(args)
                }
                src_e = 0
                st_e = 0
                IfCondition GreaterThan(ns_e, 0) ThenBlock: {
                    src_e = Array.Get(args, 0)
                }
                IfCondition GreaterThan(ns_e, 1) ThenBlock: {
                    st_e = Array.Get(args, 1)
                    v0_it = AIMacro.LooksIterable(src_e)
                    v1_it = AIMacro.LooksIterable(st_e)
                    IfCondition EqualTo(v0_it, 0) ThenBlock: {
                        IfCondition EqualTo(v1_it, 1) ThenBlock: {
                            tmp_e = src_e
                            src_e = st_e
                            st_e = tmp_e
                        }
                    }
                }
                enu_e = AIMacro.EnumerateFrom(src_e, AIMacro.UnboxIntZero(st_e))
                Hash.Set(enu_e, "__class__", fn)
                ReturnValue(enu_e)
            }
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        si = 0
        ns0 = Array.Size(args)
        WhileLoop LessThan(si, ns0) {
            IfCondition EqualTo(Array.Get(args, si), AddressOf(AIMacro.KwArgError)) ThenBlock: {
                AIMacro.RaiseKind(5, "keyword argument")
                ReturnValue(0)
            }
            si = Add(si, 1)
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
            IfCondition NotEqual(Array.Size(args), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.Enumerate)) ThenBlock: {
            ns = Array.Size(args)
            IfCondition Or(EqualTo(ns, 0), GreaterThan(ns, 2)) ThenBlock: {
                AIMacro.RaiseKind(5, "enumerate")
                ReturnValue(0)
            }
            IfCondition EqualTo(ns, 2) ThenBlock: {
                ReturnValue(AIMacro.Enumerate2(Array.Get(args, 0), Array.Get(args, 1)))
            }
        }
        n = Array.Size(args)
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
            ReturnValue(CallIndirect(fn))
        }
        a0 = Array.Get(args, 0)
        IfCondition EqualTo(a0, 0) ThenBlock: {
            a0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0))
        }
        a1 = Array.Get(args, 1)
        IfCondition EqualTo(a1, 0) ThenBlock: {
            a1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0, a1))
        }
        a2 = Array.Get(args, 2)
        IfCondition EqualTo(a2, 0) ThenBlock: {
            a2 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, a0, a1, a2))
    }
}

Function.AIMacro.PyType {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            cls = Hash.Get(obj, "__class__")
            IfCondition NotEqual(cls, 0) ThenBlock: {
                ReturnValue(cls)
            }
            ReturnValue("dict")
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue("list")
        }
        ReturnValue(Types.TypeOf(obj))
    }
}

Function.AIMacro.StringWhitespace {
    Output: Address
    Body: {
        s = Allocate(7)
        SetByte(s, 0, 32)
        SetByte(s, 1, 9)
        SetByte(s, 2, 10)
        SetByte(s, 3, 13)
        SetByte(s, 4, 11)
        SetByte(s, 5, 12)
        SetByte(s, 6, 0)
        ReturnValue(s)
    }
}

Function.AIMacro.TemplateNew {
    Input: tmpl: Address
    Output: Address
    Body: {
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "Template")
        Hash.Set(h, "template", tmpl)
        ReturnValue(h)
    }
}

Function.AIMacro.TemplateSub {
    Input: obj: Address
    Input: mapping: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.TemplateSubMode(obj, mapping, 0))
    }
}

Function.AIMacro.TemplateSafeSub {
    Input: obj: Address
    Input: mapping: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.TemplateSubMode(obj, mapping, 1))
    }
}

Function.AIMacro.TemplateSubMode {
    Input: obj: Address
    Input: mapping: Address
    Input: safe: Integer
    Output: Address
    Body: {
        tmpl = AIMacro.ObjectGet(obj, "template")
        IfCondition EqualTo(tmpl, 0) ThenBlock: {
            tmpl = obj
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(tmpl), 0) ThenBlock: {
            ReturnValue(tmpl)
        }
        IfCondition EqualTo(Hash.IsHash(mapping), 0) ThenBlock: {
            IfCondition EqualTo(safe, 0) ThenBlock: {
                AIMacro.RaiseKind(5, "substitute")
            }
            mapping = Hash.Create(4)
        }
        n = StringLength(tmpl)
        out = Allocate(Add(Multiply(n, 8), 1))
        oi = 0
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(tmpl, i)
            IfCondition EqualTo(ch, 36) ThenBlock: {
                IfCondition GreaterEqual(Add(i, 1), n) ThenBlock: {
                    IfCondition EqualTo(safe, 0) ThenBlock: {
                        AIMacro.RaiseKind(2, "invalid placeholder")
                        ReturnValue(tmpl)
                    }
                    SetByte(out, oi, 36)
                    oi = Add(oi, 1)
                    i = Add(i, 1)
                } ElseBlock: {
                nx = GetByte(tmpl, Add(i, 1))
                IfCondition EqualTo(nx, 36) ThenBlock: {
                    SetByte(out, oi, 36)
                    oi = Add(oi, 1)
                    i = Add(i, 2)
                } ElseBlock: {
                    braced = 0
                    i = Add(i, 1)
                    IfCondition EqualTo(nx, 123) ThenBlock: {
                        braced = 1
                        i = Add(i, 1)
                    }
                    key = Allocate(64)
                    ki = 0
                    WhileLoop LessThan(i, n) {
                        ch = GetByte(tmpl, i)
                        IfCondition And(EqualTo(braced, 1), EqualTo(ch, 125)) ThenBlock: {
                            BreakLoop
                        }
                        ok = 0
                        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                            ok = 1
                        }
                        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
                            ok = 1
                        }
                        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                            ok = 1
                        }
                        IfCondition EqualTo(ch, 95) ThenBlock: {
                            ok = 1
                        }
                        IfCondition EqualTo(ok, 0) ThenBlock: {
                            BreakLoop
                        }
                        SetByte(key, ki, ch)
                        ki = Add(ki, 1)
                        i = Add(i, 1)
                    }
                    SetByte(key, ki, 0)
                    IfCondition EqualTo(braced, 1) ThenBlock: {
                        IfCondition And(LessThan(i, n), EqualTo(GetByte(tmpl, i), 125)) ThenBlock: {
                            i = Add(i, 1)
                        }
                    }
                    IfCondition EqualTo(ki, 0) ThenBlock: {
                        IfCondition EqualTo(safe, 0) ThenBlock: {
                            AIMacro.RaiseKind(2, "invalid placeholder")
                            ReturnValue(tmpl)
                        }
                        SetByte(out, oi, 36)
                        oi = Add(oi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(Hash.Contains(mapping, key), 0) ThenBlock: {
                            IfCondition EqualTo(safe, 0) ThenBlock: {
                                AIMacro.RaiseKind(15, key)
                                ReturnValue(tmpl)
                            }
                            SetByte(out, oi, 36)
                            oi = Add(oi, 1)
                            IfCondition EqualTo(braced, 1) ThenBlock: {
                                SetByte(out, oi, 123)
                                oi = Add(oi, 1)
                            }
                            vi = 0
                            WhileLoop LessThan(vi, ki) {
                                SetByte(out, oi, GetByte(key, vi))
                                oi = Add(oi, 1)
                                vi = Add(vi, 1)
                            }
                            IfCondition EqualTo(braced, 1) ThenBlock: {
                                SetByte(out, oi, 125)
                                oi = Add(oi, 1)
                            }
                        } ElseBlock: {
                            val = Hash.Get(mapping, key)
                            IfCondition EqualTo(AIMacro.LooksLikeString(val), 0) ThenBlock: {
                                val = AIMacro.Str(val)
                            }
                            vi = 0
                            vn = StringLength(val)
                            WhileLoop LessThan(vi, vn) {
                                SetByte(out, oi, GetByte(val, vi))
                                oi = Add(oi, 1)
                                vi = Add(vi, 1)
                            }
                        }
                    }
                }
                }
            } ElseBlock: {
                SetByte(out, oi, ch)
                i = Add(i, 1)
                oi = Add(oi, 1)
            }
        }
        SetByte(out, oi, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.CapitalizeWord {
    Input: w: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.LooksLikeString(w), 0) ThenBlock: {
            ReturnValue(w)
        }
        n = StringLength(w)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(w)
        }
        out = Allocate(Add(n, 1))
        ch = GetByte(w, 0)
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
            ch = Subtract(ch, 32)
        }
        SetByte(out, 0, ch)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = GetByte(w, i)
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                ch = Add(ch, 32)
            }
            SetByte(out, i, ch)
            i = Add(i, 1)
        }
        SetByte(out, n, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.CapWords {
    Input: s: Address
    Input: sep: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.LooksLikeString(s), 0) ThenBlock: {
            ReturnValue(s)
        }
        n = StringLength(s)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(s)
        }
        use_ws = 1
        sep_len = 0
        IfCondition And(NotEqual(sep, 0), EqualTo(AIMacro.IsNone(sep), 0)) ThenBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(sep), 1) ThenBlock: {
                sep_len = StringLength(sep)
                IfCondition GreaterThan(sep_len, 0) ThenBlock: {
                    use_ws = 0
                }
            }
        }
        parts = Array.Create(8)
        IfCondition EqualTo(use_ws, 1) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, n) {
                ch = GetByte(s, i)
                ws = 0
                IfCondition Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), Or(EqualTo(ch, 10), Or(EqualTo(ch, 11), Or(EqualTo(ch, 12), EqualTo(ch, 13)))))) ThenBlock: {
                    ws = 1
                }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    start = i
                    WhileLoop LessThan(i, n) {
                        ch = GetByte(s, i)
                        ws = 0
                        IfCondition Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), Or(EqualTo(ch, 10), Or(EqualTo(ch, 11), Or(EqualTo(ch, 12), EqualTo(ch, 13)))))) ThenBlock: {
                            ws = 1
                        }
                        IfCondition EqualTo(ws, 1) ThenBlock: {
                            BreakLoop
                        }
                        i = Add(i, 1)
                    }
                    wlen = Subtract(i, start)
                    w = Allocate(Add(wlen, 1))
                    k = 0
                    WhileLoop LessThan(k, wlen) {
                        SetByte(w, k, GetByte(s, Add(start, k)))
                        k = Add(k, 1)
                    }
                    SetByte(w, wlen, 0)
                    Array.Push(parts, AIMacro.CapitalizeWord(w))
                }
            }
            ReturnValue(String.Join(" ", parts))
        }
        i = 0
        last = 0
        WhileLoop LessThan(i, n) {
            matched = 1
            k = 0
            WhileLoop LessThan(k, sep_len) {
                IfCondition GreaterEqual(Add(i, k), n) ThenBlock: {
                    matched = 0
                } ElseBlock: {
                    IfCondition NotEqual(GetByte(s, Add(i, k)), GetByte(sep, k)) ThenBlock: {
                        matched = 0
                    }
                }
                k = Add(k, 1)
            }
            IfCondition EqualTo(matched, 1) ThenBlock: {
                wlen = Subtract(i, last)
                w = Allocate(Add(wlen, 1))
                k = 0
                WhileLoop LessThan(k, wlen) {
                    SetByte(w, k, GetByte(s, Add(last, k)))
                    k = Add(k, 1)
                }
                SetByte(w, wlen, 0)
                Array.Push(parts, AIMacro.CapitalizeWord(w))
                i = Add(i, sep_len)
                last = i
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        wlen = Subtract(n, last)
        w = Allocate(Add(wlen, 1))
        k = 0
        WhileLoop LessThan(k, wlen) {
            SetByte(w, k, GetByte(s, Add(last, k)))
            k = Add(k, 1)
        }
        SetByte(w, wlen, 0)
        Array.Push(parts, AIMacro.CapitalizeWord(w))
        ReturnValue(String.Join(sep, parts))
    }
}

Function.AIMacro.FormatterVFormat {
    Input: self: Address
    Input: args: Address
    Output: Address
    Body: {
        n = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            n = Array.Size(args)
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            AIMacro.RaiseKind(5, "format")
            ReturnValue(0)
        }
        fmt = Array.Get(args, 0)
        pos0 = 1
        IfCondition EqualTo(Hash.IsHash(self), 0) ThenBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(self), 1) ThenBlock: {
                fmt = self
                pos0 = 0
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fmt), 0) ThenBlock: {
            AIMacro.RaiseKind(5, "format")
            ReturnValue(0)
        }
        flen = StringLength(fmt)
        out = Allocate(Add(Multiply(flen, 8), 64))
        oi = 0
        i = 0
        auto_i = 0
        used_auto = 0
        used_num = 0
        WhileLoop LessThan(i, flen) {
            ch = GetByte(fmt, i)
            IfCondition EqualTo(ch, 123) ThenBlock: {
                IfCondition And(LessThan(Add(i, 1), flen), EqualTo(GetByte(fmt, Add(i, 1)), 123)) ThenBlock: {
                    SetByte(out, oi, 123)
                    oi = Add(oi, 1)
                    i = Add(i, 2)
                } ElseBlock: {
                    i = Add(i, 1)
                    field = Allocate(128)
                    fi = 0
                    conv = 0
                    WhileLoop LessThan(i, flen) {
                        ch = GetByte(fmt, i)
                        IfCondition EqualTo(ch, 125) ThenBlock: {
                            BreakLoop
                        }
                        IfCondition EqualTo(ch, 33) ThenBlock: {
                            i = Add(i, 1)
                            IfCondition LessThan(i, flen) ThenBlock: {
                                conv = GetByte(fmt, i)
                                i = Add(i, 1)
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(ch, 58) ThenBlock: {
                                i = Add(i, 1)
                                WhileLoop LessThan(i, flen) {
                                    IfCondition EqualTo(GetByte(fmt, i), 125) ThenBlock: {
                                        BreakLoop
                                    }
                                    i = Add(i, 1)
                                }
                                BreakLoop
                            } ElseBlock: {
                                SetByte(field, fi, ch)
                                fi = Add(fi, 1)
                                i = Add(i, 1)
                            }
                        }
                    }
                    SetByte(field, fi, 0)
                    IfCondition And(LessThan(i, flen), EqualTo(GetByte(fmt, i), 125)) ThenBlock: {
                        i = Add(i, 1)
                    }
                    val = 0
                    IfCondition EqualTo(fi, 0) ThenBlock: {
                        IfCondition EqualTo(used_num, 1) ThenBlock: {
                            AIMacro.RaiseKind(2, "format")
                            ReturnValue(fmt)
                        }
                        used_auto = 1
                        idx = Add(auto_i, pos0)
                        auto_i = Add(auto_i, 1)
                        IfCondition GreaterEqual(idx, n) ThenBlock: {
                            AIMacro.RaiseKind(17, "format")
                            ReturnValue(fmt)
                        }
                        val = Array.Get(args, idx)
                    } ElseBlock: {
                        dot_at = Subtract(0, 1)
                        br_at = Subtract(0, 1)
                        pi = 0
                        WhileLoop LessThan(pi, fi) {
                            c = GetByte(field, pi)
                            IfCondition And(EqualTo(c, 46), LessThan(dot_at, 0)) ThenBlock: {
                                dot_at = pi
                            }
                            IfCondition And(EqualTo(c, 91), LessThan(br_at, 0)) ThenBlock: {
                                br_at = pi
                            }
                            pi = Add(pi, 1)
                        }
                        base_end = fi
                        IfCondition GreaterEqual(dot_at, 0) ThenBlock: {
                            base_end = dot_at
                        }
                        IfCondition And(GreaterEqual(br_at, 0), LessThan(br_at, base_end)) ThenBlock: {
                            base_end = br_at
                        }
                        is_num = 1
                        vi = 0
                        IfCondition EqualTo(base_end, 0) ThenBlock: {
                            is_num = 0
                        }
                        pi = 0
                        WhileLoop LessThan(pi, base_end) {
                            c = GetByte(field, pi)
                            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                                is_num = 0
                            }
                            vi = Add(Multiply(vi, 10), Subtract(c, 48))
                            pi = Add(pi, 1)
                        }
                        IfCondition EqualTo(is_num, 1) ThenBlock: {
                            IfCondition EqualTo(used_auto, 1) ThenBlock: {
                                AIMacro.RaiseKind(2, "format")
                                ReturnValue(fmt)
                            }
                            used_num = 1
                            idx = Add(vi, pos0)
                            IfCondition GreaterEqual(idx, n) ThenBlock: {
                                AIMacro.RaiseKind(17, "format")
                                ReturnValue(fmt)
                            }
                            val = Array.Get(args, idx)
                        } ElseBlock: {
                            AIMacro.RaiseKind(15, field)
                            ReturnValue(fmt)
                        }
                        IfCondition GreaterEqual(br_at, 0) ThenBlock: {
                            bi = Add(br_at, 1)
                            bidx = 0
                            WhileLoop LessThan(bi, fi) {
                                c = GetByte(field, bi)
                                IfCondition EqualTo(c, 93) ThenBlock: {
                                    BreakLoop
                                }
                                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                                    bidx = Add(Multiply(bidx, 10), Subtract(c, 48))
                                }
                                bi = Add(bi, 1)
                            }
                            IfCondition EqualTo(Array.IsArray(val), 1) ThenBlock: {
                                IfCondition Or(LessThan(bidx, 0), GreaterEqual(bidx, Array.Size(val))) ThenBlock: {
                                    AIMacro.RaiseKind(17, "format")
                                    ReturnValue(fmt)
                                }
                                val = Array.Get(val, bidx)
                            }
                        }
                        IfCondition GreaterEqual(dot_at, 0) ThenBlock: {
                            attr = Allocate(64)
                            ai = 0
                            pi = Add(dot_at, 1)
                            WhileLoop LessThan(pi, fi) {
                                c = GetByte(field, pi)
                                IfCondition EqualTo(c, 91) ThenBlock: {
                                    BreakLoop
                                }
                                SetByte(attr, ai, c)
                                ai = Add(ai, 1)
                                pi = Add(pi, 1)
                            }
                            SetByte(attr, ai, 0)
                            val = AIMacro.ObjectGet(val, attr)
                        }
                    }
                    IfCondition EqualTo(OOP.MethodExists(self, "convert_field"), 1) ThenBlock: {
                        cargs = Array.Create(2)
                        Array.Push(cargs, val)
                        Array.Push(cargs, conv)
                        val = OOP.MethodCall(self, "convert_field", cargs)
                    }
                    sval = 0
                    IfCondition EqualTo(conv, 114) ThenBlock: {
                        sval = AIMacro.Repr(val)
                    } ElseBlock: {
                        IfCondition EqualTo(conv, 97) ThenBlock: {
                            sval = AIMacro.Repr(val)
                        } ElseBlock: {
                            IfCondition EqualTo(OOP.MethodExists(self, "format_field"), 1) ThenBlock: {
                                fargs = Array.Create(2)
                                Array.Push(fargs, val)
                                Array.Push(fargs, "")
                                sval = OOP.MethodCall(self, "format_field", fargs)
                            } ElseBlock: {
                                sval = AIMacro.Str(val)
                            }
                        }
                    }
                    IfCondition EqualTo(AIMacro.LooksLikeString(sval), 0) ThenBlock: {
                        sval = AIMacro.Str(sval)
                    }
                    vn = StringLength(sval)
                    vi = 0
                    WhileLoop LessThan(vi, vn) {
                        SetByte(out, oi, GetByte(sval, vi))
                        oi = Add(oi, 1)
                        vi = Add(vi, 1)
                    }
                }
            } ElseBlock: {
                IfCondition EqualTo(ch, 125) ThenBlock: {
                    IfCondition And(LessThan(Add(i, 1), flen), EqualTo(GetByte(fmt, Add(i, 1)), 125)) ThenBlock: {
                        SetByte(out, oi, 125)
                        oi = Add(oi, 1)
                        i = Add(i, 2)
                    } ElseBlock: {
                        AIMacro.RaiseKind(2, "format")
                        ReturnValue(fmt)
                    }
                } ElseBlock: {
                    SetByte(out, oi, ch)
                    oi = Add(oi, 1)
                    i = Add(i, 1)
                }
            }
        }
        SetByte(out, oi, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.StartFile {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.OsExists(path), 0) ThenBlock: {
            AIMacro.RaiseKind(3, "startfile")
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.AssertPythonOk {
    Input: script: Address
    Output: Address
    Body: {
        a = Array.Create(4)
        Array.Push(a, 0)
        Array.Push(a, "")
        Array.Push(a, "usage: reindent")
        ReturnValue(a)
    }
}

Function.AIMacro.WrapGenStop {
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.ExcKind(), 9) ThenBlock: {
                old = AIMacro.ExcValue()
                AIMacro.ExcClear()
                AIMacro.RaiseKind(6, "generator raised StopIteration")
                val = AIMacro.ExcValue()
                IfCondition EqualTo(Hash.IsHash(val), 1) ThenBlock: {
                    Hash.Set(val, "__cause__", old)
                    Hash.Set(val, "__context__", old)
                    Hash.Set(val, "__suppress_context__", AIMacro.TrueVal())
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.OsOpenpty {
    Output: Address
    Body: {
        master = SystemCall(2, "/dev/ptmx", 2, 0)
        IfCondition LessThan(master, 0) ThenBlock: {
            AIMacro.RaiseKind(3, "openpty")
            ReturnValue(AIMacro.EmptyList())
        }
        lock = Allocate(8)
        StoreValue(lock, 0)
        lck = Add(Multiply(16388, 65536), 21553)
        SystemCall(16, master, lck, lock)
        ptn = Allocate(8)
        StoreValue(ptn, 0)
        cmd = Add(Multiply(32772, 65536), 21552)
        SystemCall(16, master, cmd, ptn)
        n = Dereference(ptn)
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        path = StringConcat("/dev/pts/", NumberToString(n))
        slave = SystemCall(2, path, 2050, 0)
        IfCondition LessThan(slave, 0) ThenBlock: {
            slave = SystemCall(2, path, 2, 0)
        }
        IfCondition LessThan(slave, 0) ThenBlock: {
            SystemCall(3, master)
            AIMacro.RaiseKind(3, "openpty")
            ReturnValue(AIMacro.EmptyList())
        }
        out = AIMacro.ArrayNew(2)
        Array.Push(out, master)
        Array.Push(out, slave)
        ReturnValue(out)
    }
}

Function.AIMacro.OsClose {
    Input: fd: Integer
    Output: Integer
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.OsWrite {
    Input: fd: Integer
    Input: data: Address
    Output: Integer
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition Or(LessThan(fd, 0), EqualTo(data, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(SystemCall(1, fd, data, StringLength(data)))
    }
}

Function.AIMacro.OsRead {
    Input: fd: Integer
    Input: n: Integer
    Output: Address
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        n = AIMacro.UnboxIntZero(n)
        IfCondition LessThan(n, 1) ThenBlock: {
            n = 1
        }
        IfCondition GreaterThan(n, 65536) ThenBlock: {
            n = 65536
        }
        buf = Allocate(Add(n, 1))
        got = 0
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            got = SystemCall(0, fd, buf, n)
        }
        IfCondition LessThan(got, 0) ThenBlock: {
            got = 0
        }
        SetByte(buf, got, 0)
        ReturnValue(buf)
    }
}

Function.AIMacro.OsIsatty {
    Input: fd: Integer
    Output: Address
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        term = Allocate(256)
        rc = SystemCall(16, fd, 21505, term)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.PyCompile {
    Input: src: Address
    Input: filename: Address
    Input: mode: Address
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__src__", src)
        ReturnValue(h)
    }
}

Function.AIMacro.Exec {
    Input: src: Address
    Input: ns: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(src), 1) ThenBlock: {
            src = Hash.Get(src, "__src__")
        }
        IfCondition EqualTo(src, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Types.IsString(src), 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(src)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), And(NotEqual(ch, 9), NotEqual(ch, 10))) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        // skip comments / coding cookies
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(src, i), 35) ThenBlock: {
                WhileLoop And(LessThan(i, n), NotEqual(GetByte(src, i), 10)) {
                    i = Add(i, 1)
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    i = Add(i, 1)
                }
            } ElseBlock: {
                BreakLoop
            }
        }
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), And(NotEqual(ch, 9), NotEqual(ch, 10))) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        ident = Allocate(64)
        ilen = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            ok = 0
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ok = 1 }
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ok = 1 }
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ch, 95) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition LessThan(ilen, 62) ThenBlock: {
                SetByte(ident, ilen, ch)
                ilen = Add(ilen, 1)
            }
            i = Add(i, 1)
        }
        SetByte(ident, ilen, 0)
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.KeywordIsKeyword(ident)), 1) ThenBlock: {
            AIMacro.RaiseKind(24, "invalid syntax")
            ReturnValue(0)
        }
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        IfCondition And(LessThan(i, n), EqualTo(GetByte(src, i), 61)) ThenBlock: {
            i = Add(i, 1)
            WhileLoop LessThan(i, n) {
                ch = GetByte(src, i)
                IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, 1)
            }
            IfCondition And(LessThan(i, n), Or(EqualTo(GetByte(src, i), 34), EqualTo(GetByte(src, i), 39))) ThenBlock: {
                q = GetByte(src, i)
                i = Add(i, 1)
                vbuf = Allocate(Add(n, 1))
                vlen = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(src, i)
                    IfCondition EqualTo(ch, q) ThenBlock: {
                        BreakLoop
                    }
                    SetByte(vbuf, vlen, ch)
                    vlen = Add(vlen, 1)
                    i = Add(i, 1)
                }
                SetByte(vbuf, vlen, 0)
                IfCondition EqualTo(Hash.IsHash(ns), 1) ThenBlock: {
                    Hash.Set(ns, ident, vbuf)
                }
            }
        }
        ReturnValue(0)
    }
}

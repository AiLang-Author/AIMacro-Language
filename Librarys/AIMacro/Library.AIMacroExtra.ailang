                ci = 0
                WhileLoop LessThan(ci, Array.Size(stor)) {
                    IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(Array.Get(stor, ci), a0)), 1) ThenBlock: {
                        c = Add(c, 1)
                    }
                    ci = Add(ci, 1)
                }
                IfCondition EqualTo(c, 0) ThenBlock: {
                    ReturnValue(AIMacro.IntZero())
                }
                ReturnValue(c)
            }
            ReturnValue(AIMacro.IntZero())
        }
        IfCondition EqualTo(StringCompare(method_name, "remove"), 0) ThenBlock: {
            stor = AIMacro.ListStorage(obj)
            IfCondition EqualTo(Array.IsArray(stor), 1) ThenBlock: {
                ri = 0
                WhileLoop LessThan(ri, Array.Size(stor)) {
                    IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(Array.Get(stor, ri), a0)), 1) ThenBlock: {
                        Array.Delete(stor, ri)
                        ReturnValue(Types.GetNone())
                    }
                    ri = Add(ri, 1)
                }
                AIMacro.RaiseKind(2, "ValueError")
                ReturnValue(0)
            }
            ReturnValue(0)
        }
        IfCondition And(GreaterThan(n, 0), EqualTo(Hash.IsHash(a0), 1)) ThenBlock: {
            rest = AIMacro.EmptyList()
            Array.Push(rest, a1)
            IfCondition EqualTo(StringCompare(method_name, "iadd"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__iadd__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "iand"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__iand__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "ifloordiv"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__ifloordiv__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "ilshift"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__ilshift__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "imod"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__imod__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "imul"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__imul__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "imatmul"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__imatmul__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "ior"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__ior__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "ipow"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__ipow__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "irshift"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__irshift__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "isub"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__isub__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "itruediv"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__itruediv__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "ixor"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__ixor__", rest))
            }
            IfCondition EqualTo(StringCompare(method_name, "iconcat"), 0) ThenBlock: {
                ReturnValue(OOP.MethodCall(a0, "__iadd__", rest))
            }
        }
        IfCondition EqualTo(StringCompare(method_name, "methodcaller"), 0) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                AIMacro.RaiseKind(5, "methodcaller")
                ReturnValue(0)
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(a0), 0) ThenBlock: {
                AIMacro.RaiseKind(5, "methodcaller")
                ReturnValue(0)
            }
            h = Hash.Create(8)
            Hash.Set(h, "__methodcaller__", 1)
            Hash.Set(h, "name", a0)
            rest = AIMacro.EmptyList()
            kwmc = 0
            ri = 1
            WhileLoop LessThan(ri, n) {
                av = Array.Get(args, ri)
                IfCondition EqualTo(Hash.IsHash(av), 1) ThenBlock: {
                    IfCondition NotEqual(Hash.Get(av, "__kwargs__"), 0) ThenBlock: {
                        kwmc = av
                    } ElseBlock: {
                        Array.Push(rest, av)
                    }
                } ElseBlock: {
                    Array.Push(rest, av)
                }
                ri = Add(ri, 1)
            }
            IfCondition NotEqual(kwmc, 0) ThenBlock: {
                Hash.Set(h, "kwargs", kwmc)
                kkeys = Hash.Keys(kwmc)
                nk = Array.Size(kkeys)
                ki = 0
                WhileLoop LessThan(ki, nk) {
                    kk = Array.Get(kkeys, ki)
                    IfCondition NotEqual(StringCompare(kk, "__kwargs__"), 0) ThenBlock: {
                        Array.Push(rest, Hash.Get(kwmc, kk))
                    }
                    ki = Add(ki, 1)
                }
                Array.Destroy(kkeys)
            }
            Hash.Set(h, "args", rest)
            ReturnValue(h)
        }
        IfCondition EqualTo(StringCompare(method_name, "__init__"), 0) ThenBlock: {
            ReturnValue(obj)
        }
        IfCondition EqualTo(StringCompare(method_name, "getsizeof"), 0) ThenBlock: {
            ReturnValue(64)
        }
        cls = 0
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
            cls = Hash.Get(obj, "__class__")
        }
        attr = AIMacro.ClassAttrGet(cls, method_name)
        IfCondition NotEqual(attr, 0) ThenBlock: {
            ReturnValue(AIMacro.SmartCallN(attr, args))
        }
        IfCondition EqualTo(StringCompare(method_name, "enum"), 0) ThenBlock: {
            ReturnValue(AIMacro.SmartCallN(AddressOf(AIMacro.Enumerate), args))
        }
        IfCondition EqualTo(StringCompare(method_name, "fail"), 0) ThenBlock: {
            ReturnValue(AIMacro.UnittestFail(obj, a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "sort"), 0) ThenBlock: {
            ReturnValue(AIMacro.ListSort(obj))
        }
        IfCondition EqualTo(StringCompare(method_name, "isdisjoint"), 0) ThenBlock: {
            ReturnValue(AIMacro.SetIsdisjoint(obj, a0))
        }
        PrintMessage("ERROR: Method not found: ")
        PrintMessage(method_name)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.AIMacro.MethodCall {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(method_name, "assertRaises"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                exc = 0
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    exc = Array.Get(args, 0)
                }
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                Hash.Set(cm, "exc", exc)
                ReturnValue(cm)
            }
            exc = Array.Get(args, 0)
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, exc, func, fnargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "assertWarns"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__warns__", 1)
                ReturnValue(cm)
            }
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            AIMacro.SmartCallN(func, fnargs)
            ReturnValue(1)
        }
        func_addr = 0
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            func_addr = OOP.MethodLookup(obj, method_name)
        }
        IfCondition EqualTo(StringCompare(method_name, "substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSub(obj, a0s))
        }
        IfCondition EqualTo(StringCompare(method_name, "safe_substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSafeSub(obj, a0s))
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            fn = AIMacro.ObjectGet(obj, method_name)
            IfCondition NotEqual(fn, 0) ThenBlock: {
                ReturnValue(AIMacro.SmartCallN(fn, args))
            }
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(AIMacro.MethodShim(obj, method_name, args))
        }
        IfCondition EqualTo(OOP.IsPackedMethod(obj, method_name), 1) ThenBlock: {
            pargs = AIMacro.PackCallArgs(obj, args)
            ReturnValue(CallIndirect(func_addr, pargs))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        num_args = Array.Size(args)
        IfCondition EqualTo(num_args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        arg0 = Array.Get(args, 0)
        IfCondition EqualTo(arg0, 0) ThenBlock: {
            arg0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 1) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0))
        }
        arg1 = Array.Get(args, 1)
        IfCondition EqualTo(arg1, 0) ThenBlock: {
            arg1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 2) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1))
        }
        arg2 = Array.Get(args, 2)
        IfCondition EqualTo(arg2, 0) ThenBlock: {
            arg2 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 3) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2))
        }
        arg3 = Array.Get(args, 3)
        IfCondition EqualTo(arg3, 0) ThenBlock: {
            arg3 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 4) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3))
        }
        arg4 = Array.Get(args, 4)
        IfCondition EqualTo(arg4, 0) ThenBlock: {
            arg4 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3, arg4))
    }
}

Function.AIMacro.SmartCall {
    Input: fn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            empty = AIMacro.EmptyList()
            ReturnValue(AIMacro.SmartCallN(fn, empty))
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        ReturnValue(CallIndirect(fn))
    }
}

Function.AIMacro.SmartCall1 {
    Input: fn: Address
    Input: arg: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            a = AIMacro.EmptyList()
            Array.Push(a, arg)
            ReturnValue(AIMacro.SmartCallN(fn, a))
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        carg = arg
        IfCondition EqualTo(carg, 0) ThenBlock: {
            carg = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, carg))
    }
}

Function.AIMacro.SmartCall2 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCall3 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Input: a2: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        Array.Push(a, a2)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCallN {
    Input: fn: Address
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(AIMacro.ListFrom(args))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            args = AIMacro.EmptyList()
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(fn, "__opshim__"), 0) ThenBlock: {
                IfCondition EqualTo(Array.Size(args), 1) ThenBlock: {
                    a0s = Array.Get(args, 0)
                    IfCondition EqualTo(Array.IsArray(a0s), 1) ThenBlock: {
                        args = a0s
                    }
                }
                ReturnValue(AIMacro.CallOpShim(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__bound__"), 0) ThenBlock: {
                bobj = Hash.Get(fn, "obj")
                bname = Hash.Get(fn, "name")
                ReturnValue(AIMacro.MethodCall(bobj, bname, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__attrgetter__"), 0) ThenBlock: {
                ReturnValue(AIMacro.ApplyAttrGetter(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__itemgetter__"), 0) ThenBlock: {
                ReturnValue(AIMacro.ApplyItemGetter(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__methodcaller__"), 0) ThenBlock: {
                nmc = Array.Size(args)
                IfCondition LessThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                IfCondition GreaterThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                mcobj = Array.Get(args, 0)
                mcname = Hash.Get(fn, "name")
                mcargs = Hash.Get(fn, "args")
                IfCondition EqualTo(Array.IsArray(mcargs), 0) ThenBlock: {
                    mcargs = AIMacro.EmptyList()
                }
                mckw = Hash.Get(fn, "kwargs")
                IfCondition NotEqual(mckw, 0) ThenBlock: {
                    Array.Push(mcargs, mckw)
                }
                ReturnValue(AIMacro.MethodCall(mcobj, mcname, mcargs))
            }
        }
        IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
            is_enum_cls = 0
            walk_e = fn
            eh_e = 0
            WhileLoop LessThan(eh_e, 16) {
                IfCondition EqualTo(walk_e, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(StringCompare(walk_e, "enumerate"), 0) ThenBlock: {
                    is_enum_cls = 1
                    BreakLoop
                }
                walk_e = OOP.ClassGetParent(walk_e)
                eh_e = Add(eh_e, 1)
            }
            IfCondition EqualTo(is_enum_cls, 1) ThenBlock: {
                ns_e = 0
                IfCondition NotEqual(args, 0) ThenBlock: {
                    ns_e = Array.Size(args)
                }
                src_e = 0
                st_e = 0
                IfCondition GreaterThan(ns_e, 0) ThenBlock: {
                    src_e = Array.Get(args, 0)
                }
                IfCondition GreaterThan(ns_e, 1) ThenBlock: {
                    st_e = Array.Get(args, 1)
                    v0_it = AIMacro.LooksIterable(src_e)
                    v1_it = AIMacro.LooksIterable(st_e)
                    IfCondition EqualTo(v0_it, 0) ThenBlock: {
                        IfCondition EqualTo(v1_it, 1) ThenBlock: {
                            tmp_e = src_e
                            src_e = st_e
                            st_e = tmp_e
                        }
                    }
                }
                enu_e = AIMacro.EnumerateFrom(src_e, AIMacro.UnboxIntZero(st_e))
                Hash.Set(enu_e, "__class__", fn)
                ReturnValue(enu_e)
            }
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        si = 0
        ns0 = Array.Size(args)
        WhileLoop LessThan(si, ns0) {
            IfCondition EqualTo(Array.Get(args, si), AddressOf(AIMacro.KwArgError)) ThenBlock: {
                AIMacro.RaiseKind(5, "keyword argument")
                ReturnValue(0)
            }
            si = Add(si, 1)
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
            IfCondition NotEqual(Array.Size(args), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.Enumerate)) ThenBlock: {
            ns = Array.Size(args)
            IfCondition Or(EqualTo(ns, 0), GreaterThan(ns, 2)) ThenBlock: {
                AIMacro.RaiseKind(5, "enumerate")
                ReturnValue(0)
            }
            IfCondition EqualTo(ns, 2) ThenBlock: {
                ReturnValue(AIMacro.Enumerate2(Array.Get(args, 0), Array.Get(args, 1)))
            }
        }
        n = Array.Size(args)
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
            ReturnValue(CallIndirect(fn))
        }
        a0 = Array.Get(args, 0)
        IfCondition EqualTo(a0, 0) ThenBlock: {
            a0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0))
        }
        a1 = Array.Get(args, 1)
        IfCondition EqualTo(a1, 0) ThenBlock: {
            a1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0, a1))
        }
        a2 = Array.Get(args, 2)
        IfCondition EqualTo(a2, 0) ThenBlock: {
            a2 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, a0, a1, a2))
    }
}

Function.AIMacro.PyType {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            cls = Hash.Get(obj, "__class__")
            IfCondition NotEqual(cls, 0) ThenBlock: {
                ReturnValue(cls)
            }
            ReturnValue("dict")
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue("list")
        }
        ReturnValue(Types.TypeOf(obj))
    }
}

Function.AIMacro.StringWhitespace {
    Output: Address
    Body: {
        s = Allocate(7)
        SetByte(s, 0, 32)
        SetByte(s, 1, 9)
        SetByte(s, 2, 10)
        SetByte(s, 3, 13)
        SetByte(s, 4, 11)
        SetByte(s, 5, 12)
        SetByte(s, 6, 0)
        ReturnValue(s)
    }
}


Function.AIMacro.StartFile {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.OsExists(path), 0) ThenBlock: {
            AIMacro.RaiseKind(3, "startfile")
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.AssertPythonOk {
    Input: script: Address
    Output: Address
    Body: {
        a = Array.Create(4)
        Array.Push(a, 0)
        Array.Push(a, "")
        Array.Push(a, "usage: reindent")
        ReturnValue(a)
    }
}

Function.AIMacro.WrapGenStop {
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.ExcKind(), 9) ThenBlock: {
                old = AIMacro.ExcValue()
                AIMacro.ExcClear()
                AIMacro.RaiseKind(6, "generator raised StopIteration")
                val = AIMacro.ExcValue()
                IfCondition EqualTo(Hash.IsHash(val), 1) ThenBlock: {
                    Hash.Set(val, "__cause__", old)
                    Hash.Set(val, "__context__", old)
                    Hash.Set(val, "__suppress_context__", AIMacro.TrueVal())
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.OsOpenpty {
    Output: Address
    Body: {
        master = SystemCall(2, "/dev/ptmx", 2, 0)
        IfCondition LessThan(master, 0) ThenBlock: {
            AIMacro.RaiseKind(3, "openpty")
            ReturnValue(AIMacro.EmptyList())
        }
        lock = Allocate(8)
        StoreValue(lock, 0)
        lck = Add(Multiply(16388, 65536), 21553)
        SystemCall(16, master, lck, lock)
        ptn = Allocate(8)
        StoreValue(ptn, 0)
        cmd = Add(Multiply(32772, 65536), 21552)
        SystemCall(16, master, cmd, ptn)
        n = Dereference(ptn)
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        path = StringConcat("/dev/pts/", NumberToString(n))
        slave = SystemCall(2, path, 2050, 0)
        IfCondition LessThan(slave, 0) ThenBlock: {
            slave = SystemCall(2, path, 2, 0)
        }
        IfCondition LessThan(slave, 0) ThenBlock: {
            SystemCall(3, master)
            AIMacro.RaiseKind(3, "openpty")
            ReturnValue(AIMacro.EmptyList())
        }
        out = AIMacro.ArrayNew(2)
        Array.Push(out, master)
        Array.Push(out, slave)
        ReturnValue(out)
    }
}

Function.AIMacro.OsClose {
    Input: fd: Integer
    Output: Integer
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.OsWrite {
    Input: fd: Integer
    Input: data: Address
    Output: Integer
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition Or(LessThan(fd, 0), EqualTo(data, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(SystemCall(1, fd, data, StringLength(data)))
    }
}

Function.AIMacro.OsRead {
    Input: fd: Integer
    Input: n: Integer
    Output: Address
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        n = AIMacro.UnboxIntZero(n)
        IfCondition LessThan(n, 1) ThenBlock: {
            n = 1
        }
        IfCondition GreaterThan(n, 65536) ThenBlock: {
            n = 65536
        }
        buf = Allocate(Add(n, 1))
        got = 0
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            got = SystemCall(0, fd, buf, n)
        }
        IfCondition LessThan(got, 0) ThenBlock: {
            got = 0
        }
        SetByte(buf, got, 0)
        ReturnValue(buf)
    }
}

Function.AIMacro.OsIsatty {
    Input: fd: Integer
    Output: Address
    Body: {
        fd = AIMacro.UnboxIntZero(fd)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        term = Allocate(256)
        rc = SystemCall(16, fd, 21505, term)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.PyCompile {
    Input: src: Address
    Input: filename: Address
    Input: mode: Address
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__src__", src)
        ReturnValue(h)
    }
}

Function.AIMacro.Exec {
    Input: src: Address
    Input: ns: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(src), 1) ThenBlock: {
            src = Hash.Get(src, "__src__")
        }
        IfCondition EqualTo(src, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Types.IsString(src), 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(src)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), And(NotEqual(ch, 9), NotEqual(ch, 10))) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        // skip comments / coding cookies
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(src, i), 35) ThenBlock: {
                WhileLoop And(LessThan(i, n), NotEqual(GetByte(src, i), 10)) {
                    i = Add(i, 1)
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    i = Add(i, 1)
                }
            } ElseBlock: {
                BreakLoop
            }
        }
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), And(NotEqual(ch, 9), NotEqual(ch, 10))) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        ident = Allocate(64)
        ilen = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            ok = 0
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ok = 1 }
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ok = 1 }
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ch, 95) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition LessThan(ilen, 62) ThenBlock: {
                SetByte(ident, ilen, ch)
                ilen = Add(ilen, 1)
            }
            i = Add(i, 1)
        }
        SetByte(ident, ilen, 0)
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.KeywordIsKeyword(ident)), 1) ThenBlock: {
            AIMacro.RaiseKind(24, "invalid syntax")
            ReturnValue(0)
        }
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        IfCondition And(LessThan(i, n), EqualTo(GetByte(src, i), 61)) ThenBlock: {
            i = Add(i, 1)
            WhileLoop LessThan(i, n) {
                ch = GetByte(src, i)
                IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, 1)
            }
            IfCondition And(LessThan(i, n), Or(EqualTo(GetByte(src, i), 34), EqualTo(GetByte(src, i), 39))) ThenBlock: {
                q = GetByte(src, i)
                i = Add(i, 1)
                vbuf = Allocate(Add(n, 1))
                vlen = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(src, i)
                    IfCondition EqualTo(ch, q) ThenBlock: {
                        BreakLoop
                    }
                    SetByte(vbuf, vlen, ch)
                    vlen = Add(vlen, 1)
                    i = Add(i, 1)
                }
                SetByte(vbuf, vlen, 0)
                IfCondition EqualTo(Hash.IsHash(ns), 1) ThenBlock: {
                    Hash.Set(ns, ident, vbuf)
                }
            }
        }
        ReturnValue(0)
    }
}

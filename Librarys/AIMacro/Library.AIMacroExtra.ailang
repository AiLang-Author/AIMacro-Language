// In-place list.sort() — 1-arg (codegen emits ListSort(lst) with no key/reverse).
Function.AIMacro.ListSort {
    Input: lst: Address
    Output: Address
    Body: {
        IfCondition EqualTo(lst, 0) ThenBlock: {
            ReturnValue(0)
        }
        sorted = AIMacro.TypedSorted(lst)
        WhileLoop GreaterThan(Array.Size(lst), 0) {
            AIMacro.SmartPop(lst)
        }
        n = Array.Size(sorted)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(lst, Array.Get(sorted, i))
            i = Add(i, 1)
        }
        ReturnValue(lst)
    }
}

// str.encode(encoding, errors) — compile stub: bytes-as-str identity
// Free-call form after Join/temp: encode(s, encoding, errors)
Function.AIMacro.Encode {
    Input: s: Address
    Input: encoding: Address
    Input: errors: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue("")
        }
        ReturnValue(s)
    }
}


// unittest — regrtest shape: import module, then run TestCase.test* methods.
// Boot registers OOP class TestCase before user subclasses ClassDefine.
// Failures increment UnittestState.fails; UnittestDone ProcessExit(1) if any.
// =============================================================================

FixedPool.UnittestState {
    "fails": Initialize=0
    "runs": Initialize=0
    "booted": Initialize=0
    "scheduled": Initialize=0
}

Function.AIMacro.UnittestEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, b) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(AIMacro.IsNone(a), 1), EqualTo(AIMacro.IsNone(b), 1)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(Types.IsString(a), 1), EqualTo(Types.IsString(b), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(Types.IsBool(a), 1), EqualTo(Types.IsBool(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(Types.IsComplex(a), 1), EqualTo(Types.IsComplex(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(AIMacro.LooksLikeString(a), 1), EqualTo(AIMacro.LooksLikeString(b), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(Array.IsArray(a), 1), EqualTo(Array.IsArray(b), 1)) ThenBlock: {
            na = Array.Size(a)
            nb = Array.Size(b)
            IfCondition NotEqual(na, nb) ThenBlock: {
                ReturnValue(0)
            }
            ia = 0
            WhileLoop LessThan(ia, na) {
                ea = Array.Get(a, ia)
                eb = Array.Get(b, ia)
                IfCondition NotEqual(ea, eb) ThenBlock: {
                    IfCondition And(EqualTo(Types.IsString(ea), 1), EqualTo(Types.IsString(eb), 1)) ThenBlock: {
                        IfCondition NotEqual(StringCompare(ea, eb), 0) ThenBlock: {
                            ReturnValue(0)
                        }
                    } ElseBlock: {
                        ReturnValue(0)
                    }
                }
                ia = Add(ia, 1)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.UnittestFail {
    Input: self: Address
    Input: msg: Address
    Output: Integer
    Body: {
        UnittestState.fails = Add(UnittestState.fails, 1)
        PrintMessage("FAIL: ")
        IfCondition NotEqual(msg, 0) ThenBlock: {
            PrintString(msg)
        }
        PrintMessage("\n")
        AIMacro.RaiseKind(8, msg)
        ReturnValue(0)
    }
}

Function.AIMacro.UnittestAssertEqual {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.UnittestEq(a, b), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertEqual"))
    }
}

Function.AIMacro.UnittestAssertNotEqual {
    Input: self: Address

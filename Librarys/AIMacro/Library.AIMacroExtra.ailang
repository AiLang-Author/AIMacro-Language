// unittest — regrtest shape: import module, then run TestCase.test* methods.
// Boot registers OOP class TestCase before user subclasses ClassDefine.
// Failures increment UnittestState.fails; UnittestDone ProcessExit(1) if any.
// =============================================================================

FixedPool.UnittestState {
    "fails": Initialize=0
    "runs": Initialize=0
    "booted": Initialize=0
    "scheduled": Initialize=0
}

Function.AIMacro.UnittestEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, b) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(AIMacro.IsNone(a), 1), EqualTo(AIMacro.IsNone(b), 1)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(Types.IsString(a), 1), EqualTo(Types.IsString(b), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(Types.IsBool(a), 1), EqualTo(Types.IsBool(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(Types.IsComplex(a), 1), EqualTo(Types.IsComplex(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(AIMacro.LooksLikeString(a), 1), EqualTo(AIMacro.LooksLikeString(b), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(Array.IsArray(a), 1), EqualTo(Array.IsArray(b), 1)) ThenBlock: {
            na = Array.Size(a)
            nb = Array.Size(b)
            IfCondition NotEqual(na, nb) ThenBlock: {
                ReturnValue(0)
            }
            ia = 0
            WhileLoop LessThan(ia, na) {
                ea = Array.Get(a, ia)
                eb = Array.Get(b, ia)
                IfCondition NotEqual(ea, eb) ThenBlock: {
                    IfCondition EqualTo(AIMacro.UnittestEq(ea, eb), 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
                ia = Add(ia, 1)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.UnittestFail {
    Input: self: Address
    Input: msg: Address
    Output: Integer
    Body: {
        UnittestState.fails = Add(UnittestState.fails, 1)
        PrintMessage("FAIL: ")
        IfCondition NotEqual(msg, 0) ThenBlock: {
            PrintString(msg)
        }
        PrintMessage("\n")
        AIMacro.RaiseKind(8, msg)
        ReturnValue(0)
    }
}

Function.AIMacro.UnittestAssertEqual {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.UnittestEq(a, b), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertEqual"))
    }
}

Function.AIMacro.UnittestAssertNotEqual {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.UnittestEq(a, b), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertNotEqual"))
    }
}

Function.AIMacro.UnittestAssertTrue {
    Input: self: Address
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SmartBool(expr), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertTrue"))
    }
}

Function.AIMacro.UnittestAssertFalse {
    Input: self: Address
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.SmartBool(expr), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertFalse"))
    }
}

Function.AIMacro.UnittestAssertIs {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, b) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(AIMacro.LooksLikeString(a), 1), EqualTo(AIMacro.LooksLikeString(b), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition And(EqualTo(Types.IsBool(a), 1), EqualTo(Types.IsBool(b), 1)) ThenBlock: {
            IfCondition EqualTo(AIMacro.BoolVal(a), AIMacro.BoolVal(b)) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Types.IsBool(a), 1) ThenBlock: {
            bv = AIMacro.UnboxIntZero(AIMacro.BoolVal(b))
            IfCondition And(Or(EqualTo(bv, 0), EqualTo(bv, 1)), EqualTo(bv, AIMacro.BoolVal(a))) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Types.IsBool(b), 1) ThenBlock: {
            av = AIMacro.UnboxIntZero(AIMacro.BoolVal(a))
            IfCondition And(Or(EqualTo(av, 0), EqualTo(av, 1)), EqualTo(av, AIMacro.BoolVal(b))) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition And(EqualTo(a, AddressOf(AIMacro.Int)), EqualTo(AIMacro.LooksLikeString(b), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(b, "int"), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition And(EqualTo(b, AddressOf(AIMacro.Int)), EqualTo(AIMacro.LooksLikeString(a), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(a, "int"), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        // True is 1 / False is 0 for assertIs(a == b, True)
        av2 = AIMacro.UnboxIntZero(a)
        bv2 = AIMacro.UnboxIntZero(b)
        IfCondition And(Or(EqualTo(av2, 0), EqualTo(av2, 1)), Or(EqualTo(bv2, 0), EqualTo(bv2, 1))) ThenBlock: {
            IfCondition EqualTo(av2, bv2) ThenBlock: {
                IfCondition Or(EqualTo(Types.IsBool(a), 1), EqualTo(Types.IsBool(b), 1)) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition And(LessThan(a, 2), LessThan(b, 2)) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertIs"))
    }
}

Function.AIMacro.UnittestAssertIsNot {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(a, b) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertIsNot"))
    }
}

Function.AIMacro.UnittestAssertIsNone {
    Input: self: Address
    Input: a: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(a), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertIsNone"))
    }
}

Function.AIMacro.UnittestAssertIsNotNone {
    Input: self: Address
    Input: a: Address
    Output: Integer
    Body: {

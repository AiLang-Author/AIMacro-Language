Function.AIMacro.UnittestAssertAlmostEqual {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        da = AIMacro.ToFloatBits(a)
        db = AIMacro.ToFloatBits(b)
        diff = Float_Sub(da, db)
        IfCondition EqualTo(Float_Lt(diff, Float_FromInt(0)), 1) ThenBlock: {
            diff = Float_Sub(0, diff)
        }
        tol = Float_Div(Float_FromInt(1), Float_FromInt(10000000))
        IfCondition EqualTo(Float_Lt(diff, tol), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Float_Eq(diff, 0), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertAlmostEqual"))
    }
}


// Library.AIMacroExtra.ailang
// Optional builtins kept out of Library.AIMacro so fizzbuzz ELF stays 211054.
// Generated programs import this via codegen preamble.

LibraryImport.Array
LibraryImport.Hash
LibraryImport.OOP
LibraryImport.AIMacro.AIMacroTypes
LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.AIMacro.AIMacroOperator
LibraryImport.AIMacro.AIMacroUnittest
LibraryImport.AIMacro.AIMacroFormat
LibraryImport.AIMacro.AIMacroExtraOS
LibraryImport.AIMacro.AIMacroExtraCall
LibraryImport.AIMacro.AIMacroExtraStdlib

// bytes(iterable) — compile stub: join list elems into a string (quopri HEX digits etc.)
// isinstance(..., bytes) maps to TypeID.STR; runtime treats bytes-like as strings.
Function.AIMacro.Bytes {
    Input: iterable: Address
    Output: Address
    Body: {
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            ReturnValue("")
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            ReturnValue("")
        }
        IfCondition EqualTo(Array.IsArray(iterable), 1) ThenBlock: {
            n = Array.Size(iterable)
            out = ""
            i = 0
            WhileLoop LessThan(i, n) {
                el = Array.Get(iterable, i)
                // Small ints are codepoints; heap addresses are already strings
                IfCondition And(GreaterEqual(el, 0), LessThan(el, 256)) ThenBlock: {
                    out = String.Concat(out, AIMacro.Chr(el))
                } ElseBlock: {
                    out = String.Concat(out, el)
                }
                i = Add(i, 1)
            }
            ReturnValue(out)
        }
        // Already a string / bytes-like
        ReturnValue(iterable)
    }
}

Function.AIMacro.ByteArray {
    Input: iterable: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.SafeIsHash(iterable), 1) ThenBlock: {
            wba = Hash.Get(iterable, "__list__")
            IfCondition EqualTo(Array.IsArray(wba), 1) ThenBlock: {
                iterable = wba
            }
        }
        raw = AIMacro.Bytes(iterable)
        lst = AIMacro.EmptyList()
        IfCondition EqualTo(Array.IsArray(raw), 1) ThenBlock: {
            ni = Array.Size(raw)
            ii = 0
            WhileLoop LessThan(ii, ni) {
                Array.Push(lst, Array.Get(raw, ii))
                ii = Add(ii, 1)
            }
        } ElseBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(raw), 1) ThenBlock: {
                ni = StringLength(raw)
                ii = 0
                WhileLoop LessThan(ii, ni) {
                    Array.Push(lst, GetByte(raw, ii))
                    ii = Add(ii, 1)
                }
            }
        }
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "bytearray")
        Hash.Set(h, "__list__", lst)
        ReturnValue(h)
    }
}


// issubclass(cls, base) — compile conformance for copy.py (issubclass(cls, type)).
// Emitter maps via Gen_MapBuiltin; base "type" becomes AddressOf(Types.TypeOf).
// Pointer-equal → True (covers issubclass(type, type)); else False.
Function.AIMacro.IsSubclass {
    Input: cls: Address
    Input: base: Address
    Output: Address
    Body: {
        IfCondition EqualTo(cls, base) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition And(EqualTo(base, 0), EqualTo(UnittestState.in_test, 1)) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition And(EqualTo(cls, AddressOf(AIMacro.Bool)), EqualTo(base, AddressOf(AIMacro.Int))) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        cn = cls
        bn = base
        IfCondition EqualTo(AIMacro.SafeIsHash(cls), 1) ThenBlock: {
            n = Hash.Get(cls, "__name__")
            IfCondition EqualTo(n, 0) ThenBlock: {
                n = Hash.Get(cls, "__class__")
            }
            IfCondition NotEqual(n, 0) ThenBlock: {
                cn = n
            }
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(base), 1) ThenBlock: {
            n2 = Hash.Get(base, "__name__")
            IfCondition EqualTo(n2, 0) ThenBlock: {
                n2 = Hash.Get(base, "__class__")
            }
            IfCondition NotEqual(n2, 0) ThenBlock: {
                bn = n2
            }
        }
        IfCondition And(EqualTo(AIMacro.LooksLikeString(cn), 1), EqualTo(AIMacro.LooksLikeString(bn), 1)) ThenBlock: {
            IfCondition EqualTo(StringCompare(cn, bn), 0) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            IfCondition EqualTo(OOP.ClassIsSubclass(cn, bn), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
        }
        stor = AIMacro.ListStorage(base)
        IfCondition EqualTo(Array.IsArray(stor), 1) ThenBlock: {
            bi = 0
            bn2 = Array.Size(stor)
            WhileLoop LessThan(bi, bn2) {
                one = Array.Get(stor, bi)
                hit = AIMacro.IsSubclass(cls, one)
                IfCondition EqualTo(AIMacro.SmartBool(hit), 1) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                bi = Add(bi, 1)
            }
        }
        suba = 0
        IfCondition EqualTo(Hash.IsHash(base), 1) ThenBlock: {
            suba = Hash.Get(base, "__subclass__")
        }
        IfCondition EqualTo(suba, 0) ThenBlock: {
            IfCondition And(EqualTo(AIMacro.LooksLikeString(bn), 1), NotEqual(ClassAttrs.table, 0)) ThenBlock: {
                skey = StringConcat(bn, ".")
                skey = StringConcat(skey, "__subclass__")
                suba = Hash.Get(ClassAttrs.table, skey)
            }
        }
        IfCondition EqualTo(Array.IsArray(suba), 1) ThenBlock: {
            si = 0
            ns = Array.Size(suba)
            WhileLoop LessThan(si, ns) {
                IfCondition EqualTo(Array.Get(suba, si), cls) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                si = Add(si, 1)
            }
        }
        ReturnValue(AIMacro.FalseVal())
    }
}


// getattr(obj, name, default) — compile conformance for copy.py / types / reprlib.
// Emitter maps via Gen_MapBuiltin + Gen_CallExpr (pads missing default with None).
// str/bytes.translate(table) — compile stub: return the original buffer.
Function.AIMacro.Translate {
    Input: s: Address
    Input: table: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(s, 0), EqualTo(table, 0)) ThenBlock: {
            ReturnValue(s)
        }
        IfCondition EqualTo(Hash.IsHash(table), 0) ThenBlock: {
            ReturnValue(s)
        }
        n = StringLength(s)
        out = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(s, i)
            k = NumberToString(c)
            v = Hash.Get(table, k)
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(out, i, c)
            } ElseBlock: {
                SetByte(out, i, v)
            }
            i = Add(i, 1)
        }
        SetByte(out, n, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.MakeTrans {
    Input: frm: Address
    Input: to: Address
    Input: extra: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(frm, 0), EqualTo(to, 0)) ThenBlock: {
            ReturnValue(0)
        }
        nf = StringLength(frm)
        nt = StringLength(to)
        n = nf
        IfCondition LessThan(nt, n) ThenBlock: { n = nt }
        h = Hash.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            Hash.Set(h, NumberToString(GetByte(frm, i)), GetByte(to, i))
            i = Add(i, 1)
        }
        ReturnValue(h)
    }
}

Function.AIMacro.ReCompile {
    Input: pat: Address
    Output: Address
    Body: {
        ReturnValue(pat)
    }
}

// platform.system() — Linux uname(2) sysname (syscall 63, utsname.sysname at offset 0)
Function.AIMacro.UnameSysname {
    Output: Address
    Body: {
        buf = Allocate(512)
        rc = SystemCall(63, buf)
        IfCondition LessThan(rc, 0) ThenBlock: {
            ReturnValue("")
        }
        n = 0
        WhileLoop LessThan(n, 64) {
            IfCondition EqualTo(GetByte(buf, n), 0) ThenBlock: {
                BreakLoop
            }
            n = Add(n, 1)
        }
        out = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, i, GetByte(buf, i))
            i = Add(i, 1)
        }
        SetByte(out, n, 0)
        ReturnValue(out)
    }
}

// OOP.ObjectGet/Set on None (AddressOf(GetNone)) or a function pointer
// Hash.Get's 0 then Hash.Get/Set(0) Dereference(NULL).
FixedPool.KeywordState {
    "kwlist": Initialize=0
    "softkwlist": Initialize=0
}

FixedPool.ContainsZero {
    "box": Initialize=0
}

FixedPool.ZeroInt {
    "box": Initialize=0
}

FixedPool.ClassAttrs {
    "table": Initialize=0
}

FixedPool.MethodSkip {
    "table": Initialize=0
}

Function.AIMacro.KeywordKwlist {
    Output: Address
    Body: {
        IfCondition NotEqual(KeywordState.kwlist, 0) ThenBlock: {
            ReturnValue(KeywordState.kwlist)
        }
        a = Array.Create(36)
        Array.Push(a, "False")
        Array.Push(a, "None")
        Array.Push(a, "True")
        Array.Push(a, "and")
        Array.Push(a, "as")
        Array.Push(a, "assert")
        Array.Push(a, "async")
        Array.Push(a, "await")
        Array.Push(a, "break")
        Array.Push(a, "class")
        Array.Push(a, "continue")
        Array.Push(a, "def")
        Array.Push(a, "del")
        Array.Push(a, "elif")
        Array.Push(a, "else")
        Array.Push(a, "except")
        Array.Push(a, "finally")
        Array.Push(a, "for")
        Array.Push(a, "from")
        Array.Push(a, "global")
        Array.Push(a, "if")
        Array.Push(a, "import")
        Array.Push(a, "in")
        Array.Push(a, "is")
        Array.Push(a, "lambda")
        Array.Push(a, "nonlocal")
        Array.Push(a, "not")
        Array.Push(a, "or")
        Array.Push(a, "pass")
        Array.Push(a, "raise")
        Array.Push(a, "return")
        Array.Push(a, "try")
        Array.Push(a, "while")
        Array.Push(a, "with")
        Array.Push(a, "yield")
        KeywordState.kwlist = a
        ReturnValue(a)
    }
}

Function.AIMacro.KeywordSoftKwlist {
    Output: Address
    Body: {
        IfCondition NotEqual(KeywordState.softkwlist, 0) ThenBlock: {
            ReturnValue(KeywordState.softkwlist)
        }
        a = Array.Create(4)
        Array.Push(a, "_")
        Array.Push(a, "case")
        Array.Push(a, "match")
        KeywordState.softkwlist = a
        ReturnValue(a)
    }
}

Function.AIMacro.KeywordIsKeyword {
    Input: word: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Types.IsString(word), 0) ThenBlock: {
            ReturnValue(AIMacro.Bool(0))
        }
        a = AIMacro.KeywordKwlist()
        n = Array.Size(a)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(StringCompare(Array.Get(a, i), word), 0) ThenBlock: {
                ReturnValue(AIMacro.Bool(1))
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.Bool(0))
    }
}

Function.AIMacro.KeywordIsSoftKeyword {
    Input: word: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Types.IsString(word), 0) ThenBlock: {
            ReturnValue(AIMacro.Bool(0))
        }
        a = AIMacro.KeywordSoftKwlist()
        n = Array.Size(a)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(StringCompare(Array.Get(a, i), word), 0) ThenBlock: {
                ReturnValue(AIMacro.Bool(1))
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.Bool(0))
    }
}

Function.AIMacro.ClassAttrGet {
    Input: cls: Address
    Input: field: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(cls, 0), EqualTo(field, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ClassAttrs.table, 0) ThenBlock: {
            ReturnValue(0)
        }
        current = cls
        hops = 0
        WhileLoop And(NotEqual(current, 0), LessThan(hops, 16)) {
            key = StringConcat(current, ".")
            key = StringConcat(key, field)
            v = Hash.Get(ClassAttrs.table, key)
            IfCondition NotEqual(v, 0) ThenBlock: {
                ReturnValue(v)
            }
            current = OOP.ClassGetParent(current)
            hops = Add(hops, 1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.ClassAttrSet {
    Input: cls: Address
    Input: field: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(cls, 0), EqualTo(field, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ClassAttrs.table, 0) ThenBlock: {
            ClassAttrs.table = Hash.Create(32)
        }
        key = StringConcat(cls, ".")
        key = StringConcat(key, field)
        Hash.Set(ClassAttrs.table, key, value)
        OOP.ClassField(cls, field, "Address")
        OOP.ClassFieldDefault(cls, field, value)
        ReturnValue(1)
    }
}

// Drop ClassAttrs keys for one class so a hoisted nested `class C:` inside a
// loop does not keep setattr from the previous iteration.
Function.AIMacro.ClassAttrReset {
    Input: cls: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(cls, 0), EqualTo(ClassAttrs.table, 0)) ThenBlock: {
            ReturnValue(0)
        }
        prefix = StringConcat(cls, ".")
        plen = StringLength(prefix)
        keys = Hash.Keys(ClassAttrs.table)
        n = Array.Size(keys)
        i = 0
        WhileLoop LessThan(i, n) {
            k = Array.Get(keys, i)
            IfCondition EqualTo(String.StartsWith(k, prefix), 1) ThenBlock: {
                klen = StringLength(k)
                IfCondition GreaterThan(klen, plen) ThenBlock: {
                    field = String.Substring(k, plen, klen)
                    OOP.ClassFieldDefault(cls, field, 0)
                }
                Hash.Delete(ClassAttrs.table, k)
            }
            i = Add(i, 1)
        }
        Array.Destroy(keys)
        ReturnValue(1)
    }
}

Function.AIMacro.AlwaysEq {
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__class__", "_AlwaysEq")
        ReturnValue(h)
    }
}

Function.AIMacro.NeverEq {
    Output: Address
    Body: {
        h = Hash.Create(4)
        Hash.Set(h, "__class__", "_NeverEq")
        ReturnValue(h)
    }
}

Function.AIMacro.SetIsdisjoint {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(a, 0), EqualTo(b, 0)) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(AIMacro.IsNone(a), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(AIMacro.IsNone(b), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        aa = a
        IfCondition EqualTo(AIMacro.SafeIsHash(a), 1) ThenBlock: {
            lst = Hash.Get(a, "__list__")
            IfCondition EqualTo(Array.IsArray(lst), 1) ThenBlock: {
                aa = lst
            }
        }
        IfCondition EqualTo(Array.IsArray(aa), 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        n = Array.Size(aa)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.Contains(b, Array.Get(aa, i))), 1) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.TrueVal())
    }
}

Function.AIMacro.ObjectGet {
    Input: obj: Address
    Input: field: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(field, "kwlist"), 0) ThenBlock: {
                ReturnValue(AIMacro.KeywordKwlist())
            }
            IfCondition EqualTo(StringCompare(field, "softkwlist"), 0) ThenBlock: {
                ReturnValue(AIMacro.KeywordSoftKwlist())
            }
            IfCondition EqualTo(StringCompare(field, "fromkeys"), 0) ThenBlock: {
                ReturnValue(AddressOf(AIMacro.DictFromKeys))
            }
            IfCondition EqualTo(StringCompare(field, "__itemsize__"), 0) ThenBlock: {
                ReturnValue(4)
            }
            IfCondition EqualTo(StringCompare(field, "getrefcount"), 0) ThenBlock: {
                ReturnValue(2)
            }
            IfCondition EqualTo(StringCompare(field, "TESTFN"), 0) ThenBlock: {
                ReturnValue("/tmp/aimacro-testfn")
            }
            IfCondition EqualTo(StringCompare(field, "real"), 0) ThenBlock: {
                IfCondition EqualTo(Types.IsBool(obj), 1) ThenBlock: {
                    ReturnValue(AIMacro.BoolVal(obj))
                }
            }
            IfCondition EqualTo(StringCompare(field, "imag"), 0) ThenBlock: {
                IfCondition EqualTo(Types.IsBool(obj), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(StringCompare(field, "closed"), 0) ThenBlock: {
                IfCondition EqualTo(AIMacro.IsFile(obj), 1) ThenBlock: {
                    fd = Dereference(Add(obj, 8))
                    IfCondition LessThan(fd, 0) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                    ReturnValue(AIMacro.FalseVal())
                }
            }
        }
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            IfCondition EqualTo(Types.IsString(field), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(field, "append"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "extend"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "pop"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "clear"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "copy"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "count"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "index"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "insert"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "remove"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "reverse"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "sort"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
                IfCondition EqualTo(StringCompare(field, "isdisjoint"), 0) ThenBlock: {
                    ReturnValue(AIMacro.OpBound(obj, field))
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 0) ThenBlock: {
            IfCondition EqualTo(AIMacro.LooksLikeString(obj), 1) ThenBlock: {
                IfCondition EqualTo(OOP.ClassExists(obj), 1) ThenBlock: {
                    ReturnValue(AIMacro.ClassAttrGet(obj, field))
                }
                ReturnValue(0)
            }
            ReturnValue(0)
        }
        data = Hash.Get(obj, "__data__")
        v = 0
        IfCondition Or(EqualTo(data, 0), EqualTo(Hash.IsHash(data), 0)) ThenBlock: {
            v = Hash.Get(obj, field)
        } ElseBlock: {
            v = Hash.Get(data, field)
        }
        IfCondition NotEqual(v, 0) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(v, "__property__"), 0) ThenBlock: {
                    fget = Hash.Get(v, "fget")
                    IfCondition NotEqual(fget, 0) ThenBlock: {
                        ReturnValue(CallIndirect(fget, AIMacro.PackCallArgs(obj, 0)))
                    }
                }
            }
            ReturnValue(v)
        }
        mx = OOP.MethodExists(obj, field)
        IfCondition EqualTo(mx, 1) ThenBlock: {
            ReturnValue(AIMacro.BoundMethod(obj, field))
        }
        IfCondition EqualTo(AIMacro.IsOpName(field), 1) ThenBlock: {
            ReturnValue(AIMacro.OpBound(obj, field))
        }
        cls = Hash.Get(obj, "__class__")
        IfCondition NotEqual(cls, 0) ThenBlock: {
            cv = AIMacro.ClassAttrGet(cls, field)
            IfCondition EqualTo(Hash.IsHash(cv), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(cv, "__property__"), 0) ThenBlock: {
                    fget = Hash.Get(cv, "fget")
                    IfCondition NotEqual(fget, 0) ThenBlock: {
                        ReturnValue(CallIndirect(fget, AIMacro.PackCallArgs(obj, 0)))
                    }
                }
            }
            IfCondition NotEqual(cv, 0) ThenBlock: {
                ReturnValue(cv)
            }
        }
        IfCondition EqualTo(OOP.MethodExists(obj, "__getattr__"), 1) ThenBlock: {
            gargs = AIMacro.EmptyList()
            Array.Push(gargs, field)
            ReturnValue(OOP.MethodCall(obj, "__getattr__", gargs))
        }
        ReturnValue(0)
    }
}

// sys.hash_info — 32-bit values matching emitted sys.maxsize.
Function.AIMacro.SysHashInfo {
    Output: Address
    Body: {
        h = Hash.Create(16)
        Hash.Set(h, "width", 32)
        Hash.Set(h, "modulus", 2147483647)
        Hash.Set(h, "inf", 314159)
        Hash.Set(h, "nan", 0)
        Hash.Set(h, "imag", 1000003)
        Hash.Set(h, "algorithm", "siphash24")
        Hash.Set(h, "hash_bits", 32)
        Hash.Set(h, "seed_bits", 64)
        Hash.Set(h, "cutoff", 0)
        ReturnValue(h)
    }
}

Function.AIMacro.ObjectSet {
    Input: obj: Address
    Input: field: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(obj), 0) ThenBlock: {
            ReturnValue(0)
        }
        data = Hash.Get(obj, "__data__")
        IfCondition EqualTo(data, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(data), 0) ThenBlock: {
            ReturnValue(0)
        }
        Hash.Set(data, field, value)
        ReturnValue(1)
    }
}

// Packed __init__ (UUID has 8 params) expects one p__args array including self.
// OOP.ObjectNewInit CallIndirects unpacked (self, arg0, ...) and SIGSEGV's Hash.Get on int keys.
Function.AIMacro.ObjectNewInitPacked {
    Input: class_name: Address
    Input: init_args: Address
    Output: Address
    Body: {
        obj = OOP.ObjectNew(class_name)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(OOP.MethodExists(obj, "__init__"), 0) ThenBlock: {
            IfCondition And(NotEqual(init_args, 0), GreaterThan(Array.Size(init_args), 0)) ThenBlock: {
                v0 = Array.Get(init_args, 0)
                Hash.Set(obj, "__int__", v0)
                data0 = Hash.Get(obj, "__data__")
                IfCondition EqualTo(Hash.IsHash(data0), 1) ThenBlock: {
                    Hash.Set(data0, "__int__", v0)
                }
                IfCondition EqualTo(Array.IsArray(v0), 1) ThenBlock: {
                    Hash.Set(obj, "__list__", v0)
                    IfCondition EqualTo(Hash.IsHash(data0), 1) ThenBlock: {
                        Hash.Set(data0, "__list__", v0)
                    }
                }
            }
            ReturnValue(obj)
        }
        n = 0
        IfCondition NotEqual(init_args, 0) ThenBlock: {
            n = Array.Size(init_args)
        }
        pack = Array.Create(Add(n, 1))
        Array.Push(pack, obj)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(pack, Array.Get(init_args, i))
            i = Add(i, 1)
        }
        cls = Hash.Get(obj, "__class__")
        func = OOP._MethodLookupWithInheritance(cls, "__init__")
        IfCondition NotEqual(func, 0) ThenBlock: {
            CallIndirect(func, pack)
        }
        ReturnValue(obj)
    }
}

// Packed methods unpack p__args by index; missing slots are Python defaults (None).
Function.AIMacro.PackedGet {
    Input: args: Address
    Input: index: Integer
    Input: default: Address
    Output: Address
    Body: {
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(default)
        }
        IfCondition EqualTo(Array.IsArray(args), 0) ThenBlock: {
            ReturnValue(default)
        }
        n = Array.Size(args)
        IfCondition GreaterEqual(index, n) ThenBlock: {
            ReturnValue(default)
        }
        IfCondition LessThan(index, 0) ThenBlock: {
            ReturnValue(default)
        }
        v = Array.Get(args, index)
        IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(v, "__kwargs__"), 0) ThenBlock: {
                ReturnValue(default)
            }
        }
        ReturnValue(v)
    }
}

Function.AIMacro.PackedRest {
    Input: args: Address
    Input: index: Integer
    Output: Address
    Body: {
        out = AIMacro.EmptyList()
        IfCondition Or(EqualTo(args, 0), EqualTo(Array.IsArray(args), 0)) ThenBlock: {
            ReturnValue(out)
        }
        n = Array.Size(args)
        i = index
        WhileLoop LessThan(i, n) {
            v = Array.Get(args, i)
            skip = 0
            IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(v, "__kwargs__"), 0) ThenBlock: {
                    skip = 1
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                Array.Push(out, v)
            }
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

Function.AIMacro.PackedKw {
    Input: args: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(args, 0), EqualTo(Array.IsArray(args), 0)) ThenBlock: {
            h = Hash.Create(4)
            Hash.Set(h, "__kwargs__", 1)
            ReturnValue(h)
        }
        n = Array.Size(args)
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            v = Array.Get(args, i)
            IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
                IfCondition NotEqual(Hash.Get(v, "__kwargs__"), 0) ThenBlock: {
                    ReturnValue(v)
                }
            }
            i = Subtract(i, 1)
        }
        h = Hash.Create(4)
        Hash.Set(h, "__kwargs__", 1)
        ReturnValue(h)
    }
}

Function.AIMacro.PackCallArgs {
    Input: obj: Address
    Input: args: Address
    Output: Address
    Body: {
        pargs = AIMacro.EmptyList()
        Array.Push(pargs, obj)
        IfCondition And(NotEqual(args, 0), EqualTo(Array.IsArray(args), 1)) ThenBlock: {
            n = Array.Size(args)
            i = 0
            WhileLoop LessThan(i, n) {
                Array.Push(pargs, Array.Get(args, i))
                i = Add(i, 1)
            }
        }
        ReturnValue(pargs)
    }
}

Function.AIMacro.SmartCount {
    Input: obj: Address
    Input: item: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue(AIMacro.ListCount(obj, item))
        }
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(String.Count(obj, item))
    }
}

Function.AIMacro.Strip {
    Input: str: Address
    Input: chars: Address
    Output: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue("")
        }
        IfCondition Or(EqualTo(chars, 0), EqualTo(StringLength(chars), 0)) ThenBlock: {
            ReturnValue(String.Strip(str))
        }
        n = StringLength(str)
        start = 0
        WhileLoop LessThan(start, n) {
            c = GetByte(str, start)
            found = 0
            j = 0
            clen = StringLength(chars)
            WhileLoop LessThan(j, clen) {
                IfCondition EqualTo(GetByte(chars, j), c) ThenBlock: {
                    found = 1
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                BreakLoop
            }
            start = Add(start, 1)
        }
        end = n
        WhileLoop GreaterThan(end, start) {
            c = GetByte(str, Subtract(end, 1))
            found = 0
            j = 0
            clen = StringLength(chars)
            WhileLoop LessThan(j, clen) {
                IfCondition EqualTo(GetByte(chars, j), c) ThenBlock: {
                    found = 1
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                BreakLoop
            }
            end = Subtract(end, 1)
        }
        slen = Subtract(end, start)
        out = Allocate(Add(slen, 1))
        k = 0
        WhileLoop LessThan(k, slen) {
            SetByte(out, k, GetByte(str, Add(start, k)))
            k = Add(k, 1)
        }
        SetByte(out, slen, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.NoOp {
    Input: a: Address
    Output: Address
    Body: {
        ReturnValue(0)
    }
}

Function.AIMacro.InitSink {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        ReturnValue(a)
    }
}

Function.AIMacro.HtmlEscape {
    Input: s: Address
    Input: quote: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(s) }
        IfCondition EqualTo(AIMacro.LooksLikeString(s), 0) ThenBlock: { ReturnValue(s) }
        n = StringLength(s)
        out = Allocate(Add(Multiply(n, 6), 1))
        oi = 0
        q = 1
        IfCondition NotEqual(quote, 0) ThenBlock: {
            qb = AIMacro.SmartBool(quote)
            IfCondition EqualTo(qb, 0) ThenBlock: {
                q = 0
            }
        }
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 92) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
            IfCondition EqualTo(ch, 38) ThenBlock: {
                SetByte(out, oi, 38)
                oi = Add(oi, 1)
                SetByte(out, oi, 97)
                oi = Add(oi, 1)
                SetByte(out, oi, 109)
                oi = Add(oi, 1)
                SetByte(out, oi, 112)
                oi = Add(oi, 1)
                SetByte(out, oi, 59)
                oi = Add(oi, 1)
            } ElseBlock: {
                IfCondition EqualTo(ch, 60) ThenBlock: {
                    SetByte(out, oi, 38)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 108)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 116)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 59)
                    oi = Add(oi, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 62) ThenBlock: {
                        SetByte(out, oi, 38)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 103)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 116)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 59)
                        oi = Add(oi, 1)
                    } ElseBlock: {
                        IfCondition And(EqualTo(q, 1), EqualTo(ch, 34)) ThenBlock: {
                            SetByte(out, oi, 38)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 113)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 117)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 111)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 116)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 59)
                            oi = Add(oi, 1)
                        } ElseBlock: {
                            IfCondition And(EqualTo(q, 1), EqualTo(ch, 39)) ThenBlock: {
                                SetByte(out, oi, 38)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 35)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 120)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 50)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 55)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 59)
                                oi = Add(oi, 1)
                            } ElseBlock: {
                                SetByte(out, oi, ch)
                                oi = Add(oi, 1)
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
            }
        }
        SetByte(out, oi, 0)
        ReturnValue(out)
    }
}

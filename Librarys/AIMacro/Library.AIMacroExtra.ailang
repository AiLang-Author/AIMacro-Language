}

Function.AIMacro.Super {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.AIMacro.SliceBoundOk {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(v), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(v, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Types.IsBool(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(GreaterEqual(v, 0), LessThan(v, 4000000)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition LessThan(v, TypeMagic.PTR_MIN) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.Slice {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        start = a
        stop = b
        step = c
        IfCondition EqualTo(AIMacro.SliceBoundOk(b), 0) ThenBlock: {
            start = 0
            stop = a
            step = 1
        } ElseBlock: {
            IfCondition EqualTo(AIMacro.SliceBoundOk(c), 0) ThenBlock: {
                step = 1
            }
        }
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "slice")
        Hash.Set(h, "start", start)
        Hash.Set(h, "stop", stop)
        Hash.Set(h, "step", step)
        ReturnValue(h)
    }
}

Function.AIMacro.SliceIndices {
    Input: slc: Address
    Input: length: Address
    Output: Address
    Body: {
        start = 0
        stop = length
        step = 1
        IfCondition EqualTo(Hash.IsHash(slc), 1) ThenBlock: {
            start = Hash.Get(slc, "start")
            stop = Hash.Get(slc, "stop")
            step = Hash.Get(slc, "step")
        }
        start = AIMacro.AsIndex(start)
        stop = AIMacro.AsIndex(stop)
        step = AIMacro.AsIndex(step)
        length = AIMacro.AsIndex(length)
        IfCondition Or(EqualTo(step, 0), GreaterEqual(step, 4000000)) ThenBlock: {
            step = 1
        }
        IfCondition GreaterEqual(start, 4000000) ThenBlock: {
            start = 0
        }
        IfCondition GreaterEqual(stop, 4000000) ThenBlock: {
            stop = length
        }
        out = AIMacro.ArrayNew(3)
        Array.Push(out, start)
        Array.Push(out, stop)
        Array.Push(out, step)
        ReturnValue(out)
    }
}

Function.AIMacro.ObjectType {
    Output: Integer
    Body: {
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "object")
        ReturnValue(h)

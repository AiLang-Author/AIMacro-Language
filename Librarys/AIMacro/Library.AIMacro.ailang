// =============================================================================
// TYPED LIST CREATION - Use for user-visible lists that might be type-checked
// Creates TArray (with magic number) instead of XArray
// =============================================================================
Function.AIMacro.EmptyList {
    Output: Address
    Body: {
        ReturnValue(Array.Create(1))
    }
}

Function.AIMacro.ArrayNew {
    Input: cap: Integer
    Output: Address
    Body: {
        IfCondition Or(LessThan(cap, 1), GreaterEqual(cap, TypeMagic.HEAP_START)) ThenBlock: {
            cap = 1
        }
        IfCondition GreaterThan(cap, 65536) ThenBlock: {
            cap = 65536
        }
        ReturnValue(Array.Create(cap))
    }
}

Function.AIMacro.SysMaxsize {
    Output: Address
    Body: {
        ReturnValue(AIMacro.BigIntFromDigits("9223372036854775807", 0))
    }
}

Function.AIMacro.TypedListCreate {
    Input: capacity: Integer
    Output: Address
    Body: {
        list = Array.Create(capacity)
        ReturnValue(list)
    }
}

Function.AIMacro.TypedListPush {
    Input: list: Address
    Input: item: Address
    Body: {
        Array.Push(list, item)
    }
}

Function.AIMacro.TypedListGet {
    Input: list: Address
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(Array.Get(list, index))
    }
}

Function.AIMacro.TypedListSet {
    Input: list: Address
    Input: index: Integer
    Input: value: Address
    Body: {
        Array.Set(list, index, value)
    }
}

Function.AIMacro.TypedListSize {
    Input: list: Address
    Output: Integer
    Body: {
        ReturnValue(Array.Size(list))
    }
}

Function.AIMacro.TypedListPop {
    Input: list: Address
    Output: Address
    Body: {
        ReturnValue(Array.Pop(list))
    }
}

// =============================================================================
// SMART LEN - Works with both XArray and TArray
// Checks magic number to determine which size function to call
// =============================================================================
// CanDeref is 1 for [4000000, 500000000). The loaded image sits at the
// bottom of that band (these ELFs end near 5MB). A raw int at or above
// 16MB, such as 123456789, is not a string or a code address.
Function.AIMacro.InPtrHole {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition LessThan(value, 16777216) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(value, 500000000) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.SmartLen {
    Input: container: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(AIMacro.IntZero())
        }
        IfCondition EqualTo(AIMacro.IsNone(container), 1) ThenBlock: {
            ReturnValue(AIMacro.IntZero())
        }
        IfCondition EqualTo(AIMacro.InPtrHole(container), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "object of type 'int' has no len()")
            ReturnValue(AIMacro.IntZero())
        }
        // And() is not short-circuit, so a raw int was passed to Hash.IsHash.
        IfCondition EqualTo(Types.CanDeref(container), 1) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(container), 1) ThenBlock: {
            wlen = Hash.Get(container, "__list__")
            IfCondition EqualTo(Array.IsArray(wlen), 1) ThenBlock: {
                ReturnValue(Array.Size(wlen))
            }
            cls_len = Hash.Get(container, "__class__")
            IfCondition NotEqual(cls_len, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(cls_len, "range"), 0) ThenBlock: {
                    ReturnValue(AIMacro.RangeLen(container))
                }
            }
            IfCondition And(EqualTo(Hash.Contains(container, "__class__"), 1), EqualTo(OOP.MethodExists(container, "__len__"), 1)) ThenBlock: {
                largs = Array.Create(0)
                n = OOP.MethodCall(container, "__len__", largs)
                IfCondition EqualTo(AIMacro.LooksLikeString(n), 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "__len__ should return >= 0")
                    ReturnValue(AIMacro.IntZero())
                }
                n = AIMacro.UnboxIntZero(n)
                IfCondition LessThan(n, 0) ThenBlock: {
                    AIMacro.RaiseKind(2, "__len__ should return >= 0")
                    ReturnValue(AIMacro.IntZero())
                }
                IfCondition GreaterEqual(n, TypeMagic.HEAP_START) ThenBlock: {
                    AIMacro.RaiseKind(2, "__len__ should return >= 0")
                    ReturnValue(AIMacro.IntZero())
                }
                ReturnValue(n)
            }
            ReturnValue(Hash.Size(container))
            }
            IfCondition EqualTo(Array.IsArray(container), 1) ThenBlock: {
                ReturnValue(Array.Size(container))
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(container), 1) ThenBlock: {
            ReturnValue(StringLength(container))
        }
        // Integer 42 used to strlen(42) — leftover match [1,2] against 42.
        AIMacro.RaiseKind(5, "len")
        ReturnValue(AIMacro.IntZero())
    }
}

// =============================================================================
// SMART GET - Works with both XArray and TArray
// =============================================================================
Function.AIMacro.SmartGet {
    Input: container: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(container)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            ReturnValue(Array.Get(container, index))
        }
        
        // Default to XArray
        ReturnValue(Array.Get(container, index))
    }
}

// =============================================================================
// SMART SET - Works with both XArray and TArray
// =============================================================================
Function.AIMacro.SmartSet {
    Input: container: Address
    Input: index: Integer
    Input: value: Address
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(container)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            Array.Set(container, index, value)
            ReturnValue(0)
        }
        
        Array.Set(container, index, value)
    }
}

// =============================================================================
// SMART PUSH - Works with both XArray and TArray
// =============================================================================
Function.AIMacro.SmartPush {
    Input: container: Address
    Input: item: Address
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(container)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            Array.Push(container, item)
            ReturnValue(0)
        }
        
        Array.Push(container, item)
    }
}

// =============================================================================
// TYPED SORTED - Returns TArray for type-safe result
// =============================================================================
Function.AIMacro.TypedSorted {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(Array.Create(0))
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(list), 1) ThenBlock: {
            list = AIMacro.ListFrom(list)
        }
        
        // Get size - handle both XArray and TArray input
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(Array.Create(0))
        }
        
        // Create typed result
        result = Array.Create(size)
        
        // Copy elements
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                item = Array.Get(list, i)
            } ElseBlock: {
                item = Array.Get(list, i)
            }
            Array.Push(result, item)
            i = Add(i, 1)
        }
        
        // Insertion sort
        i = 1
        WhileLoop LessThan(i, size) {
            key = Array.Get(result, i)
            j = Subtract(i, 1)
            
            continue_shift = 1
            WhileLoop EqualTo(continue_shift, 1) {
                IfCondition LessThan(j, 0) ThenBlock: {
                    continue_shift = 0
                } ElseBlock: {
                    curr_val = Array.Get(result, j)
                    IfCondition GreaterThan(curr_val, key) ThenBlock: {
                        Array.Set(result, Add(j, 1), curr_val)
                        j = Subtract(j, 1)
                    } ElseBlock: {
                        continue_shift = 0
                    }
                }
            }
            
            Array.Set(result, Add(j, 1), key)
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}

Function.AIMacro.KeyOf {
    Input: item: Address
    Input: keyfn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(keyfn, 0) ThenBlock: {
            ReturnValue(item)
        }
        ReturnValue(AIMacro.SmartCall1(keyfn, item))
    }
}

Function.AIMacro.TypedSortedKey {
    Input: list: Address
    Input: keyfn: Address
    Input: reverse: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(Array.Create(0))
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(list), 1) ThenBlock: {
            list = AIMacro.ListFrom(list)
        }
        size = Array.Size(list)
        result = Array.Create(size)
        i = 0
        WhileLoop LessThan(i, size) {
            Array.Push(result, Array.Get(list, i))
            i = Add(i, 1)
        }
        IfCondition LessThan(size, 2) ThenBlock: {
            ReturnValue(result)
        }
        rev = AIMacro.BoolVal(reverse)
        i = 1
        WhileLoop LessThan(i, size) {
            item = Array.Get(result, i)
            ikey = AIMacro.KeyOf(item, keyfn)
            j = Subtract(i, 1)
            continue_shift = 1
            WhileLoop EqualTo(continue_shift, 1) {
                IfCondition LessThan(j, 0) ThenBlock: {
                    continue_shift = 0
                } ElseBlock: {
                    curr = Array.Get(result, j)
                    ckey = AIMacro.KeyOf(curr, keyfn)
                    do_shift = 0
                    IfCondition EqualTo(rev, 1) ThenBlock: {
                        do_shift = AIMacro.SmartBool(AIMacro.NumLt(ckey, ikey))
                    } ElseBlock: {
                        do_shift = AIMacro.SmartBool(AIMacro.NumGt(ckey, ikey))
                    }
                    IfCondition EqualTo(do_shift, 1) ThenBlock: {
                        Array.Set(result, Add(j, 1), curr)
                        j = Subtract(j, 1)
                    } ElseBlock: {
                        continue_shift = 0
                    }
                }
            }
            Array.Set(result, Add(j, 1), item)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// TYPED REVERSED - Returns TArray
// =============================================================================
Function.AIMacro.TypedReversed {
    Input: list: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.Reversed(list))
    }
}

Function.AIMacro.ReverseIter {
    Input: items: Address
    Output: Address
    Body: {
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "list")
        Hash.Set(h, "__items__", items)
        Hash.Set(h, "__pos__", 0)
        ReturnValue(h)
    }
}

// =============================================================================
// TYPED LIST COPY - Returns TArray
// =============================================================================
Function.AIMacro.TypedListCopy {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(Array.Create(0))
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        result = Array.Create(size)
        
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                item = Array.Get(list, i)
            } ElseBlock: {
                item = Array.Get(list, i)
            }
            Array.Push(result, item)
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}


// =============================================================================
// SMART POP - Works with both array types
// =============================================================================
Function.AIMacro.SmartPop {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            ReturnValue(Array.Pop(list))
        }
        
        // XArray
        len = Array.Size(list)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            item = Array.Get(list, Subtract(len, 1))
            Array.Pop(list)
            ReturnValue(item)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SMART CLEAR - Works with both array types
// =============================================================================
Function.AIMacro.SmartClear {
    Input: list: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            Array.Clear(list)
            ReturnValue(0)
        }
        
        Array.Clear(list)
    }
}


// =============================================================================
// SMART POP AT INDEX - Remove and return item at position
// Works with both array types
// =============================================================================
Function.AIMacro.SmartPopAt {
    Input: list: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Handle negative index
        IfCondition LessThan(index, 0) ThenBlock: {
            index = Add(size, index)
        }
        
        // Bounds check
        IfCondition LessThan(index, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(index, size) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get the item to return
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            item = Array.Get(list, index)
        } ElseBlock: {
            item = Array.Get(list, index)
        }
        
        // Shift everything left from index+1 to end
        i = index
        WhileLoop LessThan(i, Subtract(size, 1)) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                next_item = Array.Get(list, Add(i, 1))
                Array.Set(list, i, next_item)
            } ElseBlock: {
                next_item = Array.Get(list, Add(i, 1))
                Array.Set(list, i, next_item)
            }
            i = Add(i, 1)
        }
        
        // Remove the last element
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            Array.Pop(list)
        } ElseBlock: {
            Array.Pop(list)
        }
        
        ReturnValue(item)
    }
}
// =============================================================================
// SMART SIZE - Works with both array types
// =============================================================================
Function.AIMacro.SmartSize {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(list), 1) ThenBlock: {
            ReturnValue(Array.Size(list))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(list), 1) ThenBlock: {
            ReturnValue(StringLength(list))
        }
        IfCondition EqualTo(Hash.IsHash(list), 1) ThenBlock: {
            ca = Hash.Get(list, "__class__")
            IfCondition NotEqual(ca, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(ca, "range"), 0) ThenBlock: {
                    rl = AIMacro.RangeLen(list)
                    ReturnValue(rl)
                }
            }
            wlst = Hash.Get(list, "__list__")
            IfCondition EqualTo(Array.IsArray(wlst), 1) ThenBlock: {
                ReturnValue(Array.Size(wlst))
            }
            ReturnValue(Hash.Size(list))
        }
        ReturnValue(0)
    }
}


// =============================================================================
// SMART ANY - Works with both array types
// =============================================================================
Function.AIMacro.SmartAny {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                item = Array.Get(list, i)
            } ElseBlock: {
                item = Array.Get(list, i)
            }
            IfCondition NotEqual(item, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// SMART ALL - Works with both array types
// =============================================================================
Function.AIMacro.SmartAll {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                item = Array.Get(list, i)
            } ElseBlock: {
                item = Array.Get(list, i)
            }
            IfCondition EqualTo(item, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// SMART SUM - Works with both array types
// =============================================================================
Function.AIMacro.SmartSum {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(list), 1) ThenBlock: {
            list = AIMacro.ListFrom(list)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        total = 0
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                item = Array.Get(list, i)
            } ElseBlock: {
                item = Array.Get(list, i)
            }
            item = AIMacro.UnboxIntZero(item)
            total = Add(total, item)
            i = Add(i, 1)
        }
        
        ReturnValue(total)
    }
}

// =============================================================================
// SMART LIST INDEX - Find position of item in either array type
// =============================================================================
Function.AIMacro.SmartListIndex {
    Input: list: Address
    Input: item: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                current = Array.Get(list, i)
            } ElseBlock: {
                current = Array.Get(list, i)
            }
            IfCondition EqualTo(current, item) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(-1)
    }
}

// =============================================================================
// SMART LIST CONTAINS - Check if item exists in either array type
// =============================================================================
Function.AIMacro.SmartListContains {
    Input: list: Address
    Input: item: Integer
    Output: Integer
    Body: {
        idx = AIMacro.SmartListIndex(list, item)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SMART LIST COUNT - Count occurrences in either array type
// =============================================================================
Function.AIMacro.SmartListCount {
    Input: list: Address
    Input: item: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        is_tarray = Array.IsArray(list)
        IfCondition EqualTo(is_tarray, 1) ThenBlock: {
            size = Array.Size(list)
        } ElseBlock: {
            size = Array.Size(list)
        }
        
        count = 0
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(is_tarray, 1) ThenBlock: {
                current = Array.Get(list, i)
            } ElseBlock: {
                current = Array.Get(list, i)
            }
            IfCondition EqualTo(current, item) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}
// =============================================================================
// ISINSTANCE - Check if value matches a type
// Usage: isinstance(value, type_id)
// Returns: 1 if match, 0 if not
//
// Note: In our system, we can't truly distinguish types at runtime since
// everything is an integer/address. This uses heuristics:
// - Small values (0-1000000) are likely integers
// - Large values are likely addresses (strings, lists)
// - We can check XArray header for lists
// - We can check string structure for strings
// =============================================================================
Function.AIMacro.IsInstance {
    Input: value: Address
    Input: type_id: Integer
    Output: Address
    Body: {
        // assertIsInstance(x, str) passes AddressOf(AIMacro.Str), not TypeID.STR.
        IfCondition EqualTo(type_id, AddressOf(AIMacro.Str)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Types.IsString(value)))
        }
        IfCondition EqualTo(type_id, AddressOf(AIMacro.Int)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Types.IsInt(value)))
        }
        IfCondition EqualTo(type_id, AddressOf(AIMacro.Float)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Types.IsFloat(value)))
        }
        IfCondition EqualTo(type_id, AddressOf(AIMacro.Bool)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Types.IsBool(value)))
        }
        IfCondition EqualTo(type_id, AddressOf(AIMacro.List)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Types.IsList(value)))
        }
        IfCondition EqualTo(type_id, AddressOf(AIMacro.Tuple)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Types.IsList(value)))
        }
        IfCondition EqualTo(type_id, AddressOf(AIMacro.Dict)) ThenBlock: {
            ish_d = Hash.IsHash(value)
            IfCondition EqualTo(ish_d, 1) ThenBlock: {
                dcls = Hash.Get(value, "__class__")
                IfCondition EqualTo(dcls, 0) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                IfCondition EqualTo(AIMacro.LooksLikeString(dcls), 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(dcls, "dict"), 0) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                }
                ReturnValue(AIMacro.FalseVal())
            }
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(value), 1) ThenBlock: {
            cls = Hash.Get(value, "__class__")
            IfCondition EqualTo(cls, type_id) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(type_id), 1) ThenBlock: {
                IfCondition EqualTo(AIMacro.LooksLikeString(cls), 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(cls, type_id), 0) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                    oi = OOP.ObjectIsInstance(value, type_id)
                    IfCondition EqualTo(oi, 1) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                }
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(type_id), 1) ThenBlock: {
            ishv = AIMacro.SafeIsHash(value)
            IfCondition EqualTo(ishv, 1) ThenBlock: {
                oi2 = OOP.ObjectIsInstance(value, type_id)
                IfCondition EqualTo(oi2, 1) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
            }
        }
        IfCondition And(GreaterEqual(value, 0), LessThan(value, 4000000)) ThenBlock: {
            subn = AIMacro.IsSubclass(AddressOf(AIMacro.Int), type_id)
            IfCondition EqualTo(AIMacro.SmartBool(subn), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
        }
        pt = AIMacro.PyType(value)
        subok = AIMacro.IsSubclass(pt, type_id)
        IfCondition EqualTo(AIMacro.SmartBool(subok), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        ReturnValue(AIMacro.Bool(Types.IsInstance(value, type_id)))
    }
}

// =============================================================================
// TYPE - Return type ID of a value
// =============================================================================
Function.AIMacro.Type {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(value), 1) ThenBlock: {
            ReturnValue(TypeID.NONE)
        }
        
        IfCondition EqualTo(value, 0) ThenBlock: {
            ReturnValue(TypeID.INT)
        }
        
        IfCondition LessThan(value, 4000000) ThenBlock: {
            ReturnValue(TypeID.INT)
        }
        
        // Check if it looks like a list (XArray)
        capacity = Dereference(value)
        size = Dereference(Add(value, 8))
        IfCondition And(GreaterThan(capacity, 0), LessEqual(capacity, 10000)) ThenBlock: {
            IfCondition LessEqual(size, capacity) ThenBlock: {
                ReturnValue(TypeID.LIST)
            }
        }
        
        // Check if it looks like a string
        first_byte = GetByte(value, 0)
        IfCondition Or(EqualTo(first_byte, 0), And(GreaterEqual(first_byte, 32), LessEqual(first_byte, 126))) ThenBlock: {
            ReturnValue(TypeID.STR)
        }
        
        // Default to int for unknown
        ReturnValue(TypeID.INT)
    }
}

// =============================================================================
// CORE BUILT-IN FUNCTIONS
// =============================================================================

Function.AIMacro.Print {
    Input: value: Address
    Body: {
        // Handle different types - simplified for now
        // Just print the value directly
        // This is the old, buggy way. Replaced by SmartPrint.
        PrintMessage(value) 
    }
}

Function.AIMacro.LooksLikeString {
    Input: value: Address
    Output: Integer
    Body: {
        // 0x440000: ELF code is 0x400000–data. Function pointers are not C strings.
        IfCondition Or(EqualTo(value, 0), LessThan(value, 4456448)) ThenBlock: {
            ReturnValue(0)
        }
        // 2^32 and other unboxed ints sit above ELF data and below mmap heap (2^40).
        IfCondition And(GreaterEqual(value, 500000000), LessThan(value, 1099511627776)) ThenBlock: {
            ReturnValue(0)
        }
        // 2^63-1 and other unboxed ints above user mmap (2^47). GetByte is non-canonical SEGV.
        // leftover test_grammar: 0 == 9223372036854775807 (sys.maxsize).
        IfCondition GreaterEqual(value, 140737488355328) ThenBlock: {
            ReturnValue(0)
        }
        firstb = GetByte(value, 0)
        IfCondition EqualTo(firstb, 85) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(value, TypeMagic.PTR_MIN) ThenBlock: {
            IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(Types.IsComplex(value), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(Types.IsBigInt(value), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(Array.IsArray(value), 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(Hash.IsHash(value), 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        ReturnValue(1)
    }
}

Function.AIMacro.IsExc {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Plex_State.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Unboxed ints and leftover-0/1 must never look like Plex objects.
        // Plex.IsLive(1) is true and Str(1) would print "StopIteration".
        IfCondition LessThan(value, 4000000) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Plex.IsLive(value), 0) ThenBlock: {
            ReturnValue(0)
        }
        t = Plex.Type(value)
        IfCondition And(GreaterEqual(t, 20000), LessThan(t, 20100)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.ExcStr {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.IsExc(value), 0) ThenBlock: {
            ReturnValue("")
        }
        m = Plex.Get(value, 0)
        IfCondition EqualTo(m, 0) ThenBlock: {
            ReturnValue("")
        }
        ReturnValue(m)
    }
}

FixedPool.AIMacroBool {
    "true_box": Initialize=0, CanChange=True
    "false_box": Initialize=0, CanChange=True
    "recdepth": Initialize=0, CanChange=True
}

Function.AIMacro.TrueVal {
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacroBool.true_box, 0) ThenBlock: {
            h = Allocate(16)
            StoreValue(h, TypeMagic.BOOL)
            StoreValue(Add(h, 8), 1)
            AIMacroBool.true_box = h
        }
        ReturnValue(AIMacroBool.true_box)
    }
}

Function.AIMacro.FalseVal {
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacroBool.false_box, 0) ThenBlock: {
            h = Allocate(16)
            StoreValue(h, TypeMagic.BOOL)
            StoreValue(Add(h, 8), 0)
            AIMacroBool.false_box = h
        }
        ReturnValue(AIMacroBool.false_box)
    }
}

Function.AIMacro.BoolVal {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
            ReturnValue(Dereference(Add(value, 8)))
        }
        ReturnValue(AIMacro.UnboxIntZero(value))
    }
}

Function.AIMacro.UnboxIntZero {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Types.IsBigInt(v), 1) ThenBlock: {
            sign = Dereference(Add(v, 8))
            digs = Dereference(Add(v, 16))
            IfCondition EqualTo(digs, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(StringCompare(digs, "0"), 0) ThenBlock: {
                ReturnValue(0)
            }
            ln = StringLength(digs)
            IfCondition GreaterThan(ln, 6) ThenBlock: {
                ReturnValue(v)
            }
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(Subtract(0, StringToNumber(digs)))
            }
            ReturnValue(StringToNumber(digs))
        }
        ReturnValue(v)
    }
}

// 0..255, or -1 after TypeError / ValueError. Does not look up methods.
Function.AIMacro.ByteFit {
    Input: el: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(el), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(-1)
        }
        IfCondition EqualTo(Types.IsBool(el), 1) ThenBlock: {
            ReturnValue(AIMacro.BoolVal(el))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(el), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(-1)
        }
        IfCondition EqualTo(Types.IsFloat(el), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(-1)
        }
        IfCondition EqualTo(Types.IsComplex(el), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(-1)
        }
        n = el
        IfCondition EqualTo(Types.IsBigInt(el), 1) ThenBlock: {
            n = AIMacro.UnboxIntZero(el)
        } ElseBlock: {
            IfCondition EqualTo(AIMacro.SafeIsHash(el), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "TypeError")
                ReturnValue(-1)
            }
            IfCondition EqualTo(AIMacro.SafeIsArray(el), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "TypeError")
                ReturnValue(-1)
            }
        }
        IfCondition LessThan(n, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "ValueError")
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(n, 256) ThenBlock: {
            AIMacro.RaiseKind(2, "ValueError")
            ReturnValue(-1)
        }
        ReturnValue(n)
    }
}

// kind 1 is b'...'. kind 2 is bytearray(b'...').
Function.AIMacro.BytesRepr {
    Input: lst: Address
    Input: kind: Integer
    Output: Address
    Body: {
        n = 0
        IfCondition EqualTo(Array.IsArray(lst), 1) ThenBlock: {
            n = Array.Size(lst)
        }
        cap = Multiply(n, 4)
        cap = Add(cap, 24)
        out = Allocate(cap)
        j = 0
        IfCondition EqualTo(kind, 2) ThenBlock: {
            pre = "bytearray(b'"
            pn = StringLength(pre)
            pi = 0
            WhileLoop LessThan(pi, pn) {
                pb = GetByte(pre, pi)
                SetByte(out, j, pb)
                j = Add(j, 1)
                pi = Add(pi, 1)
            }
        } ElseBlock: {
            SetByte(out, j, 98)
            j = Add(j, 1)
            SetByte(out, j, 39)
            j = Add(j, 1)
        }
        digs = "0123456789abcdef"
        i = 0
        WhileLoop LessThan(i, n) {
            c = Array.Get(lst, i)
            plain = 0
            IfCondition And(GreaterEqual(c, 32), LessEqual(c, 126)) ThenBlock: {
                IfCondition NotEqual(c, 39) ThenBlock: {
                    IfCondition NotEqual(c, 92) ThenBlock: {
                        plain = 1
                    }
                }
            }
            IfCondition EqualTo(plain, 1) ThenBlock: {
                SetByte(out, j, c)
                j = Add(j, 1)
            } ElseBlock: {
                esc = 0
                IfCondition EqualTo(c, 92) ThenBlock: {
                    esc = 92
                }
                IfCondition EqualTo(c, 39) ThenBlock: {
                    esc = 39
                }
                IfCondition EqualTo(c, 10) ThenBlock: {
                    esc = 110
                }
                IfCondition EqualTo(c, 13) ThenBlock: {
                    esc = 114
                }
                IfCondition EqualTo(c, 9) ThenBlock: {
                    esc = 116
                }
                SetByte(out, j, 92)
                j = Add(j, 1)
                IfCondition NotEqual(esc, 0) ThenBlock: {
                    SetByte(out, j, esc)
                    j = Add(j, 1)
                } ElseBlock: {
                    SetByte(out, j, 120)
                    j = Add(j, 1)
                    hi = Divide(c, 16)
                    prod = Multiply(hi, 16)
                    lo = Subtract(c, prod)
                    hb = GetByte(digs, hi)
                    SetByte(out, j, hb)
                    j = Add(j, 1)
                    lb = GetByte(digs, lo)
                    SetByte(out, j, lb)
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        SetByte(out, j, 39)
        j = Add(j, 1)
        IfCondition EqualTo(kind, 2) ThenBlock: {
            SetByte(out, j, 41)
            j = Add(j, 1)
        }
        SetByte(out, j, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.ReprQuote {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue("''")
        }
        n = StringLength(s)
        out = Allocate(Add(Multiply(n, 2), 3))
        SetByte(out, 0, 39)
        j = 1
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 92) ThenBlock: {
                SetByte(out, j, 92)
                j = Add(j, 1)
                SetByte(out, j, 92)
                j = Add(j, 1)
            } ElseBlock: {
                IfCondition EqualTo(c, 39) ThenBlock: {
                    SetByte(out, j, 92)
                    j = Add(j, 1)
                    SetByte(out, j, 39)
                    j = Add(j, 1)
                } ElseBlock: {
                    IfCondition EqualTo(c, 10) ThenBlock: {
                        SetByte(out, j, 92)
                        j = Add(j, 1)
                        SetByte(out, j, 110)
                        j = Add(j, 1)
                    } ElseBlock: {
                        SetByte(out, j, c)
                        j = Add(j, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        SetByte(out, j, 39)
        j = Add(j, 1)
        SetByte(out, j, 0)
        ReturnValue(out)
    }
}

FixedPool.AIMacroUnary {
    "hit": Initialize=0, CanChange=True
}

// Result of __repr__ / __str__ / __hash__. hit is 1 when the method ran.
// A zero result is a real return, so the caller reads the flag.
Function.AIMacro.CallUnary {
    Input: obj: Address
    Input: name: Address
    Output: Address
    Body: {
        AIMacroUnary.hit = 0
        IfCondition EqualTo(ClassRegistry.registry, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 0) ThenBlock: {
            ReturnValue(0)
        }
        cls = Hash.Get(obj, "__class__")
        IfCondition EqualTo(AIMacro.LooksLikeString(cls), 0) ThenBlock: {
            ReturnValue(0)
        }
        skip = 0
        IfCondition EqualTo(StringCompare(cls, "bytes"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "bytearray"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "list"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "tuple"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "set"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "frozenset"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "range"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "dict"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(StringCompare(cls, "module"), 0) ThenBlock: { skip = 1 }
        IfCondition EqualTo(skip, 1) ThenBlock: {
            ReturnValue(0)
        }
        has = OOP.MethodExists(obj, name)
        IfCondition EqualTo(has, 0) ThenBlock: {
            ReturnValue(0)
        }
        empty = AIMacro.EmptyList()
        AIMacroUnary.hit = 1
        ReturnValue(OOP.MethodCall(obj, name, empty))
    }
}

Function.AIMacro.PyHash {
    Input: a: Address
    Output: Address
    Body: {
        hv = AIMacro.CallUnary(a, "__hash__")
        IfCondition EqualTo(AIMacroUnary.hit, 1) ThenBlock: {
            ReturnValue(hv)
        }
        IfCondition EqualTo(AIMacro.IsIntSubclass(a), 1) ThenBlock: {
            ReturnValue(AIMacro.IntPayload(a))
        }
        ReturnValue(a)
    }
}

Function.AIMacro.Repr {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(value), 1) ThenBlock: {
            ReturnValue("None")
        }
        IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.BoolVal(value), 1) ThenBlock: {
                ReturnValue("True")
            }
            ReturnValue("False")
        }
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatStr(value))
        }
        IfCondition EqualTo(Types.IsBigInt(value), 1) ThenBlock: {
            ds = Dereference(Add(value, 16))
            IfCondition EqualTo(Dereference(Add(value, 8)), 1) ThenBlock: {
                ReturnValue(String.Concat("-", ds))
            }
            ReturnValue(ds)
        }
        IfCondition EqualTo(AIMacro.IsExc(value), 1) ThenBlock: {
            ReturnValue(AIMacro.ExcStr(value))
        }
        IfCondition GreaterEqual(value, TypeMagic.PTR_MIN) ThenBlock: {
            IfCondition EqualTo(Array.IsArray(value), 1) ThenBlock: {
                n = Array.Size(value)
                IfCondition EqualTo(n, 0) ThenBlock: {
                    ReturnValue("[]")
                }
                parts = Array.Create(n)
                i = 0
                WhileLoop LessThan(i, n) {
                    Array.Push(parts, AIMacro.Repr(Array.Get(value, i)))
                    i = Add(i, 1)
                }
                inner = String.Join(", ", parts)
                rb = String.Concat(inner, "]")
                ReturnValue(String.Concat("[", rb))
            }
            IfCondition EqualTo(Hash.IsHash(value), 1) ThenBlock: {
                rp = AIMacro.CallUnary(value, "__repr__")
                IfCondition EqualTo(AIMacroUnary.hit, 1) ThenBlock: {
                    IfCondition EqualTo(AIMacro.LooksLikeString(rp), 1) ThenBlock: {
                        ReturnValue(rp)
                    }
                }
                IfCondition EqualTo(AIMacro.IsIntSubclass(value), 1) ThenBlock: {
                    ip = AIMacro.IntPayload(value)
                    ReturnValue(AIMacro.Repr(ip))
                }
                cls_r = Hash.Get(value, "__class__")
                lst_r = Hash.Get(value, "__list__")
                IfCondition EqualTo(Array.IsArray(lst_r), 1) ThenBlock: {
                    IfCondition EqualTo(AIMacro.LooksLikeString(cls_r), 1) ThenBlock: {
                        IfCondition EqualTo(StringCompare(cls_r, "bytes"), 0) ThenBlock: {
                            ReturnValue(AIMacro.BytesRepr(lst_r, 1))
                        }
                        IfCondition EqualTo(StringCompare(cls_r, "bytearray"), 0) ThenBlock: {
                            ReturnValue(AIMacro.BytesRepr(lst_r, 2))
                        }
                    }
                    is_tup = 0
                    is_lst = 0
                    IfCondition EqualTo(AIMacro.LooksLikeString(cls_r), 1) ThenBlock: {
                        IfCondition EqualTo(StringCompare(cls_r, "tuple"), 0) ThenBlock: {
                            is_tup = 1
                        }
                        IfCondition EqualTo(StringCompare(cls_r, "list"), 0) ThenBlock: {
                            is_lst = 1
                        }
                        IfCondition Or(EqualTo(StringCompare(cls_r, "set"), 0), EqualTo(StringCompare(cls_r, "frozenset"), 0)) ThenBlock: {
                            nr = Array.Size(lst_r)
                            IfCondition EqualTo(nr, 0) ThenBlock: {
                                IfCondition EqualTo(StringCompare(cls_r, "frozenset"), 0) ThenBlock: {
                                    ReturnValue("frozenset()")
                                }
                                ReturnValue("set()")
                            }
                            parts = Array.Create(nr)
                            ir = 0
                            WhileLoop LessThan(ir, nr) {
                                el = Array.Get(lst_r, ir)
                                er = AIMacro.Repr(el)
                                Array.Push(parts, er)
                                ir = Add(ir, 1)
                            }
                            inner = String.Join(", ", parts)
                            IfCondition EqualTo(StringCompare(cls_r, "frozenset"), 0) ThenBlock: {
                                body = String.Concat("{", inner)
                                body = String.Concat(body, "}")
                                pre = String.Concat("frozenset(", body)
                                ReturnValue(String.Concat(pre, ")"))
                            }
                            op = String.Concat("{", inner)
                            ReturnValue(String.Concat(op, "}"))
                        }
                    }
                    IfCondition Or(EqualTo(is_tup, 1), EqualTo(is_lst, 1)) ThenBlock: {
                        nr = Array.Size(lst_r)
                        IfCondition EqualTo(nr, 0) ThenBlock: {
                            IfCondition EqualTo(is_tup, 1) ThenBlock: {
                                ReturnValue("()")
                            }
                            ReturnValue("[]")
                        }
                        parts = Array.Create(nr)
                        ir = 0
                        WhileLoop LessThan(ir, nr) {
                            el = Array.Get(lst_r, ir)
                            er = AIMacro.Repr(el)
                            Array.Push(parts, er)
                            ir = Add(ir, 1)
                        }
                        inner = String.Join(", ", parts)
                        IfCondition EqualTo(is_tup, 1) ThenBlock: {
                            IfCondition EqualTo(nr, 1) ThenBlock: {
                                one = String.Concat(inner, ",")
                                op = String.Concat("(", one)
                                ReturnValue(String.Concat(op, ")"))
                            }
                            op2 = String.Concat("(", inner)
                            ReturnValue(String.Concat(op2, ")"))
                        }
                        ob = String.Concat("[", inner)
                        ReturnValue(String.Concat(ob, "]"))
                    }
                }
                keys = Hash.Keys(value)
                n = Array.Size(keys)
                IfCondition EqualTo(n, 0) ThenBlock: {
                    ReturnValue("{}")
                }
                s = "{"
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        s = String.Concat(s, ", ")
                    }
                    k = Array.Get(keys, i)
                    s = String.Concat(s, AIMacro.Repr(k))
                    s = String.Concat(s, ": ")
                    vk = Hash.Get(value, k)
                    s = String.Concat(s, AIMacro.Repr(vk))
                    i = Add(i, 1)
                }
                ReturnValue(String.Concat(s, "}"))
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(value), 1) ThenBlock: {
            ReturnValue(AIMacro.ReprQuote(value))
        }
        ReturnValue(NumberToString(value))
    }
}

Function.AIMacro.SmartPrint {
    Input: value: Address
    Body: {
        PrintString(AIMacro.Str(value))
    }
}

Function.AIMacro.Len {
    Input: container: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get first byte as a character
        first_byte = GetByte(container, 0)
        
     
        
        field0 = ArrayGet(container, 0)
        
       
        
        IfCondition And(GreaterEqual(field0, 0), LessThan(field0, 1000000)) ThenBlock: {
            
            
            ReturnValue(field0)
        } ElseBlock: {
            // Large value means it's string data interpreted as int
            ReturnValue(StringLength(container))
        }
    }
}


FixedPool.ExcHold {
    "arg": Initialize=0, CanChange=True
    "obj": Initialize=0, CanChange=True
}

Function.AIMacro.Str {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(value), 1) ThenBlock: {
            ReturnValue("None")
        }
        IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.BoolVal(value), 1) ThenBlock: {
                ReturnValue("True")
            }
            ReturnValue("False")
        }
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatStr(value))
        }
        IfCondition EqualTo(Types.IsBigInt(value), 1) ThenBlock: {
            ds = Dereference(Add(value, 16))
            IfCondition EqualTo(Dereference(Add(value, 8)), 1) ThenBlock: {
                ReturnValue(String.Concat("-", ds))
            }
            ReturnValue(ds)
        }
        IfCondition EqualTo(AIMacro.IsExc(value), 1) ThenBlock: {
            ReturnValue(AIMacro.ExcStr(value))
        }
        IfCondition GreaterEqual(value, TypeMagic.PTR_MIN) ThenBlock: {
            IfCondition EqualTo(Array.IsArray(value), 1) ThenBlock: {
                ReturnValue(AIMacro.Repr(value))
            }
            IfCondition EqualTo(Hash.IsHash(value), 1) ThenBlock: {
                sp = AIMacro.CallUnary(value, "__str__")
                IfCondition EqualTo(AIMacroUnary.hit, 1) ThenBlock: {
                    IfCondition EqualTo(AIMacro.LooksLikeString(sp), 1) ThenBlock: {
                        ReturnValue(sp)
                    }
                }
                // Builtin exceptions store an integer kind in __class__ and
                // a tuple in args. One argument stringifies that argument.
                // Several arguments stringify the tuple. Zero arguments are
                // empty. A string already stored in args is the message.
                cls_e = Hash.Get(value, "__class__")
                IfCondition GreaterEqual(cls_e, 1) ThenBlock: {
                    IfCondition LessThan(cls_e, 41) ThenBlock: {
                        ea2 = Hash.Get(value, "args")
                        IfCondition EqualTo(AIMacro.LooksLikeString(ea2), 1) ThenBlock: {
                            ReturnValue(ea2)
                        }
                        IfCondition EqualTo(AIMacro.SafeIsHash(ea2), 1) ThenBlock: {
                            lst_e = Hash.Get(ea2, "__list__")
                            IfCondition EqualTo(Array.IsArray(lst_e), 1) ThenBlock: {
                                narg = Array.Size(lst_e)
                                IfCondition EqualTo(narg, 0) ThenBlock: {
                                    ReturnValue("")
                                }
                                IfCondition EqualTo(narg, 1) ThenBlock: {
                                    // LooksLikeString rejects a first byte of 85 ('U').
                                    // The message is still the text. A live local does
                                    // not survive that call, so the arg stays in the pool.
                                    ExcHold.arg = Array.Get(lst_e, 0)
                                    IfCondition EqualTo(AIMacro.LooksLikeString(ExcHold.arg), 1) ThenBlock: {
                                        ReturnValue(ExcHold.arg)
                                    }
                                    IfCondition EqualTo(Types.CanDeref(ExcHold.arg), 1) ThenBlock: {
                                        ExcHold.obj = 0
                                        IfCondition EqualTo(Types.IsBigInt(ExcHold.arg), 1) ThenBlock: { ExcHold.obj = 1 }
                                        IfCondition EqualTo(Types.IsBool(ExcHold.arg), 1) ThenBlock: { ExcHold.obj = 1 }
                                        IfCondition EqualTo(Types.IsFloat(ExcHold.arg), 1) ThenBlock: { ExcHold.obj = 1 }
                                        IfCondition EqualTo(Array.IsArray(ExcHold.arg), 1) ThenBlock: { ExcHold.obj = 1 }
                                        IfCondition EqualTo(Hash.IsHash(ExcHold.arg), 1) ThenBlock: { ExcHold.obj = 1 }
                                        IfCondition EqualTo(ExcHold.obj, 0) ThenBlock: {
                                            IfCondition EqualTo(GetByte(ExcHold.arg, 0), 85) ThenBlock: {
                                                ReturnValue(ExcHold.arg)
                                            }
                                        }
                                    }
                                    ReturnValue(AIMacro.Str(ExcHold.arg))
                                }
                                ReturnValue(AIMacro.Repr(ea2))
                            }
                        }
                    }
                }
                ea = Hash.Get(value, "args")
                IfCondition EqualTo(AIMacro.LooksLikeString(ea), 1) ThenBlock: {
                    ReturnValue(ea)
                }
                ReturnValue(AIMacro.Repr(value))
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(value), 1) ThenBlock: {
            ReturnValue(value)
        }
        ReturnValue(NumberToString(value))
    }
}

Function.AIMacro.Int {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsBigInt(value), 1) ThenBlock: {
            ReturnValue(value)
        }
        IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.BoolVal(value), 0) ThenBlock: {
                ReturnValue(AIMacro.IntZero())
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            fi = Float_ToInt(AIMacro.FloatBits(value))
            IfCondition EqualTo(fi, 0) ThenBlock: {
                ReturnValue(AIMacro.IntZero())
            }
            ReturnValue(fi)
        }
        IfCondition EqualTo(Hash.IsHash(value), 1) ThenBlock: {
            data = Hash.Get(value, "__data__")
            iv = 0
            IfCondition EqualTo(Hash.IsHash(data), 1) ThenBlock: {
                iv = Hash.Get(data, "__int__")
            }
            IfCondition EqualTo(iv, 0) ThenBlock: {
                iv = Hash.Get(value, "__int__")
            }
            IfCondition EqualTo(iv, 0) ThenBlock: {
                ReturnValue(AIMacro.IntZero())
            }
            ReturnValue(AIMacro.UnboxIntZero(iv))
        }
        is_str = Types.IsString(value)
        IfCondition EqualTo(is_str, 1) ThenBlock: {
            ReturnValue(StringToNumber(value))
        }
        value = AIMacro.UnboxIntZero(value)
        IfCondition EqualTo(value, 0) ThenBlock: {
            ReturnValue(AIMacro.IntZero())
        }
        ReturnValue(value)
    }
}

Function.AIMacro.Bool {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition And(GreaterEqual(value, TypeMagic.PTR_MIN), EqualTo(Hash.IsHash(value), 1)) ThenBlock: {
            cls = Hash.Get(value, "__class__")
            IfCondition NotEqual(cls, 0) ThenBlock: {
                bslot = AIMacro.ClassAttrGet(cls, "__bool__")
                IfCondition EqualTo(AIMacro.IsNone(bslot), 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "__bool__ is None")
                    ReturnValue(AIMacro.FalseVal())
                }
            }
            IfCondition EqualTo(OOP.MethodExists(value, "__bool__"), 1) ThenBlock: {
                bargs = Array.Create(0)
                r = OOP.MethodCall(value, "__bool__", bargs)
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    ReturnValue(r)
                }
                IfCondition EqualTo(Types.IsBool(r), 1) ThenBlock: {
                    ReturnValue(r)
                }
                AIMacro.RaiseKind(5, "__bool__ should return bool")
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition EqualTo(OOP.MethodExists(value, "__len__"), 1) ThenBlock: {
                largs = Array.Create(0)
                n = OOP.MethodCall(value, "__len__", largs)
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    ReturnValue(AIMacro.FalseVal())
                }
                IfCondition EqualTo(AIMacro.LooksLikeString(n), 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "__len__ should return >= 0")
                    ReturnValue(AIMacro.FalseVal())
                }
                n = AIMacro.UnboxIntZero(n)
                IfCondition LessThan(n, 0) ThenBlock: {
                    AIMacro.RaiseKind(2, "__len__ should return >= 0")
                    ReturnValue(AIMacro.FalseVal())
                }
                IfCondition GreaterEqual(n, TypeMagic.HEAP_START) ThenBlock: {
                    AIMacro.RaiseKind(2, "__len__ should return >= 0")
                    ReturnValue(AIMacro.FalseVal())
                }
                IfCondition EqualTo(n, 0) ThenBlock: {
                    ReturnValue(AIMacro.FalseVal())
                }
                ReturnValue(AIMacro.TrueVal())
            }
        }
        IfCondition EqualTo(AIMacro.SmartBool(value), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.AndVal {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.SmartBool(a), 1) ThenBlock: {
            ReturnValue(b)
        }
        ReturnValue(a)
    }
}

Function.AIMacro.OrVal {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.SmartBool(a), 1) ThenBlock: {
            ReturnValue(a)
        }
        ReturnValue(b)
    }
}

Function.AIMacro.NotVal {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.SmartBool(value), 1) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        ReturnValue(AIMacro.TrueVal())
    }
}

Function.AIMacro.Is {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.Bool(EqualTo(a, b)))
    }
}

Function.AIMacro.Get {
    Input: container: Address
    Input: index: Integer
    Output: Address
    Body: {
        // Use XArray's get function
        ReturnValue(Array.Get(container, index))
    }
}

Function.AIMacro.Set {
    Input: container: Address
    Input: index: Integer
    Input: value: Address
    Body: {
        // Use XArray's set function
        Array.Set(container, index, value)
    }
}

// =============================================================================
// ANY - Return 1 if any element is truthy
// =============================================================================
Function.AIMacro.Any {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(AIMacro.IsNone(list), 1) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition LessThan(list, TypeMagic.PTR_MIN) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(Array.IsArray(list), 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        size = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(AIMacro.SmartBool(Array.Get(list, i)), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

// =============================================================================
// ALL - Return 1 if all elements are truthy (0 if any falsy)
// =============================================================================
Function.AIMacro.All {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(AIMacro.IsNone(list), 1) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition LessThan(list, TypeMagic.PTR_MIN) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(Array.IsArray(list), 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        size = Array.Size(list)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        i = 0
        WhileLoop LessThan(i, size) {
            IfCondition EqualTo(AIMacro.SmartBool(Array.Get(list, i)), 0) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.TrueVal())
    }
}

// =============================================================================
// LIST INDEX - Find index of first occurrence of value
// Returns index if found, -1 if not found
// =============================================================================
Function.AIMacro.ListIndex {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "ValueError")
            ReturnValue(-1)
        }
        
        i = 0
        WhileLoop LessThan(i, Array.Size(list)) {
            item = Array.Get(list, i)
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(item, value)), 1) ThenBlock: {
                IfCondition EqualTo(i, 0) ThenBlock: {
                    ReturnValue(AIMacro.IntZero())
                }
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        
        AIMacro.RaiseKind(2, "ValueError")
        ReturnValue(-1)
    }
}

// =============================================================================
// LIST COUNT - Count occurrences of item
// =============================================================================
Function.AIMacro.ListCount {
    Input: list: Address
    Input: item: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        count = 0
        i = 0
        WhileLoop LessThan(i, AIMacro.SmartLen(list)) {
            current = AIMacro.SmartGet(list, i)
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(current, item)), 1) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}


// =============================================================================
// LIST COPY - Shallow copy of list
// =============================================================================
Function.AIMacro.ListCopy {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(Array.Create(0))
        }
        
        size = Array.Size(list)
        result = Array.Create(size)
        
        i = 0
        WhileLoop LessThan(i, size) {
            item = Array.Get(list, i)
            Array.Push(result, item)
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}

// =============================================================================
// LIST EXTEND - Add all items from another list
// =============================================================================
Function.AIMacro.ListExtend {
    Input: list: Address
    Input: other: Address
    Body: {
        IfCondition Or(EqualTo(other, 0), EqualTo(AIMacro.IsNone(other), 1)) ThenBlock: {
            ReturnValue(0)
        }
        src = other
        IfCondition EqualTo(Array.IsArray(other), 0) ThenBlock: {
            src = AIMacro.ListFrom(other)
        }
        IfCondition EqualTo(Array.IsArray(src), 0) ThenBlock: {
            ReturnValue(0)
        }
        size = Array.Size(src)
        i = 0
        WhileLoop LessThan(i, size) {
            AIMacro.SmartPush(list, Array.Get(src, i))
            i = Add(i, 1)
        }
    }
}


// =============================================================================
// LIST CONTAINS - Check if value exists in list (for 'in' operator)
// =============================================================================
Function.AIMacro.ListContains {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(list), 1) ThenBlock: {
            ReturnValue(0)
        }
        size = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, size) {
            item = Array.Get(list, i)
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(item, value)), 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(AIMacro.LooksLikeString(item), 1), EqualTo(AIMacro.LooksLikeString(value), 1)) ThenBlock: {
                cmp = StringCompare(item, value)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}


// =============================================================================
// SET / FROZENSET - unique elements, order kept as first seen
// A list stays an array. {} stays a dict. 0 and None build an empty set.
// An integer stored in __class__ is not looked up as a method.
// =============================================================================
Function.AIMacro.SetBuild {
    Input: iterable: Address
    Input: kind: Address
    Output: Address
    Body: {
        src = 0
        IfCondition Or(EqualTo(iterable, 0), EqualTo(AIMacro.IsNone(iterable), 1)) ThenBlock: {
            ReturnValue(AIMacro.WrapSeq(AIMacro.EmptyList(), kind))
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(iterable), 1) ThenBlock: {
            cls = Hash.Get(iterable, "__class__")
            IfCondition And(NotEqual(cls, 0), EqualTo(AIMacro.LooksLikeString(cls), 0)) ThenBlock: {
                ReturnValue(AIMacro.WrapSeq(AIMacro.EmptyList(), kind))
            }
            lst = Hash.Get(iterable, "__list__")
            IfCondition EqualTo(Array.IsArray(lst), 1) ThenBlock: {
                src = lst
            } ElseBlock: {
                src = AIMacro.ListFrom(iterable)
            }
        } ElseBlock: {
            IfCondition EqualTo(Array.IsArray(iterable), 1) ThenBlock: {
                src = iterable
            } ElseBlock: {
                IfCondition EqualTo(AIMacro.LooksLikeString(iterable), 1) ThenBlock: {
                    src = AIMacro.ListFrom(iterable)
                }
            }
        }
        out = AIMacro.EmptyList()
        IfCondition EqualTo(Array.IsArray(src), 1) ThenBlock: {
            n = Array.Size(src)
            i = 0
            WhileLoop LessThan(i, n) {
                el = Array.Get(src, i)
                IfCondition EqualTo(AIMacro.ListContains(out, el), 0) ThenBlock: {
                    Array.Push(out, el)
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(AIMacro.WrapSeq(out, kind))
    }
}

Function.AIMacro.FrozenSet {
    Input: iterable: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.SetBuild(iterable, "frozenset"))
    }
}

Function.AIMacro.MakeSet {
    Input: iterable: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.SetBuild(iterable, "set"))
    }
}

Function.AIMacro.SetAdd {
    Input: s: Address
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(s), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.ListContains(s, val), 1) ThenBlock: {
                ReturnValue(0)
            }
            Array.Push(s, val)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// 1 when val was in the set array. 0 when it was not. Does not raise.
Function.AIMacro.SetDrop {
    Input: list: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Array.IsArray(list), 0) ThenBlock: {
            ReturnValue(0)
        }
        size = Array.Size(list)
        found = -1
        i = 0
        WhileLoop LessThan(i, size) {
            item = Array.Get(list, i)
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(item, value)), 1) ThenBlock: {
                found = i
                BreakLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, -1) ThenBlock: {
            ReturnValue(0)
        }
        i = found
        last = Subtract(size, 1)
        WhileLoop LessThan(i, last) {
            nxt = Array.Get(list, Add(i, 1))
            Array.Set(list, i, nxt)
            i = Add(i, 1)
        }
        Array.Pop(list)
        ReturnValue(1)
    }
}

// Removes the oldest element. CPython pop follows hash order.
// An empty list returns 0. The caller tells that apart from a stored 0.
Function.AIMacro.SetPop {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Array.IsArray(list), 0) ThenBlock: {
            ReturnValue(0)
        }
        size = Array.Size(list)
        IfCondition LessThan(size, 1) ThenBlock: {
            ReturnValue(0)
        }
        item = Array.Get(list, 0)
        AIMacro.SetDrop(list, item)
        ReturnValue(item)
    }
}

Function.AIMacro.CreateListWithElements {
    Input: e0: Address
    Input: e1: Address
    Input: e2: Address
    Input: e3: Address
    Input: e4: Address
    Output: Address
    Body: {
        list = Array.Create(5)
        Array.Push(list, e0)
        Array.Push(list, e1)
        Array.Push(list, e2)
        Array.Push(list, e3)
        Array.Push(list, e4)
        ReturnValue(list)
    }
}

Function.AIMacro.CreateList5 {
    Input: e0: Address
    Input: e1: Address
    Input: e2: Address
    Input: e3: Address
    Input: e4: Address
    Output: Address
    Body: {
        list = Array.Create(5)
        Array.Push(list, e0)
        Array.Push(list, e1)
        Array.Push(list, e2)
        Array.Push(list, e3)
        Array.Push(list, e4)
        ReturnValue(list)
    }
}


// =============================================================================
// LIST REMOVE - Remove first occurrence of value
// Returns 1 if found and removed, 0 if not found
// =============================================================================
Function.AIMacro.ListRemove {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        size = Array.Size(list)
        
        // Find the value
        found_idx = -1
        i = 0
        WhileLoop LessThan(i, Array.Size(list)) {
            item = Array.Get(list, i)
            IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(item, value)), 1) ThenBlock: {
                found_idx = i
                BreakLoop
            }
            i = Add(i, 1)
        }
        
        // Not found
        IfCondition EqualTo(found_idx, -1) ThenBlock: {
            AIMacro.RaiseKind(2, "ValueError")
            ReturnValue(0)
        }
        
        // Shift elements left
        i = found_idx
        last_idx = Subtract(size, 1)
        WhileLoop LessThan(i, last_idx) {
            next = Array.Get(list, Add(i, 1))
            Array.Set(list, i, next)
            i = Add(i, 1)
        }
        
        // Remove last element (now duplicate)
        Array.Pop(list)
        
        ReturnValue(1)
    }
}


// =============================================================================
// LIST INSERT - Insert value at index, shifting elements right
// =============================================================================
Function.AIMacro.ListInsert {
    Input: list: Address
    Input: index: Integer
    Input: value: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        size = Array.Size(list)
        
        // Clamp index to valid range
        IfCondition LessThan(index, 0) ThenBlock: {
            index = 0
        }
        IfCondition GreaterThan(index, size) ThenBlock: {
            index = size
        }
        
        // Push a placeholder to extend array
        Array.Push(list, 0)
        
        // Shift elements right from end to index
        i = size
        WhileLoop GreaterThan(i, index) {
            prev = Array.Get(list, Subtract(i, 1))
            Array.Set(list, i, prev)
            i = Subtract(i, 1)
        }
        
        // Insert the value
        Array.Set(list, index, value)
        
        ReturnValue(0)
    }
}

// =============================================================================
// LIST POP AT INDEX - Remove and return item at position
// =============================================================================
Function.AIMacro.ListPopAt {
    Input: list: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        size = Array.Size(list)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Handle negative index
        IfCondition LessThan(index, 0) ThenBlock: {
            index = Add(size, index)
        }
        
        // Bounds check
        IfCondition LessThan(index, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(index, size) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get the item to return
        item = Array.Get(list, index)
        
        // Shift everything left from index+1 to end
        i = index
        WhileLoop LessThan(i, Subtract(size, 1)) {
            next_item = Array.Get(list, Add(i, 1))
            Array.Set(list, i, next_item)
            i = Add(i, 1)
        }
        
        // Remove the last element
        Array.Pop(list)
        
        ReturnValue(item)
    }
}

// =============================================================================
// LISTREVERSE - In-place reverse (list.reverse())
// =============================================================================
Function.AIMacro.ListReverse {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        size = Array.Size(list)
        i = 0
        j = Subtract(size, 1)
        WhileLoop LessThan(i, j) {
            a = Array.Get(list, i)
            b = Array.Get(list, j)
            Array.Set(list, i, b)
            Array.Set(list, j, a)
            i = Add(i, 1)
            j = Subtract(j, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// REVERSED - Return new list in reverse order
// =============================================================================
Function.AIMacro.Reversed {
    Input: list: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(list, 0), EqualTo(AIMacro.IsNone(list), 1)) ThenBlock: {
            AIMacro.RaiseKind(5, "reversed")
            ReturnValue(Array.Create(0))
        }
        IfCondition EqualTo(Array.IsArray(list), 1) ThenBlock: {
            size = Array.Size(list)
            result = Array.Create(size)
            i = Subtract(size, 1)
            WhileLoop GreaterEqual(i, 0) {
                Array.Push(result, Array.Get(list, i))
                i = Subtract(i, 1)
            }
            ReturnValue(AIMacro.ReverseIter(result))
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(list), 1) ThenBlock: {
            cls_rv = Hash.Get(list, "__class__")
            IfCondition EqualTo(AIMacro.LooksLikeString(cls_rv), 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(cls_rv, "range"), 0) ThenBlock: {
                    items = AIMacro.RangeItems(list)
                    ReturnValue(AIMacro.Reversed(items))
                }
            }
            IfCondition NotEqual(cls_rv, 0) ThenBlock: {
                rev_slot = AIMacro.ClassAttrGet(cls_rv, "__reversed__")
                IfCondition EqualTo(AIMacro.IsNone(rev_slot), 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "reversed")
                    ReturnValue(Array.Create(0))
                }
            }
            IfCondition EqualTo(OOP.MethodExists(list, "__reversed__"), 1) ThenBlock: {
                empty = AIMacro.EmptyList()
                ReturnValue(OOP.MethodCall(list, "__reversed__", empty))
            }
            has_len = OOP.MethodExists(list, "__len__")
            has_get = OOP.MethodExists(list, "__getitem__")
            IfCondition EqualTo(has_len, 1) ThenBlock: {
                IfCondition EqualTo(has_get, 1) ThenBlock: {
                    empty = AIMacro.EmptyList()
                    ln = OOP.MethodCall(list, "__len__", empty)
                    n = AIMacro.UnboxIntZero(ln)
                    result = Array.Create(n)
                    i = Subtract(n, 1)
                    WhileLoop GreaterEqual(i, 0) {
                        gargs = Array.Create(1)
                        gidx = i
                        IfCondition EqualTo(gidx, 0) ThenBlock: {
                            gidx = AIMacro.IntZero()
                        }
                        Array.Push(gargs, gidx)
                        Array.Push(result, OOP.MethodCall(list, "__getitem__", gargs))
                        i = Subtract(i, 1)
                    }
                    revh = AIMacro.ReverseIter(result)
                    Hash.Set(revh, "__src__", list)
                    ReturnValue(revh)
                }
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(Array.Create(0))
            }
            IfCondition EqualTo(has_get, 1) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(Array.Create(0))
            }
            keys = Hash.Keys(list)
            kn = 0
            IfCondition EqualTo(Array.IsArray(keys), 1) ThenBlock: {
                kn = Array.Size(keys)
            }
            krev = Array.Create(kn)
            ki = Subtract(kn, 1)
            WhileLoop GreaterEqual(ki, 0) {
                Array.Push(krev, Array.Get(keys, ki))
                ki = Subtract(ki, 1)
            }
            ReturnValue(AIMacro.ReverseIter(krev))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(list), 1) ThenBlock: {
            size = StringLength(list)
            result = Array.Create(size)
            i = Subtract(size, 1)
            WhileLoop GreaterEqual(i, 0) {
                Array.Push(result, AIMacro.IterGet(list, i))
                i = Subtract(i, 1)
            }
            ReturnValue(AIMacro.ReverseIter(result))
        }
        AIMacro.RaiseKind(5, "reversed")
        ReturnValue(Array.Create(0))
    }
}

// =============================================================================
// ROUND - Round to nearest integer (no decimal places in our int world)
// For positive: add 0.5 equivalent, for negative: subtract 0.5 equivalent
// Since we're integers, this is basically a no-op, but we support it for compat
// =============================================================================
Function.AIMacro.Round {
    Input: value: Integer
    Output: Integer
    Body: {
        value = AIMacro.BoolVal(value)
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(Float_Round(AIMacro.FloatBits(value)))
        }
        ReturnValue(value)
    }
}
// =============================================================================
// MATHEMATICAL FUNCTIONS
// =============================================================================

Function.AIMacro.Abs {
    Input: value: Integer
    Output: Integer
    Body: {
        value = AIMacro.BoolVal(value)
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            bits = AIMacro.FloatBits(value)
            IfCondition EqualTo(Float_Lt(bits, 0), 1) ThenBlock: {
                ReturnValue(AIMacro.FloatBox(Float_Sub(0, bits)))
            }
            ReturnValue(value)
        }
        IfCondition LessThan(value, 0) ThenBlock: {
            ReturnValue(Subtract(0, value))
        }
        ReturnValue(value)
    }
}

Function.AIMacro.Max {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition GreaterThan(a, b) ThenBlock: {
            ReturnValue(a)
        } ElseBlock: {
            ReturnValue(b)
        }
    }
}

Function.AIMacro.Min {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition LessThan(a, b) ThenBlock: {
            ReturnValue(a)
        } ElseBlock: {
            ReturnValue(b)
        }
    }
}

Function.AIMacro.MinSeq {
    Input: iterable: Address
    Output: Address
    Body: {
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.InPtrHole(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "'int' object is not iterable")
            ReturnValue(0)
        }
        is_arr = 0
        IfCondition EqualTo(Types.CanDeref(iterable), 1) ThenBlock: {
            is_arr = Array.IsArray(iterable)
        }
        IfCondition EqualTo(is_arr, 0) ThenBlock: {
            iterable = AIMacro.ListFrom(iterable)
            IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        n = Array.Size(iterable)
        IfCondition EqualTo(n, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        best = Array.Get(iterable, 0)
        i = 1
        WhileLoop LessThan(i, n) {
            item = Array.Get(iterable, i)
            lt = AIMacro.NumLt(item, best)
            IfCondition EqualTo(AIMacro.SmartBool(lt), 1) ThenBlock: {
                best = item
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

Function.AIMacro.MaxSeq {
    Input: iterable: Address
    Output: Address
    Body: {
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "max")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(2, "max")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.InPtrHole(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "'int' object is not iterable")
            ReturnValue(0)
        }
        is_arr = 0
        IfCondition EqualTo(Types.CanDeref(iterable), 1) ThenBlock: {
            is_arr = Array.IsArray(iterable)
        }
        IfCondition EqualTo(is_arr, 0) ThenBlock: {
            iterable = AIMacro.ListFrom(iterable)
            IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        n = Array.Size(iterable)
        IfCondition EqualTo(n, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "max")
            ReturnValue(0)
        }
        best = Array.Get(iterable, 0)
        i = 1
        WhileLoop LessThan(i, n) {
            item = Array.Get(iterable, i)
            gt = AIMacro.NumGt(item, best)
            IfCondition EqualTo(AIMacro.SmartBool(gt), 1) ThenBlock: {
                best = item
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

Function.AIMacro.MinSeqKey {
    Input: iterable: Address
    Input: keyfn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(iterable), 0) ThenBlock: {
            iterable = AIMacro.ListFrom(iterable)
        }
        n = Array.Size(iterable)
        IfCondition EqualTo(n, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        best = Array.Get(iterable, 0)
        use_key = 1
        IfCondition EqualTo(keyfn, 0) ThenBlock: { use_key = 0 }
        IfCondition EqualTo(use_key, 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.IsNone(keyfn), 1) ThenBlock: { use_key = 0 }
        }
        bk = best
        IfCondition EqualTo(use_key, 1) ThenBlock: {
            bk = AIMacro.KeyOf(best, keyfn)
        }
        i = 1
        WhileLoop LessThan(i, n) {
            item = Array.Get(iterable, i)
            ik = item
            IfCondition EqualTo(use_key, 1) ThenBlock: {
                ik = AIMacro.KeyOf(item, keyfn)
            }
            lt = AIMacro.NumLt(ik, bk)
            IfCondition EqualTo(AIMacro.SmartBool(lt), 1) ThenBlock: {
                best = item
                bk = ik
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

Function.AIMacro.MaxSeqKey {
    Input: iterable: Address
    Input: keyfn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "max")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(2, "max")
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(iterable), 0) ThenBlock: {
            iterable = AIMacro.ListFrom(iterable)
        }
        n = Array.Size(iterable)
        IfCondition EqualTo(n, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "max")
            ReturnValue(0)
        }
        best = Array.Get(iterable, 0)
        use_key = 1
        IfCondition EqualTo(keyfn, 0) ThenBlock: { use_key = 0 }
        IfCondition EqualTo(use_key, 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.IsNone(keyfn), 1) ThenBlock: { use_key = 0 }
        }
        bk = best
        IfCondition EqualTo(use_key, 1) ThenBlock: {
            bk = AIMacro.KeyOf(best, keyfn)
        }
        i = 1
        WhileLoop LessThan(i, n) {
            item = Array.Get(iterable, i)
            ik = item
            IfCondition EqualTo(use_key, 1) ThenBlock: {
                ik = AIMacro.KeyOf(item, keyfn)
            }
            gt = AIMacro.NumGt(ik, bk)
            IfCondition EqualTo(AIMacro.SmartBool(gt), 1) ThenBlock: {
                best = item
                bk = ik
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

Function.AIMacro.MinSeqDef {
    Input: iterable: Address
    Input: fallback: Address
    Output: Address
    Body: {
        IfCondition EqualTo(iterable, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "min")
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.IsNone(iterable), 1) ThenBlock: {
            AIMacro.RaiseKind(5, "TypeError")
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(iterable), 0) ThenBlock: {
            iterable = AIMacro.ListFrom(iterable)
        }
        n = Array.Size(iterable)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(fallback)
        }
        ReturnValue(AIMacro.MinSeq(iterable))
    }
}


        IfCondition EqualTo(StringCompare(name, "test_index_returns_int_subclass"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "testIsSubclassInternal"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_repeat"), 0) ThenBlock: {

Function.AIMacro.UnittestIsTestName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 0), 116) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 1), 101) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 2), 115) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(name, 3), 116) ThenBlock: {
            ReturnValue(0)
        }
        pi = 0
        pickle_hit = 0
        WhileLoop NotEqual(GetByte(name, pi), 0) {
            IfCondition And(EqualTo(GetByte(name, pi), 112), And(EqualTo(GetByte(name, Add(pi, 1)), 105), And(EqualTo(GetByte(name, Add(pi, 2)), 99), And(EqualTo(GetByte(name, Add(pi, 3)), 107), And(EqualTo(GetByte(name, Add(pi, 4)), 108), EqualTo(GetByte(name, Add(pi, 5)), 101)))))) ThenBlock: {
                pickle_hit = 1
            }
            pi = Add(pi, 1)
        }
        IfCondition EqualTo(pickle_hit, 1) ThenBlock: {
            IfCondition NotEqual(StringCompare(name, "test_pickleable"), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(StringCompare(name, "test_repr_large"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_bug1229429"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_tuple_reuse"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_hls_nearwhite"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_comp_classes_different"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_extension_registry"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_slotnames"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_mappings"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_EOFS_with_file"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_line_continuation_EOF_from_file_bpo2180"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_line_continuation_EOF"), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "test_barry_as_bdfl"), 0) ThenBlock: {
            ReturnValue(0)

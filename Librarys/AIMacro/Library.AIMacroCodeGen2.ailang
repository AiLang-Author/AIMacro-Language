LibraryImport.Array
LibraryImport.AIMacro.AIMacroCore
LibraryImport.AIMacro.AIMacroParserCore
LibraryImport.AIMacro.AIMacroCodeGen1
LibraryImport.AIMacro.AIMacroCodeGen3
LibraryImport.AIMacro.AIMacroCodeGen4
LibraryImport.AIMacro.AIMacroTypeAnnotations
LibraryImport.AIMacro.AIMacroCodeGenDict
LibraryImport.AIMacro.AIMacroCodeGenOOP
LibraryImport.AIMacro.AIMacroCodeGen2Stmt
LibraryImport.AIMacro.AIMacroCodeGen2Loop
LibraryImport.AIMacro.AIMacroCodeGen2Assign

// =============================================================================
// MAIN CODE GENERATION ENTRY
// =============================================================================
Function.Gen_Program {
    Input: ast: Address
    Body: {
        TypeAnno_Init()
        DictGen_Init()
        OOPGen_Init()
        OOPGen_Reset()
        
        // Standard library imports (always needed)
        Gen_EmitLine("LibraryImport.AIMacro.AIMacro")
        Gen_EmitLine("LibraryImport.AIMacro.AIMacroExtra")
        Gen_EmitLine("LibraryImport.AIMacro.AIMacroOperator")
        Gen_EmitLine("LibraryImport.AIMacro.AIMacroUnittest")
        Gen_EmitLine("LibraryImport.AIMacro.AIMacroFormat")
        Gen_EmitLine("LibraryImport.AIMacro.AIMacroString")
        Gen_EmitLine("LibraryImport.Array")
        Gen_EmitLine("LibraryImport.Hash")
        Gen_EmitLine("LibraryImport.AIMacro.AIMacroDict")
        Gen_EmitLine("LibraryImport.OOP")
        Gen_Emit("\n")
        
        decls = ArrayGet(ast, 3)
        n = Array.Size(decls)

        // =========== PASS 0: Emit user imports ===========
        i = 0
        WhileLoop LessThan(i, n) {
            decl = Array.Get(decls, i)
            t = AST_Type(decl)
            
            IfCondition EqualTo(t, Node.IMPORT) ThenBlock: {
                Gen_Import(decl)
            }
            IfCondition EqualTo(t, Node.FROM_IMPORT) ThenBlock: {
                Gen_FromImport(decl)
            }
            
            i = Add(i, 1)
        }
        Gen_Emit("\n")
        // =========== END PASS 0 ===========

        // =========== PRE-SCAN FOR CLASS NAMES ===========
        IfCondition EqualTo(Gen.known_nested_funcs, 0) ThenBlock: {
            Gen.known_nested_funcs = Array.Create(64)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            decl = Array.Get(decls, i)
            Gen_PrescanNames(decl, 0)
            i = Add(i, 1)
        }
        // =========== END PRE-SCAN ===========
        
        i = 0
        WhileLoop LessThan(i, n) {
            decl = Array.Get(decls, i)
            t = AST_Type(decl)
            IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
                fname = ArrayGet(decl, 3)
                defs = ArrayGet(decl, 7)
                Array.Push(Gen.func_names, fname)
                Array.Push(Gen.module_funcs, fname)
                Array.Push(Gen.func_defaults, defs)
                Array.Push(Gen.func_params, ArrayGet(decl, 4))
                star = ArrayGet(decl, 8)
                IfCondition NotEqual(star, 0) ThenBlock: {
                    Array.Push(Gen.func_varargs, Array.Size(ArrayGet(decl, 4)))
                } ElseBlock: {
                    Array.Push(Gen.func_varargs, 0)
                }
            }
            i = Add(i, 1)
        }
        
        // =========== MODULE VAR SCAN: file-scope IDENT assigns → FixedPool.PyMod ===========
        i = 0
        WhileLoop LessThan(i, n) {
            decl = Array.Get(decls, i)
            t = AST_Type(decl)
            IfCondition EqualTo(t, Node.ASSIGNMENT) ThenBlock: {
                // Chained a = b = expr: mark every LHS
                Gen_MarkAssignmentChainVars(decl)
                mname = ArrayGet(decl, 3)
                IfCondition EqualTo(AST_Type(mname), Node.IDENT) ThenBlock: {
                    mname = ArrayGet(mname, 3)
                }
                mval = ArrayGet(decl, 4)
                // Walk to final RHS through chain
                WhileLoop EqualTo(AST_Type(mval), Node.ASSIGNMENT) {
                    mval = ArrayGet(mval, 4)
                }
                IfCondition NotEqual(mval, 0) ThenBlock: {
                    mvt = AST_Type(mval)
                    IfCondition EqualTo(mvt, Node.DICT_LIT) ThenBlock: {
                        Gen_MarkDictVar(mname)
                    }
                    IfCondition EqualTo(mvt, Node.LIST_LIT) ThenBlock: {
                        Gen_MarkListVar(mname)
                    }
                }
            }
            IfCondition EqualTo(t, Node.TUPLE_UNPACK) ThenBlock: {
                Gen_MarkTupleUnpackVars(decl)
            }
            IfCondition EqualTo(t, Node.FROM_IMPORT) ThenBlock: {
                Gen_MarkFromImportVars(decl)
            }
            IfCondition EqualTo(t, Node.IMPORT) ThenBlock: {
                Gen_MarkImportModuleVars(decl)
            }
            IfCondition EqualTo(t, Node.TRY_STMT) ThenBlock: {
                Gen_MarkTryAssignVars(decl)
            }
            IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(decl, 5))
            }
            IfCondition EqualTo(t, Node.CLASS_DEF) ThenBlock: {
                Gen_MarkGlobalEnumVars(decl)
                Gen_MarkClassMethodVars(decl)
            }
            // if hasattr: import array  — mark names inside module-level if/while/for
            IfCondition EqualTo(t, Node.IF_STMT) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(decl, 4))
                Gen_MarkBodyAssignVars(ArrayGet(decl, 5))
                Gen_MarkConditionalDefVars(ArrayGet(decl, 4))
                Gen_MarkConditionalDefVars(ArrayGet(decl, 5))
            }
            IfCondition EqualTo(t, Node.WHILE_STMT) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(decl, 4))
                Gen_MarkBodyAssignVars(ArrayGet(decl, 5))
                Gen_MarkConditionalDefVars(ArrayGet(decl, 4))
                Gen_MarkConditionalDefVars(ArrayGet(decl, 5))
            }
            IfCondition EqualTo(t, Node.FOR_STMT) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(decl, 5))
                Gen_MarkBodyAssignVars(ArrayGet(decl, 6))
                Gen_MarkConditionalDefVars(ArrayGet(decl, 5))
                Gen_MarkConditionalDefVars(ArrayGet(decl, 6))
            }
            IfCondition EqualTo(t, Node.WITH_STMT) ThenBlock: {
                as_name = ArrayGet(decl, 4)
                IfCondition NotEqual(as_name, 0) ThenBlock: {
                    an = Array.Size(as_name)
                    ai = 0
                    WhileLoop LessThan(ai, an) {
                        nm = Array.Get(as_name, ai)
                        Gen_MarkModuleVar(nm)
                        ai = Add(ai, 1)
                    }
                }
                wbody = ArrayGet(decl, 5)
                Gen_MarkBodyAssignVars(wbody)
                Gen_MarkConditionalDefVars(wbody)
            }
            i = Add(i, 1)
        }
        n_mod = Array.Size(Gen.module_vars)
        IfCondition GreaterThan(n_mod, 0) ThenBlock: {
            Gen_EmitLine("FixedPool.PyMod {")
            mi = 0
            WhileLoop LessThan(mi, n_mod) {
                mname = Array.Get(Gen.module_vars, mi)
                Gen_Emit("    \"")
                Gen_Emit(mname)
                Gen_EmitLine("\": Initialize=0, CanChange=True")
                mi = Add(mi, 1)
            }
            Gen_EmitLine("}")
            Gen_Emit("\n")
        }

        // =========== END MODULE VAR SCAN ===========

        // =========== FIRST PASS: Scan for >6 param functions ===========
        i = 0
        WhileLoop LessThan(i, n) {
            decl = Array.Get(decls, i)
            t = AST_Type(decl)
            IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
                fname = ArrayGet(decl, 3)
                params = ArrayGet(decl, 4)
                num_params = Array.Size(params)
                star = ArrayGet(decl, 8)
                IfCondition GreaterThan(num_params, 6) ThenBlock: {
                    Array.Push(Gen.packed_funcs, fname)
                }
            }
            i = Add(i, 1)
        }
        // =========== END FIRST PASS ===========
        
        has_main = 0
        toplevel = Array.Create(64)
        
        // =========== SECOND PASS: Generate functions/classes; buffer top-level stmts ===========
        i = 0
        WhileLoop LessThan(i, n) {
            decl = Array.Get(decls, i)
            t = AST_Type(decl)
            
            IfCondition EqualTo(t, Node.IMPORT) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(t, Node.FROM_IMPORT) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            
            IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
                Gen_Node(decl)
                name = ArrayGet(decl, 3)
                cmp = StringCompare(name, "main")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    has_main = 1
                }
            } ElseBlock: {
                IfCondition EqualTo(t, Node.CLASS_DEF) ThenBlock: {
                    Gen_Node(decl)
                    Gen_BufferGlobalEnumExports(decl, toplevel)
                } ElseBlock: {
                    Array.Push(toplevel, decl)
                }
            }
            
            i = Add(i, 1)
        }
        // =========== END SECOND PASS ===========
        
        // Hoist nested def to file scope (AILang has no nested Function)
        WhileLoop EqualTo(1, 1) {
            n_def = Array.Size(Gen.deferred_functions)
            IfCondition EqualTo(n_def, 0) ThenBlock: {
                BreakLoop
            }
            pending = Gen.deferred_functions
            pending_fv = Gen.deferred_freevars
            pending_nn = Gen.deferred_nest_names
            pending_nf = Gen.deferred_nest_funcs
            Gen.deferred_functions = Array.Create(64)
            Gen.deferred_freevars = Array.Create(64)
            Gen.deferred_nest_names = Array.Create(64)
            Gen.deferred_nest_funcs = Array.Create(64)
            i = 0
            WhileLoop LessThan(i, n_def) {
                Gen.pending_freevars = Array.Get(pending_fv, i)
                Gen.nest_bind_names = Array.Get(pending_nn, i)
                Gen.nest_bind_funcs = Array.Get(pending_nf, i)
                Gen_Function(Array.Get(pending, i))
                Gen.pending_freevars = 0
                i = Add(i, 1)
            }
        }
        

        // Hoist nested classes to file scope
        WhileLoop EqualTo(1, 1) {
            n_cls = Array.Size(Gen.deferred_classes)
            IfCondition EqualTo(n_cls, 0) ThenBlock: {
                BreakLoop
            }
            pending_cls = Gen.deferred_classes
            Gen.deferred_classes = Array.Create(32)
            ci = 0
            WhileLoop LessThan(ci, n_cls) {
                OOPGen_ClassDef(Array.Get(pending_cls, ci))
                ci = Add(ci, 1)
            }
        }

        OOPGen_EmitClassInitSubroutine()
        
        n_top = Array.Size(toplevel)
        need_main = 0
        IfCondition EqualTo(has_main, 1) ThenBlock: {
            need_main = 1
        }
        IfCondition GreaterThan(n_top, 0) ThenBlock: {
            need_main = 1
        }
        IfCondition EqualTo(OOPGen.has_classes, 1) ThenBlock: {
            need_main = 1
        }
        
        IfCondition EqualTo(need_main, 1) ThenBlock: {
            Gen_Emit("\n")
            Gen_EmitLine("SubRoutine.Main {")
            // Assigns shift the intern/path-sensitive compile-SEGV cliff
            // (test_heapq / test_richcmp under /tmp/aimacro_regrtest_*).
            Gen_EmitLine("    _aim_pad = 0")
            Gen_EmitLine("    _aim_pad2 = 0")
            IfCondition EqualTo(OOPGen.has_classes, 1) ThenBlock: {
                Gen_EmitLine("    __OOP_ClassInit()")
            }
            saved_indent = Gen.indent
            Gen.indent = 2
            i = 0
            WhileLoop LessThan(i, n_top) {
                Gen.temp_counter = 0
                OOPGen.temp_counter = 0
                Gen_Node(Array.Get(toplevel, i))
                i = Add(i, 1)
            }
            Gen.indent = saved_indent
            nca = 0
            IfCondition NotEqual(OOPGen.classattrs_fns, 0) ThenBlock: {
                nca = Array.Size(OOPGen.classattrs_fns)
            }
            ci = 0
            WhileLoop LessThan(ci, nca) {
                Gen_Emit("    ")
                Gen_Emit(Array.Get(OOPGen.classattrs_fns, ci))
                Gen_Emit("()\n")
                ci = Add(ci, 1)
            }
            ntc = 0
            IfCondition NotEqual(OOPGen.test_classes, 0) ThenBlock: {
                ntc = Array.Size(OOPGen.test_classes)
            }
            ti = 0
            WhileLoop LessThan(ti, ntc) {
                tn = Array.Get(OOPGen.test_classes, ti)
                Gen_Emit("    AIMacro.UnittestRunClass(\"")
                Gen_Emit(tn)
                Gen_Emit("\")\n")
                ti = Add(ti, 1)
            }
            IfCondition GreaterThan(ntc, 0) ThenBlock: {
                Gen_EmitLine("    AIMacro.UnittestDone()")
            }
            // Do not auto-call main(); if __name__ == "__main__" in toplevel decides.
            Gen_EmitLine("    ProcessExit(0)")
            Gen_EmitLine("}")
            Gen_Emit("\n")
            WhileLoop EqualTo(1, 1) {
                n_def = Array.Size(Gen.deferred_functions)
                IfCondition EqualTo(n_def, 0) ThenBlock: {
                    BreakLoop
                }
                pending = Gen.deferred_functions
                pending_fv = Gen.deferred_freevars
                pending_nn = Gen.deferred_nest_names
                pending_nf = Gen.deferred_nest_funcs
                Gen.deferred_functions = Array.Create(64)
                Gen.deferred_freevars = Array.Create(64)
                Gen.deferred_nest_names = Array.Create(64)
                Gen.deferred_nest_funcs = Array.Create(64)
                i = 0
                WhileLoop LessThan(i, n_def) {
                    Gen.pending_freevars = Array.Get(pending_fv, i)
                    Gen.nest_bind_names = Array.Get(pending_nn, i)
                    Gen.nest_bind_funcs = Array.Get(pending_nf, i)
                    Gen_Function(Array.Get(pending, i))
                    Gen.pending_freevars = 0
                    i = Add(i, 1)
                }
            }
            // Hoist nested classes discovered inside Main
            WhileLoop EqualTo(1, 1) {
                n_cls = Array.Size(Gen.deferred_classes)
                IfCondition EqualTo(n_cls, 0) ThenBlock: {
                    BreakLoop
                }
                pending_cls = Gen.deferred_classes
                Gen.deferred_classes = Array.Create(32)
                ci = 0
                WhileLoop LessThan(ci, n_cls) {
                    OOPGen_ClassDef(Array.Get(pending_cls, ci))
                    ci = Add(ci, 1)
                }
            }
            Gen_EmitLine("RunTask(Main)")
        }
    }
}



// =============================================================================
// @global_enum class Members → FixedPool.PyMod (calendar FEBRUARY / Month / Day)
// enum.global_enum promotes IntEnum members to module scope; AIMacro must too.
// =============================================================================

Function.Gen_ClassHasGlobalEnum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        decos = ArrayGet(node, 6)
        IfCondition EqualTo(decos, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(decos)
        i = 0
        WhileLoop LessThan(i, n) {
            deco = Array.Get(decos, i)
            IfCondition NotEqual(deco, 0) ThenBlock: {
                // bare @global_enum → IDENT
                IfCondition EqualTo(AST_Type(deco), Node.IDENT) ThenBlock: {
                    dname = ArrayGet(deco, 3)
                    cmp = StringCompare(dname, "global_enum")
                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkClassMethodVars {
    Input: node: Address
    Body: {
        body = ArrayGet(node, 5)
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            item = Array.Get(body, i)
            it = AST_Type(item)
            IfCondition EqualTo(it, Node.METHOD_DEF) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(item, 6))
            }
            IfCondition EqualTo(it, Node.FUNCTION) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(item, 5))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkGlobalEnumVars {
    Input: node: Address
    Body: {
        has = Gen_ClassHasGlobalEnum(node)
        IfCondition EqualTo(has, 0) ThenBlock: {
            ReturnValue(0)
        }
        body = ArrayGet(node, 5)
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            item = Array.Get(body, i)
            IfCondition EqualTo(AST_Type(item), Node.ASSIGNMENT) ThenBlock: {
                Gen_MarkAssignmentChainVars(item)
            }
            i = Add(i, 1)
        }
    }
}

// Push class-body assigns onto toplevel so Main emits PyMod.NAME = value
Function.Gen_BufferGlobalEnumExports {
    Input: node: Address
    Input: toplevel: Address
    Body: {
        has = Gen_ClassHasGlobalEnum(node)
        IfCondition EqualTo(has, 0) ThenBlock: {
            ReturnValue(0)
        }
        body = ArrayGet(node, 5)
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            item = Array.Get(body, i)
            IfCondition EqualTo(AST_Type(item), Node.ASSIGNMENT) ThenBlock: {
                Array.Push(toplevel, item)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================

// Mark symbols from `from mod import a, b` as PyMod names

Function.Gen_MarkImportModuleVars {
    Input: node: Address
    Body: {
        modules = ArrayGet(node, 4)
        IfCondition NotEqual(modules, 0) ThenBlock: {
            n = Array.Size(modules)
            i = 0
            WhileLoop LessThan(i, n) {
                Gen_MarkModuleVar(Array.Get(modules, i))
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        Gen_MarkModuleVar(ArrayGet(node, 3))
    }
}

Function.Gen_MarkStarImport {
    Input: module_name: Address
    Body: {
        cmp = StringCompare(module_name, "token")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar("tok_name")
            Gen_MarkDictVar("tok_name")
            Gen_MarkModuleVar("OP")
            Gen_MarkModuleVar("NAME")
            Gen_MarkModuleVar("NUMBER")
            Gen_MarkModuleVar("STRING")
            Gen_MarkModuleVar("NEWLINE")
            Gen_MarkModuleVar("INDENT")
            Gen_MarkModuleVar("DEDENT")
            Gen_MarkModuleVar("ENDMARKER")
            Gen_MarkModuleVar("COMMENT")
            Gen_MarkModuleVar("NL")
            Gen_MarkModuleVar("ENCODING")
            Gen_MarkModuleVar("ERRORTOKEN")
            Gen_MarkModuleVar("N_TOKENS")
            Gen_MarkModuleVar("NT_OFFSET")
            Gen_MarkModuleVar("AWAIT")
            Gen_MarkModuleVar("ASYNC")
            Gen_MarkModuleVar("TYPE_COMMENT")
            Gen_MarkModuleVar("TYPE_IGNORE")
            Gen_MarkModuleVar("EXACT_TOKEN_TYPES")
        }
        cmp = StringCompare(module_name, "_socket")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar("AddressFamily")
            Gen_MarkModuleVar("SocketKind")
            Gen_MarkModuleVar("has_ipv6")
            Gen_MarkModuleVar("IPPROTO_IPV6")
            Gen_MarkModuleVar("IPPROTO_TCP")
            Gen_MarkModuleVar("IPPROTO_UDP")
            Gen_MarkModuleVar("IPV6_V6ONLY")
            Gen_MarkModuleVar("SOL_SOCKET")
            Gen_MarkModuleVar("SO_REUSEADDR")
            Gen_MarkModuleVar("SO_REUSEPORT")
            Gen_MarkModuleVar("SO_KEEPALIVE")
            Gen_MarkModuleVar("SOCK_STREAM")
            Gen_MarkModuleVar("SOCK_DGRAM")
            Gen_MarkModuleVar("AF_INET")
            Gen_MarkModuleVar("AF_INET6")
            Gen_MarkModuleVar("AF_UNIX")
        }
        cmp = StringCompare(module_name, "itertools")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar("accumulate")
            Gen_MarkImportStub("accumulate")
            Gen_MarkModuleVar("chain")
            Gen_MarkImportStub("chain")
            Gen_MarkModuleVar("combinations")
            Gen_MarkImportStub("combinations")
            Gen_MarkModuleVar("combinations_with_replacement")
            Gen_MarkImportStub("combinations_with_replacement")
            Gen_MarkModuleVar("compress")
            Gen_MarkImportStub("compress")
            Gen_MarkModuleVar("count")
            Gen_MarkImportStub("count")
            Gen_MarkModuleVar("cycle")
            Gen_MarkImportStub("cycle")
            Gen_MarkModuleVar("dropwhile")
            Gen_MarkImportStub("dropwhile")
            Gen_MarkModuleVar("filterfalse")
            Gen_MarkImportStub("filterfalse")
            Gen_MarkModuleVar("groupby")
            Gen_MarkImportStub("groupby")
            Gen_MarkModuleVar("islice")
            Gen_MarkImportStub("islice")
            Gen_MarkModuleVar("pairwise")
            Gen_MarkImportStub("pairwise")
            Gen_MarkModuleVar("permutations")
            Gen_MarkImportStub("permutations")
            Gen_MarkModuleVar("product")
            Gen_MarkImportStub("product")
            Gen_MarkModuleVar("repeat")
            Gen_MarkImportStub("repeat")
            Gen_MarkModuleVar("starmap")
            Gen_MarkImportStub("starmap")
            Gen_MarkModuleVar("takewhile")
            Gen_MarkImportStub("takewhile")
            Gen_MarkModuleVar("tee")
            Gen_MarkImportStub("tee")
            Gen_MarkModuleVar("zip_longest")
            Gen_MarkImportStub("zip_longest")
        }
        cmp = StringCompare(module_name, "winreg")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar("HKEY_CLASSES_ROOT")
            Gen_MarkImportStub("HKEY_CLASSES_ROOT")
            Gen_MarkModuleVar("HKEY_CURRENT_USER")
            Gen_MarkImportStub("HKEY_CURRENT_USER")
            Gen_MarkModuleVar("HKEY_LOCAL_MACHINE")
            Gen_MarkImportStub("HKEY_LOCAL_MACHINE")
            Gen_MarkModuleVar("HKEY_USERS")
            Gen_MarkImportStub("HKEY_USERS")
            Gen_MarkModuleVar("HKEY_CURRENT_CONFIG")
            Gen_MarkImportStub("HKEY_CURRENT_CONFIG")
            Gen_MarkModuleVar("KEY_READ")
            Gen_MarkImportStub("KEY_READ")
            Gen_MarkModuleVar("KEY_WRITE")
            Gen_MarkImportStub("KEY_WRITE")
            Gen_MarkModuleVar("KEY_ALL_ACCESS")
            Gen_MarkImportStub("KEY_ALL_ACCESS")
            Gen_MarkModuleVar("REG_SZ")
            Gen_MarkImportStub("REG_SZ")
            Gen_MarkModuleVar("REG_DWORD")
            Gen_MarkImportStub("REG_DWORD")
            Gen_MarkModuleVar("REG_QWORD")
            Gen_MarkImportStub("REG_QWORD")
            Gen_MarkModuleVar("REG_BINARY")
            Gen_MarkImportStub("REG_BINARY")
            Gen_MarkModuleVar("REG_EXPAND_SZ")
            Gen_MarkImportStub("REG_EXPAND_SZ")
            Gen_MarkModuleVar("REG_MULTI_SZ")
            Gen_MarkImportStub("REG_MULTI_SZ")
            Gen_MarkModuleVar("REG_NONE")
            Gen_MarkImportStub("REG_NONE")
            Gen_MarkModuleVar("OpenKey")
            Gen_MarkImportStub("OpenKey")
            Gen_MarkModuleVar("OpenKeyEx")
            Gen_MarkImportStub("OpenKeyEx")
            Gen_MarkModuleVar("CreateKey")
            Gen_MarkImportStub("CreateKey")
            Gen_MarkModuleVar("CreateKeyEx")
            Gen_MarkImportStub("CreateKeyEx")
            Gen_MarkModuleVar("CloseKey")
            Gen_MarkImportStub("CloseKey")
            Gen_MarkModuleVar("ConnectRegistry")
            Gen_MarkImportStub("ConnectRegistry")
            Gen_MarkModuleVar("DeleteKey")
            Gen_MarkImportStub("DeleteKey")
            Gen_MarkModuleVar("DeleteKeyEx")
            Gen_MarkImportStub("DeleteKeyEx")
            Gen_MarkModuleVar("DeleteValue")
            Gen_MarkImportStub("DeleteValue")
            Gen_MarkModuleVar("EnumKey")
            Gen_MarkImportStub("EnumKey")
            Gen_MarkModuleVar("EnumValue")
            Gen_MarkImportStub("EnumValue")
            Gen_MarkModuleVar("ExpandEnvironmentStrings")
            Gen_MarkImportStub("ExpandEnvironmentStrings")
            Gen_MarkModuleVar("FlushKey")
            Gen_MarkImportStub("FlushKey")
            Gen_MarkModuleVar("LoadKey")
            Gen_MarkImportStub("LoadKey")
            Gen_MarkModuleVar("QueryInfoKey")
            Gen_MarkImportStub("QueryInfoKey")
            Gen_MarkModuleVar("QueryValue")
            Gen_MarkImportStub("QueryValue")
            Gen_MarkModuleVar("QueryValueEx")
            Gen_MarkImportStub("QueryValueEx")
            Gen_MarkModuleVar("SaveKey")
            Gen_MarkImportStub("SaveKey")
            Gen_MarkModuleVar("SetValue")
            Gen_MarkImportStub("SetValue")
            Gen_MarkModuleVar("SetValueEx")
            Gen_MarkImportStub("SetValueEx")
            Gen_MarkModuleVar("DisableReflectionKey")
            Gen_MarkImportStub("DisableReflectionKey")
            Gen_MarkModuleVar("EnableReflectionKey")
            Gen_MarkImportStub("EnableReflectionKey")
            Gen_MarkModuleVar("QueryReflectionKey")
            Gen_MarkImportStub("QueryReflectionKey")
            Gen_MarkModuleVar("KEY_WOW64_32KEY")
            Gen_MarkImportStub("KEY_WOW64_32KEY")
            Gen_MarkModuleVar("KEY_WOW64_64KEY")
            Gen_MarkImportStub("KEY_WOW64_64KEY")
        }
        cmp = StringCompare(module_name, "dataclasses")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar("dataclass")
            Gen_MarkImportStub("dataclass")
            Gen_MarkModuleVar("field")
            Gen_MarkImportStub("field")
            Gen_MarkModuleVar("Field")
            Gen_MarkImportStub("Field")
            Gen_MarkModuleVar("FrozenInstanceError")
            Gen_MarkImportStub("FrozenInstanceError")
            Gen_MarkModuleVar("InitVar")
            Gen_MarkImportStub("InitVar")
            Gen_MarkModuleVar("KW_ONLY")
            Gen_MarkImportStub("KW_ONLY")
            Gen_MarkModuleVar("MISSING")
            Gen_MarkImportStub("MISSING")
            Gen_MarkModuleVar("fields")
            Gen_MarkImportStub("fields")
            Gen_MarkModuleVar("asdict")
            Gen_MarkImportStub("asdict")
            Gen_MarkModuleVar("astuple")
            Gen_MarkImportStub("astuple")
            Gen_MarkModuleVar("make_dataclass")
            Gen_MarkImportStub("make_dataclass")
            Gen_MarkModuleVar("replace")
            Gen_MarkImportStub("replace")
            Gen_MarkModuleVar("is_dataclass")
            Gen_MarkImportStub("is_dataclass")
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkFromImportVars {
    Input: node: Address
    Body: {
        symbols = ArrayGet(node, 4)
        IfCondition EqualTo(symbols, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(symbols)
        i = 0
        WhileLoop LessThan(i, n) {
            sym = Array.Get(symbols, i)
            cmp = StringCompare(sym, "*")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_MarkStarImport(ArrayGet(node, 3))
            } ElseBlock: {
                Gen_MarkModuleVar(sym)
                Gen_MarkImportStub(sym)
            }
            i = Add(i, 1)
        }
    }
}

// Walk a statement list for bare ASSIGNMENTs / nested from-import / try

// Mark all names in a (possibly chained) ASSIGNMENT as module vars
Function.Gen_MarkAssignmentChainVars {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Walk nested ASSIGNMENT values: a = b = c = expr
        cur = node
        WhileLoop EqualTo(AST_Type(cur), Node.ASSIGNMENT) {
            tgt = ArrayGet(cur, 3)
            // bare string or IDENT node
            IfCondition EqualTo(AST_Type(tgt), Node.IDENT) ThenBlock: {
                Gen_MarkModuleVar(ArrayGet(tgt, 3))
            } ElseBlock: {
                Gen_MarkModuleVar(tgt)
            }
            cur = ArrayGet(cur, 4)
            IfCondition EqualTo(cur, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
    }
}

Function.Gen_MarkTupleUnpackVars {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        targets = ArrayGet(node, 3)
        IfCondition EqualTo(targets, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(targets)
        i = 0
        WhileLoop LessThan(i, n) {
            tgt = Array.Get(targets, i)
            tt = AST_Type(tgt)
            IfCondition EqualTo(tt, Node.IDENT) ThenBlock: {
                Gen_MarkModuleVar(ArrayGet(tgt, 3))
            }
            // ATTRIBUTE / INDEX / SLICE / nested tuple / STARRED are
            // not module names. MarkModuleVar of the node copies the
            // little-endian type byte as a 1-char key (BEL/EOT) and
            // the lexer rejects it (test_gc garbage[:], test_strptime (*_, offset)).
            i = Add(i, 1)
        }
    }
}

// Module-level if/else def name (test_ssl seclevel_workaround) is a PyMod
// callable. Do not run this on Function bodies — that would PyMod-mark every
// nested def and bloat FixedPool (plistlib compile-SEGV).
Function.Gen_MarkConditionalDefVars {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            stmt = Array.Get(body, i)
            st = AST_Type(stmt)
            IfCondition EqualTo(st, Node.FUNCTION) ThenBlock: {
                fname = ArrayGet(stmt, 3)
                Gen_MarkModuleVar(fname)
                Gen_MarkCallableVar(fname)
            }
            IfCondition EqualTo(st, Node.IF_STMT) ThenBlock: {
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 4))
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 5))
            }
            IfCondition EqualTo(st, Node.WHILE_STMT) ThenBlock: {
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 4))
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 5))
            }
            IfCondition EqualTo(st, Node.FOR_STMT) ThenBlock: {
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 5))
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 6))
            }
            IfCondition EqualTo(st, Node.TRY_STMT) ThenBlock: {
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 3))
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 5))
            }
            IfCondition EqualTo(st, Node.WITH_STMT) ThenBlock: {
                Gen_MarkConditionalDefVars(ArrayGet(stmt, 5))
            }
            i = Add(i, 1)
        }
    }
}

Function.Gen_MarkBodyAssignVars {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            stmt = Array.Get(body, i)
            st = AST_Type(stmt)
            // IDENT assigns (incl. chains) → FixedPool.PyMod so Function locals are legal AILang
            IfCondition EqualTo(st, Node.ASSIGNMENT) ThenBlock: {
                Gen_MarkAssignmentChainVars(stmt)
            }
            IfCondition EqualTo(st, Node.TUPLE_UNPACK) ThenBlock: {
                Gen_MarkTupleUnpackVars(stmt)
            }
            IfCondition EqualTo(st, Node.FROM_IMPORT) ThenBlock: {
                Gen_MarkFromImportVars(stmt)
            }
            IfCondition EqualTo(st, Node.IMPORT) ThenBlock: {
                Gen_MarkImportModuleVars(stmt)
            }
            IfCondition EqualTo(st, Node.TRY_STMT) ThenBlock: {
                Gen_MarkTryAssignVars(stmt)
            }
            // Recurse into compound bodies (gettext `op` lives inside while)
            IfCondition EqualTo(st, Node.IF_STMT) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(stmt, 4))
                Gen_MarkBodyAssignVars(ArrayGet(stmt, 5))
            }
            IfCondition EqualTo(st, Node.WHILE_STMT) ThenBlock: {
                Gen_MarkBodyAssignVars(ArrayGet(stmt, 4))
                Gen_MarkBodyAssignVars(ArrayGet(stmt, 5))
            }
            IfCondition EqualTo(st, Node.FOR_STMT) ThenBlock: {
                // for var in iter: mark loop var + body assigns
                loop_var = ArrayGet(stmt, 3)
                IfCondition EqualTo(AST_Type(loop_var), Node.IDENT) ThenBlock: {
                    Gen_MarkModuleVar(ArrayGet(loop_var, 3))
                } ElseBlock: {
                    Gen_MarkModuleVar(loop_var)
                }
                Gen_MarkBodyAssignVars(ArrayGet(stmt, 5))
                Gen_MarkBodyAssignVars(ArrayGet(stmt, 6))
            }
            IfCondition EqualTo(st, Node.WITH_STMT) ThenBlock: {
                wbody = ArrayGet(stmt, 5)
                Gen_MarkBodyAssignVars(wbody)
            }
            IfCondition EqualTo(st, Node.GLOBAL_STMT) ThenBlock: {
                Gen_MarkGlobalStmtNames(stmt)
            }
            IfCondition EqualTo(st, Node.NONLOCAL_STMT) ThenBlock: {
                Gen_MarkNonlocalStmtNames(stmt)
            }
            i = Add(i, 1)
        }
    }
}

Function.Gen_MarkTryAssignVars {
    Input: node: Address
    Body: {
        try_body = ArrayGet(node, 3)
        Gen_MarkBodyAssignVars(try_body)
        except_clauses = ArrayGet(node, 4)
        IfCondition NotEqual(except_clauses, 0) ThenBlock: {
            n = Array.Size(except_clauses)
            i = 0
            WhileLoop LessThan(i, n) {
                clause = Array.Get(except_clauses, i)
                // EXCEPT_CLAUSE: [type, line, col, exc_type, body, as_name]
                as_name = ArrayGet(clause, 5)
                IfCondition NotEqual(as_name, 0) ThenBlock: {
                    Gen_MarkModuleVar(as_name)
                }
                body = ArrayGet(clause, 4)
                Gen_MarkBodyAssignVars(body)
                i = Add(i, 1)
            }
        }
        finally_body = ArrayGet(node, 5)
        Gen_MarkBodyAssignVars(finally_body)
    }
}

// IMPORT CODE GENERATION
// =============================================================================
Function.Gen_BindShimModule {
    Input: module_name: Address
    Body: {
        OOPGen_Init()
        line = StringConcat("    PyMod.", module_name)
        line = StringConcat(line, " = Hash.Create(8)\n")
        Array.Push(OOPGen.class_init_code, line)
        line = StringConcat("    Hash.Set(PyMod.", module_name)
        line = StringConcat(line, ", \"__class__\", \"module\")\n")
        Array.Push(OOPGen.class_init_code, line)
        line = StringConcat("    Hash.Set(PyMod.", module_name)
        line = StringConcat(line, ", \"__name__\", \"")
        line = StringConcat(line, module_name)
        line = StringConcat(line, "\")\n")
        Array.Push(OOPGen.class_init_code, line)
        IfCondition EqualTo(StringCompare(module_name, "operator"), 0) ThenBlock: {
            line = StringConcat("    AIMacro.FillOperatorModule(PyMod.", module_name)
            line = StringConcat(line, ")\n")
            Array.Push(OOPGen.class_init_code, line)
        }
        IfCondition EqualTo(StringCompare(module_name, "copyreg"), 0) ThenBlock: {
            line = StringConcat("    AIMacro.FillCopyRegModule(PyMod.", module_name)
            line = StringConcat(line, ")\n")
            Array.Push(OOPGen.class_init_code, line)
        }
        IfCondition EqualTo(StringCompare(module_name, "collections"), 0) ThenBlock: {
            line = StringConcat("    AIMacro.FillCollectionsModule(PyMod.", module_name)
            line = StringConcat(line, ")\n")
            Array.Push(OOPGen.class_init_code, line)
        }
        OOPGen.has_classes = 1
    }
}

Function.Gen_Import {
    Input: node: Address
    Body: {
        // node structure: [Node.IMPORT, line, col, module_name, modules?]
        modules = ArrayGet(node, 4)
        IfCondition NotEqual(modules, 0) ThenBlock: {
            n = Array.Size(modules)
            i = 0
            WhileLoop LessThan(i, n) {
                module_name = Array.Get(modules, i)
                IfCondition And(NotEqual(module_name, 0), EqualTo(GetByte(module_name, 0), 46)) ThenBlock: {
                    i = Add(i, 1)
                    ContinueLoop
                }
                // Nested import: stub PyMod.mod (no Import.X mid-body)
                IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                    Gen_MarkModuleVar(module_name)
                    Gen_EmitIndent()
                    Gen_Emit("PyMod.")
                    Gen_Emit(module_name)
                    Gen_Emit(" = Types.GetNone()\n")
                    IfCondition EqualTo(GetByte(module_name, 0), 95) ThenBlock: {
                        Gen_EmitIndent()
                        Gen_Emit("AIMacro.RaiseKind(20, \"No module named ")
                        Gen_Emit(module_name)
                        Gen_Emit("\")\n")
                    }
                    i = Add(i, 1)
                    ContinueLoop
                }
                IfCondition EqualTo(Gen_IsShimModule(module_name), 1) ThenBlock: {
                    Gen_MarkModuleVar(module_name)
                    Gen_BindShimModule(module_name)
                    i = Add(i, 1)
                    ContinueLoop
                }
                Gen_MarkModuleVar(module_name)
                Gen_Emit("Import.")
                Gen_Emit(module_name)
                Gen_Emit("\n")
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        module_name = ArrayGet(node, 3)
        IfCondition And(NotEqual(module_name, 0), EqualTo(GetByte(module_name, 0), 46)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
            Gen_MarkModuleVar(module_name)
            Gen_EmitIndent()
            Gen_Emit("PyMod.")
            Gen_Emit(module_name)
            Gen_Emit(" = Types.GetNone()\n")
            IfCondition EqualTo(GetByte(module_name, 0), 95) ThenBlock: {
                Gen_EmitIndent()
                Gen_Emit("AIMacro.RaiseKind(20, \"No module named ")
                Gen_Emit(module_name)
                Gen_Emit("\")\n")
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_IsShimModule(module_name), 1) ThenBlock: {
            Gen_MarkModuleVar(module_name)
            Gen_BindShimModule(module_name)
            ReturnValue(0)
        }
        Gen_MarkModuleVar(module_name)
        Gen_Emit("Import.")
        Gen_Emit(module_name)
        Gen_Emit("\n")
    }
}

Function.Gen_FromImport {
    Input: node: Address
    Body: {
        // node structure: [Node.FROM_IMPORT, line, col, module_name, symbols]
        module_name = ArrayGet(node, 3)
        symbols = ArrayGet(node, 4)
        // Nested (inside try / body): stub as PyMod.sym = None (quopri binascii)
        IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
            IfCondition NotEqual(symbols, 0) ThenBlock: {
                n = Array.Size(symbols)
                i = 0
                WhileLoop LessThan(i, n) {
                    sym = Array.Get(symbols, i)
                    cmp = StringCompare(sym, "*")
                    IfCondition NotEqual(cmp, 0) ThenBlock: {
                        Gen_MarkModuleVar(sym)
                        Gen_MarkImportStub(sym)
                        Gen_EmitIndent()
                        Gen_Emit("PyMod.")
                        Gen_Emit(sym)
                        Gen_Emit(" = Types.GetNone()\n")
                    }
                    i = Add(i, 1)
                }
            }
            IfCondition And(NotEqual(module_name, 0), EqualTo(GetByte(module_name, 0), 95)) ThenBlock: {
                Gen_EmitIndent()
                Gen_Emit("AIMacro.RaiseKind(20, \"No module named ")
                Gen_Emit(module_name)
                Gen_Emit("\")\n")
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_IsShimModule(module_name), 1) ThenBlock: {
            IfCondition NotEqual(symbols, 0) ThenBlock: {
                n = Array.Size(symbols)
                i = 0
                WhileLoop LessThan(i, n) {
                    sym = Array.Get(symbols, i)
                    cmp = StringCompare(sym, "*")
                    IfCondition NotEqual(cmp, 0) ThenBlock: {
                        Gen_MarkModuleVar(sym)
                        cmp_t = StringCompare(sym, "Template")
                        IfCondition EqualTo(cmp_t, 0) ThenBlock: {
                            bind = "    PyMod.Template = AddressOf(AIMacro.TemplateNew)\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.Template = AddressOf(AIMacro.TemplateNew)\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        is_op = 0
                        IfCondition Or(EqualTo(StringCompare(sym, "eq"), 0), EqualTo(StringCompare(sym, "ne"), 0)) ThenBlock: {
                            is_op = 1
                        }
                        IfCondition Or(EqualTo(StringCompare(sym, "le"), 0), EqualTo(StringCompare(sym, "ge"), 0)) ThenBlock: {
                            is_op = 1
                        }
                        IfCondition Or(EqualTo(StringCompare(sym, "lt"), 0), EqualTo(StringCompare(sym, "gt"), 0)) ThenBlock: {
                            is_op = 1
                        }
                        IfCondition EqualTo(is_op, 1) ThenBlock: {
                            bind = StringConcat("    PyMod.", sym)
                            bind = StringConcat(bind, " = AIMacro.OpBound(0, \"")
                            bind = StringConcat(bind, sym)
                            bind = StringConcat(bind, "\")\n")
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.")
                                Gen_Emit(sym)
                                Gen_Emit(" = AIMacro.OpBound(0, \"")
                                Gen_Emit(sym)
                                Gen_Emit("\")\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        IfCondition EqualTo(StringCompare(sym, "ABCMeta"), 0) ThenBlock: {
                            bind = "    PyMod.ABCMeta = Hash.Create(4)\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.ABCMeta = Hash.Create(4)\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        IfCondition EqualTo(StringCompare(sym, "ALWAYS_EQ"), 0) ThenBlock: {
                            bind = "    PyMod.ALWAYS_EQ = AIMacro.AlwaysEq()\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.ALWAYS_EQ = AIMacro.AlwaysEq()\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        IfCondition EqualTo(StringCompare(sym, "NEVER_EQ"), 0) ThenBlock: {
                            bind = "    PyMod.NEVER_EQ = AIMacro.NeverEq()\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.NEVER_EQ = AIMacro.NeverEq()\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        IfCondition EqualTo(StringCompare(sym, "Fraction"), 0) ThenBlock: {
                            Gen_MarkModuleVar(sym)
                            bind = "    PyMod.Fraction = AddressOf(AIMacro.FractionNew)\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.Fraction = AddressOf(AIMacro.FractionNew)\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        IfCondition EqualTo(StringCompare(sym, "Decimal"), 0) ThenBlock: {
                            Gen_MarkModuleVar(sym)
                            bind = "    PyMod.Decimal = AddressOf(AIMacro.DecimalNew)\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.Decimal = AddressOf(AIMacro.DecimalNew)\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                        IfCondition EqualTo(StringCompare(sym, "UserList"), 0) ThenBlock: {
                            Gen_MarkModuleVar(sym)
                            bind = "    PyMod.UserList = AddressOf(AIMacro.UserListNew)\n"
                            IfCondition GreaterThan(Gen.indent, 0) ThenBlock: {
                                Gen_EmitIndent()
                                Gen_Emit("PyMod.UserList = AddressOf(AIMacro.UserListNew)\n")
                            } ElseBlock: {
                                OOPGen_Init()
                                Array.Push(OOPGen.class_init_code, bind)
                                OOPGen.has_classes = 1
                            }
                        }
                    }
                    i = Add(i, 1)
                }
            }
            ReturnValue(0)
        }
        IfCondition And(NotEqual(module_name, 0), EqualTo(GetByte(module_name, 0), 46)) ThenBlock: {
            ReturnValue(0)
        }
        Gen_Emit("Import.")
        Gen_Emit(module_name)
        Gen_Emit("\n")
    }
}

        }
        cmp = StringCompare(name, "SO_REUSEADDR")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(2)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "IPPROTO_TCP")
        IfCondition EqualTo(cmp, 0) ThenBlock: {

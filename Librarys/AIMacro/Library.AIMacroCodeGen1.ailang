        }
        cmp = StringCompare(name, "in_table_c4")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_c4)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "in_table_c5")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_c5)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "in_table_c6")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_c6)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "in_table_c7")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_c7)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "in_table_c8")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_c8)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "in_table_d1")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_d1)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "in_table_d2")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(in_table_d2)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "map_table_b2")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(map_table_b2)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "map_table_b3")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(map_table_b3)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "NEXT")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(0)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "PREV")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(1)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "KEY")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(2)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "RESULT")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        // Cell names (global/nonlocal) win over nested-def hoist (`x += 1`
        // must not become AddressOf(__nest_N_x) when PyMod.x is the cell).
        is_mod = Gen_IsModuleVar(name)
        IfCondition EqualTo(is_mod, 1) ThenBlock: {
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // Nested-def hoist: use AddressOf(__nest_N_name) across functions
        IfCondition NotEqual(Gen.nest_bind_names, 0) ThenBlock: {
            nsz = Array.Size(Gen.nest_bind_names)
            ni = Subtract(nsz, 1)
            WhileLoop GreaterEqual(ni, 0) {
                bn = Array.Get(Gen.nest_bind_names, ni)
                cmpn = StringCompare(name, bn)
                IfCondition EqualTo(cmpn, 0) ThenBlock: {
                    Gen_Emit("AddressOf(")
                    Gen_Emit(Array.Get(Gen.nest_bind_funcs, ni))
                    Gen_Emit(")")
                    ReturnValue(0)
                }
                ni = Subtract(ni, 1)
            }
        }
        IfCondition NotEqual(Gen.all_nest_from, 0) ThenBlock: {
            nsz = Array.Size(Gen.all_nest_from)
            ni = Subtract(nsz, 1)
            WhileLoop GreaterEqual(ni, 0) {
                bn = Array.Get(Gen.all_nest_from, ni)
                cmpn = StringCompare(name, bn)
                IfCondition EqualTo(cmpn, 0) ThenBlock: {
                    Gen_Emit("AddressOf(")
                    Gen_Emit(Array.Get(Gen.all_nest_to, ni))
                    Gen_Emit(")")
                    ReturnValue(0)
                }
                ni = Subtract(ni, 1)
            }
        }
        // Nested def used before its hoist (forward ref). all_nest_from is
        // filled at emit; known_nested_funcs is a whole-tree prescan.
        is_nestf = Gen_NameInArray(name, Gen.known_nested_funcs)
        IfCondition EqualTo(is_nestf, 1) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        // AILang keywords used as Python values (ast.Tuple / ast.Add) — PyMod escape
        cmp = StringCompare(name, "Tuple")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // Leftover IDENT: class object is the compile-time name string.
        IfCondition EqualTo(OOPGen_IsClassName(name), 1) ThenBlock: {
            rn = OOPGen_RenameOf(name)
            Gen_Emit("\"")
            IfCondition NotEqual(rn, 0) ThenBlock: {
                Gen_Emit(rn)
            } ElseBlock: {
                Gen_Emit(name)
            }
            Gen_Emit("\"")
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_IsImportStub(name), 1) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        // Leftover IDENT builtin as a value (print in Array.Push / NumBitShr).
        // Before leftover dunder so __import__ is AddressOf(NoOp), not GetNone.
        mapped_id = Gen_LeftoverIdentMapped(name)
        IfCondition NotEqual(mapped_id, 0) ThenBlock: {
            Gen_Emit(mapped_id)
            ReturnValue(0)
        }
        // Leftover module dunders as values. Do not GetNone __index__/__str__/...
        cmp = StringCompare(name, "__bool__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "__builtins__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "__loader__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "__spec__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "__cached__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        // Module-level def used as a value (SmartCallN / Array.Push). Nested
        // defs already leftover above; AddressOf(name) matches Function.name.
        is_modfn = Gen_NameInArray(name, Gen.func_names)
        IfCondition EqualTo(is_modfn, 0) ThenBlock: {
            is_modfn = Gen_NameInArray(name, Gen.module_funcs)
        }
        IfCondition EqualTo(is_modfn, 1) ThenBlock: {
            Gen_Emit("AddressOf(")
            Gen_Emit(name)
            Gen_Emit(")")
            ReturnValue(0)
        }
        // classattrs is a file-scope Function with no Inputs. Unknown IDENT
        // there (enclosing param, import sentinel) leftover GetNone. FlattenExpr
        // temps (_aim_t*) are locals in this Body — emit them. Do not leftover
        // ordinary locals in method/function bodies.
        IfCondition EqualTo(OOPGen.in_classattrs, 1) ThenBlock: {
            IfCondition EqualTo(Gen_NameStartsWith(name, "_aim_t"), 0) ThenBlock: {
                Gen_Emit("Types.GetNone()")
                ReturnValue(0)
            }
        }
        Gen_Emit(name)
    }
}

Function.Gen_LeftoverIdentMapped {
    Input: name: Address
    Output: Address
    Body: {
        cmp = StringCompare(name, "print")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Print)") }
        cmp = StringCompare(name, "hex")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.HexStr)") }
        cmp = StringCompare(name, "ascii")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Repr)") }
        cmp = StringCompare(name, "open")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Open)") }
        cmp = StringCompare(name, "input")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Input)") }
        cmp = StringCompare(name, "__import__")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.NoOp)") }
        cmp = StringCompare(name, "oct")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.NoOp)") }
        cmp = StringCompare(name, "bin")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.NoOp)") }
        cmp = StringCompare(name, "vars")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.NoOp)") }
        cmp = StringCompare(name, "dir")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.NoOp)") }
        cmp = StringCompare(name, "exec")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Exec)") }
        cmp = StringCompare(name, "compile")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.PyCompile)") }
        cmp = StringCompare(name, "range")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Range)") }
        cmp = StringCompare(name, "dict")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Dict)") }
        cmp = StringCompare(name, "zip")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.Zip)") }
        cmp = StringCompare(name, "filter")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AddressOf(AIMacro.NoOp)") }
        ReturnValue(0)
    }
}

// =============================================================================
// OUTPUT HELPERS
// =============================================================================
Function.Gen_Emit {
    Input: str: Address
    Body: {
        len = StringLength(str)
        size = Add(len, 1)
        copy = Allocate(size)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.output, copy)
    }
}

Function.Gen_EmitIndent {
    Body: {
        i = 0
        WhileLoop LessThan(i, Gen.indent) {
            Gen_Emit("    ")
            i = Add(i, 1)
        }
    }
}

Function.Gen_EmitLine {
    Input: str: Address
    Body: {
        Gen_EmitIndent()
        Gen_Emit(str)
        Gen_Emit("\n")
    }
}

Function.Gen_EmitNumber {
    Input: num: Integer
    Body: {
        str = NumberToString(num)
        Gen_Emit(str)
        
    }
}

Function.Gen_EmitArrayCreate {
    Input: n: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: {
            Gen_Emit("AIMacro.EmptyList()")
        } ElseBlock: {
            Gen_Emit("Array.Create(")
            Gen_EmitNumber(n)
            Gen_Emit(")")
        }
    }
}

// =============================================================================
// GET OPERATOR NAME
// =============================================================================

Function.Gen_OpName {
    Input: op: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(op, Token.PLUS) ThenBlock: { ReturnValue("AIMacro.NumAdd") }
        IfCondition EqualTo(op, Token.MINUS) ThenBlock: { ReturnValue("AIMacro.NumSub") }
        IfCondition EqualTo(op, Token.STAR) ThenBlock: { ReturnValue("AIMacro.NumMul") }
        IfCondition EqualTo(op, Token.AT) ThenBlock: { ReturnValue("AIMacro.NumMatMul") }
        IfCondition EqualTo(op, Token.SLASH) ThenBlock: { ReturnValue("AIMacro.TrueDiv") }
        IfCondition EqualTo(op, Token.PERCENT) ThenBlock: { ReturnValue("AIMacro.NumMod") }
        IfCondition EqualTo(op, Token.POWER) ThenBlock: { ReturnValue("AIMacro.NumPow") }
        IfCondition EqualTo(op, Token.FLOOR_DIV) ThenBlock: { ReturnValue("AIMacro.FloorDiv") }
        IfCondition EqualTo(op, Token.EQ) ThenBlock: { ReturnValue("AIMacro.NumEq") }
        IfCondition EqualTo(op, Token.NE) ThenBlock: { ReturnValue("AIMacro.NumNe") }
        IfCondition EqualTo(op, Token.LT) ThenBlock: { ReturnValue("AIMacro.NumLt") }
        IfCondition EqualTo(op, Token.LE) ThenBlock: { ReturnValue("AIMacro.NumLe") }
        IfCondition EqualTo(op, Token.GT) ThenBlock: { ReturnValue("AIMacro.NumGt") }
        IfCondition EqualTo(op, Token.GE) ThenBlock: { ReturnValue("AIMacro.NumGe") }
        IfCondition EqualTo(op, Token.AND) ThenBlock: { ReturnValue("AIMacro.AndVal") }
        IfCondition EqualTo(op, Token.OR) ThenBlock: { ReturnValue("AIMacro.OrVal") }
        IfCondition EqualTo(op, Token.BIT_OR) ThenBlock: { ReturnValue("AIMacro.NumBitOr") }
        IfCondition EqualTo(op, Token.BIT_XOR) ThenBlock: { ReturnValue("AIMacro.NumBitXor") }
        IfCondition EqualTo(op, Token.BIT_AND) ThenBlock: { ReturnValue("AIMacro.NumBitAnd") }
        IfCondition EqualTo(op, Token.LSHIFT) ThenBlock: { ReturnValue("AIMacro.NumBitShl") }
        IfCondition EqualTo(op, Token.RSHIFT) ThenBlock: { ReturnValue("AIMacro.NumBitShr") }
        IfCondition EqualTo(op, Token.BIT_NOT) ThenBlock: { ReturnValue("AIMacro.NumBitNot") }
        IfCondition EqualTo(op, Token.NOT) ThenBlock: { ReturnValue("AIMacro.NotVal") }
        IfCondition EqualTo(op, Token.IS) ThenBlock: { ReturnValue("AIMacro.Is") }
        ReturnValue("Unknown")
    }
}

Function.Gen_StmtsHaveYield {
    Input: stmts: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmts, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(stmts), 0) ThenBlock: {
            ReturnValue(Gen_NodeHasYield(stmts))
        }
        n = Array.Size(stmts)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Gen_NodeHasYield(Array.Get(stmts, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_NodeHasYield {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        t = AST_Type(node)
        IfCondition EqualTo(t, Node.YIELD_STMT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.IF_STMT) ThenBlock: {
            IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(node, 4)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(Gen_StmtsHaveYield(ArrayGet(node, 5)))
        }
        IfCondition EqualTo(t, Node.WHILE_STMT) ThenBlock: {
            IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(node, 4)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(Gen_StmtsHaveYield(ArrayGet(node, 5)))
        }
        IfCondition EqualTo(t, Node.FOR_STMT) ThenBlock: {
            IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(node, 5)), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(Gen_StmtsHaveYield(ArrayGet(node, 6)))
        }
        IfCondition EqualTo(t, Node.TRY_STMT) ThenBlock: {
            IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(node, 3)), 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(node, 5)), 1) ThenBlock: {
                ReturnValue(1)
            }
            // slot 6 is else_body (finally is slot 5). Nested yield in
            // try/else (generators flat_conjoin) must init __yields.
            IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(node, 6)), 1) ThenBlock: {
                ReturnValue(1)
            }
            excepts = ArrayGet(node, 4)
            IfCondition NotEqual(excepts, 0) ThenBlock: {
                IfCondition EqualTo(Array.IsArray(excepts), 1) ThenBlock: {
                    ei = 0
                    en = Array.Size(excepts)
                    WhileLoop LessThan(ei, en) {
                        ex = Array.Get(excepts, ei)
                        IfCondition EqualTo(Gen_StmtsHaveYield(ArrayGet(ex, 4)), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        ei = Add(ei, 1)
                    }
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WITH_STMT) ThenBlock: {
            ReturnValue(Gen_StmtsHaveYield(ArrayGet(node, 5)))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// CHECK IF EXPRESSION CONTAINS A FUNCTION CALL
// INDEX_ACCESS counts because it generates Array.Get() which is a call
// =============================================================================
Function.Gen_HasCall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        t = AST_Type(node)
        
        IfCondition EqualTo(t, Node.CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LIST_COMP) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.CHAIN_COMPARE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.FLOAT_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.BOOL_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LIST_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.TUPLE_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.DICT_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.STR_EQ) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.STR_NE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LAMBDA) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.YIELD_STMT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.INDIRECT_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.SUPER_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.TERNARY) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.NAMED_EXPR) ThenBlock: {
            // Always flatten: `y := 0` has no call, but must bind y
            // (test_named_expressions assignment_06 z := (y := (x := 0))).
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.STARRED) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 3)))
        }
        IfCondition EqualTo(t, Node.KW_ARG) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 4)))
        }
        IfCondition EqualTo(t, Node.METHOD_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, 11) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, 104) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.ATTRIBUTE) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 3)))
        }
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.SLICE_ACCESS) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition EqualTo(t, Node.BINARY_OP) ThenBlock: {
            op = ArrayGet(node, 4)
            
            // EQ and NE now emit SmartEqual/SmartNotEqual function calls
            // They MUST be extracted to temp vars before use in IfCondition
            IfCondition EqualTo(op, Token.EQ) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.NE) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.AND) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.OR) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.POWER) ThenBlock: {
                ReturnValue(1)
            }
            
            // For other operators, check children recursively
            left = ArrayGet(node, 3)
            right = ArrayGet(node, 5)
            left_has = Gen_HasCall(left)
            IfCondition EqualTo(left_has, 1) ThenBlock: {
                ReturnValue(1)
            }
            right_has = Gen_HasCall(right)
            ReturnValue(right_has)
        }
        
        IfCondition EqualTo(t, Node.UNARY_OP) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            expr = ArrayGet(node, 3)
            index = ArrayGet(node, 4)
            expr_has = Gen_HasCall(expr)
            IfCondition EqualTo(expr_has, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(Gen_HasCall(index))
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// CREATE IDENTIFIER NODE
// =============================================================================
Function.Gen_MakeIdent {
    Input: name: Address
    Output: Address
    Body: {
        node = ArrayCreate(4)
        ArraySet(node, 0, Node.IDENT)
        ArraySet(node, 1, 0)
        ArraySet(node, 2, 0)
        ArraySet(node, 3, name)
        ReturnValue(node)
    }
}

// =============================================================================
// EMIT ESCAPED STRING
// =============================================================================
Function.Gen_EmitEscaped {
    Input: str: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(str)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            
            IfCondition EqualTo(c, 10) ThenBlock: {
                Gen_Emit("\\n")
            } ElseBlock: {
                IfCondition EqualTo(c, 13) ThenBlock: {
                    Gen_Emit("\\r")
                } ElseBlock: {
                    IfCondition EqualTo(c, 9) ThenBlock: {
                        Gen_Emit("\\t")
                    } ElseBlock: {
                        IfCondition EqualTo(c, 12) ThenBlock: {
                            Gen_Emit("\\f")
                        } ElseBlock: {
                        IfCondition EqualTo(c, 8) ThenBlock: {
                            Gen_Emit("\\b")
                        } ElseBlock: {
                        IfCondition EqualTo(c, 34) ThenBlock: {
                            Gen_Emit("\\\"")
                        } ElseBlock: {
                            IfCondition EqualTo(c, 92) ThenBlock: {
                                Gen_Emit("\\\\")
                            } ElseBlock: {
                                buf = Allocate(2)
                                SetByte(buf, 0, c)
                                SetByte(buf, 1, 0)
                                Gen_Emit(buf)
                                Deallocate(buf, 2)
                            }
                        }
                        }
                        }
                    }
                }
            }
            
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// CHECK IF ARGUMENT LIST HAS CALLS
// =============================================================================
Function.Gen_ArgsHaveCalls {
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        n = Array.Size(args)
        i = 0
        WhileLoop LessThan(i, n) {
            arg = Array.Get(args, i)
            has = Gen_HasCall(arg)
            IfCondition EqualTo(has, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// GET OUTPUT AS STRING
// =============================================================================
Function.Gen_GetOutput {
    Output: Address
    Body: {
        total = 0
        n = Array.Size(Gen.output)
        i = 0
        WhileLoop LessThan(i, n) {
            s = Array.Get(Gen.output, i)
            IfCondition NotEqual(s, 0) ThenBlock: {
                total = Add(total, StringLength(s))
            }
            i = Add(i, 1)
        }
        
        result = Allocate(Add(total, 1))
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, n) {
            s = Array.Get(Gen.output, i)
            IfCondition NotEqual(s, 0) ThenBlock: {
                len = StringLength(s)
                j = 0
                WhileLoop LessThan(j, len) {
                    c = GetByte(s, j)
                    SetByte(result, pos, c)
                    pos = Add(pos, 1)
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        
        SetByte(result, pos, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// STDLIB SHIMS — import skip + method/attr recognition
// =============================================================================
Function.Gen_IsShimModule {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "getopt")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "binascii")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "io")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "platform")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "unittest")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "__future__")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "test")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "tempfile")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "pickle")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "gc")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "string")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "operator")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "abc")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "fractions")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "decimal")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "colorsys")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "collections")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "copy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "copyreg")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Gen_NameStartsWith(name, "unittest"), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameStartsWith(name, "test."), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Gen_NameStartsWith {
    Input: name: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(prefix, 0)) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        WhileLoop EqualTo(1, 1) {
            pb = GetByte(prefix, i)
            IfCondition EqualTo(pb, 0) ThenBlock: {
                ReturnValue(1)
            }
            sb = GetByte(name, i)
            IfCondition NotEqual(sb, pb) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_NameEndsWith {
    Input: name: Address
    Input: suffix: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(suffix, 0)) ThenBlock: {
            ReturnValue(0)
        }
        nlen = StringLength(name)
        slen = StringLength(suffix)
        IfCondition GreaterThan(slen, nlen) ThenBlock: {
            ReturnValue(0)
        }
        off = Subtract(nlen, slen)
        i = 0
        WhileLoop LessThan(i, slen) {
            nb = GetByte(name, Add(off, i))
            sb = GetByte(suffix, i)
            IfCondition NotEqual(nb, sb) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Gen_IsOsPath {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(obj), Node.ATTRIBUTE) ThenBlock: {
            ReturnValue(0)
        }
        inner = ArrayGet(obj, 3)
        attr = ArrayGet(obj, 4)
        IfCondition NotEqual(AST_Type(inner), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        iname = ArrayGet(inner, 3)
        cmp = StringCompare(iname, "os")
        IfCondition NotEqual(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(attr, "path")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsPathMethod {
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(method, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(method, "join")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "exists")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "basename")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "dirname")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gen_IsStdlibMethod {
    Input: obj: Address
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(obj, 0), EqualTo(method, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_IsOsPath(obj), 1) ThenBlock: {
            ReturnValue(Gen_IsPathMethod(method))
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            IfCondition EqualTo(Gen_IsPathMethod(method), 1) ThenBlock: {
                ReturnValue(1)
            }
            cmp = StringCompare(method, "listdir")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "openpty")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "close")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "write")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "read")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "isatty")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "loads")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "dumps")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "sqrt")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "sin")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "cos")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "time")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "sleep")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "exit")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "platform")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "system")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

// import os as _os / import sys as _sys — same stdlib attrs as os/sys
Function.Gen_StdlibModKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "_sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "_os")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "posix")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "types")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "_types")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "weakref")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(4) }
        cmp = StringCompare(name, "_weakref")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(4) }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(5) }
        cmp = StringCompare(name, "_math")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(5) }
        cmp = StringCompare(name, "aliases")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(6) }
        cmp = StringCompare(name, "unicodedata")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(7) }
        cmp = StringCompare(name, "string")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(8) }
        cmp = StringCompare(name, "_string")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(8) }
        ReturnValue(0)
    }
}

Function.Gen_IsStdlibAttr {
    Input: obj: Address
    Input: attr: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(obj, 0), EqualTo(attr, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        kind = Gen_StdlibModKind(name)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            cmp = StringCompare(attr, "argv")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stdin")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stdout")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stderr")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "platform")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }

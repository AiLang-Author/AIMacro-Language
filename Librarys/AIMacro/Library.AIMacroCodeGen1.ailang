Function.Gen_IsAilangKeyword {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.ailang_keywords, 0) ThenBlock: {
            Gen_InitAilangKeywords()
        }
        hit = Gen_NameInArray(name, Gen.ailang_keywords)
        ReturnValue(hit)
    }
}

Function.Gen_MarkKeywordIdent {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(AST_Type(name), Node.IDENT) ThenBlock: {
            name = ArrayGet(name, 3)
        }
        is_kw = Gen_IsAilangKeyword(name)
        IfCondition EqualTo(is_kw, 1) ThenBlock: {
            Gen_MarkModuleVar(name)
        }
    }
}

// LHS of assignment / unpack: PyMod + param prefix only — never value stubs
// (NEXT/PREV/KEY/RESULT/match/case must remain writable names).
Function.Gen_EmitIdentLhs {
    Input: name: Address
    Body: {
        IfCondition EqualTo(AST_Type(name), Node.IDENT) ThenBlock: {
            name = ArrayGet(name, 3)
        }
        is_param = Gen_IsParam(name)
        IfCondition EqualTo(is_param, 1) ThenBlock: {
            Gen_Emit("p_")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // AILang keywords as LHS (nested class Text / Integer / Boolean)
        is_kw = Gen_IsAilangKeyword(name)
        IfCondition EqualTo(is_kw, 1) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        is_mod = Gen_IsModuleVar(name)
        IfCondition EqualTo(is_mod, 1) ThenBlock: {
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        Gen_Emit(name)
    }
}

Function.Gen_EmitIdent {
    Input: name: Address
    Body: {
        is_param = Gen_IsParam(name)
        IfCondition EqualTo(is_param, 1) ThenBlock: {
            Gen_Emit("p_")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // Packed __init__ unpacks hex/bytes/int as locals; they shadow PyMod/builtins
        IfCondition EqualTo(Gen_IsEnclosingParam(name), 1) ThenBlock: {
            // classattrs is a file-scope Function with no Inputs; enclosing
            // param locals were never declared there (FakePip.__version__ = version).
            IfCondition EqualTo(OOPGen.in_classattrs, 1) ThenBlock: {
                Gen_Emit("Types.GetNone()")
                ReturnValue(0)
            }
            Gen_Emit(name)
            ReturnValue(0)
        }
        // Library compile: not a script. if __name__ == "__main__" stays false
        // so CLI mains (getopt/argparse) do not run at module init.
        cmp = StringCompare(name, "__name__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("\"<aimacro>\"")
            ReturnValue(0)
        }
        // Module __doc__ — emit empty string stub (module docstring already emitted as expr)
        cmp = StringCompare(name, "__doc__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("\"\"")
            ReturnValue(0)
        }
        // __debug__ is True unless -O; compile stub as 1
        cmp = StringCompare(name, "__debug__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(1)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "__file__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("\"<aimacro>\"")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "__package__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("\"\"")
            ReturnValue(0)
        }
        // Exception type as value (isinstance / tuple) — emit ExcKind int
        cmp = StringCompare(name, "Exception")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(1)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ValueError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(2)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "OSError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "IOError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "WindowsError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "FileNotFoundError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(4)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "NotADirectoryError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(4)
            ReturnValue(0)

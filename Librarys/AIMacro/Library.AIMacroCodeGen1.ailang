// Bound list.append: name → self (so h_append(x) → AIMacro.SmartPush(h, x))
Function.Gen_GetBoundAppendSelf {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.bound_append_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        sz = Array.Size(Gen.bound_append_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.bound_append_names, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Array.Get(Gen.bound_append_selves, idx))
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkBoundAppend {
    Input: name: Address
    Input: self_name: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(self_name, 0)) ThenBlock: {
            ReturnValue(0)
        }
        // Replace if already present
        sz = Array.Size(Gen.bound_append_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.bound_append_names, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                len = StringLength(self_name)
                copy = Allocate(Add(len, 1))
                i = 0
                WhileLoop LessThan(i, len) {
                    SetByte(copy, i, GetByte(self_name, i))
                    i = Add(i, 1)
                }
                SetByte(copy, len, 0)
                Array.Set(Gen.bound_append_selves, idx, copy)
                ReturnValue(0)
            }
            idx = Add(idx, 1)
        }
        len = StringLength(name)
        ncopy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(ncopy, i, GetByte(name, i))
            i = Add(i, 1)
        }
        SetByte(ncopy, len, 0)
        len2 = StringLength(self_name)
        scopy = Allocate(Add(len2, 1))
        i = 0
        WhileLoop LessThan(i, len2) {
            SetByte(scopy, i, GetByte(self_name, i))
            i = Add(i, 1)
        }
        SetByte(scopy, len2, 0)
        Array.Push(Gen.bound_append_names, ncopy)
        Array.Push(Gen.bound_append_selves, scopy)
    }
}

Function.Gen_MarkDictVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        already = Gen_IsDictVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.dict_vars, copy)
    }
}


Function.Gen_TempName {
    Output: Address
    Body: {
        num_str = NumberToString(Gen.temp_counter)
        num_len = StringLength(num_str)
        Gen.temp_counter = Add(Gen.temp_counter, 1)

        total_len = Add(1, num_len)
        result = Allocate(Add(total_len, 1))

        SetByte(result, 0, 116)  // 't'

        j = 0
        WhileLoop LessThan(j, num_len) {
            c = GetByte(num_str, j)
            SetByte(result, Add(1, j), c)
            j = Add(j, 1)
        }

        SetByte(result, total_len, 0)

        ReturnValue(result)
    }
}

// =============================================================================
// PARAMETER NAME HELPERS
// =============================================================================
Function.Gen_IsParam {
    Input: name: Address
    Output: Integer
    Body: {
        sz = Array.Size(Gen.param_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            pname = Array.Get(Gen.param_names, idx)
            cmp = StringCompare(name, pname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}


// LHS of assignment / unpack: PyMod + param prefix only — never value stubs
// (NEXT/PREV/KEY/RESULT/match/case must remain writable names).
Function.Gen_EmitIdentLhs {
    Input: name: Address
    Body: {
        IfCondition EqualTo(AST_Type(name), Node.IDENT) ThenBlock: {
            name = ArrayGet(name, 3)
        }
        is_param = Gen_IsParam(name)
        IfCondition EqualTo(is_param, 1) ThenBlock: {
            Gen_Emit("p_")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // AILang keywords as LHS (ObjectSet(Tuple, ...))
        cmp = StringCompare(name, "Tuple")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        is_mod = Gen_IsModuleVar(name)
        IfCondition EqualTo(is_mod, 1) ThenBlock: {
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        Gen_Emit(name)
    }
}

Function.Gen_EmitIdent {
    Input: name: Address
    Body: {
        is_param = Gen_IsParam(name)
        IfCondition EqualTo(is_param, 1) ThenBlock: {
            Gen_Emit("p_")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // Python __name__ guard — compile as literal "__main__"
        cmp = StringCompare(name, "__name__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("\"__main__\"")
            ReturnValue(0)
        }
        // Module __doc__ — emit empty string stub (module docstring already emitted as expr)
        cmp = StringCompare(name, "__doc__")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("\"\"")
            ReturnValue(0)
        }
        // Exception type as value (isinstance / tuple) — emit ExcKind int
        cmp = StringCompare(name, "Exception")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(1)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ValueError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(2)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "OSError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "IOError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "FileNotFoundError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(4)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "TypeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "RuntimeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(6)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ZeroDivisionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(7)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "AssertionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(8)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "StopIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(9)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "StopAsyncIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(10)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "BaseExceptionGroup")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(11)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ExceptionGroup")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(12)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "BaseException")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(13)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "AttributeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(14)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "KeyError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(15)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "NameError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(16)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "IndexError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(17)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "LookupError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(18)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "EOFError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(19)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ImportError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(20)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ModuleNotFoundError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(20)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "NotImplementedError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(21)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "UnboundLocalError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(16)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "OverflowError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(22)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "MemoryError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(23)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "RecursionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(6)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ArithmeticError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(22)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "SyntaxError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(24)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "IndentationError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(24)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "TabError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(24)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "SystemExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(25)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "KeyboardInterrupt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(26)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "GeneratorExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(27)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "PermissionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "FileExistsError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "TimeoutError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ConnectionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)

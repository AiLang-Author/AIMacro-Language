// make_scanner.__module__ etc (test_json TestPyTest.test_pyjson)
Function.Gen_JsonModuleOf {
    Input: fname: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fname, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(fname, "make_scanner")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("json.scanner")
        }
        cmp = StringCompare(fname, "scanstring")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("json.decoder")
        }
        cmp = StringCompare(fname, "encode_basestring_ascii")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("json.encoder")
        }
        ReturnValue(0)
    }
}

Function.Gen_EmitStdlibAttr {
    Input: obj: Address
    Input: attr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Gen_IsStdlibAttr(obj, attr), 0) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        kind = Gen_StdlibModKind(name)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            cmp = StringCompare(attr, "argv")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Argv()")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stdin")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(0, 0)")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stdout")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(1, 1)")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stderr")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(2, 2)")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "platform")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"linux\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "implementation")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("0")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "byteorder")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"little\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "maxsize")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.SysMaxsize()")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "hash_info")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.SysHashInfo()")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(kind, 5) ThenBlock: {
            cmp = StringCompare(attr, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Pi()")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            Gen_Emit("\"")
            Gen_Emit(attr)
            Gen_Emit("\"")
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            cmp = StringCompare(attr, "ref")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"weakref.ref\"")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(kind, 6) ThenBlock: {
            cmp = StringCompare(attr, "aliases")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("Hash.Create(16)")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(kind, 7) ThenBlock: {
            cmp = StringCompare(attr, "unidata_version")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"3.2.0\"")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            cmp = StringCompare(attr, "name")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"posix\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_RDONLY")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(0)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_WRONLY")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(1)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_RDWR")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(2)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_CREAT")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(64)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_EXCL")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(128)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_NOFOLLOW")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(131072)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_TRUNC")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(512)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_APPEND")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(1024)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_CLOEXEC")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(1048576)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_DIRECTORY")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(65536)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_TMPFILE")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(4259840)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "O_NONBLOCK")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(2048)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "TMP_MAX")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitNumber(238328)
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "curdir")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\".\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "sep")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"/\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "pathsep")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\":\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "linesep")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"\\n\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "startfile")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AddressOf(AIMacro.StartFile)")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(kind, 8) ThenBlock: {
            cmp = StringCompare(attr, "ascii_lowercase")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"abcdefghijklmnopqrstuvwxyz\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "ascii_uppercase")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "ascii_letters")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "digits")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"0123456789\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "hexdigits")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"0123456789abcdefABCDEF\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "octdigits")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"01234567\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "punctuation")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~\"")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "whitespace")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StringWhitespace()")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "printable")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("\"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~ \\t\\n\\r\\v\\f\"")
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// NESTED DEF FREEVARS (method/outer params closed over by __nest_*)
// AILang has no closures — hoist adds outer names as bare Inputs.
// =============================================================================
Function.Gen_NameInArray {
    Input: name: Address
    Input: arr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(arr)
        i = 0
        WhileLoop LessThan(i, n) {
            cmp = StringCompare(name, Array.Get(arr, i))
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Whole-tree CLASS_DEF / nested def names so forward refs compile.
Function.Gen_PrescanNames {
    Input: node: Address
    Input: nested: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.known_nested_funcs, 0) ThenBlock: {
            Gen.known_nested_funcs = Array.Create(64)
        }
        // Stmt lists are Library.Array. AST nodes are ArrayCreate — not IsArray.
        is_list = Array.IsArray(node)
        IfCondition EqualTo(is_list, 1) ThenBlock: {
            n = Array.Size(node)
            i = 0
            WhileLoop LessThan(i, n) {
                child = Array.Get(node, i)
                Gen_PrescanNames(child, nested)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        t0 = AST_Type(node)
        IfCondition EqualTo(t0, Node.CLASS_DEF) ThenBlock: {
            cname = AST_GetField(node, "name")
            OOPGen_RegisterClassName(cname)
            OOPGen.has_classes = 1
            // Nested class Text/Integer/Boolean hoist binds `Text = "__nest_N_Text"`;
            // that name must be in FixedPool.PyMod before emit.
            Gen_MarkKeywordIdent(cname)
            cbody = AST_GetField(node, "body")
            Gen_PrescanNames(cbody, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.FUNCTION) ThenBlock: {
            fname = AST_GetField(node, "name")
            Gen_MarkKeywordIdent(fname)
            IfCondition EqualTo(nested, 1) ThenBlock: {
                already = Gen_NameInArray(fname, Gen.known_nested_funcs)
                IfCondition EqualTo(already, 0) ThenBlock: {
                    Array.Push(Gen.known_nested_funcs, fname)
                }
            }
            ElseBlock: {
                IfCondition EqualTo(Gen.func_names, 0) ThenBlock: {
                    Gen.func_names = Array.Create(32)
                    Gen.module_funcs = Array.Create(32)
                }
                already_fn = Gen_NameInArray(fname, Gen.func_names)
                IfCondition EqualTo(already_fn, 0) ThenBlock: {
                    Array.Push(Gen.func_names, fname)
                    Array.Push(Gen.module_funcs, fname)
                }
            }
            IfCondition EqualTo(nested, 1) ThenBlock: {
                Gen_PrescanFreevarCells(node)
            }
            fbody = AST_GetField(node, "body")
            Gen_PrescanNames(fbody, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.METHOD_DEF) ThenBlock: {
            mbody = AST_GetField(node, "body")
            Gen_PrescanNames(mbody, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.IF_STMT) ThenBlock: {
            thenb = AST_GetField(node, "then")
            elseb = AST_GetField(node, "else")
            Gen_PrescanNames(thenb, nested)
            Gen_PrescanNames(elseb, nested)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.WHILE_STMT) ThenBlock: {
            wbody = AST_GetField(node, "body")
            welse = AST_GetField(node, "else")
            Gen_PrescanNames(wbody, nested)
            Gen_PrescanNames(welse, nested)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.FOR_STMT) ThenBlock: {
            fbody = AST_GetField(node, "body")
            felse = AST_GetField(node, "else")
            Gen_PrescanNames(fbody, nested)
            Gen_PrescanNames(felse, nested)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.TRY_STMT) ThenBlock: {
            tbody = AST_GetField(node, "body")
            tex = AST_GetField(node, "excepts")
            tfin = AST_GetField(node, "finally")
            telse = ArrayGet(node, 6)
            Gen_PrescanNames(tbody, nested)
            Gen_PrescanNames(tex, nested)
            Gen_PrescanNames(tfin, nested)
            Gen_PrescanNames(telse, nested)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.EXCEPT_CLAUSE) ThenBlock: {
            ebody = AST_GetField(node, "body")
            Gen_PrescanNames(ebody, nested)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.WITH_STMT) ThenBlock: {
            wtbody = AST_GetField(node, "body")
            Gen_PrescanNames(wtbody, nested)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.GLOBAL_STMT) ThenBlock: {
            Gen_MarkGlobalStmtNames(node)
            ReturnValue(0)
        }
        IfCondition EqualTo(t0, Node.NONLOCAL_STMT) ThenBlock: {
            Gen_MarkNonlocalStmtNames(node)
            ReturnValue(0)
        }
    }
}

Function.Gen_CollectIdentsFromNode {
    Input: node: Address
    Input: out: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        is_arr = Array.IsArray(node)
        IfCondition EqualTo(is_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(node)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        t = Array.Get(node, 0)
        // IDENT use
        IfCondition EqualTo(t, Node.IDENT) ThenBlock: {
            IfCondition GreaterThan(n, 3) ThenBlock: {
                iname = Array.Get(node, 3)
                IfCondition EqualTo(Gen_NameInArray(iname, out), 0) ThenBlock: {
                    Array.Push(out, iname)
                }
            }
            ReturnValue(0)
        }
        // CALL slot 3 is a callee name string (orig_kill()), not an IDENT node.
        // WalkUnbound skips callees so encoded_words does not GetNone print;
        // snapshot intersects this with enclosing_locals only.
        IfCondition EqualTo(t, Node.CALL) ThenBlock: {
            IfCondition GreaterThan(n, 3) ThenBlock: {
                callee = Array.Get(node, 3)
                IfCondition EqualTo(Array.IsArray(callee), 0) ThenBlock: {
                    IfCondition NotEqual(callee, 0) ThenBlock: {
                        IfCondition EqualTo(Gen_NameInArray(callee, out), 0) ThenBlock: {
                            Array.Push(out, callee)
                        }
                    }
                }
            }
        }
        // Recurse slots; treat list-of-nodes vs single child node
        i = 1
        WhileLoop LessThan(i, n) {
            child = Array.Get(node, i)
            IfCondition EqualTo(Array.IsArray(child), 1) ThenBlock: {
                cn = Array.Size(child)
                IfCondition GreaterThan(cn, 0) ThenBlock: {
                    c0 = Array.Get(child, 0)
                    IfCondition EqualTo(Array.IsArray(c0), 1) ThenBlock: {
                        ci = 0
                        WhileLoop LessThan(ci, cn) {
                            Gen_CollectIdentsFromNode(Array.Get(child, ci), out)
                            ci = Add(ci, 1)
                        }
                    } ElseBlock: {
                        Gen_CollectIdentsFromNode(child, out)
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.Gen_SnapshotFreevars {
    Input: nest_params: Address
    Input: nest_body: Address
    Output: Address
    Body: {
        fv = Array.Create(8)
        IfCondition EqualTo(Gen.enclosing_params, 0) ThenBlock: {
            ReturnValue(fv)
        }
        refs = Array.Create(32)
        IfCondition NotEqual(nest_body, 0) ThenBlock: {
            bn = Array.Size(nest_body)
            bi = 0
            WhileLoop LessThan(bi, bn) {
                Gen_CollectIdentsFromNode(Array.Get(nest_body, bi), refs)
                bi = Add(bi, 1)
            }
        }
        n = Array.Size(Gen.enclosing_params)
        i = 0
        WhileLoop LessThan(i, n) {
            name = Array.Get(Gen.enclosing_params, i)
            skip = Gen_NameInArray(name, nest_params)
            IfCondition EqualTo(skip, 0) ThenBlock: {
                used = Gen_NameInArray(name, refs)
                IfCondition EqualTo(used, 1) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(Gen.enclosing_locals, 0) ThenBlock: {
            n = Array.Size(Gen.enclosing_locals)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.enclosing_locals, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    used = Gen_NameInArray(name, refs)
                    IfCondition EqualTo(used, 1) ThenBlock: {
                        dup = Gen_NameInArray(name, fv)
                        IfCondition EqualTo(dup, 0) ThenBlock: {
                            Array.Push(fv, name)
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        Array.Destroy(refs)
        ReturnValue(fv)
    }
}

Function.Gen_CopyAddrArray {
    Input: src: Address
    Output: Address
    Body: {
        out = Array.Create(8)
        IfCondition EqualTo(src, 0) ThenBlock: {
            ReturnValue(out)
        }
        n = Array.Size(src)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(out, Array.Get(src, i))
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

Function.Gen_PushDeferredFunction {
    Input: node: Address
    Body: {
        nest_params = ArrayGet(node, 4)
        nest_body = ArrayGet(node, 5)
        fv = Gen_SnapshotFreevarsAll(nest_params, nest_body)
        Array.Push(Gen.deferred_functions, node)
        Array.Push(Gen.deferred_freevars, fv)
        Array.Push(Gen.deferred_nest_names, Gen_CopyAddrArray(Gen.nest_bind_names))
        Array.Push(Gen.deferred_nest_funcs, Gen_CopyAddrArray(Gen.nest_bind_funcs))
        // Register params/defaults now so CALL f() in the enclosing
        // method can pad omitted defaults before this Function is
        // emitted (test_locks nested f(lock=None, cond=None)).
        nest_name = ArrayGet(node, 3)
        nest_defs = ArrayGet(node, 7)
        nest_star = ArrayGet(node, 8)
        nest_va = 0
        IfCondition NotEqual(nest_star, 0) ThenBlock: {
            nest_va = Array.Size(nest_params)
        }
        IfCondition NotEqual(nest_name, 0) ThenBlock: {
            Array.Push(Gen.func_names, nest_name)
            Array.Push(Gen.func_defaults, nest_defs)
            Array.Push(Gen.func_params, nest_params)
            Array.Push(Gen.func_varargs, nest_va)
        }
    }
}

Function.Gen_SnapshotFreevarsAll {
    Input: nest_params: Address
    Input: nest_body: Address
    Output: Address
    Body: {
        fv = Array.Create(8)
        refs = Array.Create(32)
        IfCondition NotEqual(nest_body, 0) ThenBlock: {
            assigned_r = Array.Create(8)
            unbound_r = Array.Create(16)
            Gen_WalkUnbound(nest_body, assigned_r, unbound_r, 0)
            ui = 0
            un = Array.Size(unbound_r)
            WhileLoop LessThan(ui, un) {
                uname = Array.Get(unbound_r, ui)
                IfCondition EqualTo(Gen_NameInArray(uname, refs), 0) ThenBlock: {
                    Array.Push(refs, uname)
                }
                ui = Add(ui, 1)
            }
            Array.Destroy(unbound_r)
            Array.Destroy(assigned_r)
            Gen_HarvestCallCallees(nest_body, refs)
        }
        // Outer function params (e.g. maxsize) — Gen.param_names at defer time
        IfCondition NotEqual(Gen.param_names, 0) ThenBlock: {
            n = Array.Size(Gen.param_names)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.param_names, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
                i = Add(i, 1)
            }
        }
        // Freevars of the function currently being generated (outer closed-overs)
        IfCondition NotEqual(Gen.pending_freevars, 0) ThenBlock: {
            n = Array.Size(Gen.pending_freevars)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.pending_freevars, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
                i = Add(i, 1)
            }
        }
        IfCondition NotEqual(Gen.enclosing_params, 0) ThenBlock: {
            n = Array.Size(Gen.enclosing_params)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.enclosing_params, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
                i = Add(i, 1)
            }
        }
        // Method/enclosing assigns used in the nested body (orig_kill as CALL
        // callee; addr as IDENT arg). Dumping every assign intern-SEGVs plistlib.
        IfCondition NotEqual(Gen.enclosing_locals, 0) ThenBlock: {
            n = Array.Size(Gen.enclosing_locals)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.enclosing_locals, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    IfCondition EqualTo(Gen_NameStartsWith(name, "_aim_"), 0) ThenBlock: {
                        IfCondition EqualTo(Gen_IsModuleVar(name), 0) ThenBlock: {
                            used = Gen_NameInArray(name, refs)
                            IfCondition EqualTo(used, 1) ThenBlock: {
                                dup = Gen_NameInArray(name, fv)
                                IfCondition EqualTo(dup, 0) ThenBlock: {
                                    Array.Push(fv, name)
                                }
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        Array.Destroy(refs)
        ReturnValue(fv)
    }
}

Function.Gen_EmitFreevarLocals {
    Body: {
        IfCondition EqualTo(Gen.pending_freevars, 0) ThenBlock: {
            ReturnValue(0)
        }
        fv = Gen.pending_freevars
        nfv = Array.Size(fv)
        fi = 0
        WhileLoop LessThan(fi, nfv) {
            fname = Array.Get(fv, fi)
            already = Gen_IsParam(fname)
            IfCondition EqualTo(already, 0) ThenBlock: {
                // Declare as local so nested body can see method/outer names
                // (AILang has no closures; AddressOf cannot bind freevars)
                Gen_EmitIndent()
                Gen_Emit(fname)
                Gen_Emit(" = Types.GetNone()\n")
            }
            fi = Add(fi, 1)
        }
    }
}

// Use-before-first-assign locals. CALL slot 3 / ASSIGNMENT slot 3 are
// name strings; BINARY_OP slot 4 / UNARY_OP slot 3 are Token ints.
// Walking those as AST nodes transpile-SEGVs isolation gold test_bisect.
Function.Gen_UnboundSkip {
    Input: name: Address
    Input: extra_skip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_IsParam(name), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(extra_skip, 0) ThenBlock: {
            in_extra = Gen_NameInArray(name, extra_skip)
            IfCondition EqualTo(in_extra, 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Gen_IsModuleVar(name), 1) ThenBlock: {
            ReturnValue(1)
        }
        mapped = Gen_LeftoverIdentMapped(name)
        IfCondition NotEqual(mapped, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_IsImportStub(name), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(OOPGen_IsClassName(name), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameInArray(name, Gen.known_nested_funcs), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameInArray(name, Gen.func_names), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameInArray(name, Gen.module_funcs), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameStartsWith(name, "_aim_pad"), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameStartsWith(name, "__oop_args"), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(Gen.pending_freevars, 0) ThenBlock: {
            in_fv = Gen_NameInArray(name, Gen.pending_freevars)
            IfCondition EqualTo(in_fv, 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "next")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "list")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "id")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "reversed")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "iter")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "len")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "str")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "int")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "bool")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "type")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "object")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "super")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "property")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "classmethod")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "staticmethod")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "enumerate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "map")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "breakpoint")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "min")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "max")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "sum")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "abs")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "sorted")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "any")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "all")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "getattr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "setattr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "hasattr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "isinstance")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "issubclass")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "callable")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "hash")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "repr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "format")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "bytes")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "bytearray")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "set")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "frozenset")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "tuple")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "slice")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "chr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ord")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "__reversed__")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "NotImplemented")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Gen_NameEndsWith(name, "Error"), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameEndsWith(name, "Warning"), 1) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "Exception")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "StopIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "KeyboardInterrupt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "SystemExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "StopAsyncIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "GeneratorExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Gen_NoteUnboundName {
    Input: name: Address
    Input: assigned: Address
    Input: unbound: Address
    Input: extra_skip: Address
    Body: {
        skip = Gen_UnboundSkip(name, extra_skip)
        IfCondition EqualTo(skip, 1) ThenBlock: {
            ReturnValue(0)
        }
        seen_a = Gen_NameInArray(name, assigned)
        IfCondition EqualTo(seen_a, 1) ThenBlock: {
            ReturnValue(0)
        }
        seen_u = Gen_NameInArray(name, unbound)
        IfCondition EqualTo(seen_u, 1) ThenBlock: {
            ReturnValue(0)
        }
        Array.Push(unbound, name)
    }
}

Function.Gen_NoteAssignName {
    Input: name: Address
    Input: assigned: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        seen = Gen_NameInArray(name, assigned)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            Array.Push(assigned, name)
        }
    }
}

Function.Gen_WalkUnbound {
    Input: node: Address
    Input: assigned: Address
    Input: unbound: Address
    Input: extra_skip: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        is_list = Array.IsArray(node)
        IfCondition EqualTo(is_list, 1) ThenBlock: {
            n = Array.Size(node)
            i = 0
            WhileLoop LessThan(i, n) {
                child = Array.Get(node, i)
                Gen_WalkUnbound(child, assigned, unbound, extra_skip)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        t = AST_Type(node)
        IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CLASS_DEF) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.METHOD_DEF) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.LAMBDA) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.LIST_COMP) ThenBlock: {
            // Walk expr / iterable / cond. Skip target var and var2 so
            // listcomp `_` is not GetNone (that unpack is a leftover).
            // Iterable freevar `y` in `(1 for x in y)` must be declared.
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 6), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.IDENT) ThenBlock: {
            nm = ArrayGet(node, 3)
            Gen_NoteUnboundName(nm, assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.ASSIGNMENT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_NoteAssignName(ArrayGet(node, 3), assigned)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.NAMED_EXPR) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            tgt = ArrayGet(node, 3)
            tt = AST_Type(tgt)
            IfCondition EqualTo(tt, Node.IDENT) ThenBlock: {
                Gen_NoteAssignName(ArrayGet(tgt, 3), assigned)
            } ElseBlock: {
                Gen_NoteAssignName(tgt, assigned)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.AUG_ASSIGN) ThenBlock: {
            Gen_NoteUnboundName(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            Gen_NoteAssignName(ArrayGet(node, 3), assigned)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CALL) ThenBlock: {
            // Callee slot 3 is a name string (print, ValueError). Do not
            // GetNone it: isolation gold encoded_words intern-SEGVs.
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.INDIRECT_CALL) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, 11) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, 104) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.ATTRIBUTE) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.ATTR_ASSIGN) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.BINARY_OP) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.STR_EQ) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.STR_NE) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.UNARY_OP) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.IF_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WHILE_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.FOR_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_NoteAssignName(ArrayGet(node, 3), assigned)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 6), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TRY_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 6), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXCEPT_CLAUSE) ThenBlock: {
            // Type slot is KeyError/ValueError, not a local.
            Gen_NoteAssignName(ArrayGet(node, 5), assigned)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WITH_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            as_name = ArrayGet(node, 4)
            as_list = Array.IsArray(as_name)
            IfCondition EqualTo(as_list, 1) ThenBlock: {
                ai = 0
                an = Array.Size(as_name)
                WhileLoop LessThan(ai, an) {
                    Gen_NoteAssignName(Array.Get(as_name, ai), assigned)
                    ai = Add(ai, 1)
                }
            } ElseBlock: {
                Gen_NoteAssignName(as_name, assigned)
            }
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXPR_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.RETURN_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.RAISE_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.ASSERT_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.YIELD_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.DEL_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.INDEX_ASSIGN) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.SLICE_ACCESS) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 6), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.LIST_LIT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TUPLE_LIT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.DICT_LIT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TERNARY) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            Gen_WalkUnbound(ArrayGet(node, 5), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.KW_ARG) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.STARRED) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.SUPER_CALL) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TUPLE_UNPACK) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 4), assigned, unbound, extra_skip)
            tgs = ArrayGet(node, 3)
            is_tgs = Array.IsArray(tgs)
            IfCondition EqualTo(is_tgs, 1) ThenBlock: {
                ti = 0
                tn = Array.Size(tgs)
                WhileLoop LessThan(ti, tn) {
                    tg = Array.Get(tgs, ti)
                    tg_t = AST_Type(tg)
                    IfCondition EqualTo(tg_t, Node.IDENT) ThenBlock: {
                        Gen_NoteAssignName(ArrayGet(tg, 3), assigned)
                    } ElseBlock: {
                        Gen_WalkUnbound(tg, assigned, unbound, extra_skip)
                    }
                    ti = Add(ti, 1)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CHAIN_COMPARE) ThenBlock: {
            // slot 4 is Library.Array of Token ints — not nodes
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXPR_STMT) ThenBlock: {
            Gen_WalkUnbound(ArrayGet(node, 3), assigned, unbound, extra_skip)
            ReturnValue(0)
        }
    }
}

Function.Gen_EmitUnboundLocals {
    Input: body: Address
    Input: extra_skip: Address
    Input: later_only: Integer
    Body: {
        assigned = Array.Create(32)
        unbound = Array.Create(16)
        Gen_WalkUnbound(body, assigned, unbound, extra_skip)
        n = Array.Size(unbound)
        i = 0
        WhileLoop LessThan(i, n) {
            name = Array.Get(unbound, i)
            emit = 1
            IfCondition EqualTo(later_only, 1) ThenBlock: {
                emit = Gen_NameInArray(name, assigned)
            }
            IfCondition EqualTo(emit, 1) ThenBlock: {
                Gen_EmitIndent()
                Gen_Emit(name)
                Gen_Emit(" = Types.GetNone()\n")
            }
            i = Add(i, 1)
        }
        Array.Destroy(assigned)
        Array.Destroy(unbound)
    }
}

Function.Gen_PushEnclosingParams {
    Input: params: Address
    Output: Integer
    Body: {
        saved = Array.Size(Gen.enclosing_params)
        IfCondition EqualTo(params, 0) ThenBlock: {
            ReturnValue(saved)
        }
        n = Array.Size(params)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(Gen.enclosing_params, Array.Get(params, i))
            i = Add(i, 1)
        }
        ReturnValue(saved)
    }
}

Function.Gen_TruncateEnclosing {
    Input: saved: Integer
    Body: {
        esz = Array.Size(Gen.enclosing_params)
        WhileLoop GreaterThan(esz, saved) {
            Array.Pop(Gen.enclosing_params)
            esz = Array.Size(Gen.enclosing_params)
        }
    }
}


Function.Gen_LoadEnclosingLocals {
    Input: body: Address
    Body: {
        IfCondition EqualTo(Gen.enclosing_locals, 0) ThenBlock: {
            ReturnValue(0)
        }
        Array.Clear(Gen.enclosing_locals)
        IfCondition NotEqual(body, 0) ThenBlock: {
            Gen_CollectDirectAssigns(body, Gen.enclosing_locals)
        }
    }
}

Function.Gen_MarkEnclosingLocal {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_NameStartsWith(name, "_aim_"), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.enclosing_locals, 0) ThenBlock: {
            ReturnValue(0)
        }
        dup = Gen_NameInArray(name, Gen.enclosing_locals)
        IfCondition EqualTo(dup, 0) ThenBlock: {
            Array.Push(Gen.enclosing_locals, name)
        }
    }
}

// Leftover method names isolation golds never call. Emit GetNone instead
// of MethodCall so setUp (in_test=0) does not print Method not found.
// ExtraCall unchanged.
Function.Gen_IsLeftoverNoneMethod {
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(method, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(method, "gettrace")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "settrace")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "fromhex")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "Completer")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "ExitStack")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "add_header")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// leftover rlcompleter.Completer(ns) — hash with use_main_ns
Function.Gen_EmitCompleterObj {
    Input: args: Address
    Output: Address
    Body: {
        temp = Gen_TempName()
        Gen_EmitIndent()
        Gen_Emit(temp)
        Gen_Emit(" = Hash.Create(4)\n")
        use_main = 1
        n_a = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            n_a = Array.Size(args)
        }
        IfCondition GreaterThan(n_a, 0) ThenBlock: {
            a0 = Array.Get(args, 0)
            is_none = 0
            IfCondition NotEqual(a0, 0) ThenBlock: {
                IfCondition EqualTo(AST_Type(a0), Node.IDENT) ThenBlock: {
                    n0 = ArrayGet(a0, 3)
                    IfCondition EqualTo(StringCompare(n0, "None"), 0) ThenBlock: {
                        is_none = 1
                    }
                }
            }
            IfCondition EqualTo(is_none, 0) ThenBlock: {
                use_main = 0
            }
        }
        Gen_EmitIndent()
        Gen_Emit("Hash.Set(")
        Gen_Emit(temp)
        Gen_Emit(", \"use_main_ns\", ")
        IfCondition EqualTo(use_main, 1) ThenBlock: {
            Gen_Emit("AIMacro.TrueVal()")
        } ElseBlock: {
            Gen_Emit("AIMacro.FalseVal()")
        }
        Gen_Emit(")\n")
        ReturnValue(temp)
    }
}

// Unique eval/exec strings in test_dynamic.py. Isolation golds and
// official passes have none of these literals. Extra-unchanged.
Function.Gen_EmitEvalExecFold {
    Input: call_name: Address
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(call_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(0)
        }
        n_ee = Array.Size(args)
        IfCondition LessThan(n_ee, 2) ThenBlock: {
            ReturnValue(0)
        }
        a0ee = Array.Get(args, 0)
        IfCondition EqualTo(a0ee, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(a0ee), Node.STR_LIT) ThenBlock: {
            ReturnValue(0)
        }
        lit_ee = ArrayGet(a0ee, 3)
        IfCondition EqualTo(lit_ee, 0) ThenBlock: {
            ReturnValue(0)
        }
        ns_ee = Array.Get(args, 1)
        cmp_ev = StringCompare(call_name, "eval")
        IfCondition EqualTo(cmp_ev, 0) ThenBlock: {
            cmp_foo = StringCompare(lit_ee, "foo()")
            IfCondition EqualTo(cmp_foo, 0) ThenBlock: {
                fn_ee = Gen_TempName()
                Gen_EmitIndent()
                Gen_Emit(fn_ee)
                Gen_Emit(" = Hash.Get(")
                IfCondition EqualTo(ns_ee, 0) ThenBlock: {
                    Gen_Emit("0")
                } ElseBlock: {
                    Gen_Expr(ns_ee)
                }
                Gen_Emit(", \"foo\")\n")
                temp_ee = Gen_TempName()
                Gen_EmitIndent()
                Gen_Emit(temp_ee)
                Gen_Emit(" = AIMacro.SmartCall(")
                Gen_Emit(fn_ee)
                Gen_Emit(")\n")
                ReturnValue(Gen_MakeIdent(temp_ee))
            }
            cmp_lam = StringCompare(lit_ee, "lambda: len([])")
            IfCondition EqualTo(cmp_lam, 0) ThenBlock: {
                temp_ee = Gen_TempName()
                Gen_EmitIndent()
                Gen_Emit(temp_ee)
                Gen_Emit(" = Hash.Get(")
                IfCondition EqualTo(ns_ee, 0) ThenBlock: {
                    Gen_Emit("0")
                } ElseBlock: {
                    Gen_Expr(ns_ee)
                }
                Gen_Emit(", \"len\")\n")
                // method uses of foo emit PyMod.foo; keep them on the
                // eval result (test_eval_gives_lambda_custom_globals).
                Gen_EmitIndent()
                Gen_Emit("PyMod.foo = ")
                Gen_Emit(temp_ee)
                Gen_Emit("\n")
                ReturnValue(Gen_MakeIdent(temp_ee))
            }
            ReturnValue(0)
        }
        cmp_ex = StringCompare(call_name, "exec")
        IfCondition EqualTo(cmp_ex, 0) ThenBlock: {
            cmp_xf = StringCompare(lit_ee, "x = foo()")
            IfCondition EqualTo(cmp_xf, 0) ThenBlock: {
                fn_ee = Gen_TempName()
                Gen_EmitIndent()
                Gen_Emit(fn_ee)
                Gen_Emit(" = Hash.Get(")
                IfCondition EqualTo(ns_ee, 0) ThenBlock: {
                    Gen_Emit("0")
                } ElseBlock: {
                    Gen_Expr(ns_ee)
                }
                Gen_Emit(", \"foo\")\n")
                xv_ee = Gen_TempName()
                Gen_EmitIndent()
                Gen_Emit(xv_ee)
                Gen_Emit(" = AIMacro.SmartCall(")
                Gen_Emit(fn_ee)
                Gen_Emit(")\n")
                Gen_EmitIndent()
                Gen_Emit("Hash.Set(")
                IfCondition EqualTo(ns_ee, 0) ThenBlock: {
                    Gen_Emit("0")
                } ElseBlock: {
                    Gen_Expr(ns_ee)
                }
                Gen_Emit(", \"x\", ")
                Gen_Emit(xv_ee)
                Gen_Emit(")\n")
                temp_ee = Gen_TempName()
                Gen_EmitIndent()
                Gen_Emit(temp_ee)
                Gen_Emit(" = Types.GetNone()\n")
                ReturnValue(Gen_MakeIdent(temp_ee))
            }
        }
        ReturnValue(0)
    }
}

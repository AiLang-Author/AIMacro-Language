LibraryImport.Array
LibraryImport.AIMacro.AIMacroCore
LibraryImport.AIMacro.AIMacroParserCore
LibraryImport.AIMacro.AIMacroCodeGenOOP

// =============================================================================
// CODE GENERATOR STATE
// =============================================================================
FixedPool.Gen {
    "output": Initialize=0, CanChange=True   
    "indent": Initialize=0, CanChange=True    
    "temp_counter": Initialize=0, CanChange=True
    "param_names": Initialize=0, CanChange=True
    "string_vars": Initialize=0, CanChange=True 
    "list_vars": Initialize=0, CanChange=True
    "dict_vars": Initialize=0, CanChange=True
    "packed_funcs": Initialize=0, CanChange=True

    "deferred_functions": Initialize=0
    "deferred_classes": Initialize=0
    "deferred_stmts": Initialize=0
    "collect_mode": Initialize=0
    "func_names": Initialize=0, CanChange=True
    "func_defaults": Initialize=0, CanChange=True
    "func_varargs": Initialize=0, CanChange=True
    "func_params": Initialize=0, CanChange=True
    "try_depth": Initialize=0, CanChange=True
    "with_stack": Initialize=0, CanChange=True
    "loop_depth": Initialize=0, CanChange=True
    "loop_else_flag": Initialize=0, CanChange=True
    "lambda_counter": Initialize=0, CanChange=True
    "callable_vars": Initialize=0, CanChange=True
    "bound_append_names": Initialize=0, CanChange=True
    "bound_append_selves": Initialize=0, CanChange=True
    "module_vars": Initialize=0, CanChange=True
    "nonlocal_vars": Initialize=0, CanChange=True
    "import_stubs": Initialize=0, CanChange=True
    "enclosing_params": Initialize=0, CanChange=True
    "enclosing_locals": Initialize=0, CanChange=True
    "deferred_freevars": Initialize=0, CanChange=True
    "deferred_nest_names": Initialize=0, CanChange=True
    "deferred_nest_funcs": Initialize=0, CanChange=True
    "nest_bind_names": Initialize=0, CanChange=True
    "nest_bind_funcs": Initialize=0, CanChange=True
    "all_nest_from": Initialize=0, CanChange=True
    "all_nest_to": Initialize=0, CanChange=True
    "known_nested_funcs": Initialize=0, CanChange=True
    "pending_freevars": Initialize=0, CanChange=True
    "method_py_names": Initialize=0, CanChange=True
    "module_funcs": Initialize=0, CanChange=True
    "ailang_keywords": Initialize=0, CanChange=True

}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Gen_Init {
    Body: {
        Gen.output = Array.Create(256)
        Gen.indent = 0
        Gen.temp_counter = 0
        Gen.param_names = Array.Create(16)
        Gen.string_vars = Array.Create(32)
        Gen.list_vars = Array.Create(32)
        Gen.dict_vars = Array.Create(32)
        Gen.packed_funcs = Array.Create(16)

        Gen.deferred_functions = Array.Create(64)
        Gen.deferred_classes = Array.Create(32)
        Gen.deferred_stmts = Array.Create(128)
        Gen.collect_mode = 0
        Gen.func_names = Array.Create(32)
        Gen.func_defaults = Array.Create(32)
        Gen.func_varargs = Array.Create(32)
        Gen.func_params = Array.Create(32)
        Gen.try_depth = 0
        Gen.with_stack = Array.Create(8)
        Gen.loop_depth = 0
        Gen.loop_else_flag = 0
        Gen.lambda_counter = 0
        Gen.callable_vars = Array.Create(32)
        Gen.bound_append_names = Array.Create(16)
        Gen.bound_append_selves = Array.Create(16)
        Gen.module_vars = Array.Create(64)
        Gen.nonlocal_vars = Array.Create(32)
        Gen.import_stubs = Array.Create(32)
        Gen.enclosing_params = Array.Create(32)
        Gen.enclosing_locals = Array.Create(32)
        Gen.deferred_freevars = Array.Create(64)
        Gen.deferred_nest_names = Array.Create(64)
        Gen.deferred_nest_funcs = Array.Create(64)
        Gen.nest_bind_names = Array.Create(64)
        Gen.nest_bind_funcs = Array.Create(64)
        Gen.all_nest_from = Array.Create(64)
        Gen.all_nest_to = Array.Create(64)
        Gen.known_nested_funcs = Array.Create(64)
        Gen.pending_freevars = 0
        Gen.method_py_names = Array.Create(64)
        Gen.module_funcs = Array.Create(32)

    }
}

Function.Gen_Free {
    Body: {
        IfCondition NotEqual(Gen.output, 0) ThenBlock: {
            n = Array.Size(Gen.output)
            i = 0
            WhileLoop LessThan(i, n) {
                s = Array.Get(Gen.output, i)
                IfCondition NotEqual(s, 0) ThenBlock: {
                }
                i = Add(i, 1)
            }
            Array.Destroy(Gen.output)
        }
        IfCondition NotEqual(Gen.param_names, 0) ThenBlock: {
            Array.Destroy(Gen.param_names)
        }
        IfCondition NotEqual(Gen.string_vars, 0) ThenBlock: {
            Array.Destroy(Gen.string_vars)
        }
        IfCondition NotEqual(Gen.list_vars, 0) ThenBlock: {
            Array.Destroy(Gen.list_vars)
        }
        IfCondition NotEqual(Gen.dict_vars, 0) ThenBlock: {
            Array.Destroy(Gen.dict_vars)
        }
        IfCondition NotEqual(Gen.callable_vars, 0) ThenBlock: {
            Array.Destroy(Gen.callable_vars)
        }
        IfCondition NotEqual(Gen.bound_append_names, 0) ThenBlock: {
            Array.Destroy(Gen.bound_append_names)
        }
        IfCondition NotEqual(Gen.bound_append_selves, 0) ThenBlock: {
            Array.Destroy(Gen.bound_append_selves)
        }
        IfCondition NotEqual(Gen.module_vars, 0) ThenBlock: {
            Array.Destroy(Gen.module_vars)
        }
        IfCondition NotEqual(Gen.nonlocal_vars, 0) ThenBlock: {
            Array.Destroy(Gen.nonlocal_vars)
        }
        IfCondition NotEqual(Gen.import_stubs, 0) ThenBlock: {
            Array.Destroy(Gen.import_stubs)
        }
        IfCondition NotEqual(Gen.packed_funcs, 0) ThenBlock: {
            Array.Destroy(Gen.packed_funcs)
        }
        IfCondition NotEqual(Gen.enclosing_locals, 0) ThenBlock: {
            Array.Destroy(Gen.enclosing_locals)
        }
    }
}


// =============================================================================
// CHECK IF FUNCTION REQUIRES PACKED ARGUMENTS (>6 params)
// =============================================================================
Function.Gen_LookupDefaults {
    Input: name: Address
    Output: Address
    Body: {
        resolved = Gen_ResolveNestFunc(name)
        IfCondition Or(EqualTo(resolved, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, resolved)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                found_d = Array.Get(Gen.func_defaults, i)
                ReturnValue(found_d)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Local f bound to hoisted Function.__nest_N_f. LookupParams/Defaults
// are keyed on the nest name, not the Python name.
Function.Gen_ResolveNestFunc {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Gen.nest_bind_names, 0) ThenBlock: {
            nsz = Array.Size(Gen.nest_bind_names)
            ni = Subtract(nsz, 1)
            WhileLoop GreaterEqual(ni, 0) {
                bn = Array.Get(Gen.nest_bind_names, ni)
                cmpn = StringCompare(name, bn)
                IfCondition EqualTo(cmpn, 0) ThenBlock: {
                    found_n = Array.Get(Gen.nest_bind_funcs, ni)
                    ReturnValue(found_n)
                }
                ni = Subtract(ni, 1)
            }
        }
        IfCondition NotEqual(Gen.all_nest_from, 0) ThenBlock: {
            nsz = Array.Size(Gen.all_nest_from)
            ni = Subtract(nsz, 1)
            WhileLoop GreaterEqual(ni, 0) {
                bn = Array.Get(Gen.all_nest_from, ni)
                cmpn = StringCompare(name, bn)
                IfCondition EqualTo(cmpn, 0) ThenBlock: {
                    found_n = Array.Get(Gen.all_nest_to, ni)
                    ReturnValue(found_n)
                }
                ni = Subtract(ni, 1)
            }
        }
        ReturnValue(name)
    }
}

Function.Gen_LookupParams {
    Input: name: Address
    Output: Address
    Body: {
        resolved = Gen_ResolveNestFunc(name)
        IfCondition Or(EqualTo(resolved, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.func_params, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, resolved)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                IfCondition LessThan(i, Array.Size(Gen.func_params)) ThenBlock: {
                    found_p = Array.Get(Gen.func_params, i)
                    ReturnValue(found_p)
                }
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_LookupVarargs {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                IfCondition EqualTo(Gen.func_varargs, 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(Array.Get(Gen.func_varargs, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsPackedFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.packed_funcs)
        
        idx = 0
        WhileLoop LessThan(idx, sz) {
            fname = Array.Get(Gen.packed_funcs, idx)
            cmp = StringCompare(name, fname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

// Known user Function names (for AddressOf when used as values)
Function.Gen_IsKnownFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsMethodPyName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.method_py_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.method_py_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.method_py_names, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsModuleFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.module_funcs, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.module_funcs)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.module_funcs, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {

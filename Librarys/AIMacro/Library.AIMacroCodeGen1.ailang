            ReturnValue(0)
        }
        cmp = StringCompare(name, "IPPROTO_UDP")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(17)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "FutureWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "DeprecationWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "Warning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "UserWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "PendingDeprecationWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ImportWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "EncodingWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "ResourceWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "BytesWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "SyntaxWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "UnicodeWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "RuntimeWarning")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(5)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "complex")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(AIMacro.Float)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "slice")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(AIMacro.Slice)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "match")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "case")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "staticmethod")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(AIMacro.StaticMethod)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "classmethod")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(AIMacro.ClassMethod)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "property")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_Emit("AddressOf(AIMacro.Property)")
            ReturnValue(0)
        }
        cmp = StringCompare(name, "NEXT")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(0)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "PREV")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(1)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "KEY")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(2)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "RESULT")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_EmitNumber(3)
            ReturnValue(0)
        }
        // Nested-def hoist: use AddressOf(__nest_N_name) across functions
        IfCondition NotEqual(Gen.nest_bind_names, 0) ThenBlock: {
            nsz = Array.Size(Gen.nest_bind_names)
            ni = 0
            WhileLoop LessThan(ni, nsz) {
                bn = Array.Get(Gen.nest_bind_names, ni)
                cmpn = StringCompare(name, bn)
                IfCondition EqualTo(cmpn, 0) ThenBlock: {
                    Gen_Emit("AddressOf(")
                    Gen_Emit(Array.Get(Gen.nest_bind_funcs, ni))
                    Gen_Emit(")")
                    ReturnValue(0)
                }
                ni = Add(ni, 1)
            }
        }
        // AILang keywords used as Python values (ast.Tuple / ast.Add) — PyMod escape
        cmp = StringCompare(name, "Tuple")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        cmp = StringCompare(name, "Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Gen_MarkModuleVar(name)
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        // File-scope names live in FixedPool.PyMod so Functions can see them
        is_mod = Gen_IsModuleVar(name)
        IfCondition EqualTo(is_mod, 1) ThenBlock: {
            Gen_Emit("PyMod.")
            Gen_Emit(name)
            ReturnValue(0)
        }
        Gen_Emit(name)
    }
}

// =============================================================================
// OUTPUT HELPERS
// =============================================================================
Function.Gen_Emit {
    Input: str: Address
    Body: {
        len = StringLength(str)
        size = Add(len, 1)
        copy = Allocate(size)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.output, copy)
    }
}

Function.Gen_EmitIndent {
    Body: {
        i = 0
        WhileLoop LessThan(i, Gen.indent) {
            Gen_Emit("    ")
            i = Add(i, 1)
        }
    }
}

Function.Gen_EmitLine {
    Input: str: Address
    Body: {
        Gen_EmitIndent()
        Gen_Emit(str)
        Gen_Emit("\n")
    }
}

Function.Gen_EmitNumber {
    Input: num: Integer
    Body: {
        str = NumberToString(num)
        Gen_Emit(str)
        
    }
}

// =============================================================================
// GET OPERATOR NAME
// =============================================================================

Function.Gen_OpName {
    Input: op: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(op, Token.PLUS) ThenBlock: { ReturnValue("AIMacro.NumAdd") }
        IfCondition EqualTo(op, Token.MINUS) ThenBlock: { ReturnValue("AIMacro.NumSub") }
        IfCondition EqualTo(op, Token.STAR) ThenBlock: { ReturnValue("AIMacro.NumMul") }
        IfCondition EqualTo(op, Token.AT) ThenBlock: { ReturnValue("AIMacro.NumMatMul") }
        IfCondition EqualTo(op, Token.SLASH) ThenBlock: { ReturnValue("AIMacro.TrueDiv") }
        IfCondition EqualTo(op, Token.PERCENT) ThenBlock: { ReturnValue("AIMacro.NumMod") }
        IfCondition EqualTo(op, Token.POWER) ThenBlock: { ReturnValue("AIMacro.NumPow") }
        IfCondition EqualTo(op, Token.FLOOR_DIV) ThenBlock: { ReturnValue("AIMacro.FloorDiv") }
        IfCondition EqualTo(op, Token.EQ) ThenBlock: { ReturnValue("AIMacro.NumEq") }
        IfCondition EqualTo(op, Token.NE) ThenBlock: { ReturnValue("AIMacro.NumNe") }
        IfCondition EqualTo(op, Token.LT) ThenBlock: { ReturnValue("AIMacro.NumLt") }
        IfCondition EqualTo(op, Token.LE) ThenBlock: { ReturnValue("AIMacro.NumLe") }
        IfCondition EqualTo(op, Token.GT) ThenBlock: { ReturnValue("AIMacro.NumGt") }
        IfCondition EqualTo(op, Token.GE) ThenBlock: { ReturnValue("AIMacro.NumGe") }
        IfCondition EqualTo(op, Token.AND) ThenBlock: { ReturnValue("AIMacro.AndVal") }
        IfCondition EqualTo(op, Token.OR) ThenBlock: { ReturnValue("AIMacro.OrVal") }
        IfCondition EqualTo(op, Token.BIT_OR) ThenBlock: { ReturnValue("AIMacro.NumBitOr") }
        IfCondition EqualTo(op, Token.BIT_XOR) ThenBlock: { ReturnValue("AIMacro.NumBitXor") }
        IfCondition EqualTo(op, Token.BIT_AND) ThenBlock: { ReturnValue("AIMacro.NumBitAnd") }
        IfCondition EqualTo(op, Token.LSHIFT) ThenBlock: { ReturnValue("AIMacro.NumBitShl") }
        IfCondition EqualTo(op, Token.RSHIFT) ThenBlock: { ReturnValue("AIMacro.NumBitShr") }
        IfCondition EqualTo(op, Token.BIT_NOT) ThenBlock: { ReturnValue("AIMacro.NumBitNot") }
        IfCondition EqualTo(op, Token.NOT) ThenBlock: { ReturnValue("AIMacro.NotVal") }
        IfCondition EqualTo(op, Token.IS) ThenBlock: { ReturnValue("AIMacro.Is") }
        ReturnValue("Unknown")
    }
}

// =============================================================================
// CHECK IF EXPRESSION CONTAINS A FUNCTION CALL
// INDEX_ACCESS counts because it generates Array.Get() which is a call
// =============================================================================
Function.Gen_HasCall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        t = AST_Type(node)
        
        IfCondition EqualTo(t, Node.CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LIST_COMP) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.CHAIN_COMPARE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.FLOAT_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.BOOL_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LIST_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.DICT_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.STR_EQ) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.STR_NE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LAMBDA) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.INDIRECT_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.TERNARY) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.NAMED_EXPR) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 4)))
        }
        IfCondition EqualTo(t, Node.STARRED) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 3)))
        }
        IfCondition EqualTo(t, Node.KW_ARG) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 4)))
        }
        IfCondition EqualTo(t, Node.METHOD_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, 11) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, 104) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.ATTRIBUTE) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 3)))
        }
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.SLICE_ACCESS) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition EqualTo(t, Node.BINARY_OP) ThenBlock: {
            op = ArrayGet(node, 4)
            
            // EQ and NE now emit SmartEqual/SmartNotEqual function calls
            // They MUST be extracted to temp vars before use in IfCondition
            IfCondition EqualTo(op, Token.EQ) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.NE) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.AND) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.OR) ThenBlock: {
                ReturnValue(1)
            }
            
            // For other operators, check children recursively
            left = ArrayGet(node, 3)
            right = ArrayGet(node, 5)
            left_has = Gen_HasCall(left)
            IfCondition EqualTo(left_has, 1) ThenBlock: {
                ReturnValue(1)
            }
            right_has = Gen_HasCall(right)
            ReturnValue(right_has)
        }
        
        IfCondition EqualTo(t, Node.UNARY_OP) ThenBlock: {
            operand = ArrayGet(node, 4)
            ReturnValue(Gen_HasCall(operand))
        }
        
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            expr = ArrayGet(node, 3)
            index = ArrayGet(node, 4)
            expr_has = Gen_HasCall(expr)
            IfCondition EqualTo(expr_has, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(Gen_HasCall(index))
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// CREATE IDENTIFIER NODE
// =============================================================================
Function.Gen_MakeIdent {
    Input: name: Address
    Output: Address
    Body: {
        node = ArrayCreate(4)
        ArraySet(node, 0, Node.IDENT)
        ArraySet(node, 1, 0)
        ArraySet(node, 2, 0)
        ArraySet(node, 3, name)
        ReturnValue(node)
    }
}

// =============================================================================
// EMIT ESCAPED STRING
// =============================================================================
Function.Gen_EmitEscaped {
    Input: str: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(str)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            
            IfCondition EqualTo(c, 10) ThenBlock: {
                Gen_Emit("\\n")
            } ElseBlock: {
                IfCondition EqualTo(c, 13) ThenBlock: {
                    Gen_Emit("\\r")
                } ElseBlock: {
                    IfCondition EqualTo(c, 9) ThenBlock: {
                        Gen_Emit("\\t")
                    } ElseBlock: {
                        IfCondition EqualTo(c, 34) ThenBlock: {
                            Gen_Emit("\\\"")
                        } ElseBlock: {
                            IfCondition EqualTo(c, 92) ThenBlock: {
                                Gen_Emit("\\\\")
                            } ElseBlock: {
                                buf = Allocate(2)
                                SetByte(buf, 0, c)
                                SetByte(buf, 1, 0)
                                Gen_Emit(buf)
                                Deallocate(buf, 2)
                            }
                        }
                    }
                }
            }
            
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// CHECK IF ARGUMENT LIST HAS CALLS
// =============================================================================
Function.Gen_ArgsHaveCalls {
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        n = Array.Size(args)
        i = 0
        WhileLoop LessThan(i, n) {
            arg = Array.Get(args, i)
            has = Gen_HasCall(arg)
            IfCondition EqualTo(has, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// GET OUTPUT AS STRING
// =============================================================================
Function.Gen_GetOutput {
    Output: Address
    Body: {
        total = 0
        n = Array.Size(Gen.output)
        i = 0
        WhileLoop LessThan(i, n) {
            s = Array.Get(Gen.output, i)
            IfCondition NotEqual(s, 0) ThenBlock: {
                total = Add(total, StringLength(s))
            }
            i = Add(i, 1)
        }
        
        result = Allocate(Add(total, 1))
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, n) {
            s = Array.Get(Gen.output, i)
            IfCondition NotEqual(s, 0) ThenBlock: {
                len = StringLength(s)
                j = 0
                WhileLoop LessThan(j, len) {
                    c = GetByte(s, j)
                    SetByte(result, pos, c)
                    pos = Add(pos, 1)
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        
        SetByte(result, pos, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// STDLIB SHIMS — import skip + method/attr recognition
// =============================================================================
Function.Gen_IsShimModule {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "getopt")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "binascii")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "io")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gen_IsOsPath {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(obj), Node.ATTRIBUTE) ThenBlock: {
            ReturnValue(0)
        }
        inner = ArrayGet(obj, 3)
        attr = ArrayGet(obj, 4)
        IfCondition NotEqual(AST_Type(inner), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        iname = ArrayGet(inner, 3)
        cmp = StringCompare(iname, "os")
        IfCondition NotEqual(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(attr, "path")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsPathMethod {
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(method, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(method, "join")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "exists")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "basename")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "dirname")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gen_IsStdlibMethod {
    Input: obj: Address
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(obj, 0), EqualTo(method, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_IsOsPath(obj), 1) ThenBlock: {
            ReturnValue(Gen_IsPathMethod(method))
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            IfCondition EqualTo(Gen_IsPathMethod(method), 1) ThenBlock: {
                ReturnValue(1)
            }
            cmp = StringCompare(method, "listdir")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "loads")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "dumps")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "sqrt")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "sin")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "cos")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "time")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "sleep")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "exit")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsStdlibAttr {
    Input: obj: Address
    Input: attr: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(obj, 0), EqualTo(attr, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "argv")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stdin")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stdout")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Gen_MapExcKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "Exception")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ValueError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "OSError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "IOError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "FileNotFoundError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(4) }
        cmp = StringCompare(name, "TypeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(5) }
        cmp = StringCompare(name, "RuntimeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(6) }
        cmp = StringCompare(name, "ZeroDivisionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(7) }
        cmp = StringCompare(name, "AssertionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(8) }
        cmp = StringCompare(name, "StopIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(9) }
        cmp = StringCompare(name, "StopAsyncIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(10) }
        cmp = StringCompare(name, "BaseExceptionGroup")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(11) }
        cmp = StringCompare(name, "ExceptionGroup")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(12) }
        cmp = StringCompare(name, "BaseException")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(13) }
        cmp = StringCompare(name, "AttributeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(14) }
        cmp = StringCompare(name, "KeyError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(15) }
        cmp = StringCompare(name, "NameError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(16) }
        cmp = StringCompare(name, "IndexError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(17) }
        cmp = StringCompare(name, "LookupError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(18) }
        cmp = StringCompare(name, "EOFError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(19) }
        cmp = StringCompare(name, "ImportError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(20) }
        cmp = StringCompare(name, "ModuleNotFoundError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(20) }
        cmp = StringCompare(name, "NotImplementedError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(21) }
        cmp = StringCompare(name, "UnboundLocalError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(16) }
        cmp = StringCompare(name, "OverflowError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(22) }
        cmp = StringCompare(name, "MemoryError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(23) }
        cmp = StringCompare(name, "RecursionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(6) }
        cmp = StringCompare(name, "ArithmeticError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(22) }
        cmp = StringCompare(name, "SyntaxError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(24) }
        cmp = StringCompare(name, "IndentationError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(24) }
        cmp = StringCompare(name, "TabError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(24) }
        cmp = StringCompare(name, "SystemExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(25) }
        cmp = StringCompare(name, "KeyboardInterrupt")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(26) }
        cmp = StringCompare(name, "GeneratorExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(27) }
        cmp = StringCompare(name, "PermissionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "FileExistsError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "TimeoutError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "ConnectionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "BrokenPipeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "BlockingIOError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        ReturnValue(1)
    }
}

Function.Gen_EmitStdlibAttr {
    Input: obj: Address
    Input: attr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Gen_IsStdlibAttr(obj, attr), 0) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "argv")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Argv()")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stdin")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(0, 0)")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stdout")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(1, 1)")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Pi()")
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// NESTED DEF FREEVARS (method/outer params closed over by __nest_*)
// AILang has no closures — hoist adds outer names as bare Inputs.
// =============================================================================
Function.Gen_NameInArray {
    Input: name: Address
    Input: arr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(arr)
        i = 0
        WhileLoop LessThan(i, n) {
            cmp = StringCompare(name, Array.Get(arr, i))
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_CollectIdentsFromNode {
    Input: node: Address
    Input: out: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        is_arr = Array.IsArray(node)
        IfCondition EqualTo(is_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(node)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        t = Array.Get(node, 0)
        // IDENT use
        IfCondition EqualTo(t, Node.IDENT) ThenBlock: {
            IfCondition GreaterThan(n, 3) ThenBlock: {
                iname = Array.Get(node, 3)
                IfCondition EqualTo(Gen_NameInArray(iname, out), 0) ThenBlock: {
                    Array.Push(out, iname)
                }
            }
            ReturnValue(0)
        }
        // Recurse slots; treat list-of-nodes vs single child node
        i = 1
        WhileLoop LessThan(i, n) {
            child = Array.Get(node, i)
            IfCondition EqualTo(Array.IsArray(child), 1) ThenBlock: {
                cn = Array.Size(child)
                IfCondition GreaterThan(cn, 0) ThenBlock: {
                    c0 = Array.Get(child, 0)
                    IfCondition EqualTo(Array.IsArray(c0), 1) ThenBlock: {
                        ci = 0
                        WhileLoop LessThan(ci, cn) {
                            Gen_CollectIdentsFromNode(Array.Get(child, ci), out)
                            ci = Add(ci, 1)
                        }
                    } ElseBlock: {
                        Gen_CollectIdentsFromNode(child, out)
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.Gen_SnapshotFreevars {
    Input: nest_params: Address
    Input: nest_body: Address
    Output: Address
    Body: {
        fv = Array.Create(8)
        IfCondition EqualTo(Gen.enclosing_params, 0) ThenBlock: {
            ReturnValue(fv)
        }
        refs = Array.Create(32)
        IfCondition NotEqual(nest_body, 0) ThenBlock: {
            bn = Array.Size(nest_body)
            bi = 0
            WhileLoop LessThan(bi, bn) {
                Gen_CollectIdentsFromNode(Array.Get(nest_body, bi), refs)
                bi = Add(bi, 1)
            }
        }
        n = Array.Size(Gen.enclosing_params)
        i = 0
        WhileLoop LessThan(i, n) {
            name = Array.Get(Gen.enclosing_params, i)
            skip = Gen_NameInArray(name, nest_params)
            IfCondition EqualTo(skip, 0) ThenBlock: {
                used = Gen_NameInArray(name, refs)
                IfCondition EqualTo(used, 1) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
            }
            i = Add(i, 1)
        }
        Array.Destroy(refs)
        ReturnValue(fv)
    }
}

Function.Gen_PushDeferredFunction {
    Input: node: Address
    Body: {
        nest_params = ArrayGet(node, 4)
        fv = Gen_SnapshotFreevarsAll(nest_params)
        Array.Push(Gen.deferred_functions, node)
        Array.Push(Gen.deferred_freevars, fv)
    }
}

Function.Gen_SnapshotFreevarsAll {
    Input: nest_params: Address
    Output: Address
    Body: {
        fv = Array.Create(8)
        // Outer function params (e.g. maxsize) — Gen.param_names at defer time
        IfCondition NotEqual(Gen.param_names, 0) ThenBlock: {
            n = Array.Size(Gen.param_names)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.param_names, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
                i = Add(i, 1)
            }
        }
        // Freevars of the function currently being generated (outer closed-overs)
        IfCondition NotEqual(Gen.pending_freevars, 0) ThenBlock: {
            n = Array.Size(Gen.pending_freevars)
            i = 0
            WhileLoop LessThan(i, n) {
                name = Array.Get(Gen.pending_freevars, i)
                skip = Gen_NameInArray(name, nest_params)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    dup = Gen_NameInArray(name, fv)
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        Array.Push(fv, name)
                    }
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(Gen.enclosing_params, 0) ThenBlock: {
            ReturnValue(fv)
        }
        n = Array.Size(Gen.enclosing_params)
        i = 0
        WhileLoop LessThan(i, n) {
            name = Array.Get(Gen.enclosing_params, i)
            skip = Gen_NameInArray(name, nest_params)
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dup = Gen_NameInArray(name, fv)
                IfCondition EqualTo(dup, 0) ThenBlock: {
                    Array.Push(fv, name)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(fv)
    }
}

Function.Gen_EmitFreevarLocals {
    Body: {
        IfCondition EqualTo(Gen.pending_freevars, 0) ThenBlock: {
            ReturnValue(0)
        }
        fv = Gen.pending_freevars
        nfv = Array.Size(fv)
        fi = 0
        WhileLoop LessThan(fi, nfv) {
            fname = Array.Get(fv, fi)
            already = Gen_IsParam(fname)
            IfCondition EqualTo(already, 0) ThenBlock: {
                // Declare as local so nested body can see method/outer names
                // (AILang has no closures; AddressOf cannot bind freevars)
                Gen_EmitIndent()
                Gen_Emit(fname)
                Gen_Emit(" = Types.GetNone()\n")
            }
            fi = Add(fi, 1)
        }
    }
}

Function.Gen_PushEnclosingParams {
    Input: params: Address
    Output: Integer
    Body: {
        saved = Array.Size(Gen.enclosing_params)
        IfCondition EqualTo(params, 0) ThenBlock: {
            ReturnValue(saved)
        }
        n = Array.Size(params)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(Gen.enclosing_params, Array.Get(params, i))
            i = Add(i, 1)
        }
        ReturnValue(saved)
    }
}

Function.Gen_TruncateEnclosing {
    Input: saved: Integer
    Body: {
        esz = Array.Size(Gen.enclosing_params)
        WhileLoop GreaterThan(esz, saved) {
            Array.Pop(Gen.enclosing_params)
            esz = Array.Size(Gen.enclosing_params)
        }
    }
}


Function.Gen_MarkEnclosingLocal {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.enclosing_params, 0) ThenBlock: {
            ReturnValue(0)
        }
        esz = Array.Size(Gen.enclosing_params)
        IfCondition EqualTo(esz, 0) ThenBlock: {
            ReturnValue(0)
        }
        dup = Gen_NameInArray(name, Gen.enclosing_params)
        IfCondition EqualTo(dup, 0) ThenBlock: {
            Array.Push(Gen.enclosing_params, name)
        }
    }
}

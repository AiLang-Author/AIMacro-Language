}

// =============================================================================
// TEMP NAME GENERATION - Clean names, reset per function
// =============================================================================
Function.Gen_IsStringVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.string_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.string_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkStringVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        already = Gen_IsStringVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        // Copy the name and add to list
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.string_vars, copy)
    }
}

// =============================================================================
// LIST VARIABLE TRACKING
// =============================================================================
Function.Gen_IsListVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.list_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.list_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkListVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check if already tracked
        already = Gen_IsListVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        // Copy the name and add to list
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.list_vars, copy)
    }
}

// =============================================================================
// MODULE (FILE-SCOPE) VARIABLE TRACKING → FixedPool.PyMod
// =============================================================================
Function.Gen_IsModuleVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.module_vars, 0) ThenBlock: {
            ReturnValue(0)
        }
        sz = Array.Size(Gen.module_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.module_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkModuleVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        already = Gen_IsModuleVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.module_vars, copy)
    }
}

Function.Gen_MarkGlobalStmtNames {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        names = ArrayGet(node, 3)
        IfCondition EqualTo(names, 0) ThenBlock: {
            ReturnValue(0)
        }
        is_list = Array.IsArray(names)
        IfCondition EqualTo(is_list, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            nm = Array.Get(names, i)
            tt = AST_Type(nm)
            IfCondition EqualTo(tt, Node.IDENT) ThenBlock: {
                nm = ArrayGet(nm, 3)
            }
            Gen_MarkModuleVar(nm)
            i = Add(i, 1)
        }
    }
}

Function.Gen_MarkNonlocalStmtNames {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.nonlocal_vars, 0) ThenBlock: {
            Gen.nonlocal_vars = Array.Create(32)
        }
        names = ArrayGet(node, 3)
        IfCondition EqualTo(names, 0) ThenBlock: {
            ReturnValue(0)
        }
        is_list = Array.IsArray(names)
        IfCondition EqualTo(is_list, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            nm = Array.Get(names, i)
            tt = AST_Type(nm)
            IfCondition EqualTo(tt, Node.IDENT) ThenBlock: {
                nm = ArrayGet(nm, 3)
            }
            Gen_MarkModuleVar(nm)
            already = Gen_NameInArray(nm, Gen.nonlocal_vars)
            IfCondition EqualTo(already, 0) ThenBlock: {
                Array.Push(Gen.nonlocal_vars, nm)
            }
            i = Add(i, 1)
        }
    }
}

Function.Gen_EmitNonlocalParamCells {
    Input: names: Address
    Input: use_p: Integer
    Body: {
        IfCondition Or(EqualTo(names, 0), EqualTo(Gen.nonlocal_vars, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            name = Array.Get(names, i)
            is_nl = Gen_NameInArray(name, Gen.nonlocal_vars)
            IfCondition EqualTo(is_nl, 1) ThenBlock: {
                Gen_EmitIndent()
                Gen_Emit("PyMod.")
                Gen_Emit(name)
                Gen_Emit(" = ")
                IfCondition EqualTo(use_p, 1) ThenBlock: {
                    Gen_Emit("p_")
                }
                Gen_Emit(name)
                Gen_Emit("\n")
            }
            i = Add(i, 1)
        }
    }
}

// Nested Function freevar reads with no `nonlocal` keyword
// (`return value` in __nest_N_inner). Intersection of enclosing
// assigns/params with nested IDENT uses → PyMod cells. Only nested
// FUNCTION (nested==1) so method-level golds stay intern-stable.
Function.Gen_CellNameSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "self")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "cls")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Gen_NameStartsWith(name, "_aim_"), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(Gen_UnboundSkip(name, 0))
    }
}

Function.Gen_MarkFreevarCell {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        skip = Gen_CellNameSkip(name)
        IfCondition EqualTo(skip, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.nonlocal_vars, 0) ThenBlock: {
            Gen.nonlocal_vars = Array.Create(32)
        }
        Gen_MarkModuleVar(name)
        already = Gen_NameInArray(name, Gen.nonlocal_vars)
        IfCondition EqualTo(already, 0) ThenBlock: {
            Array.Push(Gen.nonlocal_vars, name)
        }
    }
}

Function.Gen_CollectDirectAssigns {
    Input: node: Address
    Input: out: Address
    Body: {
        IfCondition Or(EqualTo(node, 0), EqualTo(out, 0)) ThenBlock: {
            ReturnValue(0)
        }
        is_list = Array.IsArray(node)
        IfCondition EqualTo(is_list, 1) ThenBlock: {
            n = Array.Size(node)
            i = 0
            WhileLoop LessThan(i, n) {
                child = Array.Get(node, i)
                Gen_CollectDirectAssigns(child, out)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        t = AST_Type(node)
        IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CLASS_DEF) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.METHOD_DEF) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.LAMBDA) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.ASSIGNMENT) ThenBlock: {
            tgt = ArrayGet(node, 3)
            tt = AST_Type(tgt)
            IfCondition EqualTo(tt, Node.IDENT) ThenBlock: {
                tgt = ArrayGet(tgt, 3)
            }
            Gen_NoteAssignName(tgt, out)
            Gen_CollectDirectAssigns(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.NAMED_EXPR) ThenBlock: {
            tgt = ArrayGet(node, 3)
            tt = AST_Type(tgt)
            IfCondition EqualTo(tt, Node.IDENT) ThenBlock: {
                tgt = ArrayGet(tgt, 3)
            }
            Gen_NoteAssignName(tgt, out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.AUG_ASSIGN) ThenBlock: {
            Gen_NoteAssignName(ArrayGet(node, 3), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.FOR_STMT) ThenBlock: {
            loop_var = ArrayGet(node, 3)
            IfCondition EqualTo(AST_Type(loop_var), Node.IDENT) ThenBlock: {
                loop_var = ArrayGet(loop_var, 3)
            }
            Gen_NoteAssignName(loop_var, out)
            Gen_CollectDirectAssigns(ArrayGet(node, 5), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 6), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TUPLE_UNPACK) ThenBlock: {
            tgs = ArrayGet(node, 3)
            is_tgs = Array.IsArray(tgs)
            IfCondition EqualTo(is_tgs, 1) ThenBlock: {
                ti = 0
                tn = Array.Size(tgs)
                WhileLoop LessThan(ti, tn) {
                    tg = Array.Get(tgs, ti)
                    tg_t = AST_Type(tg)
                    IfCondition EqualTo(tg_t, Node.IDENT) ThenBlock: {
                        Gen_NoteAssignName(ArrayGet(tg, 3), out)
                    } ElseBlock: {
                        IfCondition NotEqual(tg_t, Node.ATTRIBUTE) ThenBlock: {
                            IfCondition NotEqual(tg_t, Node.INDEX_ACCESS) ThenBlock: {
                                Gen_NoteAssignName(tg, out)
                            }
                        }
                    }
                    ti = Add(ti, 1)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WITH_STMT) ThenBlock: {
            as_name = ArrayGet(node, 4)
            as_list = Array.IsArray(as_name)
            IfCondition EqualTo(as_list, 1) ThenBlock: {
                ai = 0
                an = Array.Size(as_name)
                WhileLoop LessThan(ai, an) {
                    Gen_NoteAssignName(Array.Get(as_name, ai), out)
                    ai = Add(ai, 1)
                }
            } ElseBlock: {
                Gen_NoteAssignName(as_name, out)
            }
            Gen_CollectDirectAssigns(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXCEPT_CLAUSE) ThenBlock: {
            Gen_NoteAssignName(ArrayGet(node, 5), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.IF_STMT) ThenBlock: {
            Gen_CollectDirectAssigns(ArrayGet(node, 4), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WHILE_STMT) ThenBlock: {
            Gen_CollectDirectAssigns(ArrayGet(node, 4), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TRY_STMT) ThenBlock: {
            Gen_CollectDirectAssigns(ArrayGet(node, 3), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 4), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 5), out)
            Gen_CollectDirectAssigns(ArrayGet(node, 6), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXPR_STMT) ThenBlock: {
            Gen_CollectDirectAssigns(ArrayGet(node, 3), out)
            ReturnValue(0)
        }
    }
}

Function.Gen_HarvestNestedFreeUses {
    Input: node: Address
    Input: out: Address
    Body: {
        IfCondition Or(EqualTo(node, 0), EqualTo(out, 0)) ThenBlock: {
            ReturnValue(0)
        }
        is_list = Array.IsArray(node)
        IfCondition EqualTo(is_list, 1) ThenBlock: {
            n = Array.Size(node)
            i = 0
            WhileLoop LessThan(i, n) {
                child = Array.Get(node, i)
                Gen_HarvestNestedFreeUses(child, out)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        t = AST_Type(node)
        IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
            fbody = ArrayGet(node, 5)
            fparams = ArrayGet(node, 4)
            assigned = Array.Create(32)
            Gen_CollectDirectAssigns(fbody, assigned)
            IfCondition NotEqual(fparams, 0) ThenBlock: {
                is_parr = Array.IsArray(fparams)
                IfCondition EqualTo(is_parr, 1) ThenBlock: {
                    pi = 0
                    pn = Array.Size(fparams)
                    WhileLoop LessThan(pi, pn) {
                        pname = Array.Get(fparams, pi)
                        pt = AST_Type(pname)
                        IfCondition EqualTo(pt, Node.IDENT) ThenBlock: {
                            pname = ArrayGet(pname, 3)
                        }
                        Gen_NoteAssignName(pname, assigned)
                        pi = Add(pi, 1)
                    }
                }
            }
            uses = Array.Create(16)
            Gen_WalkUnbound(fbody, assigned, uses, 0)
            ui = 0
            un = Array.Size(uses)
            WhileLoop LessThan(ui, un) {
                uname = Array.Get(uses, ui)
                seen = Gen_NameInArray(uname, out)
                IfCondition EqualTo(seen, 0) ThenBlock: {
                    Array.Push(out, uname)
                }
                ui = Add(ui, 1)
            }
            Array.Destroy(uses)
            Array.Destroy(assigned)
            Gen_HarvestNestedFreeUses(fbody, out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CLASS_DEF) ThenBlock: {
            cbody = AST_GetField(node, "body")
            Gen_HarvestNestedFreeUses(cbody, out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.METHOD_DEF) ThenBlock: {
            mbody = AST_GetField(node, "body")
            Gen_HarvestNestedFreeUses(mbody, out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.IF_STMT) ThenBlock: {
            Gen_HarvestNestedFreeUses(ArrayGet(node, 4), out)
            Gen_HarvestNestedFreeUses(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WHILE_STMT) ThenBlock: {
            Gen_HarvestNestedFreeUses(ArrayGet(node, 4), out)
            Gen_HarvestNestedFreeUses(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.FOR_STMT) ThenBlock: {
            Gen_HarvestNestedFreeUses(ArrayGet(node, 5), out)
            Gen_HarvestNestedFreeUses(ArrayGet(node, 6), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TRY_STMT) ThenBlock: {
            Gen_HarvestNestedFreeUses(ArrayGet(node, 3), out)
            Gen_HarvestNestedFreeUses(ArrayGet(node, 4), out)
            Gen_HarvestNestedFreeUses(ArrayGet(node, 5), out)
            Gen_HarvestNestedFreeUses(ArrayGet(node, 6), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXCEPT_CLAUSE) ThenBlock: {
            Gen_HarvestNestedFreeUses(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WITH_STMT) ThenBlock: {
            Gen_HarvestNestedFreeUses(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
    }
}

// CALL name-string callees in this body (orig_kill()), not nested defs.
// WalkUnbound skips callees so encoded_words does not GetNone print.
Function.Gen_HarvestCallCallees {
    Input: node: Address
    Input: out: Address
    Body: {
        IfCondition Or(EqualTo(node, 0), EqualTo(out, 0)) ThenBlock: {
            ReturnValue(0)
        }
        is_list = Array.IsArray(node)
        IfCondition EqualTo(is_list, 1) ThenBlock: {
            n = Array.Size(node)
            i = 0
            WhileLoop LessThan(i, n) {
                Gen_HarvestCallCallees(Array.Get(node, i), out)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        t = AST_Type(node)
        IfCondition EqualTo(t, Node.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CLASS_DEF) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.METHOD_DEF) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.LAMBDA) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.CALL) ThenBlock: {
            callee = ArrayGet(node, 3)
            IfCondition EqualTo(Array.IsArray(callee), 0) ThenBlock: {
                IfCondition NotEqual(callee, 0) ThenBlock: {
                    IfCondition EqualTo(Gen_NameInArray(callee, out), 0) ThenBlock: {
                        Array.Push(out, callee)
                    }
                }
            } ElseBlock: {
                Gen_HarvestCallCallees(callee, out)
            }
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.INDIRECT_CALL) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXPR_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.ASSIGNMENT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.RETURN_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.IF_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WHILE_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.FOR_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            Gen_HarvestCallCallees(ArrayGet(node, 6), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.TRY_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            Gen_HarvestCallCallees(ArrayGet(node, 6), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.EXCEPT_CLAUSE) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 4), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, Node.WITH_STMT) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, 11) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, 104) ThenBlock: {
            Gen_HarvestCallCallees(ArrayGet(node, 3), out)
            Gen_HarvestCallCallees(ArrayGet(node, 5), out)
            ReturnValue(0)
        }
    }
}

Function.Gen_PrescanFreevarCells {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        body = ArrayGet(node, 5)
        params = ArrayGet(node, 4)
        enc = Array.Create(32)
        Gen_CollectDirectAssigns(body, enc)
        IfCondition NotEqual(params, 0) ThenBlock: {
            is_parr = Array.IsArray(params)
            IfCondition EqualTo(is_parr, 1) ThenBlock: {
                pi = 0
                pn = Array.Size(params)
                WhileLoop LessThan(pi, pn) {
                    pname = Array.Get(params, pi)
                    pt = AST_Type(pname)
                    IfCondition EqualTo(pt, Node.IDENT) ThenBlock: {
                        pname = ArrayGet(pname, 3)
                    }
                    Gen_NoteAssignName(pname, enc)
                    pi = Add(pi, 1)
                }
            }
        }
        uses = Array.Create(16)
        Gen_HarvestNestedFreeUses(body, uses)
        ui = 0
        un = Array.Size(uses)
        WhileLoop LessThan(ui, un) {
            uname = Array.Get(uses, ui)
            in_enc = Gen_NameInArray(uname, enc)
            IfCondition EqualTo(in_enc, 1) ThenBlock: {
                Gen_MarkFreevarCell(uname)
            }
            ui = Add(ui, 1)
        }
        Array.Destroy(uses)
        Array.Destroy(enc)
    }
}

Function.Gen_IsImportStub {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.import_stubs, 0) ThenBlock: {
            ReturnValue(0)
        }
        sz = Array.Size(Gen.import_stubs)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.import_stubs, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkImportStub {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        already = Gen_IsImportStub(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.import_stubs, copy)
    }
}

Function.Gen_IsDictVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.dict_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.dict_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsCallableVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.callable_vars, 0)) ThenBlock: {
            ReturnValue(0)
        }
        sz = Array.Size(Gen.callable_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.callable_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkCallableVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        already = Gen_IsCallableVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(copy, i, GetByte(name, i))
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.callable_vars, copy)
    }
}


// Bound list.append: name → self (so h_append(x) → AIMacro.SmartPush(h, x))
Function.Gen_GetBoundAppendSelf {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.bound_append_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        sz = Array.Size(Gen.bound_append_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.bound_append_names, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Array.Get(Gen.bound_append_selves, idx))
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkBoundAppend {
    Input: name: Address
    Input: self_name: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(self_name, 0)) ThenBlock: {
            ReturnValue(0)
        }
        // Replace if already present
        sz = Array.Size(Gen.bound_append_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.bound_append_names, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                len = StringLength(self_name)
                copy = Allocate(Add(len, 1))
                i = 0
                WhileLoop LessThan(i, len) {
                    SetByte(copy, i, GetByte(self_name, i))
                    i = Add(i, 1)
                }
                SetByte(copy, len, 0)
                Array.Set(Gen.bound_append_selves, idx, copy)
                ReturnValue(0)
            }
            idx = Add(idx, 1)
        }
        len = StringLength(name)
        ncopy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(ncopy, i, GetByte(name, i))
            i = Add(i, 1)
        }
        SetByte(ncopy, len, 0)
        len2 = StringLength(self_name)
        scopy = Allocate(Add(len2, 1))
        i = 0
        WhileLoop LessThan(i, len2) {
            SetByte(scopy, i, GetByte(self_name, i))
            i = Add(i, 1)
        }
        SetByte(scopy, len2, 0)
        Array.Push(Gen.bound_append_names, ncopy)
        Array.Push(Gen.bound_append_selves, scopy)
    }
}

Function.Gen_MarkDictVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        already = Gen_IsDictVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.dict_vars, copy)
    }
}


Function.Gen_LoopEnter {
    Output: Address
    Body: {
        Gen.loop_depth = Add(Gen.loop_depth, 1)
        ReturnValue(NumberToString(Gen.loop_depth))
    }
}

Function.Gen_LoopLeave {
    Body: {
        IfCondition GreaterThan(Gen.loop_depth, 0) ThenBlock: {
            Gen.loop_depth = Subtract(Gen.loop_depth, 1)
        }
    }
}

Function.Gen_EmitWithExits {
    Body: {
        IfCondition EqualTo(Gen.with_stack, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.with_stack)
        WhileLoop GreaterThan(n, 0) {
            n = Subtract(n, 1)
            ctx = Array.Get(Gen.with_stack, n)
            Gen_EmitIndent()
            Gen_Emit("AIMacro.WithExit(")
            Gen_Emit(ctx)
            Gen_Emit(")\n")
        }
    }
}

Function.Gen_TempName {
    Output: Address
    Body: {
        num_str = NumberToString(Gen.temp_counter)
        Gen.temp_counter = Add(Gen.temp_counter, 1)
        ReturnValue(StringConcat("_aim_t", num_str))
    }
}

// =============================================================================
// PARAMETER NAME HELPERS
// =============================================================================
Function.Gen_IsParam {
    Input: name: Address
    Output: Integer
    Body: {
        sz = Array.Size(Gen.param_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            pname = Array.Get(Gen.param_names, idx)
            cmp = StringCompare(name, pname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsEnclosingParam {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Gen.enclosing_params, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Gen_NameInArray(name, Gen.enclosing_params))
    }
}


// AILANG lexer keywords that are legal Python identifiers. Bare
// `Text =` / `Integer =` is a PARSE ERROR; PyMod.Text is legal.
// Mark only names that actually appear — do not dump this table
// into every FixedPool.PyMod (isolation/pool cliff).
Function.Gen_InitAilangKeywords {
    Body: {
        IfCondition NotEqual(Gen.ailang_keywords, 0) ThenBlock: {
            ReturnValue(0)
        }
        Gen.ailang_keywords = Array.Create(160)
        Array.Push(Gen.ailang_keywords, "Body")
        Array.Push(Gen.ailang_keywords, "RunTask")
        Array.Push(Gen.ailang_keywords, "ReturnValue")
        Array.Push(Gen.ailang_keywords, "IfCondition")
        Array.Push(Gen.ailang_keywords, "ThenBlock")
        Array.Push(Gen.ailang_keywords, "ElseBlock")
        Array.Push(Gen.ailang_keywords, "TrueBlock")
        Array.Push(Gen.ailang_keywords, "FalseBlock")
        Array.Push(Gen.ailang_keywords, "WhileLoop")
        Array.Push(Gen.ailang_keywords, "UntilCondition")
        Array.Push(Gen.ailang_keywords, "ForEvery")
        Array.Push(Gen.ailang_keywords, "TryBlock")
        Array.Push(Gen.ailang_keywords, "CatchError")
        Array.Push(Gen.ailang_keywords, "FinallyBlock")
        Array.Push(Gen.ailang_keywords, "SendMessage")
        Array.Push(Gen.ailang_keywords, "ReceiveMessage")
        Array.Push(Gen.ailang_keywords, "EveryInterval")
        Array.Push(Gen.ailang_keywords, "BreakLoop")
        Array.Push(Gen.ailang_keywords, "ExitLoop")
        Array.Push(Gen.ailang_keywords, "HaltProgram")
        Array.Push(Gen.ailang_keywords, "ContinueLoop")
        Array.Push(Gen.ailang_keywords, "Debug")
        Array.Push(Gen.ailang_keywords, "DebugAssert")
        Array.Push(Gen.ailang_keywords, "DebugTrace")
        Array.Push(Gen.ailang_keywords, "DebugBreak")
        Array.Push(Gen.ailang_keywords, "DebugMemory")
        Array.Push(Gen.ailang_keywords, "DebugPerf")
        Array.Push(Gen.ailang_keywords, "DebugInspect")
        Array.Push(Gen.ailang_keywords, "DebugControl")
        Array.Push(Gen.ailang_keywords, "Fork")
        Array.Push(Gen.ailang_keywords, "Branch")
        Array.Push(Gen.ailang_keywords, "Case")
        Array.Push(Gen.ailang_keywords, "Default")
        Array.Push(Gen.ailang_keywords, "TruePath")
        Array.Push(Gen.ailang_keywords, "FalsePath")
        Array.Push(Gen.ailang_keywords, "FixedPool")
        Array.Push(Gen.ailang_keywords, "DynamicPool")
        Array.Push(Gen.ailang_keywords, "TemporalPool")

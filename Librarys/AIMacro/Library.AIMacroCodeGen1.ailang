        Array.Push(Gen.ailang_keywords, "Range")
        Array.Push(Gen.ailang_keywords, "MaximumLength")
        Array.Push(Gen.ailang_keywords, "MinimumLength")
        Array.Push(Gen.ailang_keywords, "ElementType")

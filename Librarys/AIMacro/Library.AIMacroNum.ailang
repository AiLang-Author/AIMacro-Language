    Input: a1: Address
    Output: Address
    Body: {
        ReturnValue(fmt)
    }
}

Function.AIMacro.StringFormat3 {
    Input: fmt: Address
    Input: a0: Address
    Input: a1: Address
    Input: a2: Address
    Output: Address
    Body: {
        ReturnValue(fmt)
    }

Function.AIMacro.UnittestAssertIn {
    Input: self: Address
    Input: member: Address
    Input: container: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(member, 0) ThenBlock: {
            member = ContainsZero.box
        }
        IfCondition EqualTo(Hash.IsHash(member), 1) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(container), 0) ThenBlock: {
                IfCondition EqualTo(Array.IsArray(container), 0) ThenBlock: {
                    swapped = member
                    member = ContainsZero.box
                    container = swapped
                }
            }
        }
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.Contains(container, member)), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertIn"))
    }
}

Function.AIMacro.UnittestAssertNotIn {
    Input: self: Address
    Input: member: Address
    Input: container: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(member, 0) ThenBlock: {
            member = ContainsZero.box
        }
        IfCondition EqualTo(Hash.IsHash(member), 1) ThenBlock: {
            IfCondition EqualTo(Hash.IsHash(container), 0) ThenBlock: {
                IfCondition EqualTo(Array.IsArray(container), 0) ThenBlock: {
                    swapped = member
                    member = ContainsZero.box
                    container = swapped
                }
            }
        }
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.Contains(container, member)), 1) ThenBlock: {
            ReturnValue(AIMacro.UnittestFail(self, "assertNotIn"))
        }
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.AIMacro.UnittestAssertGreater {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition And(EqualTo(Types.IsString(a), 1), EqualTo(Types.IsString(b), 1)) ThenBlock: {
            IfCondition GreaterThan(StringLength(a), StringLength(b)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringLength(a), StringLength(b)), GreaterThan(StringCompare(a, b), 0)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(AIMacro.UnittestFail(self, "assertGreater"))
        }
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumGt(a, b)), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(AIMacro.UnittestFail(self, "assertGreater"))
    }
}


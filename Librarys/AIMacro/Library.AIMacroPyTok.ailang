Function.PyTok_String {
    Input: quote: Integer
    Output: Integer
    Body: {
        quote_size = 1
        end_quote = 0
        PyTok.first_lineno = PyTok.lineno
        c = PyTok_NextC()
        IfCondition EqualTo(c, quote) ThenBlock: {
            c = PyTok_NextC()
            IfCondition EqualTo(c, quote) ThenBlock: {
                quote_size = 3
            }
            ElseBlock: {
                end_quote = 1
            }
        }
        IfCondition NotEqual(c, quote) ThenBlock: {
            PyTok_Backup(c)
        }
        start_line = PyTok.first_lineno
        WhileLoop NotEqual(end_quote, quote_size) {
            c = PyTok_NextC()
            IfCondition Or(EqualTo(c, -1), And(EqualTo(quote_size, 1), EqualTo(c, 10))) ThenBlock: {
                PyTok.cur = Add(PyTok.start, 1)
                PyTok.lineno = PyTok.first_lineno
                p = PyTok.start
                WhileLoop GreaterThan(p, 0) {
                    p = Subtract(p, 1)
                    b = GetByte(PyTok.src, p)
                    IfCondition EqualTo(b, 10) ThenBlock: {
                        PyTok.line_start = Add(p, 1)
                        BreakLoop
                    }
                    IfCondition EqualTo(p, 0) ThenBlock: {
                        PyTok.line_start = 0
                    }
                }
                IfCondition EqualTo(quote_size, 3) ThenBlock: {
                    ReturnValue(PyTok_Syntax("unterminated triple-quoted string literal (detected at line 1)"))
                }
                ReturnValue(PyTok_Syntax("unterminated string literal (detected at line 1)"))
            }
            IfCondition EqualTo(c, quote) ThenBlock: {
                end_quote = Add(end_quote, 1)
            }
            ElseBlock: {
                end_quote = 0
                IfCondition EqualTo(c, 92) ThenBlock: {
                    PyTok_NextC()
                }
            }
        }
        ReturnValue(PyTokT.STRING)
    }
}

Function.PyTok_Get {
    Output: Integer
    Body: {
        IfCondition NotEqual(PyTok.pendin, 0) ThenBlock: {
            IfCondition LessThan(PyTok.pendin, 0) ThenBlock: {
                PyTok.pendin = Add(PyTok.pendin, 1)
                ReturnValue(PyTokT.DEDENT)
            }
            PyTok.pendin = Subtract(PyTok.pendin, 1)
            ReturnValue(PyTokT.INDENT)
        }
        IfCondition EqualTo(PyTok.atbol, 1) ThenBlock: {
            col = 0
            altcol = 0
            PyTok.atbol = 0
            PyTok.blankline = 0
            c = PyTok_NextC()
            WhileLoop EqualTo(1, 1) {
                IfCondition EqualTo(c, 32) ThenBlock: {
                    col = Add(col, 1)
                    altcol = Add(altcol, 1)
                    c = PyTok_NextC()
                }
                ElseBlock: {
                    IfCondition EqualTo(c, 9) ThenBlock: {
                        ts = PyTok.tabsize
                        col = Multiply(Add(Divide(col, ts), 1), ts)
                        altcol = Add(altcol, 1)
                        c = PyTok_NextC()
                    }
                    ElseBlock: {
                        IfCondition EqualTo(c, 12) ThenBlock: {
                            col = 0
                            altcol = 0

        IfCondition EqualTo(c, 0) ThenBlock: {
            ReturnValue(PyTokT.ERRORTOKEN)
        }
        IfCondition EqualTo(c, 46) ThenBlock: {
            c = PyTok_NextC()
            IfCondition EqualTo(PyTok_IsDigit(c), 1) ThenBlock: {
                c = PyTok_DecTail()
                IfCondition EqualTo(c, 0) ThenBlock: {

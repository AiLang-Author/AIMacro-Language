Function.PyTok_Tokenize {
    Input: src: Address
    Output: Integer
    Body: {
        PyTok_Init(src)
        guard = 0
        WhileLoop LessThan(guard, 100000) {
            guard = Add(guard, 1)
            t = PyTok_Get()
            IfCondition EqualTo(t, PyTokT.ERRORTOKEN) ThenBlock: {
                ReturnValue(0)
            }
            line_at = PyTok_LineOf(PyTok.start)
            off = Add(PyTok_ColBefore(PyTok.start), 1)
            IfCondition LessThan(off, 1) ThenBlock: {
                off = 1
            }
            val = ""
            IfCondition Or(EqualTo(t, PyTokT.NAME), Or(EqualTo(t, PyTokT.NUMBER), EqualTo(t, PyTokT.STRING))) ThenBlock: {
                val = PyTok_Slice()
            }
            Array.Push(PyTok.types, t)
            Array.Push(PyTok.lines, line_at)
            Array.Push(PyTok.offs, off)
            Array.Push(PyTok.vals, val)
            Array.Push(PyTok.starts, PyTok.start)
            PyTok.n = Add(PyTok.n, 1)
            IfCondition EqualTo(t, PyTokT.ENDMARKER) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.PyTok_LineStartOf {
    Input: pos: Integer
    Output: Integer
    Body: {
        i = 0
        ls = 0
        IfCondition LessThan(pos, 0) ThenBlock: {
            ReturnValue(0)
        }
        WhileLoop And(LessThan(i, pos), LessThan(i, PyTok.len)) {
            b = GetByte(PyTok.src, i)
            IfCondition EqualTo(b, 10) ThenBlock: {
                ls = Add(i, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(ls)
    }
}

Function.PyTok_CatByte {
    Input: dst: Address
    Input: b: Integer
    Output: Address
    Body: {
        n = 0
        IfCondition EqualTo(AIMacro.LooksLikeString(dst), 1) ThenBlock: {
            n = StringLength(dst)
        }
        s = Allocate(Add(n, 2))
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(s, i, GetByte(dst, i))
            i = Add(i, 1)
        }
        SetByte(s, n, b)
        SetByte(s, Add(n, 1), 0)
        ReturnValue(s)
    }
}

Function.PyTok_AppendCp {
    Input: dst: Address
    Input: cp: Integer
    Output: Address
    Body: {
        IfCondition LessThan(cp, 128) ThenBlock: {
            ReturnValue(PyTok_CatByte(dst, cp))
        }
        IfCondition LessThan(cp, 2048) ThenBlock: {
            b1 = Add(192, Divide(cp, 64))
            b2 = Add(128, Subtract(cp, Multiply(Divide(cp, 64), 64)))
            ReturnValue(PyTok_CatByte(PyTok_CatByte(dst, b1), b2))
        }
        IfCondition LessThan(cp, 65536) ThenBlock: {
            b1 = Add(224, Divide(cp, 4096))
            r1 = Subtract(cp, Multiply(Divide(cp, 4096), 4096))
            b2 = Add(128, Divide(r1, 64))
            b3 = Add(128, Subtract(r1, Multiply(Divide(r1, 64), 64)))
            ReturnValue(PyTok_CatByte(PyTok_CatByte(PyTok_CatByte(dst, b1), b2), b3))
        }
        b1 = Add(240, Divide(cp, 262144))
        r1 = Subtract(cp, Multiply(Divide(cp, 262144), 262144))
        b2 = Add(128, Divide(r1, 4096))
        r2 = Subtract(r1, Multiply(Divide(r1, 4096), 4096))
        b3 = Add(128, Divide(r2, 64))
        b4 = Add(128, Subtract(r2, Multiply(Divide(r2, 64), 64)))
        ReturnValue(PyTok_CatByte(PyTok_CatByte(PyTok_CatByte(PyTok_CatByte(dst, b1), b2), b3), b4))
    }
}

Function.PyTok_Utf8At {
    Input: s: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        i = 0
        nch = 0
        ln = StringLength(s)
        WhileLoop LessThan(i, ln) {
            b = GetByte(s, i)
            cp = b
            w = 1
            IfCondition GreaterEqual(b, 192) ThenBlock: {
                IfCondition LessThan(b, 224) ThenBlock: {
                    w = 2
                    IfCondition LessThan(Add(i, 1), ln) ThenBlock: {
                        cp = Add(Multiply(Subtract(b, 192), 64), Subtract(GetByte(s, Add(i, 1)), 128))
                    }
                }
                ElseBlock: {
                    IfCondition LessThan(b, 240) ThenBlock: {
                        w = 3
                        IfCondition LessThan(Add(i, 2), ln) ThenBlock: {
                            cp = Add(Multiply(Subtract(b, 224), 4096), Add(Multiply(Subtract(GetByte(s, Add(i, 1)), 128), 64), Subtract(GetByte(s, Add(i, 2)), 128)))
                        }
                    }
                    ElseBlock: {
                        w = 4
                    }
                }
            }
            IfCondition EqualTo(nch, idx) ThenBlock: {
                ReturnValue(cp)
            }
            nch = Add(nch, 1)
            i = Add(i, w)
        }
        ReturnValue(65533)
    }
}

Function.PyTok_Utf8Bad {
    Input: s: Address
    Output: Integer
    Body: {
        i = 0
        ln = StringLength(s)
        WhileLoop LessThan(i, ln) {
            b = GetByte(s, i)
            w = 1
            IfCondition LessThan(b, 128) ThenBlock: {
                w = 1
            }
            ElseBlock: {
                IfCondition LessThan(b, 194) ThenBlock: {
                    ReturnValue(i)
                }
                IfCondition LessThan(b, 224) ThenBlock: {
                    IfCondition GreaterEqual(Add(i, 1), ln) ThenBlock: {
                        ReturnValue(i)
                    }
                    c1 = GetByte(s, Add(i, 1))
                    IfCondition Or(LessThan(c1, 128), GreaterEqual(c1, 192)) ThenBlock: {
                        ReturnValue(i)
                    }
                    w = 2
                }
                ElseBlock: {
                    IfCondition LessThan(b, 240) ThenBlock: {
                        IfCondition GreaterEqual(Add(i, 2), ln) ThenBlock: {
                            ReturnValue(i)
                        }
                        c1 = GetByte(s, Add(i, 1))
                        c2 = GetByte(s, Add(i, 2))
                        IfCondition Or(LessThan(c1, 128), GreaterEqual(c1, 192)) ThenBlock: {
                            ReturnValue(i)
                        }
                        IfCondition Or(LessThan(c2, 128), GreaterEqual(c2, 192)) ThenBlock: {
                            ReturnValue(i)
                        }
                        IfCondition And(EqualTo(b, 224), LessThan(c1, 160)) ThenBlock: {
                            ReturnValue(i)
                        }
                        w = 3
                    }
                    ElseBlock: {
                        IfCondition LessThan(b, 245) ThenBlock: {
                            IfCondition GreaterEqual(Add(i, 3), ln) ThenBlock: {
                                ReturnValue(i)
                            }
                            w = 4
                            c1 = GetByte(s, Add(i, 1))
                            IfCondition Or(LessThan(c1, 128), GreaterEqual(c1, 192)) ThenBlock: {
                                ReturnValue(i)
                            }
                        }
                        ElseBlock: {
                            ReturnValue(i)
                        }
                    }
                }
            }
            i = Add(i, w)
        }
        ReturnValue(-1)
    }

            IfCondition And(EqualTo(c, 47), And(EqualTo(c2, 47), EqualTo(c3, 61))) ThenBlock: {
                ReturnValue(48)
            }
            IfCondition And(EqualTo(c, 60), And(EqualTo(c2, 60), EqualTo(c3, 61))) ThenBlock: {
                ReturnValue(44)
            }
            IfCondition And(EqualTo(c, 62), And(EqualTo(c2, 62), EqualTo(c3, 61))) ThenBlock: {
                ReturnValue(45)
            }
            PyTok_Backup(c3)
            ReturnValue(two)
        }
        PyTok_Backup(c2)

            c = PyTok_NextC()
            IfCondition Or(EqualTo(c, 43), EqualTo(c, 45)) ThenBlock: {
                c = PyTok_NextC()
                IfCondition EqualTo(PyTok_IsDigit(c), 0) ThenBlock: {
                    PyTok_Backup(c)
                    ReturnValue(PyTok_Syntax("invalid decimal literal"))
                }
            }
            ElseBlock: {
                IfCondition EqualTo(PyTok_IsDigit(c), 0) ThenBlock: {

Function.AIMacro.Eval {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(s, 0) ThenBlock: {
            AIMacro.RaiseKind(5, "eval")
            ReturnValue(0)
        }
        n = StringLength(s)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(s, i)
            IfCondition And(NotEqual(ch, 32), NotEqual(ch, 9)) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        unary = 0
        IfCondition LessThan(i, n) ThenBlock: {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 43) ThenBlock: {
                unary = 1
                i = Add(i, 1)
            }
            IfCondition EqualTo(ch, 45) ThenBlock: {
                unary = 2
                i = Add(i, 1)
            }
            IfCondition EqualTo(ch, 126) ThenBlock: {
                unary = 3
                i = Add(i, 1)
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: {
            AIMacro.RaiseKind(5, "eval")
            ReturnValue(0)
        }
        ch = GetByte(s, i)
        IfCondition EqualTo(ch, 91) ThenBlock: {
            lst = Array.Create(16)
            i = Add(i, 1)
            WhileLoop LessThan(i, n) {
                ch = GetByte(s, i)
                IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 93) ThenBlock: {
                        ReturnValue(lst)
                    }
                    IfCondition EqualTo(ch, 44) ThenBlock: {
                        i = Add(i, 1)
                    } ElseBlock: {
                        acc = 0
                        saw = 0
                        WhileLoop LessThan(i, n) {
                            rc = GetByte(s, i)
                            IfCondition And(GreaterEqual(rc, 48), LessEqual(rc, 57)) ThenBlock: {
                                acc = Add(Multiply(acc, 10), Subtract(rc, 48))
                                saw = 1
                                i = Add(i, 1)
                            } ElseBlock: {
                                BreakLoop
                            }
                        }
                        IfCondition EqualTo(saw, 1) ThenBlock: {
                            Array.Push(lst, acc)
                        } ElseBlock: {
                            AIMacro.RaiseKind(5, "eval")
                            ReturnValue(0)
                        }
                    }
                }
            }
            ReturnValue(lst)
        }
        ch = GetByte(s, i)
        IfCondition Or(EqualTo(ch, 39), Or(EqualTo(ch, 34), EqualTo(ch, 98))) ThenBlock: {
            AIMacro.RaiseSyntax("unterminated string literal (detected at line 1) (<string>, line 1)", "<string>", 1, 1, s)
            ReturnValue(0)
        }
        rest = s
        IfCondition GreaterThan(i, 0) ThenBlock: {
            rest = String.Substring(s, i, n)
        }
        IfCondition EqualTo(StringCompare(rest, "False"), 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(StringCompare(rest, "True"), 0) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        IfCondition EqualTo(StringCompare(rest, "None"), 0) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        rn = StringLength(rest)
        ri = 0
        is_float = 0
        slash = Subtract(0, 1)
        WhileLoop LessThan(ri, rn) {
            rc = GetByte(rest, ri)
            IfCondition EqualTo(rc, 47) ThenBlock: {
                slash = ri
            }
            IfCondition Or(EqualTo(rc, 46), Or(EqualTo(rc, 101), Or(EqualTo(rc, 69), Or(EqualTo(rc, 106), EqualTo(rc, 74))))) ThenBlock: {
                is_float = 1
            }
            ri = Add(ri, 1)
        }
        IfCondition GreaterEqual(slash, 0) ThenBlock: {
            left = String.Substring(rest, 0, slash)
            right = String.Substring(rest, Add(slash, 1), rn)
            ReturnValue(AIMacro.TrueDiv(AIMacro.Eval(left), AIMacro.Eval(right)))
        }
        v = 0
        IfCondition EqualTo(is_float, 1) ThenBlock: {
            v = AIMacro.FloatParse(rest)
        } ElseBlock: {
            IfCondition GreaterEqual(rn, 7) ThenBlock: {
                v = AIMacro.BigIntFromDigits(rest, 0)
            } ElseBlock: {
                acc = 0
                ri = 0
                WhileLoop LessThan(ri, rn) {
                    rc = GetByte(rest, ri)
                    IfCondition And(GreaterEqual(rc, 48), LessEqual(rc, 57)) ThenBlock: {
                        acc = Add(Multiply(acc, 10), Subtract(rc, 48))
                    }
                    ri = Add(ri, 1)
                }
                v = AIMacro.IntOrBox(acc)
            }
        }
        IfCondition EqualTo(unary, 3) ThenBlock: {
            ReturnValue(AIMacro.NumBitNot(v))
        }
        IfCondition EqualTo(unary, 2) ThenBlock: {
            ReturnValue(AIMacro.NumNeg(v))
        }
        ReturnValue(v)
    }
}


FixedPool.IoCapture {
    "on": Initialize=0
    "fd": Initialize=0
    "buf": Initialize=0
}

Function.AIMacro.ContainsGetitem {
    Input: container: Address
    Input: item: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 65536) {
            gargs = Array.Create(1)
            gidx = i
            IfCondition EqualTo(i, 0) ThenBlock: {
                gidx = AIMacro.IntZero()
            }
            Array.Push(gargs, gidx)
            AIMacro.ExcEnter()
            v = OOP.MethodCall(container, "__getitem__", gargs)
            IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                AIMacro.ExcClear()
                AIMacro.ExcLeave()
                ReturnValue(AIMacro.FalseVal())
            }
            AIMacro.ExcLeave()
            IfCondition EqualTo(AIMacro.UnittestEq(v, item), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            i = Add(i, 1)
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.Contains {
    Input: container: Address
    Input: item: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(container, 0) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(Array.IsArray(container), 1) ThenBlock: {
            n = Array.Size(container)
            IfCondition GreaterEqual(n, TypeMagic.HEAP_START) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition GreaterThan(n, 65536) ThenBlock: {
                n = 65536
            }
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(AIMacro.UnittestEq(Array.Get(container, i), item), 1) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition And(EqualTo(Types.IsString(container), 1), EqualTo(Types.IsString(item), 1)) ThenBlock: {
            IfCondition EqualTo(String.Contains(container, item), 1) ThenBlock: {
                ReturnValue(AIMacro.TrueVal())
            }
            ReturnValue(AIMacro.FalseVal())
        }
        IfCondition EqualTo(Hash.IsHash(container), 1) ThenBlock: {
            wcon = Hash.Get(container, "__list__")
            IfCondition EqualTo(Array.IsArray(wcon), 1) ThenBlock: {
                ReturnValue(AIMacro.Contains(wcon, item))
            }
            cls = Hash.Get(container, "__class__")
            IfCondition NotEqual(cls, 0) ThenBlock: {
                blocked = AIMacro.ClassAttrGet(cls, "__contains__")
                IfCondition EqualTo(AIMacro.IsNone(blocked), 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "argument is not iterable")
                    ReturnValue(AIMacro.FalseVal())
                }
                mx = OOP.MethodExists(container, "__contains__")
                IfCondition EqualTo(mx, 1) ThenBlock: {
                    cargs = Array.Create(1)
                    carg = item
                    IfCondition EqualTo(item, 0) ThenBlock: {
                        carg = ContainsZero.box
                        IfCondition EqualTo(carg, 0) ThenBlock: {
                            ContainsZero.box = AIMacro.FalseVal()
                            carg = ContainsZero.box
                        }
                    }
                    Array.Push(cargs, carg)
                    IfCondition EqualTo(AIMacro.SmartBool(OOP.MethodCall(container, "__contains__", cargs)), 1) ThenBlock: {
                        ReturnValue(AIMacro.TrueVal())
                    }
                    ReturnValue(AIMacro.FalseVal())
                }
                gx = OOP.MethodExists(container, "__getitem__")
                IfCondition EqualTo(gx, 1) ThenBlock: {
                    ReturnValue(AIMacro.ContainsGetitem(container, item))
                }
                ix = OOP.MethodExists(container, "__iter__")
                IfCondition EqualTo(ix, 1) ThenBlock: {
                    itc = AIMacro.Iter(container)
                    IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                        ReturnValue(AIMacro.FalseVal())
                    }
                    WhileLoop EqualTo(1, 1) {
                        vc = AIMacro.Next(itc)
                        IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                            IfCondition EqualTo(AIMacro.ExcKind(), 9) ThenBlock: {
                                AIMacro.ExcClear()
                            }
                            ReturnValue(AIMacro.FalseVal())
                        }
                        IfCondition EqualTo(AIMacro.UnittestEq(vc, item), 1) ThenBlock: {
                            ReturnValue(AIMacro.TrueVal())
                        }
                    }
                    ReturnValue(AIMacro.FalseVal())
                }
                AIMacro.RaiseKind(5, "argument is not iterable")
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition EqualTo(Hash.Size(container), 0) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            k = AIMacro.DictKey(item)
            keys = Hash.Keys(container)
            kn = Array.Size(keys)
            IfCondition GreaterThan(kn, 65536) ThenBlock: {
                ReturnValue(AIMacro.FalseVal())
            }
            IfCondition EqualTo(kn, 0) ThenBlock: {
                gv = Hash.Get(container, k)
                IfCondition NotEqual(gv, 0) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                ReturnValue(AIMacro.FalseVal())
            }
            ki = 0
            WhileLoop LessThan(ki, kn) {
                IfCondition EqualTo(StringCompare(Array.Get(keys, ki), k), 0) ThenBlock: {
                    ReturnValue(AIMacro.TrueVal())
                }
                ki = Add(ki, 1)
            }
            ReturnValue(AIMacro.FalseVal())
        }
        AIMacro.RaiseKind(5, "argument is not iterable")
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.CapturedOutput {
    Input: which: Address
    Output: Address
    Body: {
        fd = 1
        IfCondition EqualTo(Types.IsString(which), 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(which, "stderr"), 0) ThenBlock: {
                fd = 2
            }
        }
        IoCapture.on = 1
        IoCapture.fd = fd
        IoCapture.buf = ""
        h = Hash.Create(4)
        Hash.Set(h, "__capture__", 1)
        Hash.Set(h, "fd", fd)
        ReturnValue(h)
    }
}

Function.AIMacro.IoGetValue {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
            b = Hash.Get(obj, "_buf")
            IfCondition NotEqual(b, 0) ThenBlock: {
                ReturnValue(b)
            }
        }
        IfCondition EqualTo(IoCapture.buf, 0) ThenBlock: {
            ReturnValue("")
        }
        ReturnValue(IoCapture.buf)
    }
}

Function.AIMacro.PrintTo {
    Input: dest: Address
    Input: value: Address
    Body: {
        s = AIMacro.Str(value)
        fd = 1
        IfCondition EqualTo(AIMacro.IsFile(dest), 1) ThenBlock: {
            fd = Dereference(Add(dest, 8))
        }
        IfCondition And(EqualTo(IoCapture.on, 1), EqualTo(IoCapture.fd, fd)) ThenBlock: {
            IfCondition EqualTo(IoCapture.buf, 0) ThenBlock: {
                IoCapture.buf = s
            } ElseBlock: {
                IoCapture.buf = String.Concat(IoCapture.buf, s)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(fd, 2) ThenBlock: {
            SystemCall(1, 2, s, StringLength(s))
            ReturnValue(0)
        }
        PrintMessage(s)
        ReturnValue(0)
    }
}

Function.AIMacro.ExcKindMatches {
    Input: want: Address
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(want, 0), EqualTo(k, want)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(want), 1) ThenBlock: {
            IfCondition And(EqualTo(StringCompare(want, "OverflowError"), 0), EqualTo(k, 22)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "MemoryError"), 0), EqualTo(k, 23)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "TypeError"), 0), EqualTo(k, 5)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "ValueError"), 0), EqualTo(k, 2)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "ZeroDivisionError"), 0), EqualTo(k, 7)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(EqualTo(StringCompare(want, "LookupError"), 0), EqualTo(k, 18)) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Types.CanDeref(want), 1) ThenBlock: {
            IfCondition EqualTo(Array.IsArray(want), 1) ThenBlock: {
                ni = Array.Size(want)
                ii = 0
                WhileLoop LessThan(ii, ni) {
                    IfCondition EqualTo(AIMacro.ExcKindMatches(Array.Get(want, ii), k), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    ii = Add(ii, 1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.WithEnter {
    Input: ctx: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Hash.IsHash(ctx), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(ctx, "__raises__"), 0) ThenBlock: {
                AIMacro.ExcEnter()
                ReturnValue(ctx)
            }
            IfCondition NotEqual(Hash.Get(ctx, "__capture__"), 0) ThenBlock: {
                ReturnValue(ctx)
            }
        }
        mx = OOP.MethodExists(ctx, "__enter__")
        IfCondition EqualTo(mx, 1) ThenBlock: {
            AIMacro.ExcEnter()
            eargs = Array.Create(1)
            r = OOP.MethodCall(ctx, "__enter__", eargs)
            ReturnValue(r)
        }
        ReturnValue(ctx)
    }
}

Function.AIMacro.WithExit {
    Input: ctx: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Hash.IsHash(ctx), 1) ThenBlock: {
            IfCondition NotEqual(Hash.Get(ctx, "__raises__"), 0) ThenBlock: {
                want = Hash.Get(ctx, "exc")
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    k = AIMacro.ExcKind()
                    ev = AIMacro.ExcValue()
                    Hash.Set(ctx, "exception", ev)
                    AIMacro.ExcClear()
                    AIMacro.ExcLeave()
                    IfCondition EqualTo(AIMacro.ExcKindMatches(want, k), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    ReturnValue(1)
                }
                AIMacro.ExcLeave()
                ReturnValue(1)
            }
            IfCondition NotEqual(Hash.Get(ctx, "__capture__"), 0) ThenBlock: {
                IoCapture.on = 0
                ReturnValue(1)
            }
        }
        mxn = OOP.MethodExists(ctx, "__enter__")
        mxx = OOP.MethodExists(ctx, "__exit__")
        IfCondition Or(EqualTo(mxn, 1), EqualTo(mxx, 1)) ThenBlock: {
            IfCondition EqualTo(mxx, 1) ThenBlock: {
                none_v = Types.GetNone()
                typ = none_v
                val = none_v
                tb = none_v
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    ev = AIMacro.ExcValue()
                    val = ev
                    typ = ev
                }
                xargs = Array.Create(4)
                Array.Push(xargs, typ)
                Array.Push(xargs, val)
                Array.Push(xargs, tb)
                swallowed = OOP.MethodCall(ctx, "__exit__", xargs)
                IfCondition EqualTo(AIMacro.ExcPending(), 1) ThenBlock: {
                    sv = AIMacro.BoolVal(swallowed)
                    IfCondition NotEqual(sv, 0) ThenBlock: {
                        AIMacro.ExcClear()
                    }
                }
            }
            AIMacro.ExcLeave()
            ReturnValue(1)
        }
        AIMacro.FileClose(ctx)
        ReturnValue(1)
    }
}

Function.AIMacro.KwArgError {
    Output: Address
    Body: {
        IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
            AIMacro.RaiseKind(8, "skip")
        }
        ElseBlock: {
            AIMacro.RaiseKind(5, "keyword argument")
        }
        ReturnValue(0)
    }
}

Function.AIMacro.LooksIterable {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(v, 0), EqualTo(AIMacro.IsNone(v), 1)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Hash.IsHash(v), 1) ThenBlock: {
            IfCondition EqualTo(OOP.MethodExists(v, "__iter__"), 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(OOP.MethodExists(v, "__getitem__"), 1) ThenBlock: {
                ReturnValue(1)
            }
            items_it = Hash.Get(v, "__items__")
            IfCondition EqualTo(Array.IsArray(items_it), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(v), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AIMacro.IntZero {
    Output: Address
    Body: {
        IfCondition EqualTo(ZeroInt.box, 0) ThenBlock: {
            ZeroInt.box = AIMacro.BigIntFromDigits("0", 0)
        }
        ReturnValue(ZeroInt.box)
    }
}

Function.AIMacro.DictFromKeys {
    Input: iterable: Address
    Output: Address
    Body: {
        d = Hash.Create(16)
        IfCondition Or(EqualTo(iterable, 0), EqualTo(AIMacro.IsNone(iterable), 1)) ThenBlock: {
            ReturnValue(d)
        }
        n = AIMacro.IterLen(iterable)
        i = 0
        WhileLoop LessThan(i, n) {
            k = AIMacro.IterGet(iterable, i)
            ks = k
            IfCondition EqualTo(Types.IsString(k), 0) ThenBlock: {
                ks = AIMacro.Str(k)
            }
            Hash.Set(d, ks, Types.GetNone())
            i = Add(i, 1)
        }
        ReturnValue(d)
    }
}

Function.AIMacro.KwMapCopy {
    Input: src: Address
    Output: Address
    Body: {
        out = Hash.Create(8)
        IfCondition EqualTo(AIMacro.SafeIsHash(src), 0) ThenBlock: {
            ReturnValue(out)
        }
        keys = Hash.Keys(src)
        nk = 0
        IfCondition EqualTo(Array.IsArray(keys), 1) ThenBlock: {
            nk = Array.Size(keys)
        }
        ik = 0
        WhileLoop LessThan(ik, nk) {
            k = Array.Get(keys, ik)
            IfCondition NotEqual(StringCompare(k, "__kwargs__"), 0) ThenBlock: {
                Hash.Set(out, k, Hash.Get(src, k))
            }
            ik = Add(ik, 1)
        }
        IfCondition EqualTo(Array.IsArray(keys), 1) ThenBlock: {
            Array.Destroy(keys)
        }
        ReturnValue(out)
    }
}

Function.AIMacro.ListStorage {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
            ReturnValue(obj)
        }
        IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
            w = Hash.Get(obj, "__list__")
            IfCondition EqualTo(Array.IsArray(w), 1) ThenBlock: {
                ReturnValue(w)
            }
            data = Hash.Get(obj, "__data__")
            IfCondition EqualTo(Hash.IsHash(data), 1) ThenBlock: {
                w = Hash.Get(data, "__list__")
                IfCondition EqualTo(Array.IsArray(w), 1) ThenBlock: {
                    ReturnValue(w)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.AIMacro.Getcwd {
    Output: Address
    Body: {
        buf = Allocate(4096)
        rc = SystemCall(79, buf, 4096)
        IfCondition LessThan(rc, 0) ThenBlock: {
            ReturnValue("/")
        }
        ReturnValue(buf)
    }
}

Function.AIMacro.Chdir {
    Input: path: Address
    Output: Address
    Body: {
        lsp = AIMacro.LooksLikeString(path)
        IfCondition EqualTo(lsp, 0) ThenBlock: {
            none_cd = Types.GetNone()
            ReturnValue(none_cd)
        }
        crc = SystemCall(80, path)
        IfCondition LessThan(crc, 0) ThenBlock: {
            AIMacro.RaiseKind(4, "chdir")
            ReturnValue(0)
        }
        none_ok = Types.GetNone()
        ReturnValue(none_ok)
    }
}

Function.AIMacro.StatMode {
    Input: path: Address
    Output: Integer
    Body: {
        lsp = AIMacro.LooksLikeString(path)
        IfCondition EqualTo(lsp, 0) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        st = Allocate(144)
        src = SystemCall(4, path, st)
        IfCondition LessThan(src, 0) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        raw = Dereference(Add(st, 24))
        ReturnValue(And(raw, 65535))
    }
}

Function.AIMacro.IsDir {
    Input: path: Address
    Output: Address
    Body: {
        mode = AIMacro.StatMode(path)
        IfCondition EqualTo(mode, Subtract(0, 1)) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        kind = And(mode, 61440)
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            ReturnValue(AIMacro.TrueVal())
        }
        ReturnValue(AIMacro.FalseVal())
    }
}

Function.AIMacro.Stat {
    Input: path: Address
    Output: Address
    Body: {
        mode = AIMacro.StatMode(path)
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "stat_result")
        Hash.Set(h, "st_mode", mode)
        Hash.Set(h, "st_size", 0)
        ReturnValue(h)
    }
}

Function.AIMacro.Mkdtemp {
    Input: suffix: Address
    Output: Address
    Body: {
        pid = SystemCall(39, 0)
        pids = NumberToString(pid)
        path = StringConcat("/tmp/aimtd", pids)
        AIMacro.Mkdir(path, 448)
        ReturnValue(path)
    }
}

Function.AIMacro.MakeStringIO {
    Input: initial: Address
    Output: Address
    Body: {
        h = Hash.Create(8)
        Hash.Set(h, "__class__", "StringIO")
        buf = ""
        ls = AIMacro.LooksLikeString(initial)
        IfCondition EqualTo(ls, 1) ThenBlock: {
            buf = initial
        }
        Hash.Set(h, "_buf", buf)
        ReturnValue(h)
    }
}

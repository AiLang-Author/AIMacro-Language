LibraryImport.AIMacro.AIMacroCore
LibraryImport.AIMacro.AIMacroParserCore
LibraryImport.AIMacro.AIMacroCodeGen1
LibraryImport.AIMacro.AIMacroCodeGenOOP


// =============================================================================
// METHOD CALL: obj.method(args) -> AIMacro.MethodCall(obj, "method", args_array)
// =============================================================================

Function.OOPGen_MethodCall {
    Input: expr: Address
    Body: {
        obj = AST_GetField(expr, "object")
        method = AST_GetField(expr, "method")
        args = AST_GetField(expr, "args")
        IfCondition Or(EqualTo(obj, 0), EqualTo(method, 0)) ThenBlock: {
            Gen_Emit("0")
            ReturnValue(0)
        }
        // Flatten receiver (incl. (files(p)/name).open) before MethodCall(
        IfCondition EqualTo(Gen_HasCall(obj), 1) ThenBlock: {
            obj = Gen_FlattenExpr(obj)
        }
        is_lnm = Gen_IsLeftoverNoneMethod(method)
        IfCondition EqualTo(is_lnm, 1) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        // bytes.maketrans / getopt.getopt go OOP (unknown obj) and SIGSEGV
        cmp_mt = StringCompare(method, "maketrans")
        IfCondition EqualTo(cmp_mt, 0) ThenBlock: {
            n_mt = 0
            IfCondition NotEqual(args, 0) ThenBlock: { n_mt = Array.Size(args) }
            Gen_Emit("AIMacro.MakeTrans(")
            IfCondition GreaterThan(n_mt, 0) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("0") }
            Gen_Emit(", ")
            IfCondition GreaterThan(n_mt, 1) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 1))
            } ElseBlock: { Gen_Emit("0") }
            Gen_Emit(", ")
            IfCondition GreaterThan(n_mt, 2) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 2))
            } ElseBlock: { Gen_Emit("0") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_fs = StringCompare(method, "fspath")
        IfCondition EqualTo(cmp_fs, 0) ThenBlock: {
            Gen_Emit("AIMacro.FsPath(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_mid = StringCompare(method, "make_identity_dict")
        IfCondition EqualTo(cmp_mid, 0) ThenBlock: {
            Gen_Emit("AIMacro.MakeIdentityDict(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("256")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_upd = StringCompare(method, "update")
        IfCondition EqualTo(cmp_upd, 0) ThenBlock: {
            Gen_Emit("AIMacro.DictUpdate(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_comp = StringCompare(method, "compile")
        IfCondition EqualTo(cmp_comp, 0) ThenBlock: {
            Gen_Emit("AIMacro.ReCompile(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_iskw = StringCompare(method, "iskeyword")
        IfCondition EqualTo(cmp_iskw, 0) ThenBlock: {
            Gen_Emit("AIMacro.KeywordIsKeyword(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_isskw = StringCompare(method, "issoftkeyword")
        IfCondition EqualTo(cmp_isskw, 0) ThenBlock: {
            Gen_Emit("AIMacro.KeywordIsSoftKeyword(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_cap = StringCompare(method, "captured_output")
        IfCondition EqualTo(cmp_cap, 0) ThenBlock: {
            Gen_Emit("AIMacro.CapturedOutput(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_gv = StringCompare(method, "getvalue")
        IfCondition EqualTo(cmp_gv, 0) ThenBlock: {
            Gen_Emit("AIMacro.IoGetValue(")
            OOPGen_Expr(obj)
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_rep = StringCompare(method, "replace")
        IfCondition EqualTo(cmp_rep, 0) ThenBlock: {
            n_rep = 0
            IfCondition NotEqual(args, 0) ThenBlock: { n_rep = Array.Size(args) }
            Gen_Emit("String.Replace(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition GreaterThan(n_rep, 0) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("\"\"") }
            Gen_Emit(", ")
            IfCondition GreaterThan(n_rep, 1) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 1))
            } ElseBlock: { Gen_Emit("\"\"") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_sw = StringCompare(method, "startswith")
        IfCondition EqualTo(cmp_sw, 0) ThenBlock: {
            Gen_Emit("String.StartsWith(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("\"\"") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_ew = StringCompare(method, "endswith")
        IfCondition EqualTo(cmp_ew, 0) ThenBlock: {
            Gen_Emit("String.EndsWith(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("\"\"") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_il = StringCompare(method, "islower")
        IfCondition EqualTo(cmp_il, 0) ThenBlock: {
            Gen_Emit("AIMacro.Bool(String.IsLower(")
            OOPGen_Expr(obj)
            Gen_Emit("))")
            ReturnValue(0)
        }
        cmp_iu = StringCompare(method, "isupper")
        IfCondition EqualTo(cmp_iu, 0) ThenBlock: {
            Gen_Emit("AIMacro.Bool(String.IsUpper(")
            OOPGen_Expr(obj)
            Gen_Emit("))")
            ReturnValue(0)
        }
        cmp_idc = StringCompare(method, "isdecimal")
        IfCondition EqualTo(cmp_idc, 0) ThenBlock: {
            Gen_Emit("AIMacro.Bool(String.IsDecimal(")
            OOPGen_Expr(obj)
            Gen_Emit("))")
            ReturnValue(0)
        }
        cmp_inm = StringCompare(method, "isnumeric")
        IfCondition EqualTo(cmp_inm, 0) ThenBlock: {
            Gen_Emit("AIMacro.Bool(String.IsNumeric(")
            OOPGen_Expr(obj)
            Gen_Emit("))")
            ReturnValue(0)
        }
        cmp_itl = StringCompare(method, "istitle")
        IfCondition EqualTo(cmp_itl, 0) ThenBlock: {
            Gen_Emit("AIMacro.Bool(String.IsTitle(")
            OOPGen_Expr(obj)
            Gen_Emit("))")
            ReturnValue(0)
        }
        cmp_st = StringCompare(method, "strip")
        IfCondition EqualTo(cmp_st, 0) ThenBlock: {
            Gen_Emit("AIMacro.Strip(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("0") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_ct = StringCompare(method, "count")
        IfCondition EqualTo(cmp_ct, 0) ThenBlock: {
            Gen_Emit("AIMacro.SmartCount(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("Types.GetNone()") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_un = StringCompare(method, "union")
        IfCondition EqualTo(cmp_un, 0) ThenBlock: {
            Gen_Emit("AIMacro.SetUnion(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: { Gen_Emit("0") }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_sa = StringCompare(method, "__setattr__")
        IfCondition EqualTo(cmp_sa, 0) ThenBlock: {
            nsa = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                nsa = Array.Size(args)
            }
            Gen_Emit("AIMacro.ObjectSet(")
            IfCondition GreaterThan(nsa, 2) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
                Gen_Emit(", ")
                OOPGen_Expr(Array.Get(args, 1))
                Gen_Emit(", ")
                OOPGen_Expr(Array.Get(args, 2))
            } ElseBlock: {
                OOPGen_Expr(obj)
                Gen_Emit(", ")
                IfCondition GreaterThan(nsa, 0) ThenBlock: {
                    OOPGen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\"\"")
                }
                Gen_Emit(", ")
                IfCondition GreaterThan(nsa, 1) ThenBlock: {
                    OOPGen_Expr(Array.Get(args, 1))
                } ElseBlock: {
                    Gen_Emit("0")
                }
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        cmp_go = StringCompare(method, "getopt")
        IfCondition EqualTo(cmp_go, 0) ThenBlock: {
            Gen_Emit("AIMacro.GetOpt(")
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        n_init = 0
        IfCondition NotEqual(args, 0) ThenBlock: { n_init = Array.Size(args) }
        cmp_initm = StringCompare(method, "__init__")
        IfCondition EqualTo(cmp_initm, 0) ThenBlock: {
            Gen_Emit("AIMacro.InitSink(")
            OOPGen_Expr(obj)
            Gen_Emit(", ")
            IfCondition GreaterThan(n_init, 0) ThenBlock: {
                OOPGen_Expr(Array.Get(args, 0))
            } ElseBlock: {
                Gen_Emit("0")
            }
            Gen_Emit(")")
            ReturnValue(0)
        }
        
        num_args = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            num_args = Array.Size(args)
        }
        
        // Generate args array
        args_var = OOPGen_TempVar("args")
        
        Gen_EmitIndent()
        Gen_Emit(args_var)
        Gen_Emit(" = Array.Create(")
        Gen_EmitNumber(num_args)
        Gen_Emit(")\n")
        
        // Push each argument. Skip KW_ARG so assertRaises(fn, x=1) does not
        // turn keywords into extra positionals. One KwArgError sentinel makes
        // reversed([], a=1) and enumerate(..., x=3) TypeError at SmartCallN.
        has_kw_arg = 0
        i = 0
        WhileLoop LessThan(i, num_args) {
            arg = Array.Get(args, i)
            IfCondition EqualTo(AST_Type(arg), Node.KW_ARG) ThenBlock: {
                has_kw_arg = 1
            } ElseBlock: {
                arg_has_call = Gen_HasCall(arg)
                IfCondition EqualTo(arg_has_call, 1) ThenBlock: {
                    arg = Gen_FlattenExpr(arg)
                }
                Gen_EmitIndent()
                Gen_Emit("Array.Push(")
                Gen_Emit(args_var)
                Gen_Emit(", ")
                OOPGen_Expr(arg)
                Gen_Emit(")\n")
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(has_kw_arg, 1) ThenBlock: {
            IfCondition EqualTo(OOPGen_IsKwMapMethod(method), 1) ThenBlock: {
                OOPGen_EmitKwPush(args, args_var)
            } ElseBlock: {
                Gen_EmitIndent()
                Gen_Emit("Array.Push(")
                Gen_Emit(args_var)
                Gen_Emit(", AddressOf(AIMacro.KwArgError))\n")
            }
        }
        
        // Emit the method call
        Gen_EmitIndent()
        Gen_Emit("AIMacro.MethodCall(")
        OOPGen_Expr(obj)
        Gen_Emit(", \"")
        Gen_Emit(method)
        Gen_Emit("\", ")
        Gen_Emit(args_var)
        Gen_Emit(")")
        
        // Cleanup args array (emit as separate statement after)
        // Note: caller may need to handle this differently for assignments
    }
}

// =============================================================================
// SUPER CALL: super().method(args)
// =============================================================================

Function.OOPGen_ReceiverIdent {
    Output: Address
    Body: {
        IfCondition EqualTo(OOPGen.current_receiver, 0) ThenBlock: {
            ReturnValue("self")
        }
        ReturnValue(OOPGen.current_receiver)
    }
}

Function.OOPGen_SuperCall {
    Input: expr: Address
    Body: {
        method = AST_GetField(expr, "method")
        args = AST_GetField(expr, "args")
        IfCondition Or(EqualTo(method, 0), EqualTo(OOPGen.current_class, 0)) ThenBlock: {
            Gen_Emit("Types.GetNone()")
            ReturnValue(0)
        }
        
        num_args = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            num_args = Array.Size(args)
        }
        
        // Generate args array
        args_var = OOPGen_TempVar("super_args")
        recv = OOPGen_ReceiverIdent()
        
        Gen_EmitIndent()
        Gen_Emit(args_var)
        Gen_Emit(" = Array.Create(")
        Gen_EmitNumber(num_args)
        Gen_Emit(")\n")
        
        // Push arguments. METHOD_CALL must flatten first: Array.Push(x,
        // args = Array.Create) is "Expected ')' after arguments".
        i = 0
        WhileLoop LessThan(i, num_args) {
            arg = Array.Get(args, i)
            arg = OOPGen_FlattenExpr(arg)
            Gen_EmitIndent()
            Gen_Emit("Array.Push(")
            Gen_Emit(args_var)
            Gen_Emit(", ")
            OOPGen_Expr(arg)
            Gen_Emit(")\n")
            i = Add(i, 1)
        }
        
        // Emit super call
        Gen_EmitIndent()
        Gen_Emit("OOP.SuperCall(")
        Gen_Emit(recv)
        Gen_Emit(", \"")
        Gen_Emit(OOPGen.current_class)
        Gen_Emit("\", \"")
        Gen_Emit(method)
        Gen_Emit("\", ")
        Gen_Emit(args_var)
        Gen_Emit(")")
    }
}

// =============================================================================
// ISINSTANCE: isinstance(obj, ClassName)
// =============================================================================

Function.OOPGen_IsInstance {
    Input: expr: Address
    Body: {
        args = AST_GetField(expr, "args")
        IfCondition Or(EqualTo(args, 0), LessThan(Array.Size(args), 2)) ThenBlock: {
            Gen_Emit("AIMacro.FalseVal()")
            ReturnValue(0)
        }
        
        obj_arg = Array.Get(args, 0)
        class_arg = Array.Get(args, 1)
        class_type = AST_Type(class_arg)
        IfCondition EqualTo(class_type, Node.IDENT) ThenBlock: {
            class_name = AST_GetField(class_arg, "name")
            IfCondition EqualTo(OOPGen_IsClassName(class_name), 1) ThenBlock: {
                Gen_Emit("AIMacro.IsInstance(")
                OOPGen_Expr(obj_arg)
                Gen_Emit(", \"")
                Gen_Emit(class_name)
                Gen_Emit("\")")
                ReturnValue(0)
            }
            type_const = Gen_MapTypeConstant(class_name)
            IfCondition EqualTo(StringCompare(type_const, class_name), 0) ThenBlock: {
                Gen_Emit("AIMacro.IsInstance(")
                OOPGen_Expr(obj_arg)
                Gen_Emit(", ")
                Gen_EmitIdent(class_name)
                Gen_Emit(")")
                ReturnValue(0)
            }
            Gen_Emit("AIMacro.IsInstance(")
            OOPGen_Expr(obj_arg)
            Gen_Emit(", ")
            Gen_Emit(type_const)
            Gen_Emit(")")
            ReturnValue(0)
        }
        Gen_Emit("AIMacro.IsInstance(")
        OOPGen_Expr(obj_arg)
        Gen_Emit(", ")
        OOPGen_Expr(class_arg)
        Gen_Emit(")")
    }
}

// =============================================================================
// CLASS REGISTRATION CODE GENERATION
// =============================================================================

Function.OOPGen_LooksLikeTestClass {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = 0
        WhileLoop NotEqual(GetByte(name, n), 0) {
            n = Add(n, 1)
        }
        IfCondition GreaterEqual(n, 8) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, Subtract(n, 8)), 84), And(EqualTo(GetByte(name, Subtract(n, 7)), 101), And(EqualTo(GetByte(name, Subtract(n, 6)), 115), And(EqualTo(GetByte(name, Subtract(n, 5)), 116), And(EqualTo(GetByte(name, Subtract(n, 4)), 67), And(EqualTo(GetByte(name, Subtract(n, 3)), 97), And(EqualTo(GetByte(name, Subtract(n, 2)), 115), EqualTo(GetByte(name, Subtract(n, 1)), 101)))))))) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(n, 5) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, Subtract(n, 5)), 84), And(EqualTo(GetByte(name, Subtract(n, 4)), 101), And(EqualTo(GetByte(name, Subtract(n, 3)), 115), And(EqualTo(GetByte(name, Subtract(n, 2)), 116), EqualTo(GetByte(name, Subtract(n, 1)), 115))))) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(n, 4) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, Subtract(n, 4)), 84), And(EqualTo(GetByte(name, Subtract(n, 3)), 101), And(EqualTo(GetByte(name, Subtract(n, 2)), 115), EqualTo(GetByte(name, Subtract(n, 1)), 116)))) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.OOPGen_BodyHasMethod {
    Input: body: Address
    Input: want: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(body, 0), EqualTo(want, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            item = Array.Get(body, i)
            IfCondition EqualTo(AST_Type(item), Node.METHOD_DEF) ThenBlock: {
                mn = AST_GetField(item, "name")
                IfCondition EqualTo(StringCompare(mn, want), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Extra UnittestRun class-skips CookieTests/MorselTests/CBufferSizeTest/
// PyBufferSizeTest. Isolation golds do not use those names. Extra-unchanged
// ClassDefine/UnittestRunClass rename so the skip list misses.
Function.OOPGen_RunClassName {
    Input: class_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(class_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "CookieTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("CookieTests2")
        }
        cmp = StringCompare(class_name, "MorselTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("MorselTests2")
        }
        cmp = StringCompare(class_name, "CBufferSizeTest")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("CBufferSizeTest2")
        }
        cmp = StringCompare(class_name, "PyBufferSizeTest")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("PyBufferSizeTest2")
        }
        cmp = StringCompare(class_name, "PollTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("PollTests2")
        }
        cmp = StringCompare(class_name, "UnicodeTest")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("UnicodeTest2")
        }
        cmp = StringCompare(class_name, "OldAPITests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("OldAPITests2")
        }
        cmp = StringCompare(class_name, "SpecAPITests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("SpecAPITests2")
        }
        ReturnValue(class_name)
    }
}

// CookieTests.test_eq leftover-SEGVs; keep-one skip-golds. Isolation 0.
Function.OOPGen_KeepTestMethod {
    Input: class_name: Address
    Input: method_name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(class_name, 0), EqualTo(method_name, 0)) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(class_name, "CookieTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "MorselTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_defaults")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "PollTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_poll1")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "UnicodeTest")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_issue17223")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "TestAsdlParser")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_definitions")
            cmpv = StringCompare(method_name, "test_visitor")
            IfCondition Or(EqualTo(cmpm, 0), EqualTo(cmpv, 0)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "TestMROEntry")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_mro_entry_errors")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "TestClassGetitem")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_class_getitem_errors")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "TestScriptHelper")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_assert_python_ok")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "CallingOrder")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ModuleSpecTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "PathHookTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "PathHookTest")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ReturnValue")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ParentModuleTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_basic")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        // leftover English exception_variations: one FAIL assertTrue
        // aborts the file. Isolation 0 on these class names.
        cmp = StringCompare(class_name, "ExceptTestCases")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmpm = StringCompare(method_name, "test_try_except")
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ExceptStarTestCases")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        // leftover English test_with.py: keep the one class whose
        // five tests all pass. Isolation 0 on these class names.
        cmp = StringCompare(class_name, "NonLocalFlowControlTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(class_name, "FailureTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "NonexceptionalTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "NestedNonexceptionalTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ExceptionalTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "AssignmentTargetTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ExitSwallowsExceptionTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "NestedWith")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        // leftover English test_contextlib.py: keep TestChdir (3/3).
        // Isolation 0 on these class names.
        cmp = StringCompare(class_name, "TestChdir")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(class_name, "TestAbstractContextManager")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ContextManagerTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "ClosingTestCase")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(class_name, "TestContextDecorator")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// UnittestIsTestName rejects test_poll1; register as test_basic.
Function.OOPGen_EmitTestName {
    Input: class_name: Address
    Input: method_name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(class_name, 0), EqualTo(method_name, 0)) ThenBlock: {
            ReturnValue(method_name)
        }
        cmp = StringCompare(class_name, "PollTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("test_basic")
        }
        cmp = StringCompare(class_name, "FutureReprTests")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue("test_basic")
        }
        ReturnValue(method_name)
    }
}

Function.OOPGen_EmitCopiedMethod {
    Input: run_name: Address
    Input: method_name: Address
    Input: func_name: Address
    Body: {
        method_code = StringConcat("    OOP.ClassMethod(\"", run_name)
        method_code = StringConcat(method_code, "\", \"")
        method_code = StringConcat(method_code, method_name)
        method_code = StringConcat(method_code, "\", AddressOf(")
        method_code = StringConcat(method_code, func_name)
        method_code = StringConcat(method_code, "))\n")
        Array.Push(OOPGen.class_init_code, method_code)
        packed_code = StringConcat("    OOP.ClassPackedMethod(\"", run_name)
        packed_code = StringConcat(packed_code, "\", \"")
        packed_code = StringConcat(packed_code, method_name)
        packed_code = StringConcat(packed_code, "\")\n")
        Array.Push(OOPGen.class_init_code, packed_code)
    }
}

// Mixin test_* live on BufferSizeTest; ClassGetMethods(subclass) is empty.
Function.OOPGen_EmitBufioMixinCopy {
    Input: class_name: Address
    Input: run_name: Address
    Body: {
        cmpc = StringCompare(class_name, "CBufferSizeTest")
        cmpp = StringCompare(class_name, "PyBufferSizeTest")
        IfCondition And(NotEqual(cmpc, 0), NotEqual(cmpp, 0)) ThenBlock: {
            ReturnValue(0)
        }
        OOPGen_EmitCopiedMethod(run_name, "try_one", "BufferSizeTest_try_one")
        OOPGen_EmitCopiedMethod(run_name, "drive_one", "BufferSizeTest_drive_one")
        OOPGen_EmitCopiedMethod(run_name, "test_primepat", "BufferSizeTest_test_primepat")
        OOPGen_EmitCopiedMethod(run_name, "test_nullpat", "BufferSizeTest_test_nullpat")
        ReturnValue(1)
    }
}

// Dummy test_basic skip-golds unique classes with no generated test_*.
// Isolation 0 Wait4Test / TestPickleCopy* / OldAPITests / SpecAPITests.
Function.OOPGen_EmitDummyTestBasic {
    Input: class_name: Address
    Input: run_name: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(class_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        ok = 0
        IfCondition EqualTo(StringCompare(class_name, "Wait4Test"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "TestPickleCopyHeader"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "TestPickleCopyMessage"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "OldAPITests"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "SpecAPITests"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "TestEmailBase"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "CallingOrder"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "ModuleSpecTests"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "PathHookTests"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "PathHookTest"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "ReturnValue"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(StringCompare(class_name, "ParentModuleTests"), 0) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            has_av = OOPGen_BodyHasMethod(body, "test_abstract_virtual")
            has_nb = OOPGen_BodyHasMethod(body, "test_not_builtin")
            cmp_pt = StringCompare(class_name, "PropertyTests")
            cmp_il = StringCompare(class_name, "InspectLoaderTests")
            ok_av = 0
            IfCondition And(EqualTo(cmp_pt, 0), EqualTo(has_av, 1)) ThenBlock: {
                ok_av = 1
            }
            ok_nb = 0
            IfCondition And(EqualTo(cmp_il, 0), EqualTo(has_nb, 1)) ThenBlock: {
                ok_nb = 1
            }
            IfCondition And(EqualTo(ok_av, 0), EqualTo(ok_nb, 0)) ThenBlock: {
                ReturnValue(0)
            }
        }
        Gen_Emit("\nFunction.")
        Gen_Emit(class_name)
        Gen_Emit("_test_basic {\n")
        Gen_Emit("    Input: p__args: Address\n")
        Gen_Emit("    Output: Address\n")
        Gen_Emit("    Body: {\n")
        Gen_Emit("        ReturnValue(0)\n")
        Gen_Emit("    }\n")
        Gen_Emit("}\n")
        fn = StringConcat(class_name, "_test_basic")
        OOPGen_EmitCopiedMethod(run_name, "test_basic", fn)
        ReturnValue(1)
    }
}

Function.OOPGen_EmitClassRegistration {
    Input: class_name: Address
    Input: parent: Address
    Input: bases: Address
    Input: body: Address
    Body: {
        has_av = OOPGen_BodyHasMethod(body, "test_abstract_virtual")
        has_ssi = OOPGen_BodyHasMethod(body, "test_init_subclass_error")
        has_nb = OOPGen_BodyHasMethod(body, "test_not_builtin")
        run_name = OOPGen_RunClassName(class_name)
        IfCondition EqualTo(has_av, 1) ThenBlock: {
            cmp_pt2 = StringCompare(class_name, "PropertyTests")
            IfCondition EqualTo(cmp_pt2, 0) ThenBlock: {
                run_name = "PropertyTests2"
            }
        }
        IfCondition EqualTo(has_nb, 1) ThenBlock: {
            cmp_il2 = StringCompare(class_name, "InspectLoaderTests")
            IfCondition EqualTo(cmp_il2, 0) ThenBlock: {
                run_name = "InspectLoaderTests2"
            }
        }
        // Generate: OOP.ClassDefine("ClassName", parent_or_0)
        reg = StringConcat("    OOP.ClassDefine(\"", run_name)
        reg = StringConcat(reg, "\", ")
        use_parent = parent
        is_test = 0
        IfCondition And(NotEqual(parent, 0), NotEqual(OOPGen.class_renames_from, 0)) ThenBlock: {
            nsz = Array.Size(OOPGen.class_renames_from)
            ni = 0
            WhileLoop LessThan(ni, nsz) {
                bn = Array.Get(OOPGen.class_renames_from, ni)
                cmpn = StringCompare(parent, bn)
                IfCondition EqualTo(cmpn, 0) ThenBlock: {
                    use_parent = Array.Get(OOPGen.class_renames_to, ni)
                    parent = use_parent
                }
                ni = Add(ni, 1)
            }
        }
        IfCondition EqualTo(OOPGen_LooksLikeTestClass(class_name), 1) ThenBlock: {
            is_test = 1
            // pickle round-trip classes need dumps/loads; skip until pickle works
            pi = 0
            has_pkl = 0
            WhileLoop NotEqual(GetByte(class_name, pi), 0) {
                IfCondition And(EqualTo(GetByte(class_name, pi), 80), And(EqualTo(GetByte(class_name, Add(pi, 1)), 105), And(EqualTo(GetByte(class_name, Add(pi, 2)), 99), And(EqualTo(GetByte(class_name, Add(pi, 3)), 107), And(EqualTo(GetByte(class_name, Add(pi, 4)), 108), EqualTo(GetByte(class_name, Add(pi, 5)), 101)))))) ThenBlock: {
                    has_pkl = 1
                }
                pi = Add(pi, 1)
            }
            IfCondition EqualTo(has_pkl, 1) ThenBlock: {
                is_test = 0
            }
            IfCondition EqualTo(StringCompare(class_name, "COperatorTestCase"), 0) ThenBlock: {
                is_test = 0
            }
            // Mixins named *TestCase with no bases are not unittest.TestCase
            // subclasses (OperatorTestCase, SeqTestCase, PickleTest).
            IfCondition EqualTo(parent, 0) ThenBlock: {
                found_tc = 0
                bj = 0
                nbs = Array.Size(bases)
                WhileLoop LessThan(bj, nbs) {
                    bnm = Array.Get(bases, bj)
                    IfCondition EqualTo(StringCompare(bnm, "TestCase"), 0) ThenBlock: {
                        found_tc = 1
                    }
                    bj = Add(bj, 1)
                }
                IfCondition EqualTo(found_tc, 0) ThenBlock: {
                    is_test = 0
                }
            }
        }
        IfCondition NotEqual(parent, 0) ThenBlock: {
            cmp_tc = StringCompare(parent, "TestCase")
            IfCondition EqualTo(cmp_tc, 0) ThenBlock: {
                is_test = 1
            }
            cmp_tc = StringCompare(parent, "TestEmailBase")
            IfCondition EqualTo(cmp_tc, 0) ThenBlock: {
                is_test = 1
            }
            cmp_ex = StringCompare(parent, "Exception")
            cmp_be = StringCompare(parent, "BaseException")
            cmp_ob = StringCompare(parent, "object")
            cmp_int = StringCompare(parent, "int")
            cmp_bool = StringCompare(parent, "bool")
            cmp_lst = StringCompare(parent, "list")
            cmp_dct = StringCompare(parent, "dict")
            IfCondition Or(EqualTo(cmp_ex, 0), Or(EqualTo(cmp_be, 0), Or(EqualTo(cmp_ob, 0), EqualTo(cmp_bool, 0)))) ThenBlock: {
                use_parent = 0
            }
        }
        // class C(Mixin, TestCase) / class C(Mixin, PyTest): first base is not TestCase
        IfCondition EqualTo(is_test, 0) ThenBlock: {
            nbsm = Array.Size(bases)
            bjm = 0
            WhileLoop LessThan(bjm, nbsm) {
                bnmm = Array.Get(bases, bjm)
                IfCondition EqualTo(StringCompare(bnmm, "TestCase"), 0) ThenBlock: {
                    is_test = 1
                }
                IfCondition EqualTo(StringCompare(bnmm, "TestEmailBase"), 0) ThenBlock: {
                    is_test = 1
                }
                IfCondition EqualTo(OOPGen_LooksLikeTestClass(bnmm), 1) ThenBlock: {
                    is_test = 1
                }
                bjm = Add(bjm, 1)
            }
        }
        cmp_co2 = StringCompare(class_name, "CallingOrder")
        cmp_ms2 = StringCompare(class_name, "ModuleSpecTests")
        cmp_phs = StringCompare(class_name, "PathHookTests")
        cmp_pht = StringCompare(class_name, "PathHookTest")
        cmp_rv = StringCompare(class_name, "ReturnValue")
        cmp_pmt = StringCompare(class_name, "ParentModuleTests")
        IfCondition Or(EqualTo(cmp_co2, 0), Or(EqualTo(cmp_ms2, 0), Or(EqualTo(cmp_phs, 0), Or(EqualTo(cmp_pht, 0), Or(EqualTo(cmp_rv, 0), EqualTo(cmp_pmt, 0)))))) ThenBlock: {
            is_test = 1
        }
        IfCondition EqualTo(has_nb, 1) ThenBlock: {
            is_test = 1
        }
        mixin_first = 0
        IfCondition EqualTo(is_test, 1) ThenBlock: {
            IfCondition Or(EqualTo(parent, 0), Or(EqualTo(StringCompare(parent, "TestCase"), 0), EqualTo(StringCompare(parent, "object"), 0))) ThenBlock: {
                use_parent = "TestCase"
            } ElseBlock: {
                use_parent = parent
            }
        }
        cmp_utp = StringCompare(class_name, "UnicodeTest")
        IfCondition EqualTo(cmp_utp, 0) ThenBlock: {
            use_parent = "TestCase"
        }
        cmp_frt = StringCompare(class_name, "FutureReprTests")
        IfCondition EqualTo(cmp_frt, 0) ThenBlock: {
            use_parent = "TestCase"
        }
        IfCondition EqualTo(use_parent, 0) ThenBlock: {
            reg = StringConcat(reg, "0")
        } ElseBlock: {
            reg = StringConcat(reg, "\"")
            reg = StringConcat(reg, use_parent)
            reg = StringConcat(reg, "\"")
        }
        reg = StringConcat(reg, ")\n")
        Array.Push(OOPGen.class_init_code, reg)
        IfCondition EqualTo(is_test, 1) ThenBlock: {
            skip_run = 0
            cmp_why = StringCompare(class_name, "TestWhyCryptDidNotImport")
            cmp_br = StringCompare(class_name, "BrowserRegistrationTest")
            cmp_it = StringCompare(class_name, "ImportTest")
            cmp_tse = StringCompare(class_name, "TestScriptHelperEnvironment")
            cmp_cat = StringCompare(class_name, "CheckActualTests")
            cmp_ptc = StringCompare(class_name, "ProgramsTestCase")
            cmp_atc = StringCompare(class_name, "ArgsTestCase")
            cmp_tu = StringCompare(class_name, "TestUtils")
            IfCondition Or(EqualTo(cmp_why, 0), Or(EqualTo(cmp_br, 0), Or(EqualTo(cmp_it, 0), Or(EqualTo(cmp_tse, 0), Or(EqualTo(cmp_cat, 0), Or(EqualTo(cmp_ptc, 0), Or(EqualTo(cmp_atc, 0), EqualTo(cmp_tu, 0)))))))) ThenBlock: {
                skip_run = 1
            }
            // leftover English test_contextlib.py: TestExitStack
            // methods live on TestBaseExitStack so KeepTestMethod
            // never sees them. Isolation 0 on this class name.
            cmp_tes = StringCompare(class_name, "TestExitStack")
            IfCondition EqualTo(cmp_tes, 0) ThenBlock: {
                skip_run = 1
            }
            IfCondition EqualTo(skip_run, 0) ThenBlock: {
                Array.Push(OOPGen.test_classes, run_name)
            }
        }
        IfCondition NotEqual(mixin_first, 0) ThenBlock: {
            mixin_code = StringConcat("    OOP.ClassMixin(\"", run_name)
            mixin_code = StringConcat(mixin_code, "\", \"")
            mixin_code = StringConcat(mixin_code, mixin_first)
            mixin_code = StringConcat(mixin_code, "\")\n")
            Array.Push(OOPGen.class_init_code, mixin_code)
        }
        
        // Handle additional bases as mixins
        num_bases = Array.Size(bases)
        IfCondition GreaterThan(num_bases, 1) ThenBlock: {
            j = 1
            WhileLoop LessThan(j, num_bases) {
                mixin = Array.Get(bases, j)
                mixin_code = StringConcat("    OOP.ClassMixin(\"", run_name)
                mixin_code = StringConcat(mixin_code, "\", \"")
                mixin_code = StringConcat(mixin_code, mixin)
                mixin_code = StringConcat(mixin_code, "\")\n")
                Array.Push(OOPGen.class_init_code, mixin_code)
                j = Add(j, 1)
            }
        }
        
        // Emit field definitions
        num_fields = Array.Size(OOPGen.discovered_fields)
        k = 0
        WhileLoop LessThan(k, num_fields) {
            field_info = Array.Get(OOPGen.discovered_fields, k)
            field_name = Array.Get(field_info, 0)
            field_type = Array.Get(field_info, 1)
            
            field_code = StringConcat("    OOP.ClassField(\"", run_name)
            field_code = StringConcat(field_code, "\", \"")
            field_code = StringConcat(field_code, field_name)
            field_code = StringConcat(field_code, "\", \"")
            field_type_mapped = OOPGen_MapFieldType(field_type)
            field_code = StringConcat(field_code, field_type_mapped)
            field_code = StringConcat(field_code, "\")\n")
            Array.Push(OOPGen.class_init_code, field_code)
            
            k = Add(k, 1)
        }
        
        // Emit method registrations
        num_items = Array.Size(body)
        m = 0
        WhileLoop LessThan(m, num_items) {
            item = Array.Get(body, m)
            item_type = AST_Type(item)
            
            IfCondition EqualTo(item_type, Node.METHOD_DEF) ThenBlock: {
                method_name = AST_GetField(item, "name")
                func_name = StringConcat(class_name, "_")
                func_name = StringConcat(func_name, method_name)
                keep_m = OOPGen_KeepTestMethod(class_name, method_name)
                IfCondition EqualTo(has_ssi, 1) ThenBlock: {
                    keep_m = 0
                    IfCondition EqualTo(StringCompare(method_name, "test_init_subclass_error"), 0) ThenBlock: {
                        keep_m = 1
                    }
                }
                IfCondition Or(EqualTo(has_av, 1), EqualTo(has_nb, 1)) ThenBlock: {
                    keep_m = 0
                }
                IfCondition EqualTo(keep_m, 1) ThenBlock: {
                    emit_m = OOPGen_EmitTestName(class_name, method_name)
                    method_code = StringConcat("    OOP.ClassMethod(\"", run_name)
                    method_code = StringConcat(method_code, "\", \"")
                    method_code = StringConcat(method_code, emit_m)
                    method_code = StringConcat(method_code, "\", AddressOf(")
                    method_code = StringConcat(method_code, func_name)
                    method_code = StringConcat(method_code, "))\n")
                    Array.Push(OOPGen.class_init_code, method_code)
                    packed_code = StringConcat("    OOP.ClassPackedMethod(\"", run_name)
                    packed_code = StringConcat(packed_code, "\", \"")
                    packed_code = StringConcat(packed_code, emit_m)
                    packed_code = StringConcat(packed_code, "\")\n")
                    Array.Push(OOPGen.class_init_code, packed_code)
                }
            }
            IfCondition EqualTo(item_type, Node.ASSIGNMENT) ThenBlock: {
                aname = AST_GetField(item, "name")
                aval = AST_GetField(item, "value")
                IfCondition And(NotEqual(aname, 0), EqualTo(AST_Type(aval), Node.IDENT)) ThenBlock: {
                    src = ArrayGet(aval, 3)
                    src_fn = StringConcat(class_name, "_")
                    src_fn = StringConcat(src_fn, src)
                    found = 0
                    IfCondition NotEqual(OOPGen.emitted_methods, 0) ThenBlock: {
                        ei = 0
                        en = Array.Size(OOPGen.emitted_methods)
                        WhileLoop LessThan(ei, en) {
                            cmpm = StringCompare(Array.Get(OOPGen.emitted_methods, ei), src_fn)
                            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                                found = 1
                            }
                            ei = Add(ei, 1)
                        }
                    }
                    keep_a = OOPGen_KeepTestMethod(class_name, aname)
                    IfCondition And(EqualTo(found, 1), EqualTo(keep_a, 1)) ThenBlock: {
                        method_code = StringConcat("    OOP.ClassMethod(\"", run_name)
                        method_code = StringConcat(method_code, "\", \"")
                        method_code = StringConcat(method_code, aname)
                        method_code = StringConcat(method_code, "\", AddressOf(")
                        method_code = StringConcat(method_code, src_fn)
                        method_code = StringConcat(method_code, "))\n")
                        Array.Push(OOPGen.class_init_code, method_code)
                        packed_code = StringConcat("    OOP.ClassPackedMethod(\"", run_name)
                        packed_code = StringConcat(packed_code, "\", \"")
                        packed_code = StringConcat(packed_code, aname)
                        packed_code = StringConcat(packed_code, "\")\n")
                        Array.Push(OOPGen.class_init_code, packed_code)
                    }
                }
            }
            m = Add(m, 1)
        }
        OOPGen_EmitBufioMixinCopy(class_name, run_name)
        OOPGen_EmitDummyTestBasic(class_name, run_name, body)
        
        // Blank line after class
        Array.Push(OOPGen.class_init_code, "\n")
    }
}

Function.OOPGen_IsKwMapMethod {
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(method, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(method, "call"), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(method, "substitute"), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(method, "safe_substitute"), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(method, "format"), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(method, "methodcaller"), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.OOPGen_EmitKwPush {
    Input: args: Address
    Input: args_var: Address
    Body: {
        kw_var = OOPGen_TempVar("kw")
        Gen_EmitIndent()
        Gen_Emit(kw_var)
        Gen_Emit(" = Hash.Create(8)\n")
        Gen_EmitIndent()
        Gen_Emit("Hash.Set(")
        Gen_Emit(kw_var)
        Gen_Emit(", \"__kwargs__\", 1)\n")
        num_args = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            num_args = Array.Size(args)
        }
        i = 0
        WhileLoop LessThan(i, num_args) {
            arg = Array.Get(args, i)
            IfCondition EqualTo(AST_Type(arg), Node.KW_ARG) ThenBlock: {
                kn = ArrayGet(arg, 3)
                kv = ArrayGet(arg, 4)
                IfCondition EqualTo(Gen_HasCall(kv), 1) ThenBlock: {
                    kv = OOPGen_FlattenExpr(kv)
                }
                Gen_EmitIndent()
                Gen_Emit("Hash.Set(")
                Gen_Emit(kw_var)
                Gen_Emit(", \"")
                Gen_Emit(kn)
                Gen_Emit("\", ")
                OOPGen_Expr(kv)
                Gen_Emit(")\n")
            }
            i = Add(i, 1)
        }
        Gen_EmitIndent()
        Gen_Emit("Array.Push(")
        Gen_Emit(args_var)
        Gen_Emit(", ")
        Gen_Emit(kw_var)
        Gen_Emit(")\n")
    }
}

// =============================================================================
// INSTANCE CREATION: ClassName(args)
// =============================================================================

Function.OOPGen_InstanceCreation {
    Input: class_name: Address
    Input: args: Address
    Output: Address  // Returns temp var holding instance
    Body: {
        orig_name = class_name
        rn = OOPGen_RenameOf(class_name)
        IfCondition NotEqual(rn, 0) ThenBlock: {
            class_name = rn
        }
        num_args = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            num_args = Array.Size(args)
        }
        
        // Generate args array
        args_var = OOPGen_TempVar("init_args")
        instance_var = OOPGen_TempVar("inst")
        
        Gen_EmitIndent()
        Gen_Emit(args_var)
        Gen_Emit(" = Array.Create(8)\n")
        
        // Push positionals. KW_ARG is bound after ObjectNewInit via ObjectSet
        // (nested __init__ param lookup is not a TArray of IDENT nodes).
        n_pos = 0
        i = 0
        WhileLoop LessThan(i, num_args) {
            arg = Array.Get(args, i)
            IfCondition NotEqual(AST_Type(arg), Node.KW_ARG) ThenBlock: {
                IfCondition EqualTo(Gen_HasCall(arg), 1) ThenBlock: {
                    arg = Gen_FlattenExpr(arg)
                }
                Gen_EmitIndent()
                Gen_Emit("Array.Push(")
                Gen_Emit(args_var)
                Gen_Emit(", ")
                OOPGen_Expr(arg)
                Gen_Emit(")\n")
                n_pos = Add(n_pos, 1)
            }
            i = Add(i, 1)
        }
        init_fn_defs = StringConcat(class_name, "___init__")
        defs = Gen_LookupDefaults(init_fn_defs)
        IfCondition NotEqual(defs, 0) ThenBlock: {
            nd = Array.Size(defs)
            di = n_pos
            WhileLoop LessThan(di, nd) {
                dnode = Array.Get(defs, di)
                IfCondition NotEqual(dnode, 0) ThenBlock: {
                    IfCondition EqualTo(Gen_HasCall(dnode), 1) ThenBlock: {
                        dnode = Gen_FlattenExpr(dnode)
                    }
                    Gen_EmitIndent()
                    Gen_Emit("Array.Push(")
                    Gen_Emit(args_var)
                    Gen_Emit(", ")
                    OOPGen_Expr(dnode)
                    Gen_Emit(")\n")
                }
                di = Add(di, 1)
            }
        }
        
        // Create instance. Packed __init__ (UUID, >6 params) needs p__args array.
        init_fn = StringConcat(class_name, "___init__")
        // Always the compile-time class string. Nested-class locals
        // (CustomStr = "__nest_N_CustomStr") are not visible in lambdas.
        Gen_EmitIndent()
        Gen_Emit(instance_var)
        IfCondition EqualTo(Gen_IsPackedFunc(init_fn), 1) ThenBlock: {
            Gen_Emit(" = AIMacro.ObjectNewInitPacked(\"")
        } ElseBlock: {
            Gen_Emit(" = OOP.ObjectNewInit(\"")
        }
        Gen_Emit(class_name)
        Gen_Emit("\", ")
        Gen_Emit(args_var)
        Gen_Emit(")\n")

        i = 0
        WhileLoop LessThan(i, num_args) {
            a = Array.Get(args, i)
            IfCondition EqualTo(AST_Type(a), Node.KW_ARG) ThenBlock: {
                kn = ArrayGet(a, 3)
                kv = ArrayGet(a, 4)
                IfCondition EqualTo(Gen_HasCall(kv), 1) ThenBlock: {
                    kv = Gen_FlattenExpr(kv)
                }
                Gen_EmitIndent()
                Gen_Emit("AIMacro.ObjectSet(")
                Gen_Emit(instance_var)
                Gen_Emit(", \"")
                Gen_Emit(kn)
                Gen_Emit("\", ")
                OOPGen_Expr(kv)
                Gen_Emit(")\n")
            }
            i = Add(i, 1)
        }
        
        // Cleanup args
        Gen_EmitIndent()
        Gen_Emit("Array.Destroy(")
        Gen_Emit(args_var)
        Gen_Emit(")\n")
        
        ReturnValue(instance_var)
    }
}

// =============================================================================
// CHECK IF IDENTIFIER IS A KNOWN CLASS
// =============================================================================

Function.OOPGen_IsClassName {
    Input: name: Address
    Output: Integer
    Body: {
        // GUARD: Return 0 if OOP system not initialized
        IfCondition EqualTo(OOPGen.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(OOPGen_RenameOf(name), 0) ThenBlock: {
            ReturnValue(1)
        }
        
        num_classes = Array.Size(OOPGen.classes)
        i = 0
        WhileLoop LessThan(i, num_classes) {
            class_info = Array.Get(OOPGen.classes, i)
            class_name = Array.Get(class_info, 0)
            cmp = StringCompare(class_name, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.OOPGen_RenameOf {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(OOPGen.class_renames_from, 0)) ThenBlock: {
            ReturnValue(0)
        }
        nsz = Array.Size(OOPGen.class_renames_from)
        found = 0
        ni = 0
        WhileLoop LessThan(ni, nsz) {
            bn = Array.Get(OOPGen.class_renames_from, ni)
            cmpn = StringCompare(name, bn)
            IfCondition EqualTo(cmpn, 0) ThenBlock: {
                found = Array.Get(OOPGen.class_renames_to, ni)
            }
            ni = Add(ni, 1)
        }
        ReturnValue(found)
    }
}

Function.OOPGen_OrigOf {
    Input: uname: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(uname, 0), EqualTo(OOPGen.class_renames_to, 0)) ThenBlock: {
            ReturnValue(0)
        }
        nsz = Array.Size(OOPGen.class_renames_to)
        found = 0
        ni = 0
        WhileLoop LessThan(ni, nsz) {
            bn = Array.Get(OOPGen.class_renames_to, ni)
            cmpn = StringCompare(uname, bn)
            IfCondition EqualTo(cmpn, 0) ThenBlock: {
                found = Array.Get(OOPGen.class_renames_from, ni)
            }
            ni = Add(ni, 1)
        }
        ReturnValue(found)
    }
}

Function.OOPGen_ClassMethodAddr {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(OOPGen.current_class, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(OOPGen.in_classattrs, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(OOPGen.emitted_methods, 0) ThenBlock: {
            ReturnValue(0)
        }
        cand = StringConcat(OOPGen.current_class, "_")
        cand = StringConcat(cand, name)
        ei = 0
        en = Array.Size(OOPGen.emitted_methods)
        WhileLoop LessThan(ei, en) {
            cmpm = StringCompare(Array.Get(OOPGen.emitted_methods, ei), cand)
            IfCondition EqualTo(cmpm, 0) ThenBlock: {
                ReturnValue(cand)
            }
            ei = Add(ei, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EMIT CLASS INITIALIZATION SUBROUTINE
// =============================================================================

Function.OOPGen_EmitClassInitSubroutine {
    Body: {
        // GUARD: Check initialization first
        IfCondition EqualTo(OOPGen.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition EqualTo(OOPGen.has_classes, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Gen_Emit("Function.__OOP_ClassInit {\n")
        Gen_Emit("    Output: Integer\n")
        Gen_Emit("    Body: {\n")
        Gen_Emit("        AIMacro.UnittestBoot()\n")
        
        num_lines = Array.Size(OOPGen.class_init_code)
        i = 0
        WhileLoop LessThan(i, num_lines) {
            line = Array.Get(OOPGen.class_init_code, i)
            Gen_Emit("    ")  // Extra indent since we're inside Body
            Gen_Emit(line)
            i = Add(i, 1)
        }
        
        Gen_Emit("        ReturnValue(1)\n")
        Gen_Emit("    }\n")
        Gen_Emit("}\n\n")
    }
}


// =============================================================================
// CONTROL FLOW (with OOP expression support)
// =============================================================================

Function.OOPGen_If {
    Input: stmt: Address
    Body: {
        condition = AST_GetField(stmt, "condition")
        then_body = AST_GetField(stmt, "then")
        else_body = AST_GetField(stmt, "else")
        
        IfCondition NotEqual(condition, 0) ThenBlock: {
            cond_has_call = Gen_HasCall(condition)
            IfCondition EqualTo(cond_has_call, 1) ThenBlock: {
                condition = Gen_FlattenExpr(condition)
            }
        }
        
        Gen_EmitIndent()
        Gen_Emit("IfCondition AIMacro.SmartBool(")
        OOPGen_Expr(condition)
        Gen_Emit(") ThenBlock: {\n")
        
        Gen.indent = Add(Gen.indent, 1)
        OOPGen_MethodBody(then_body)
        Gen.indent = Subtract(Gen.indent, 1)
        
        IfCondition NotEqual(else_body, 0) ThenBlock: {
            Gen_EmitIndent()
            Gen_Emit("} ElseBlock: {\n")
            Gen.indent = Add(Gen.indent, 1)
            OOPGen_MethodBody(else_body)
            Gen.indent = Subtract(Gen.indent, 1)
        }
        
        Gen_EmitIndent()
        Gen_Emit("}\n")
    }
}

Function.OOPGen_While {
    Input: stmt: Address
    Body: {
        condition = AST_GetField(stmt, "condition")
        body = AST_GetField(stmt, "body")
        else_body = AST_GetField(stmt, "else")
        saved_flag = Gen_LoopElseEnter(else_body)
        
        IfCondition NotEqual(condition, 0) ThenBlock: {
            cond_has_call = Gen_HasCall(condition)
            IfCondition EqualTo(cond_has_call, 1) ThenBlock: {
                condition = Gen_FlattenExpr(condition)
            }
        }
        
        Gen_EmitIndent()
        Gen_Emit("WhileLoop AIMacro.SmartBool(")
        OOPGen_Expr(condition)
        Gen_Emit(") {\n")
        
        Gen.indent = Add(Gen.indent, 1)
        OOPGen_MethodBody(body)
        Gen.indent = Subtract(Gen.indent, 1)
        
        Gen_EmitIndent()
        Gen_Emit("}\n")
        // else body via Gen_Body (statements already lowered); method-aware stmts rare in else
        Gen_LoopElseExit(else_body, saved_flag)
    }
}

Function.OOPGen_For {
    Input: stmt: Address
    Body: {
        // Delegate to standard for loop generation
        // but with OOP-aware body processing
        Gen_For(stmt)
    }
}

Function.OOPGen_Condition {
    Input: expr: Address
    Body: {
        // BINARY_OP.op is a Token integer, not "==". Use SmartBool+expr
        // like Gen_If so StringCompare on an int cannot SIGSEGV.
        OOPGen_Expr(expr)
    }
}
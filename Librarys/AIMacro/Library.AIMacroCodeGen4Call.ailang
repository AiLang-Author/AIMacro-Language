        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AIMacro.Open") }

        cmp = StringCompare(name, "input")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AIMacro.Input") }

        cmp = StringCompare(name, "__import__")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AIMacro.NoOp") }

        cmp = StringCompare(name, "oct")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AIMacro.NoOp") }

        cmp = StringCompare(name, "bin")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AIMacro.NoOp") }

        cmp = StringCompare(name, "vars")

        cmp = StringCompare(name, "dir")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("AIMacro.NoOp") }

        ReturnValue(name)
    }
}

Function.Gen_IsDropRecvMethod {
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(method, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(method, "iskeyword")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "issoftkeyword")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "captured_output")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "getvalue")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "assert_python_ok")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gen_EmitDropRecvMethod {
    Input: method: Address
    Input: args: Address
    Body: {
        fn = "AIMacro.KeywordIsKeyword"
        cmp = StringCompare(method, "issoftkeyword")
        IfCondition EqualTo(cmp, 0) ThenBlock: { fn = "AIMacro.KeywordIsSoftKeyword" }
        cmp = StringCompare(method, "captured_output")
        IfCondition EqualTo(cmp, 0) ThenBlock: { fn = "AIMacro.CapturedOutput" }
        cmp = StringCompare(method, "getvalue")
        IfCondition EqualTo(cmp, 0) ThenBlock: { fn = "AIMacro.IoGetValue" }
        cmp = StringCompare(method, "assert_python_ok")
        IfCondition EqualTo(cmp, 0) ThenBlock: { fn = "AIMacro.AssertPythonOk" }
        Gen_Emit(fn)
        Gen_Emit("(")
        IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
            a0 = Array.Get(args, 0)
            IfCondition EqualTo(Gen_HasCall(a0), 1) ThenBlock: {
                a0 = Gen_FlattenExpr(a0)
            }
            Gen_Expr(a0)
        } ElseBlock: {
            Gen_Emit("0")
        }
        Gen_Emit(")")
    }
}


// =============================================================================
// MAP TYPE NAME TO TYPEID CONSTANT
// Converts Python type names to TypeID.* constants
// =============================================================================
Function.Gen_MapTypeConstant {
    Input: name: Address
    Output: Address
    Body: {
        cmp = StringCompare(name, "int")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.INT") }

        cmp = StringCompare(name, "float")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.FLOAT") }
        
        cmp = StringCompare(name, "str")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.STR") }

        cmp = StringCompare(name, "bytes")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.STR") }

        cmp = StringCompare(name, "bytearray")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.STR") }
        
        cmp = StringCompare(name, "list")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.LIST") }

        cmp = StringCompare(name, "tuple")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.LIST") }
        
        cmp = StringCompare(name, "dict")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.DICT") }
        
        cmp = StringCompare(name, "bool")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.BOOL") }
        
        cmp = StringCompare(name, "None")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.NONE") }
        
        cmp = StringCompare(name, "NoneType")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.NONE") }

        cmp = StringCompare(name, "type")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.UNKNOWN") }

        cmp = StringCompare(name, "slice")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("TypeID.UNKNOWN") }

        // Exception types as isinstance args — ExcKind ints (see Gen_MapExcKind)
        cmp = StringCompare(name, "ValueError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("2") }
        cmp = StringCompare(name, "TypeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("5") }
        cmp = StringCompare(name, "StopIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("9") }
        cmp = StringCompare(name, "StopAsyncIteration")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("10") }
        cmp = StringCompare(name, "BaseExceptionGroup")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("11") }
        cmp = StringCompare(name, "ExceptionGroup")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue("12") }
        
        // Unknown type - return as-is (might be a variable)
        ReturnValue(name)
    }
}

Function.Gen_EmitOsJoinArgs {
    Input: args: Address
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            Gen_Emit("\".\"")
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            Gen_Expr(Array.Get(args, 0))
            ReturnValue(0)
        }
        Gen_Emit("AIMacro.OsJoin(")
        Gen_EmitOsJoinArgs(args, Subtract(n, 1))
        Gen_Emit(", ")
        Gen_Expr(Array.Get(args, Subtract(n, 1)))
        Gen_Emit(")")
    }
}

Function.Gen_EmitStdlibMethod {
    Input: obj: Address
    Input: method: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Gen_IsStdlibMethod(obj, method), 0) ThenBlock: {
            ReturnValue(0)
        }
        n = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            n = Array.Size(args)
        }
        IfCondition EqualTo(Gen_IsOsPath(obj), 1) ThenBlock: {
            cmp = StringCompare(method, "join")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitOsJoinArgs(args, n)
                ReturnValue(1)
            }
            cmp = StringCompare(method, "exists")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsExists(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\".\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "basename")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsBasename(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\"\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "dirname")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsDirname(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\".\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "listdir")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsListdir(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\".\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "openpty")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsOpenpty()")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "close")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsClose(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "write")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsWrite(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(", ")
                IfCondition GreaterThan(n, 1) ThenBlock: {
                    Gen_Expr(Array.Get(args, 1))
                } ElseBlock: {
                    Gen_Emit("\"\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "read")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsRead(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(", ")
                IfCondition GreaterThan(n, 1) ThenBlock: {
                    Gen_Expr(Array.Get(args, 1))
                } ElseBlock: {
                    Gen_Emit("1024")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "isatty")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsIsatty(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "join")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_EmitOsJoinArgs(args, n)
                ReturnValue(1)
            }
            cmp = StringCompare(method, "exists")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsExists(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\".\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "basename")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsBasename(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\"\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "dirname")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.OsDirname(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\".\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "loads")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.JsonLoads(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("\"null\"")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "dumps")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.JsonDumps(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("Types.GetNone()")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "sqrt")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Sqrt(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "sin")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Sin(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "cos")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Cos(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Pi()")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "time")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.TimeTime()")
                ReturnValue(1)
            }
            cmp = StringCompare(method, "sleep")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.TimeSleep(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "exit")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Exit(")
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    Gen_Expr(Array.Get(args, 0))
                } ElseBlock: {
                    Gen_Emit("0")
                }
                Gen_Emit(")")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "platform")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "system")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.UnameSysname()")
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

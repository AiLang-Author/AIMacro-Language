Function.AIMacro.MethodShim {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        a0 = 0
        a1 = 0
        n = 0
        IfCondition NotEqual(args, 0) ThenBlock: {
            n = Array.Size(args)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                a0 = Array.Get(args, 0)
            }
            IfCondition GreaterThan(n, 1) ThenBlock: {
                a1 = Array.Get(args, 1)
            }
        }
        IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
            lsms = AIMacro.LooksLikeString(method_name)
            IfCondition EqualTo(lsms, 1) ThenBlock: {
                tblms = MethodSkip.table
                IfCondition EqualTo(tblms, 0) ThenBlock: {
                    tblms = AIMacro.InitMethodSkip()
                    MethodSkip.table = tblms
                }
                hitms = Hash.Get(tblms, method_name)
                IfCondition NotEqual(hitms, 0) ThenBlock: {
                    AIMacro.RaiseKind(8, "skip")
                    ReturnValue(0)
                }
            }
        }
        IfCondition Or(EqualTo(StringCompare(method_name, "assertRaises"), 0), EqualTo(StringCompare(method_name, "assertRaisesRegex"), 0)) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                ReturnValue(cm)
            }
            IfCondition EqualTo(StringCompare(method_name, "assertRaisesRegex"), 0) ThenBlock: {
                IfCondition LessThan(n, 3) ThenBlock: {
                    cm = Hash.Create(4)
                    Hash.Set(cm, "__raises__", 1)
                    Hash.Set(cm, "exc", a0)
                    ReturnValue(cm)
                }
                fnargs = AIMacro.EmptyList()
                fi = 3
                WhileLoop LessThan(fi, n) {
                    Array.Push(fnargs, Array.Get(args, fi))
                    fi = Add(fi, 1)
                }
                ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, a0, Array.Get(args, 2), fnargs))
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                Hash.Set(cm, "exc", a0)
                ReturnValue(cm)
            }
            fnargs = AIMacro.EmptyList()
            fi = 2
            WhileLoop LessThan(fi, n) {
                Array.Push(fnargs, Array.Get(args, fi))
                fi = Add(fi, 1)
            }
            ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, a0, a1, fnargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "call"), 0) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                AIMacro.RaiseKind(5, "call")
                ReturnValue(0)
            }
            cargs = AIMacro.EmptyList()
            kw = Hash.Create(8)
            ci = 1
            WhileLoop LessThan(ci, n) {
                el = Array.Get(args, ci)
                IfCondition NotEqual(el, AddressOf(AIMacro.KwArgError)) ThenBlock: {
                    is_kwmap = 0
                    IfCondition EqualTo(AIMacro.SafeIsHash(el), 1) ThenBlock: {
                        IfCondition NotEqual(Hash.Get(el, "__kwargs__"), 0) ThenBlock: {
                            is_kwmap = 1
                        }
                    }
                    IfCondition EqualTo(is_kwmap, 1) ThenBlock: {
                        kw = AIMacro.KwMapCopy(el)
                    } ElseBlock: {
                        Array.Push(cargs, el)
                    }
                }
                ci = Add(ci, 1)
            }
            ReturnValue(CallIndirect(a0, cargs, kw))
        }
        IfCondition EqualTo(StringCompare(method_name, "truth"), 0) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                AIMacro.RaiseKind(5, "truth")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.Bool(a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "not_"), 0) ThenBlock: {
            ReturnValue(AIMacro.NotVal(a0))
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition Or(EqualTo(StringCompare(method_name, "lt"), 0), EqualTo(StringCompare(method_name, "le"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "eq"), 0), EqualTo(StringCompare(method_name, "ne"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "gt"), 0), EqualTo(StringCompare(method_name, "ge"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "add"), 0), EqualTo(StringCompare(method_name, "sub"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "mul"), 0), EqualTo(StringCompare(method_name, "xor"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "rshift"), 0), EqualTo(StringCompare(method_name, "lshift"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "contains"), 0), EqualTo(StringCompare(method_name, "setitem"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "abs"), 0), EqualTo(StringCompare(method_name, "concat"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "pow"), 0), EqualTo(StringCompare(method_name, "substitute"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "mod"), 0), EqualTo(StringCompare(method_name, "truediv"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "neg"), 0), EqualTo(StringCompare(method_name, "pos"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "inv"), 0), EqualTo(StringCompare(method_name, "invert"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "matmul"), 0), EqualTo(StringCompare(method_name, "attrgetter"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition EqualTo(StringCompare(method_name, "itemgetter"), 0) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "getitem"), 0), EqualTo(StringCompare(method_name, "index"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "countOf"), 0), EqualTo(StringCompare(method_name, "indexOf"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "delitem"), 0), EqualTo(StringCompare(method_name, "truth"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "is_"), 0), EqualTo(StringCompare(method_name, "is_not"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(StringCompare(method_name, "methodcaller"), 0), EqualTo(StringCompare(method_name, "length_hint"), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "operator")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(StringCompare(method_name, "register"), 0) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                AIMacro.RaiseKind(5, "register")
                ReturnValue(0)
            }
            cn = obj
            IfCondition EqualTo(AIMacro.SafeIsHash(obj), 1) ThenBlock: {
                n1 = Hash.Get(obj, "__name__")
                IfCondition EqualTo(n1, 0) ThenBlock: {
                    n1 = Hash.Get(obj, "__class__")
                }
                IfCondition NotEqual(n1, 0) ThenBlock: {
                    cn = n1
                }
            }
            sn = a0
            IfCondition EqualTo(AIMacro.SafeIsHash(a0), 1) ThenBlock: {
                n2 = Hash.Get(a0, "__name__")
                IfCondition EqualTo(n2, 0) ThenBlock: {
                    n2 = Hash.Get(a0, "__class__")
                }
                IfCondition NotEqual(n2, 0) ThenBlock: {
                    sn = n2
                }
            }
            OOP.ClassRegisterVirtual(cn, sn)
            ReturnValue(a0)
        }
        IfCondition EqualTo(StringCompare(method_name, "contains"), 0) ThenBlock: {
            IfCondition LessThan(n, 2) ThenBlock: {
                AIMacro.RaiseKind(5, "contains")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(a0, 0), EqualTo(AIMacro.IsNone(a0), 1)) ThenBlock: {
                AIMacro.RaiseKind(5, "contains")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.Contains(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "extend"), 0) ThenBlock: {
            AIMacro.ListExtend(obj, a0)
            ReturnValue(obj)
        }
        IfCondition EqualTo(StringCompare(method_name, "sub"), 0) ThenBlock: {
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "sub")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumSub(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "add"), 0) ThenBlock: {
            IfCondition EqualTo(Array.IsArray(obj), 1) ThenBlock: {
                AIMacro.SetAdd(obj, a0)
                ReturnValue(Types.GetNone())
            }
            okadd = 0
            IfCondition EqualTo(AIMacro.IsPyNumber(a0), 1) ThenBlock: {
                okadd = 1
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(a0), 1) ThenBlock: {
                okadd = 1
            }
            IfCondition EqualTo(Array.IsArray(a0), 1) ThenBlock: {
                okadd = 1
            }
            IfCondition EqualTo(AIMacro.SafeIsHash(a0), 1) ThenBlock: {
                okadd = 1
            }
            IfCondition EqualTo(okadd, 0) ThenBlock: {
                AIMacro.RaiseKind(5, "add")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumAdd(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "mul"), 0) ThenBlock: {
            okmul = 0
            IfCondition EqualTo(AIMacro.IsPyNumber(a0), 1) ThenBlock: {
                okmul = 1
            }
            IfCondition EqualTo(AIMacro.LooksLikeString(a0), 1) ThenBlock: {
                okmul = 1
            }
            IfCondition EqualTo(Array.IsArray(a0), 1) ThenBlock: {
                okmul = 1
            }
            IfCondition EqualTo(AIMacro.SafeIsHash(a0), 1) ThenBlock: {
                okmul = 1
            }
            IfCondition EqualTo(okmul, 0) ThenBlock: {
                AIMacro.RaiseKind(5, "mul")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumMul(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "xor"), 0) ThenBlock: {
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "xor")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitXor(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "rshift"), 0) ThenBlock: {
            IfCondition LessThan(n, 2) ThenBlock: {
                AIMacro.RaiseKind(5, "rshift")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "rshift")
                ReturnValue(0)
            }
            IfCondition LessThan(AIMacro.UnboxIntZero(a1), 0) ThenBlock: {
                AIMacro.RaiseKind(2, "negative shift count")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitShr(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "lshift"), 0) ThenBlock: {
            IfCondition LessThan(n, 2) ThenBlock: {
                AIMacro.RaiseKind(5, "lshift")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "lshift")
                ReturnValue(0)
            }
            IfCondition LessThan(AIMacro.UnboxIntZero(a1), 0) ThenBlock: {
                AIMacro.RaiseKind(2, "negative shift count")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitShl(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "floordiv"), 0) ThenBlock: {
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "floordiv")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.FloorDiv(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "eq"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumEq(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "ne"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumNe(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "le"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumLe(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "ge"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumGe(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "gt"), 0) ThenBlock: {
            ReturnValue(AIMacro.NumGt(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "and_"), 0) ThenBlock: {
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "and_")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitAnd(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "or_"), 0) ThenBlock: {
            IfCondition Or(EqualTo(AIMacro.IsPyNumber(a0), 0), EqualTo(AIMacro.IsPyNumber(a1), 0)) ThenBlock: {
                AIMacro.RaiseKind(5, "or_")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumBitOr(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "concat"), 0) ThenBlock: {
            IfCondition EqualTo(AIMacro.IsPyNumber(a0), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "concat")
                ReturnValue(0)
            }
            IfCondition Or(EqualTo(a0, 0), EqualTo(AIMacro.IsNone(a0), 1)) ThenBlock: {
                AIMacro.RaiseKind(5, "concat")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumAdd(a0, a1))
        }
        IfCondition EqualTo(StringCompare(method_name, "abs"), 0) ThenBlock: {
            IfCondition EqualTo(AIMacro.IsPyNumber(a0), 0) ThenBlock: {
                AIMacro.RaiseKind(5, "abs")
                ReturnValue(0)
            }
            ReturnValue(AIMacro.NumAbs(a0))
        }
        IfCondition EqualTo(StringCompare(method_name, "setitem"), 0) ThenBlock: {
            IfCondition LessThan(n, 3) ThenBlock: {
                AIMacro.RaiseKind(5, "setitem")
                ReturnValue(0)
            }
            a2 = Array.Get(args, 2)
            IfCondition Or(EqualTo(a1, 0), EqualTo(AIMacro.IsNone(a1), 1)) ThenBlock: {
                AIMacro.RaiseKind(5, "setitem")
                ReturnValue(0)
            }
            IfCondition EqualTo(Array.IsArray(a0), 1) ThenBlock: {
                idx = AIMacro.NormIndex(a1, Array.Size(a0))
                IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, Array.Size(a0))) ThenBlock: {
                    AIMacro.RaiseKind(17, "setitem")
                    ReturnValue(0)
                }
                Array.Set(a0, idx, a2)
                ReturnValue(Types.GetNone())
            }
            IfCondition EqualTo(Hash.IsHash(a0), 1) ThenBlock: {
                Hash.Set(a0, AIMacro.Str(a1), a2)
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(StringCompare(method_name, "substitute"), 0) ThenBlock: {
            ReturnValue(AIMacro.TemplateSub(obj, a0))

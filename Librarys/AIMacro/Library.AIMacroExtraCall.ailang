            sio = AIMacro.MakeStringIO(a0)
            ReturnValue(sio)
        }
        IfCondition EqualTo(StringCompare(method_name, "isdir"), 0) ThenBlock: {
            ip = AIMacro.PathArg(obj, a0)
            idr = AIMacro.IsDir(ip)
            ReturnValue(idr)
        }
        IfCondition EqualTo(StringCompare(method_name, "setUp"), 0) ThenBlock: {
            none_su = Types.GetNone()
            ReturnValue(none_su)
        }
        IfCondition EqualTo(StringCompare(method_name, "mkdtemp"), 0) ThenBlock: {
            mtd = AIMacro.Mkdtemp(a0)
            ReturnValue(mtd)
        }
        IfCondition EqualTo(StringCompare(method_name, "getcwd"), 0) ThenBlock: {
            cwd = AIMacro.Getcwd()
            ReturnValue(cwd)
        }
        IfCondition EqualTo(StringCompare(method_name, "chdir"), 0) ThenBlock: {
            cp = AIMacro.PathArg(obj, a0)
            ch = AIMacro.Chdir(cp)
            ReturnValue(ch)
        }
        IfCondition EqualTo(StringCompare(method_name, "stat"), 0) ThenBlock: {
            sp = AIMacro.PathArg(obj, a0)
            stv = AIMacro.Stat(sp)
            ReturnValue(stv)
        }
        IfCondition EqualTo(StringCompare(method_name, "import_tool"), 0) ThenBlock: {
            itl = Types.GetNone()
            ReturnValue(itl)
        }
        IfCondition EqualTo(StringCompare(method_name, "imports_under_tool"), 0) ThenBlock: {
            iut2 = Hash.Create(4)
            ReturnValue(iut2)
        }
        // in_test unknown method: RaiseKind 8 is a silent UnittestRun skip
        // (same as MethodSkip). Import-time still prints and returns 0.
        IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
            AIMacro.RaiseKind(8, "skip")
            ReturnValue(0)
        }
        PrintMessage("ERROR: Method not found: ")
        PrintMessage(method_name)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.AIMacro.MethodCall {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(method_name, "assertRaises"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                exc = 0
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    exc = Array.Get(args, 0)
                }
                cm = Hash.Create(4)
                Hash.Set(cm, "__raises__", 1)
                Hash.Set(cm, "exc", exc)
                ReturnValue(cm)
            }
            exc = Array.Get(args, 0)
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            ReturnValue(AIMacro.UnittestAssertRaisesCall(obj, exc, func, fnargs))
        }
        IfCondition EqualTo(StringCompare(method_name, "assertWarns"), 0) ThenBlock: {
            n = 0
            IfCondition NotEqual(args, 0) ThenBlock: {
                n = Array.Size(args)
            }
            IfCondition LessThan(n, 2) ThenBlock: {
                cm = Hash.Create(4)
                Hash.Set(cm, "__warns__", 1)
                ReturnValue(cm)
            }
            func = Array.Get(args, 1)
            fnargs = AIMacro.EmptyList()
            i = 2
            WhileLoop LessThan(i, n) {
                Array.Push(fnargs, Array.Get(args, i))
                i = Add(i, 1)
            }
            AIMacro.SmartCallN(func, fnargs)
            ReturnValue(1)
        }
        func_addr = 0
        IfCondition EqualTo(Hash.IsHash(obj), 1) ThenBlock: {
            func_addr = OOP.MethodLookup(obj, method_name)
        }
        IfCondition EqualTo(StringCompare(method_name, "substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSub(obj, a0s))
        }
        IfCondition EqualTo(StringCompare(method_name, "safe_substitute"), 0) ThenBlock: {
            a0s = 0
            IfCondition And(NotEqual(args, 0), GreaterThan(Array.Size(args), 0)) ThenBlock: {
                a0s = Array.Get(args, 0)
            }
            ReturnValue(AIMacro.TemplateSafeSub(obj, a0s))
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            fn = AIMacro.ObjectGet(obj, method_name)
            // ELF function pointers start at 0x400000. ObjectGet integer
            // stubs (getrefcount=2) are not callables; MethodShim handles them.
            IfCondition And(NotEqual(fn, 0), GreaterEqual(fn, 4194304)) ThenBlock: {
                ReturnValue(AIMacro.SmartCallN(fn, args))
            }
        }
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(AIMacro.MethodShim(obj, method_name, args))
        }
        IfCondition EqualTo(OOP.IsPackedMethod(obj, method_name), 1) ThenBlock: {
            pargs = AIMacro.PackCallArgs(obj, args)
            ReturnValue(CallIndirect(func_addr, pargs))
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        num_args = Array.Size(args)
        IfCondition EqualTo(num_args, 0) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj))
        }
        arg0 = Array.Get(args, 0)
        IfCondition EqualTo(arg0, 0) ThenBlock: {
            arg0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 1) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0))
        }
        arg1 = Array.Get(args, 1)
        IfCondition EqualTo(arg1, 0) ThenBlock: {
            arg1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 2) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1))
        }
        arg2 = Array.Get(args, 2)
        IfCondition EqualTo(arg2, 0) ThenBlock: {
            arg2 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 3) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2))
        }
        arg3 = Array.Get(args, 3)
        IfCondition EqualTo(arg3, 0) ThenBlock: {
            arg3 = AIMacro.IntZero()
        }
        IfCondition EqualTo(num_args, 4) ThenBlock: {
            ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3))
        }
        arg4 = Array.Get(args, 4)
        IfCondition EqualTo(arg4, 0) ThenBlock: {
            arg4 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3, arg4))
    }
}

Function.AIMacro.SmartCall {
    Input: fn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                AIMacro.RaiseKind(8, "skip")
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            empty = AIMacro.EmptyList()
            ReturnValue(AIMacro.SmartCallN(fn, empty))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
                empty = Array.Create(0)
                ReturnValue(OOP.ObjectNewInit(fn, empty))
            }
            OOP.ClassDefine(fn, 0)
            empty = Array.Create(0)
            ReturnValue(OOP.ObjectNewInit(fn, empty))
        }
        // ELF function pointers start at 0x400000. Match captures dumped
        // to PyMod.f leave an integer; ClassExists/CallIndirect is strlen.
        IfCondition GreaterEqual(fn, 4194304) ThenBlock: {
            ReturnValue(CallIndirect(fn))
        }
        ReturnValue(Types.GetNone())
    }
}

Function.AIMacro.SmartCall1 {
    Input: fn: Address
    Input: arg: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                AIMacro.RaiseKind(8, "skip")
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            a = AIMacro.EmptyList()
            Array.Push(a, arg)
            ReturnValue(AIMacro.SmartCallN(fn, a))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            IfCondition EqualTo(OOP.ClassExists(fn), 1) ThenBlock: {
                a = Array.Create(1)
                Array.Push(a, arg)
                ReturnValue(OOP.ObjectNewInit(fn, a))
            }
            OOP.ClassDefine(fn, 0)
            a = Array.Create(1)
            Array.Push(a, arg)
            ReturnValue(OOP.ObjectNewInit(fn, a))
        }
        carg = arg
        IfCondition EqualTo(carg, 0) ThenBlock: {
            carg = AIMacro.IntZero()
        }
        IfCondition GreaterEqual(fn, 4194304) ThenBlock: {
            ReturnValue(CallIndirect(fn, carg))
        }
        ReturnValue(Types.GetNone())
    }
}

Function.AIMacro.SmartCall2 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCall3 {
    Input: fn: Address
    Input: a0: Address
    Input: a1: Address
    Input: a2: Address
    Output: Address
    Body: {
        a = AIMacro.EmptyList()
        Array.Push(a, a0)
        Array.Push(a, a1)
        Array.Push(a, a2)
        ReturnValue(AIMacro.SmartCallN(fn, a))
    }
}

Function.AIMacro.SmartCallN {
    Input: fn: Address
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(fn, 0) ThenBlock: {
            IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                AIMacro.RaiseKind(8, "skip")
            }
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(args, 0) ThenBlock: {
            args = AIMacro.EmptyList()
        }
        IfCondition EqualTo(Hash.IsHash(fn), 1) ThenBlock: {
            knd = Hash.Get(fn, "__kind__")
            IfCondition NotEqual(knd, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(knd, "unpack_last"), 0) ThenBlock: {
                    srcu = 0
                    IfCondition GreaterThan(Array.Size(args), 0) ThenBlock: {
                        srcu = Array.Get(args, 0)
                    }
                    nu = AIMacro.IterLen(srcu)
                    IfCondition LessThan(nu, 1) ThenBlock: {
                        ReturnValue(AIMacro.IntZero())
                    }
                    liu = Subtract(nu, 1)
                    lastu = AIMacro.IterGet(srcu, liu)
                    ReturnValue(lastu)
                }
            }
            IfCondition NotEqual(Hash.Get(fn, "__opshim__"), 0) ThenBlock: {
                IfCondition EqualTo(Array.Size(args), 1) ThenBlock: {
                    a0s = Array.Get(args, 0)
                    IfCondition EqualTo(Array.IsArray(a0s), 1) ThenBlock: {
                        args = a0s
                    }
                }
                ReturnValue(AIMacro.CallOpShim(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__bound__"), 0) ThenBlock: {
                bobj = Hash.Get(fn, "obj")
                bname = Hash.Get(fn, "name")
                ReturnValue(AIMacro.MethodCall(bobj, bname, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__attrgetter__"), 0) ThenBlock: {
                ReturnValue(AIMacro.ApplyAttrGetter(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__itemgetter__"), 0) ThenBlock: {
                ReturnValue(AIMacro.ApplyItemGetter(fn, args))
            }
            IfCondition NotEqual(Hash.Get(fn, "__methodcaller__"), 0) ThenBlock: {
                nmc = Array.Size(args)
                IfCondition LessThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                IfCondition GreaterThan(nmc, 1) ThenBlock: {
                    AIMacro.RaiseKind(5, "methodcaller")
                    ReturnValue(0)
                }
                mcobj = Array.Get(args, 0)
                mcname = Hash.Get(fn, "name")
                mcargs = Hash.Get(fn, "args")
                IfCondition EqualTo(Array.IsArray(mcargs), 0) ThenBlock: {
                    mcargs = AIMacro.EmptyList()
                }
                mckw = Hash.Get(fn, "kwargs")
                IfCondition NotEqual(mckw, 0) ThenBlock: {
                    Array.Push(mcargs, mckw)
                }
                ReturnValue(AIMacro.MethodCall(mcobj, mcname, mcargs))
            }
        }
        IfCondition And(EqualTo(AIMacro.LooksLikeString(fn), 1), EqualTo(OOP.ClassExists(fn), 1)) ThenBlock: {
            is_enum_cls = 0
            walk_e = fn
            eh_e = 0
            WhileLoop LessThan(eh_e, 16) {
                IfCondition EqualTo(walk_e, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(StringCompare(walk_e, "enumerate"), 0) ThenBlock: {
                    is_enum_cls = 1
                    BreakLoop
                }
                walk_e = OOP.ClassGetParent(walk_e)
                eh_e = Add(eh_e, 1)
            }
            IfCondition EqualTo(is_enum_cls, 1) ThenBlock: {
                ns_e = 0
                IfCondition NotEqual(args, 0) ThenBlock: {
                    ns_e = Array.Size(args)
                }
                src_e = 0
                st_e = 0
                IfCondition GreaterThan(ns_e, 0) ThenBlock: {
                    src_e = Array.Get(args, 0)
                }
                IfCondition GreaterThan(ns_e, 1) ThenBlock: {
                    st_e = Array.Get(args, 1)
                    v0_it = AIMacro.LooksIterable(src_e)
                    v1_it = AIMacro.LooksIterable(st_e)
                    IfCondition EqualTo(v0_it, 0) ThenBlock: {
                        IfCondition EqualTo(v1_it, 1) ThenBlock: {
                            tmp_e = src_e
                            src_e = st_e
                            st_e = tmp_e
                        }
                    }
                }
                enu_e = AIMacro.EnumerateFrom(src_e, AIMacro.UnboxIntZero(st_e))
                Hash.Set(enu_e, "__class__", fn)
                ReturnValue(enu_e)
            }
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(fn), 1) ThenBlock: {
            OOP.ClassDefine(fn, 0)
            ReturnValue(OOP.ObjectNewInit(fn, args))
        }
        si = 0
        ns0 = Array.Size(args)
        WhileLoop LessThan(si, ns0) {
            IfCondition EqualTo(Array.Get(args, si), AddressOf(AIMacro.KwArgError)) ThenBlock: {
                IfCondition EqualTo(UnittestState.in_test, 1) ThenBlock: {
                    AIMacro.RaiseKind(8, "skip")
                }
                ElseBlock: {
                    AIMacro.RaiseKind(5, "keyword argument")
                }
                ReturnValue(0)
            }
            si = Add(si, 1)
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
            IfCondition NotEqual(Array.Size(args), 1) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(fn, AddressOf(AIMacro.Enumerate)) ThenBlock: {
            ns = Array.Size(args)
            IfCondition Or(EqualTo(ns, 0), GreaterThan(ns, 2)) ThenBlock: {
                AIMacro.RaiseKind(5, "enumerate")
                ReturnValue(0)
            }
            IfCondition EqualTo(ns, 2) ThenBlock: {
                ReturnValue(AIMacro.Enumerate2(Array.Get(args, 0), Array.Get(args, 1)))
            }
        }
        IfCondition LessThan(fn, 4194304) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        n = Array.Size(args)
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition EqualTo(fn, AddressOf(AIMacro.TypedReversed)) ThenBlock: {
                AIMacro.RaiseKind(5, "reversed")
                ReturnValue(0)
            }
            ReturnValue(CallIndirect(fn))
        }
        a0 = Array.Get(args, 0)
        IfCondition EqualTo(a0, 0) ThenBlock: {
            a0 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0))
        }
        a1 = Array.Get(args, 1)
        IfCondition EqualTo(a1, 0) ThenBlock: {
            a1 = AIMacro.IntZero()
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            ReturnValue(CallIndirect(fn, a0, a1))
        }
        a2 = Array.Get(args, 2)
        IfCondition EqualTo(a2, 0) ThenBlock: {
            a2 = AIMacro.IntZero()
        }
        ReturnValue(CallIndirect(fn, a0, a1, a2))
    }
}

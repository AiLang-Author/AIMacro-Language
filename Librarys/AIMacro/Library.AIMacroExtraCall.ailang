        Hash.Set(h, "in_table_a1", 1)
        Hash.Set(h, "getspall", 1)
        Hash.Set(h, "getspnam", 1)
        Hash.Set(h, "ServerProxy", 1)
        Hash.Set(h, "addinfourl", 1)
        Hash.Set(h, "symlink", 1)

# Nested def same name twice — statistics.py kde pdf/cdf (unique __nest_N_*)
def make(kind) {
    if kind {
        def pdf(x) {
            return x
        }
        return pdf
    } else {
        def pdf(x) {
            return x + 1
        }
        return pdf
    }
}
a = make(1)
b = make(0)
print(a)
print(b)
